// The editor baseline. Every other pack's fragment sits on top of this one,
// so what belongs here is what is true of a repository before it has a stack:
// the nesting map for repo-root and hygiene files, the exclude lists, and the
// editor-wide keys that name no language and no tool.
//
// A key that names a tool or a stack belongs to that pack, not here — the
// formatter keys and `[toml]` are the dprint gate's, `eslint.*` the eslint
// gate's, `js/ts.*` and the Node excludes the tsconfig gate's, `[dart]`,
// `dart.*` and the Dart tool directory the Dart gate's, `yaml.*` the
// pre-commit gate's, a package manager's or a framework's own output that
// pack's, and the toolchain manager's extension is its own. Composition order
// decides a collision, so a duplicated key is a silent override rather than
// an error: keep them disjoint.
{
  "settings": {
    "diffEditor.ignoreTrimWhitespace": false,
    "diffEditor.renderSideBySide": false,
    "editor.autoIndent": "full",
    "editor.codeActions.triggerOnFocusChange": false,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "never",
      "source.sort.json": "explicit",
    },
    "editor.defaultColorDecorators": "always",
    "editor.detectIndentation": false,
    "editor.indentSize": 2,
    "editor.insertSpaces": true,
    "editor.quickSuggestions": {
      "comments": true,
      "other": true,
      "strings": true,
    },
    "editor.suggest.insertMode": "replace",
    "editor.tabSize": 2,
    // File nesting is switched on here and collapsed by default; the map
    // itself is the `nesting` key below, which every pack contributes to.
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "files.autoGuessEncoding": true,
    // Regenerable output and the lockfile, hidden from the explorer. A path
    // hidden here is still searched unless it is in `search.exclude` too.
    //
    // `graphify-out/` is deliberately absent. .gitignore tracks exactly one
    // file inside it — GRAPH_REPORT.md, which is there to be read — and this
    // setting has no negation form, so hiding the directory would hide the one
    // file the negation exists for.
    //
    // A stack's own output — a dependency directory, a build cache, a
    // lockfile — is excluded by the fragment of the pack that pins that
    // stack, not here.
    "files.exclude": {
      "**/*.log": true,
      "**/ui-debug.log": true,
    },
    // `**/dist/` is deliberately `false`: a build watcher is how a rebuilt
    // artifact is noticed, and the tree is small enough to watch.
    "files.watcherExclude": {
      "**/.git/objects/**": true,
      "**/.git/subtree-cache/**": true,
      "**/.hg/store/**": true,
      "**/*.log": true,
      "**/coverage/": true,
      "**/dist/": false,
      "**/ui-debug.log": true,
    },
    "outline.showKeys": true,
    "search.exclude": {
      "**/*.code-search": true,
      "**/*.log": true,
      "**/bower_components": true,
      "**/coverage/": true,
      "**/dist/": true,
      "**/ui-debug.log": true,
    },
    "todo-tree.general.tags": [
      "TODO",
      "FIXME",
      "HACK",
      "REVIEW",
      "NOTE",
      "REFACTOR",
      "REMOVE",
    ],
    "todo-tree.highlights.defaultHighlight": {
      "hideFromActivityBar": true,
      "hideFromStatusBar": false,
      "type": "text-and-comment",
    },
  },
  // Parent → children, merged into `explorer.fileNesting.patterns`. Only
  // parents this pack owns are here; a pack nests its own files under its own
  // parent. `${capture}` and the glob forms are VS Code's, verbatim.
  //
  // Every ignore file the repo carries nests under `.gitignore`, whichever
  // tool reads it — that is where you go looking for an ignore file.
  //
  // A file nests under one parent only — `.env` under `.gitignore`, never
  // also under `.envrc`; `CLAUDE.md` under `readme.md`, never also under
  // `AGENTS.md` — because the editor takes the first parent that matches and
  // a second row is a silent no-op. A stack's manifest — `package.json`,
  // `*.js` — is the parent in the fragment of the pack that pins it.
  "nesting": {
    ".envrc": [".env.*", ".env.*.secrets", ".nvmrc", "*.env"],
    ".gitignore": [
      ".gitkeep",
      ".gitmodules",
      ".gitattributes",
      ".dockerignore",
      ".graphifyignore",
      ".prettierignore",
      ".env",
    ],
    "readme.md": [
      "todo.md",
      "LICENSE",
      "CLAUDE.md",
      "CONTRIBUTING.md",
      "SECURITY.md",
    ],
  },
  // Editor-wide helpers that belong to no one pack, and that a repository
  // wants before it has a stack. An extension for a tool, a framework or a
  // language is recommended by that thing's own pack — recommending it from
  // the baseline would put it in front of every repository, including the
  // ones that pinned the alternative.
  //
  // The todo tree is the companion to its settings keys above; drop it and the
  // keys it serves go dead. The other three are display alone.
  "extensions": [
    "gruntfuggly.todo-tree",
    "oderwat.indent-rainbow",
    "pkief.material-icon-theme",
    "usernamehw.errorlens",
  ],
}
