source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/plugins"

# Project scope resolves against the working directory.
cd "${MISE_PROJECT_ROOT}"

print_subheader "Checking the claude-code pack's plugins ..."
ensure_plugin "taste-skill@taste-skill" "Leonxlnx/taste-skill"
