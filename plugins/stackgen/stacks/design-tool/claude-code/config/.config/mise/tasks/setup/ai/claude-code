#!/usr/bin/env bash

#MISE description="Install the taste-skill plugin the canvas authoring runs through"
#MISE hide=true

set -euo pipefail
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"
