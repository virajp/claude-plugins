#!/usr/bin/env bash

#MISE description="Move the lockfile forward within the manifest's ranges"
#MISE hide=true

set -euo pipefail
# helpers ships with stackgen:tool-config, not this pack, so there is no
# path here for -x to follow.
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# `swift package update` re-resolves every dependency to the newest version its
# declared range allows and rewrites `Package.resolved`, fetching as it goes —
# so there is no separate re-install step. The lockfile diff is the review
# surface.
#
# One command, so no header: whatever called it — `setup:deps:all`, or a person
# — frames it.

swift package update
