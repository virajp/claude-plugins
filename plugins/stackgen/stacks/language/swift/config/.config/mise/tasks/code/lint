#!/usr/bin/env bash

#MISE description="Lint the repo's files"
#MISE dir="{{ config_root }}"

#USAGE flag "--debug" help="emit debug logs"
#USAGE flag "--fix" help="apply fixes"
#USAGE arg "[files]" var=#true help="files to lint (default: the whole repo)"

set -euo pipefail
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# `--fix` reaches the house linter only: layout is swift-format's, not SwiftLint's.

files=()
eval "files+=(${usage_files:-})"

args=()
if [[ "${usage_debug:-false}" == "true" ]]; then
  args+=(--debug)
fi
if [[ "${usage_fix:-false}" == "true" ]]; then
  args+=(--fix)
fi

print_header "Linting files ..."

# Keep shellcheck and actionlint in any overlay: a tool dropped here stops running.
if command -v shellcheck >/dev/null 2>&1; then
  shell_scope=()
  while IFS= read -r shell_file; do
    if [ -n "${shell_file}" ]; then
      shell_scope+=("${shell_file}")
    fi
  done < <(shell_files_in_scope ${files[@]+"${files[@]}"})

  if [ "${#shell_scope[@]}" -gt 0 ]; then
    print_subheader "Checking shell scripts ..."
    shellcheck -x "${shell_scope[@]}"
  fi
fi

if command -v actionlint >/dev/null 2>&1; then
  workflow_scope=()
  if [ "${#files[@]}" -gt 0 ]; then
    for candidate in "${files[@]}"; do
      case "${candidate}" in
        .github/workflows/*.yml | .github/workflows/*.yaml)
          if [ -f "${candidate}" ]; then
            workflow_scope+=("${candidate}")
          fi
          ;;
      esac
    done
  else
    while IFS= read -r workflow; do
      if [ -n "${workflow}" ]; then
        workflow_scope+=("${workflow}")
      fi
    done < <(git -C "${MISE_PROJECT_ROOT}" ls-files '.github/workflows/*.yml' '.github/workflows/*.yaml' 2>/dev/null || true)
  fi

  if [ "${#workflow_scope[@]}" -gt 0 ]; then
    print_subheader "Checking workflows ..."
    actionlint "${workflow_scope[@]}"
  fi
fi

# Whole tree from git's list, even with a file list: neither tool reads `.gitignore`.
lint_targets=()
swift_scope=()
in_git=false
if command -v git >/dev/null 2>&1; then
  if [ -n "${GIT_DIR:-}" ]; then
    in_git=true
  fi
  dir="${PWD}"
  while [ "${in_git}" = "false" ]; do
    if [ -e "${dir}/.git" ]; then
      in_git=true
    elif [ -z "${dir}" ]; then
      break
    else
      dir="${dir%/*}"
    fi
  done
fi

if [ "${in_git}" = "true" ]; then
  # To a file, not a process substitution, so a failed listing stops the task.
  git_list="$(mktemp "${TMPDIR:-/tmp}/code-lint.XXXXXX")"
  trap 'rm -f "${git_list}"' EXIT
  git_status=0
  git -c core.quotePath=off ls-files -z --cached --others --exclude-standard \
    >"${git_list}" || git_status=$?
  if [ "${git_status}" -ne 0 ]; then
    print_error "git ls-files failed (exit ${git_status})"
    exit "${git_status}"
  fi
  # Mid-merge git lists a conflicted path once per stage; skip the repeats.
  previous=""
  while IFS= read -r -d '' path; do
    if [ "${path}" = "${previous}" ]; then
      continue
    fi
    previous="${path}"
    case "${path}" in
      *[][*?{}\(\)!+@\\]*)
        case "${path}" in
          *.js | *.mjs | *.cjs | *.jsx | *.ts | *.mts | *.cts | *.tsx | *.astro | \
            *.css | *.html | *.json | *.jsonc | *.md | *.toml | *.yaml | *.yml)
            lint_targets+=("./${path}")
            ;;
        esac
        ;;
      *)
        # A one-file glob, so the linter skips an ignored or unknown type silently.
        lint_targets+=("./${path%?}[${path: -1}]")
        ;;
    esac
    case "/${path}" in
      */.build/* | */.swiftpm/* | */Derived/* | */DerivedData/* | *.generated.swift) ;;
      *.swift)
        if [ -f "${path}" ]; then
          swift_scope+=("./${path}")
        fi
        ;;
    esac
  done <"${git_list}"
else
  while IFS= read -r -d '' swift_file; do
    swift_scope+=("${swift_file}")
  done < <(find . \( -name .build -o -name .swiftpm -o -name Derived -o -name DerivedData \) -prune \
    -o -name '*.swift' ! -name '*.generated.swift' -print0)
fi

if [ "${in_git}" = "false" ] || [ "${#lint_targets[@]}" -gt 0 ]; then
  # By mise path: `node_modules/.bin` on PATH would shadow the pin in `conf.d/tools.toml`.
  linter_bin="$(mise which linter --tool npm:@askviraj/linter)"
  print_subheader "Linting config files ..."
  "${linter_bin}" ${args[@]+"${args[@]}"} ${lint_targets[@]+"${lint_targets[@]}"}
fi

# SwiftLint's "No lintable files" exit is an empty gate, not a failure.
if [ "${#swift_scope[@]}" -gt 0 ]; then
  print_subheader "Linting Swift sources ..."
  if ! swiftlint_output="$(swiftlint lint --strict --quiet --force-exclude \
    --config .config/swiftlint.yml "${swift_scope[@]}" 2>&1)"; then
    if [[ "${swiftlint_output}" == *"No lintable files found"* ]]; then
      print_yellow "Every Swift file is excluded by .config/swiftlint.yml; nothing to lint."
    else
      printf '%s\n' "${swiftlint_output}"
      exit 1
    fi
  elif [ -n "${swiftlint_output}" ]; then
    printf '%s\n' "${swiftlint_output}"
  fi
fi
