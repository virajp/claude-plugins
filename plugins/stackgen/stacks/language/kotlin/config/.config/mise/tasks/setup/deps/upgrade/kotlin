#!/usr/bin/env bash

#MISE description="Rewrite the lockfiles from the version catalog"
#MISE hide=true

set -euo pipefail
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

if [[ ! -x ./gradlew ]]; then
  print_warn "setup:deps:upgrade:kotlin: no executable ./gradlew, so there is nothing to upgrade."
  exit 0
fi

# Every project's resolvable configurations, not the root's alone.
init_script="$(mktemp "${TMPDIR:-/tmp}/stackgen-resolve-all.XXXXXX")"
trap 'rm -f "${init_script}"' EXIT
printf '%s\n' \
  'allprojects { p ->' \
  '  p.tasks.register("stackgenResolveAll") {' \
  '    notCompatibleWithConfigurationCache("resolves every configuration at execution time")' \
  '    def confs = p.configurations' \
  '    doLast { confs.matching { it.canBeResolved }.each { it.resolve() } }' \
  '  }' \
  '}' >"${init_script}"

# A version moves by editing gradle/libs.versions.toml; this re-locks what the catalog now asks for.
./gradlew --init-script "${init_script}" stackgenResolveAll --write-locks
