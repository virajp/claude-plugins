#!/usr/bin/env bash

#MISE description="Report dependencies that have moved on"
#MISE hide=true

set -euo pipefail
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

if [[ ! -x ./gradlew ]]; then
  print_warn "setup:deps:outdated:kotlin: no executable ./gradlew, so there is nothing to report."
  exit 0
fi

# The task comes from the ben-manes plugin com.github.ben-manes.versions, applied in the root build.gradle.kts.
# One run: only Gradle's task-not-found error is a skip; any other failure is the build's, and fails.
log="$(mktemp "${TMPDIR:-/tmp}/stackgen-outdated.XXXXXX")"
trap 'rm -f "${log}"' EXIT
if ./gradlew dependencyUpdates 2>&1 | tee "${log}"; then
  exit 0
fi
if grep -Eq "Task '(:)?dependencyUpdates' not found" "${log}"; then
  print_warn "setup:deps:outdated:kotlin: no dependencyUpdates task, so there is nothing to report."
  print_yellow "Apply the ben-manes plugin com.github.ben-manes.versions in the root build.gradle.kts, then re-run."
  exit 0
fi
print_error "setup:deps:outdated:kotlin: ./gradlew dependencyUpdates failed; its output is above."
exit 1
