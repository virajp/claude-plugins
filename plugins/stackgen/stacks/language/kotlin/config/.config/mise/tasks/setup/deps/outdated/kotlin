#!/usr/bin/env bash

#MISE description="Report dependencies that have moved on"
#MISE hide=true

set -euo pipefail
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

if [[ ! -x ./gradlew ]]; then
  print_warn "setup:deps:outdated:kotlin: no executable ./gradlew, so there is nothing to report."
  exit 0
fi

# The task comes from the ben-manes plugin com.github.ben-manes.versions, applied in the root build.gradle.kts.
if ! ./gradlew -q help --task dependencyUpdates >/dev/null 2>&1; then
  print_warn "setup:deps:outdated:kotlin: no dependencyUpdates task (or the build does not configure), so there is nothing to report."
  print_yellow "Apply the ben-manes plugin com.github.ben-manes.versions in the root build.gradle.kts, then re-run."
  exit 0
fi

./gradlew dependencyUpdates
