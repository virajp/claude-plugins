#!/usr/bin/env bash

#MISE description="Scope this repo to its secrets project"
#MISE hide=true

set -euo pipefail
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

print_header "Setting up the secrets manager ..."

project="${DOPPLER_PROJECT:-}"
config="${DOPPLER_CONFIG:-}"

for key in DOPPLER_PROJECT DOPPLER_CONFIG; do
  if [ -z "${!key:-}" ]; then
    print_error "${key} is unset or empty in the environment mise exports."
    print_yellow "Run /stackgen:tool-config mise set env ${key}=<value> for doppler, then re-run."
    exit 1
  fi
done

# Both checks below skip, never fail: setup:all must run without a seat.
if ! command -v doppler >/dev/null 2>&1; then
  print_warn "doppler is not installed — skipping. Run: mise install"
  exit 0
fi

doppler --version

# `doppler me` is the cheapest authenticated call whose output is not a secret.
if ! doppler me >/dev/null 2>&1; then
  print_warn "doppler is not logged in — skipping. Run: doppler login && mise run setup:secrets"
  exit 0
fi

echo "Project: ${project}   Config: ${config}"

# --no-read-env: scope from these flags; --scope: record it for the repo root.
doppler setup --no-interactive --no-read-env \
  --project "$project" \
  --config "$config" \
  --scope "${MISE_PROJECT_ROOT}"

print_success "Secrets manager scoped to ${project}/${config}"
