#!/usr/bin/env bash

#MISE description="Security scan the repo"
#MISE dir="{{ config_root }}"

#USAGE flag "--debug" help="emit debug logs"
#USAGE flag "--staged" help="scan only what is staged, and skip the dependency scan"
#USAGE arg "[files]" var=#true help="accepted for the gate's sake; both scanners read the tree"

set -euo pipefail
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# Two scans, and both read the repo as a DIRECTORY rather than as a resolved
# dependency tree — which is what makes them a default the way `code:format` is
# one, and not a slot the way `code:lint` is. Neither needs a package manager,
# a language runtime or a lockfile to say something true.
#
#   secrets       every file in the tree, against the built-in rule set
#   vulnerable    every manifest and lockfile the scanner recognises
#
# The package manager's own advisory check is `setup:deps:audit`, a different
# task on purpose: that one reports during setup, this one fails before a
# commit. A gate component that pins different scanners overwrites this file.
#
# **This is also the repo's secret-scanning HOOK, which is what `--staged` is
# for.** The pre-commit gate calls `code:sec --staged` rather than a scanner
# binary, so the scanner and its config are configured once, here. In that mode
# the scan is the staged diff and nothing else, and the dependency scan is
# skipped outright: a vulnerable transitive dependency is not news a commit can
# act on, and paying for the whole scan on every commit is how a gate gets
# turned off.

SECRETS_CONFIG="${MISE_PROJECT_ROOT}/.config/gitleaks.toml"
VULN_CONFIG="${MISE_PROJECT_ROOT}/.config/grype.yaml"

if [ "${usage_staged:-false}" = "true" ]; then
  if command -v gitleaks >/dev/null 2>&1; then
    print_wait "Scanning the staged changes for secrets ... "
    if [ -f "${SECRETS_CONFIG}" ]; then
      gitleaks git --staged --config "${SECRETS_CONFIG}" --redact=50
    else
      gitleaks git --staged --redact=50
    fi
    print_ok
  else
    print_warn "gitleaks is not on PATH — skipping the staged secret scan."
  fi
  exit 0
fi

if command -v gitleaks >/dev/null 2>&1; then
  print_wait "Scanning for committed secrets ... "
  # The scanner takes a directory, so a file list narrows it only as far as a
  # shared parent — with one given, the whole tree is scanned rather than
  # guessing at that parent. The narrowed scan is `--staged`.
  #
  # `dir` mode does not honour `.gitignore`, so a gitignored `.env` — a file
  # that exists to hold secrets OUTSIDE the tree — fails every full scan on a
  # value that was never going to be committed. It is skipped here through a
  # throwaway overlay that extends the repo's config, and NOT in that config:
  # an allowlist there is mode-wide, and would also make the `--staged` gate
  # above wave through a `.env` someone did stage.
  OVERLAY=$(mktemp "${TMPDIR:-/tmp}/gitleaks-overlay.XXXXXX")
  trap 'rm -f "${OVERLAY}"' EXIT
  {
    echo '[extend]'
    if [ -f "${SECRETS_CONFIG}" ]; then
      echo "path = \"${SECRETS_CONFIG}\""
    else
      echo 'useDefault = true'
    fi
    cat <<'EOF'

[allowlist]
paths = ['(^|/)\.env$', '(^|/)\.env\..*']
EOF
  } >"${OVERLAY}"
  gitleaks dir . --config "${OVERLAY}" --redact=50
  print_ok
else
  print_warn "gitleaks is not on PATH — skipping the secret scan."
fi

if command -v grype >/dev/null 2>&1; then
  print_wait "Scanning dependencies for known vulnerabilities ... "
  grype_status=0
  if [ -f "${VULN_CONFIG}" ]; then
    grype "dir:${MISE_PROJECT_ROOT}" --config "${VULN_CONFIG}" --fail-on medium || grype_status=$?
  else
    grype "dir:${MISE_PROJECT_ROOT}" --fail-on medium || grype_status=$?
  fi
  if [ "$grype_status" -ne 0 ]; then
    print_error "ERROR"
    if [ -f "${VULN_CONFIG}" ]; then
      print_warn "To accept a finding, add its vulnerability id under ignore: in .config/grype.yaml with a one-line reason — see the grype conventions."
    else
      print_warn "No .config/grype.yaml to accept a finding in — materialize the grype component first, then add the id under ignore: with a one-line reason."
    fi
    exit "$grype_status"
  fi
  print_ok
else
  print_warn "grype is not on PATH — skipping the vulnerability scan."
fi
