{
  // Removing `main` makes this a different stack — `workers-static-assets`.
  // Credentials never live here — wrangler reads them from the environment.
  "$schema": "node_modules/wrangler/config-schema.json",

  // MARKED POSITION — the Worker's name. Filled when this stack is pinned.
  // Lowercase letters, digits and dashes, derived from the project; the
  // shipped value is invalid on purpose, so an unfilled slot fails at deploy.
  "name": "PLACEHOLDER",

  // MARKED POSITION — the script's entry. Ships Astro's adapter entry; any
  // other framework fills it from its own adapter's documentation.
  "main": "@astrojs/cloudflare/entrypoints/server",

  "compatibility_date": "2026-09-06",

  // Add a flag only when the adapter's documentation asks for it.
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./dist",

    "binding": "ASSETS",
    // No `not_found_handling` on purpose: unmatched paths fall to the script.

    // `run_worker_first` stays unset: on, every asset request bills a script.
  },
  // MARKED POSITION — the custom domain, filled when this stack is pinned.
  // Uncomment and set the hostname; a repo with no custom domain deletes it.
  //
  //   "routes": [
  //     {
  //       "pattern": "www.example.com",
  //       "custom_domain": true,
  //     },
  //   ],
}
