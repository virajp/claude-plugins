{
  // A WORKER WITH A SCRIPT in front of its own static assets. `main` names an
  // entry, the platform serves the uploaded file set for every request that
  // matches one, and everything else falls through to the script. One
  // `wrangler deploy` uploads both halves. Removing `main` here turns this
  // into a different stack — see the `workers-static-assets` pack.
  //
  // CREDENTIALS NEVER LIVE IN THIS FILE. Wrangler reads CLOUDFLARE_API_TOKEN
  // and CLOUDFLARE_ACCOUNT_ID from the environment; the secrets provider
  // supplies them from GLB_CLOUDFLARE_API_TOKEN and GLB_CLOUDFLARE_ACCOUNT_ID.
  //
  // This file sits at the REPO ROOT because wrangler discovers its config by
  // walking up from the working directory and cannot be told to look under
  // .config/ without a --config flag on every invocation.

  // Editor completion and validation. The path is relative to THIS file, so a
  // repo that installs wrangler inside a sub-project points at that project's
  // node_modules instead.
  "$schema": "node_modules/wrangler/config-schema.json",

  // ---------------------------------------------------------------------
  // MARKED POSITION — the Worker's name. Filled when this stack is pinned.
  //
  // Cloudflare names are account-unique and lowercase: letters, digits and
  // dashes only. Derive it from the project, not from the domain, so a repo
  // that moves domains keeps its Worker:
  //
  //   "name": "acme-marketing-site",
  //
  // The value shipped below is deliberately invalid — uppercase names are
  // rejected — so an unfilled slot fails at the first deploy rather than
  // publishing a Worker nobody meant to create.
  // ---------------------------------------------------------------------
  "name": "PLACEHOLDER",

  // ---------------------------------------------------------------------
  // MARKED POSITION — the script's entry, and the one field that makes this
  // stack what it is. Unlike the two positions above it ships a REAL value,
  // because the project bundle that pairs here names the adapter that
  // defines it.
  //
  // The value below is Astro's: `@astrojs/cloudflare` v13 — the release
  // Astro 6 requires — moved `main` from a built file path
  // ("dist/_worker.js/index.js") to a unified entrypoint that serves local
  // development and production alike.
  //
  // A DIFFERENT FRAMEWORK'S ADAPTER NAMES A DIFFERENT ENTRY, and some emit a
  // built file rather than a package export. Fill this from the adapter's own
  // documentation when the project is not an Astro one; nothing here can
  // guess it.
  // ---------------------------------------------------------------------
  "main": "@astrojs/cloudflare/entrypoints/server",

  // The runtime behaviour this deployment was written against. It is a date,
  // not a version: pinning it is what stops a future runtime change from
  // altering how an already-shipped deployment behaves. Move it deliberately
  // and read the changelog for the span you skipped.
  "compatibility_date": "2026-09-06",

  // The Node surface the framework adapter needs. The platform's runtime is
  // not Node; this flag is what provides the built-ins an adapter and its
  // dependencies expect. A dependency reaching for something the flag does
  // not cover fails at the edge, not at build time.
  //
  // Some adapters ask for more — Astro's own deployment guide also lists
  // "global_fetch_strictly_public", which makes a fetch() to the site's own
  // hostname leave the Worker and come back through the edge. Add a flag
  // when the adapter's documentation asks for it, and not speculatively:
  // each one changes runtime behaviour.
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    // The build output directory, relative to this file. `./dist` is what the
    // framework packs that pair with this bundle emit at a repo root; a repo
    // whose site is a sub-project points at that project's output
    // ("./site/dist") instead.
    "directory": "./dist",

    // How the SCRIPT reaches its own files: `env.ASSETS.fetch(request)`,
    // in-process rather than over the network. The adapter uses it to serve
    // prerendered pages and hashed assets from inside the rendered response
    // path, which is why a script deployment names a binding and an
    // assets-only one does not.
    "binding": "ASSETS",
    // NOTE THE ABSENCE OF `not_found_handling`, and that it is deliberate.
    //
    // With `main` present, a request that matches no asset FALLS THROUGH TO
    // THE SCRIPT. What an unknown path gets is therefore the framework's
    // routing and its own 404 page — a decision in code, where it can read
    // the request, rather than a platform mode with two answers.
    //
    // Setting it here would put a second, silent answer in front of the
    // script for exactly the paths the script exists to handle.

    // `run_worker_first` is deliberately UNSET, which means assets are
    // matched first. Turning it on invokes the script ahead of every asset
    // match — including every hashed CSS and JS file — which is a billed
    // invocation in front of files that needed none. Turn it on only where
    // the script must see requests the assets would otherwise have answered,
    // such as an auth check over the whole site. See the `workers-ssr` skill.
  },
  // ---------------------------------------------------------------------
  // MARKED POSITION — the custom domain, filled when this stack is pinned.
  //
  // Uncomment and set the pattern to the hostname this site answers on. The
  // zone must already be on the same Cloudflare account, and `custom_domain`
  // is what makes wrangler create and manage the DNS record for it:
  //
  //   "routes": [
  //     {
  //       "pattern": "www.example.com",
  //       "custom_domain": true,
  //     },
  //   ],
  //
  // A repo with no custom domain DELETES this block rather than filling it.
  // The Worker is then reachable at <name>.<account-subdomain>.workers.dev,
  // which is a complete and legitimate deployment — a preview surface, an
  // internal tool, anything not yet worth a hostname.
  // ---------------------------------------------------------------------
}
