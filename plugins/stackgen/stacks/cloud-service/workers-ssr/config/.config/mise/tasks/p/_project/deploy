#!/usr/bin/env bash

#MISE description="Deploy this project's Worker script and its static assets to Cloudflare"
#MISE dir="{{ config_root }}"

#USAGE flag "--dry-run" help="validate the config and the upload without publishing"

# `_project` is a MARKED POSITION — renamed to the project's id on landing.

set -euo pipefail
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# The id is the directory name, so the rename is the only edit a pin makes.
project_id="$(basename "$(dirname "${BASH_SOURCE[0]}")")"

# Not in helpers — `setup/mise` defines its own copy; keep the two in step.
have_task() { mise tasks 2>/dev/null | awk 'NR>1 {print $1}' | grep -qx "$1"; }

print_header "Deploying ${project_id} to Cloudflare Workers with a script ..."

# 1. Credentials, before anything runs. `--dry-run` needs none.
if [[ "${usage_dry_run:-false}" != "true" ]]; then
  missing=""
  [[ -n "${CLOUDFLARE_API_TOKEN:-}" ]] || missing="CLOUDFLARE_API_TOKEN"
  [[ -n "${CLOUDFLARE_ACCOUNT_ID:-}" ]] || missing="${missing:+${missing} }CLOUDFLARE_ACCOUNT_ID"
  if [[ -n "${missing}" ]]; then
    print_error "Missing Cloudflare credentials: ${missing}"
    print_warn "wrangler reads CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID from the"
    print_warn "environment. This repo's secrets provider supplies them from"
    print_warn "GLB_CLOUDFLARE_API_TOKEN and GLB_CLOUDFLARE_ACCOUNT_ID — run through"
    print_warn "\`mise run setup:secrets\` first, or export them for a one-off deploy."
    print_warn "\`wrangler login\` is the interactive alternative and is a laptop-only"
    print_warn "convenience: CI has no browser and must use the token."
    exit 1
  fi
fi

# 2. The build is the framework's, not this task's.
if have_task "p:${project_id}:build"; then
  print_subheader "Building ${project_id} ..."
  mise run "p:${project_id}:build"
else
  print_subheader "Skipping the build ..."
  print_warn "No p:${project_id}:build task — assuming the asset directory in"
  print_warn "wrangler.jsonc is already built."
fi

# 3. Deploy, through the lockfile's wrangler — the pack pins none.
if [[ -f "pnpm-lock.yaml" ]]; then
  wrangler=(pnpm exec wrangler)
else
  wrangler=(npx wrangler)
fi

deploy_args=(deploy)
if [[ "${usage_dry_run:-false}" == "true" ]]; then
  deploy_args+=(--dry-run)
  print_subheader "Validating the deploy (--dry-run) ..."
else
  print_subheader "Uploading the script and its assets, and publishing ..."
fi

"${wrangler[@]}" "${deploy_args[@]}"
