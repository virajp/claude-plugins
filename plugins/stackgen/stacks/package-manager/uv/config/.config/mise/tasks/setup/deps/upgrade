#!/usr/bin/env bash

#MISE description="Move the lockfile forward, then re-install"
#MISE hide=true

set -euo pipefail
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# The sync is not optional: `uv lock --upgrade` leaves the virtualenv untouched.

print_subheader "Resolving the latest versions ..."
uv lock --upgrade

print_subheader "Re-installing from the lockfile ..."
uv sync --all-extras
