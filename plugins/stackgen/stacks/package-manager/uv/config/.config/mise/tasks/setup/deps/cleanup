#!/usr/bin/env bash

#MISE description="Delete the virtualenv and the resolver cache"
#MISE hide=true

set -euo pipefail
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# `uv.lock` stays: moving it forward is `setup:deps:upgrade`'s job.

print_subheader "Removing the virtualenv ..."
rm -rf .venv || true

print_subheader "Pruning the uv cache ..."
uv cache prune || true
