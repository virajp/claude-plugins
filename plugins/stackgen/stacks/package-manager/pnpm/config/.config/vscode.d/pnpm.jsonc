// Editor fragment: `/vwf:init` merges it into the editor settings; a key after its block wins.
{
  "settings": {
    "files.exclude": {
      "**/.turbo/": true,
      "pnpm-lock.yaml": true,
    },
    "files.watcherExclude": {
      "**/.turbo/": true,
    },
    "search.exclude": {
      "**/.turbo/": true,
    },
  },

  "nesting": {
    "package.json": [
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      ".npmrc",
      "vitest.config.ts",
      "turbo.json",
      "build.ts",
      "esbuild.mjs",
      "waitOn.json",
      "waitOnExternal.json",
      "apphosting.yaml",
      "apphosting.*.yaml",
      ".prettierrc.yaml",
      ".markdownlint.yaml",
      "doppler.yaml",
    ],
  },
}
