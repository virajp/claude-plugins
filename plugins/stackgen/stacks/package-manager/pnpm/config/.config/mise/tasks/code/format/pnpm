#!/usr/bin/env bash

#MISE description="Check or sort every package.json"
#MISE dir="{{ config_root }}"
#MISE hide=true

#USAGE flag "--debug" help="emit debug logs"
#USAGE flag "--fix" help="apply fixes"
#USAGE arg "[files]" var=#true help="files to format (default: the whole repo)"

set -euo pipefail
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

files=()
eval "files+=(${usage_files:-})"

sort_targets=()
if [ ${#files[@]} -gt 0 ]; then
  for f in "${files[@]}"; do
    case "${f}" in
      package.json | */package.json) sort_targets+=("${f}") ;;
    esac
  done
else
  sort_targets=("**/package.json" --ignore "**/node_modules")
fi

# The sorter's pair is the inverse of dprint's: sorting is its default, `--check` read-only.
sort_args=()
if [[ "${usage_fix:-false}" != "true" ]]; then
  sort_args=(--check)
fi

# By mise path, and skipped where the dev-only pin is not installed.
sort_bin="$(mise which sort-package-json --tool npm:sort-package-json 2>/dev/null || true)"
if [ -n "${sort_bin}" ] && [ ${#sort_targets[@]} -gt 0 ]; then
  print_subheader "Sorting package.json files ..."
  "${sort_bin}" ${sort_args[@]+"${sort_args[@]}"} "${sort_targets[@]}"
fi
