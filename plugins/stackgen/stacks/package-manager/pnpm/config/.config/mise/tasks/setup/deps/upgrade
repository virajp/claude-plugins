#!/usr/bin/env bash

#MISE description="Move the lockfile forward, then re-install"
#MISE hide=true

set -euo pipefail
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# pnpm upgrades itself first: an older resolver writes a lockfile the new one rewrites.

print_subheader "Updating the package manager ..."
pnpm self-update

print_subheader "Resolving the latest versions ..."
pnpm update --recursive --latest
