#!/usr/bin/env bash

#MISE description="Install dependencies from the lockfile"
#MISE hide=true

#USAGE flag "--frozen" help="fail rather than write the lockfile"

set -euo pipefail
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

install_args=(--aggregate-output --child-concurrency 10 --network-concurrency 10 --recursive)
if [[ "${usage_frozen:-false}" == "true" ]]; then
  install_args+=(--frozen-lockfile)
fi

pnpm install "${install_args[@]}"
