#!/usr/bin/env bash

#MISE description="Report known vulnerabilities in the dependency tree"
#MISE hide=true

set -euo pipefail
# helpers ships with stackgen:tool-config, not this pack, so there is no
# path here for -x to follow.
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# Advisory, and deliberately not a gate. `pnpm audit` reads a registry advisory
# feed that moves under the repo without any lockfile change, and a gate that
# can start failing on an unchanged tree is not one a commit can be held to. The
# blocking supply-chain check is `code:sec`, which runs pinned tools.

pnpm audit || true
