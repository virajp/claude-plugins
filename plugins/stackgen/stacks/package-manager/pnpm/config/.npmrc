# An install never runs a dependency's install-time code. A postinstall script
# is arbitrary code from a package you did not audit, executed the moment it is
# resolved; blocking it by default is what makes a compromised release a
# dependency you can still remove rather than a machine you have to rebuild.
ignore-scripts=true

# A dependency that genuinely has to build — a native addon, a downloaded
# binary — is allowed by name in pnpm-workspace.yaml (`allowBuilds`, or
# `onlyBuiltDependencies` before pnpm 10.26), so the exception is a reviewable
# line rather than a blanket switch.

# No funding banner after an install. It is output on every run that nobody
# reads and that buries what the install actually did.
fund=false
