#!/usr/bin/env bash

#MISE description="Resolve the app's dependencies and generate its Xcode project"
#MISE hide=true

#USAGE flag "--frozen" help="fail rather than write the lockfile"

set -euo pipefail
# helpers ships in the toolchain-manager pack, not this one, so there is no
# path here for -x to follow.
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# Fills the `setup:deps:install` slot.
#
# Xcode is not installed by mise, so it can be missing on a machine where every
# other tool resolved; Tuist is mise's, pinned in this pack's conf.d fragment,
# and missing only until `mise install` has run. Checking both first turns a
# bare "command not found" into a message that says what to install. Which
# Xcode is acceptable is not this task's call: `compatibleXcodeVersions` in
# `Tuist.swift` pins it, and `tuist generate` refuses any other.
#
# `tuist install` resolves the external packages the project's `Package.swift`
# declares — SwiftPM underneath — and `tuist generate` then writes the Xcode
# project and workspace from `Project.swift`. They are one task, not two,
# because the generated project links what the install fetched: a project
# generated before the install describes a dependency graph that is not there.
# `--no-open` keeps a task from launching Xcode.
#
# `--force-resolved-versions` is SwiftPM's frozen mode, which `tuist install`
# passes through: it resolves exactly what `Package.resolved` records and fails
# when the manifest needs something else, rather than rewriting the lockfile.
#
# No header: the aggregator `setup:deps:all` already frames each verb with its
# own subheader, so one here would invert the hierarchy.

if ! command -v xcodebuild >/dev/null 2>&1; then
  print_error "setup:deps:install: xcodebuild is not on PATH."
  print_yellow "Install Xcode, select it with xcode-select, then re-run."
  exit 1
fi

if ! command -v tuist >/dev/null 2>&1; then
  print_error "setup:deps:install: tuist is not on PATH."
  print_yellow "Run mise install, which installs the Tuist this repo pins, then re-run."
  exit 1
fi

install_args=()
if [[ "${usage_frozen:-false}" == "true" ]]; then
  install_args+=(--force-resolved-versions)
fi

print_subheader "Resolving packages ..."
tuist install ${install_args[@]+"${install_args[@]}"}

print_subheader "Generating the Xcode project ..."
tuist generate --no-open
