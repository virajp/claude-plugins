#!/usr/bin/env bash

#MISE description="Report dependencies that have moved on"
#MISE hide=true

set -euo pipefail
# helpers ships in the toolchain-manager pack, not this one, so there is no
# path here for -x to follow.
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# A Tuist app declares its external packages in `Tuist/Package.swift` — or in a
# `Package.swift` at the root, the older spelling Tuist still reads — so that
# directory is the package SwiftPM is pointed at. `--dry-run` lists what
# `swift package update` would move, within the ranges the manifest declares,
# without touching `Package.resolved`. A dependency whose next release falls
# outside its declared range is not listed — widening a range is a manifest
# edit, and the review surface for it is that diff.
#
# With neither manifest the app has no external packages, and there is nothing
# that could be outdated.

if [ -f Tuist/Package.swift ]; then
  package_path="Tuist"
elif [ -f Package.swift ]; then
  package_path="."
else
  print_yellow "setup:deps:outdated: no Tuist/Package.swift or Package.swift, so no external packages to check."
  exit 0
fi

swift package --package-path "${package_path}" update --dry-run
