#!/usr/bin/env bash

#MISE description="Compare the app's views against their recorded golden images"
#MISE dir="{{ config_root }}"

#USAGE flag "--record" help="re-record every golden, then compare against the new ones"
#USAGE flag "--target <target>" default="SnapshotTests" help="the snapshot test target to run"
#USAGE flag "--scheme <scheme>" help="the scheme whose test action holds the target (default: the project's name)"
#USAGE flag "--platform <platform>" help="the destination platform for one run (default: SIMULATOR_PLATFORM)"
#USAGE flag "--device <device>" help="the simulator to render on, by name, for one run (default: SIMULATOR_DEVICE)"
#USAGE flag "--os <os>" help="the simulator OS version to render on, for one run (default: SIMULATOR_OS)"

set -euo pipefail
# helpers ships in the toolchain-manager pack, not this one, so there is no
# path here for -x to follow.
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/xcode"

# The goldens are swift-snapshot-testing image snapshots, kept in a test target
# of their own — `SnapshotTests` unless `--target` names another — so they run
# apart from the unit tests and nothing else is judged by pixels. The target
# runs through `xcodebuild test` on the committed project, limited to it by
# `-only-testing`, in the scheme named after the project unless `--scheme`
# names another. Build products and package checkouts stay under `.build/`,
# and `-onlyUsePackageVersionsFromResolvedFile` keeps a test run from moving
# `Package.resolved` — that is `setup:deps:upgrade`'s job.
#
# A golden is pixels from one simulator: another device or OS version renders
# differently, and every comparison against it fails. So the repo pins the
# simulator once, in its mise `[env]` — SIMULATOR_PLATFORM (`iOS Simulator`,
# say), SIMULATOR_DEVICE and SIMULATOR_OS — and this task builds the
# `-destination` from them, so recording, comparing, the `ux-gate` skill and CI
# render on the same one. `--platform`, `--device` and `--os` override the pin
# for one run, and `--platform` comes with `--device` and `--os`, never
# alone: a platform on the pin's device and OS names a simulator that does not
# exist. A run with no pin is refused rather than left to whichever simulator
# xcodebuild would pick. A Mac-only app pins `macOS`, the one platform with no
# simulator, which needs neither a device nor an OS. The goldens are the
# pinned platform's; running another platform against them compares renders
# with goldens recorded elsewhere.
#
# The record mode reaches the test process through xcodebuild, which strips the
# `TEST_RUNNER_` prefix from any variable carrying it and hands the rest to the
# tests. A comparison runs with recording off (`never`), so a view with no
# golden fails rather than quietly recording one — the library's own default
# would record it and pass the next run. A failed comparison leaves its
# evidence in three places: the reference is the committed file under the
# test's `__Snapshots__` directory, the new render lands under
# `.build/snapshot-artifacts/` — emptied first, so what is there is this
# run's — and the diff is an attachment in the result bundle, written to
# `.build/golden.xcresult`, a fixed path, so it can be found.
#
# `-collect-test-diagnostics never`: on a failure xcodebuild otherwise gathers
# a sysdiagnose-sized bundle from the simulator, minutes per run, and every
# recording run fails by design.
#
# `--record` writes every golden afresh (`all`) and then compares. The library
# fails every assertion it records — so a recording is never mistaken for a
# pass — which makes the recording run's exit status meaningless; the
# comparison after it is the verdict, and it proves the new goldens reproduce.
# Recording is refused on any destination but the pin: the goldens are the
# pinned simulator's, and an override run would overwrite them with renders
# from elsewhere, then "prove" those.

require_xcode "test:golden"
project=$(find_xcodeproj "test:golden")
scheme="${usage_scheme:-$(basename "${project}" .xcodeproj)}"

if [ -n "${usage_platform:-}" ] && [ "${usage_platform}" != "macOS" ] &&
  { [ -z "${usage_device:-}" ] || [ -z "${usage_os:-}" ]; }; then
  print_error "test:golden: --platform ${usage_platform} needs --device and --os too."
  print_yellow "The pin's device and OS belong to its own platform; name the simulator to use on ${usage_platform} with --device and --os, then re-run."
  exit 1
fi

platform="${usage_platform:-${SIMULATOR_PLATFORM:-}}"
device="${usage_device:-${SIMULATOR_DEVICE:-}}"
os="${usage_os:-${SIMULATOR_OS:-}}"

if [ -z "${platform}" ]; then
  print_error "test:golden: no simulator is pinned — SIMULATOR_PLATFORM is unset."
  print_yellow "Set SIMULATOR_PLATFORM, SIMULATOR_DEVICE and SIMULATOR_OS in the repo's mise [env] (or pass --platform, --device and --os), then re-run."
  exit 1
fi
if [ "${platform}" == "macOS" ]; then
  destination="platform=macOS"
elif [ -z "${device}" ] || [ -z "${os}" ]; then
  print_error "test:golden: the ${platform} pin is incomplete — SIMULATOR_DEVICE and SIMULATOR_OS are both required."
  print_yellow "Set them in the repo's mise [env] (or pass --device and --os); xcrun simctl list devices available lists the choices."
  exit 1
else
  destination="platform=${platform},name=${device},OS=${os}"
fi

if [[ "${usage_record:-false}" == "true" ]] &&
  { [ "${platform}" != "${SIMULATOR_PLATFORM:-}" ] ||
    { [ "${platform}" != "macOS" ] &&
      { [ "${device}" != "${SIMULATOR_DEVICE:-}" ] || [ "${os}" != "${SIMULATOR_OS:-}" ]; }; }; }; then
  print_error "test:golden: --record records on the pinned simulator only, and ${destination} is not it."
  print_yellow "Drop --platform, --device and --os to record, or move the pin in the repo's mise [env] first."
  exit 1
fi

artifacts="${PWD}/.build/snapshot-artifacts"
result_bundle=".build/golden.xcresult"

run_goldens() {
  rm -rf "${result_bundle}"
  TEST_RUNNER_SNAPSHOT_TESTING_RECORD="$1" \
    TEST_RUNNER_SNAPSHOT_ARTIFACTS="${artifacts}" \
    xcodebuild test \
    -project "${project}" \
    -scheme "${scheme}" \
    -destination "${destination}" \
    -only-testing:"${usage_target:-SnapshotTests}" \
    -derivedDataPath .build/DerivedData \
    -clonedSourcePackagesDirPath .build/SourcePackages \
    -onlyUsePackageVersionsFromResolvedFile \
    -resultBundlePath "${result_bundle}" \
    -collect-test-diagnostics never
}

print_subheader "Destination: ${destination}"

if [[ "${usage_record:-false}" == "true" ]]; then
  print_header "Recording goldens ..."
  run_goldens all || true
fi

print_header "Comparing goldens ..."
rm -rf "${artifacts}"
mkdir -p "${artifacts}"
run_goldens never
