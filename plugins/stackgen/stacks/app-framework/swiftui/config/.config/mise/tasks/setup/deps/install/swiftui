#!/usr/bin/env bash

#MISE description="Resolve the app's package dependencies"
#MISE hide=true

#USAGE flag "--frozen" help="fail rather than write the lockfile"

set -euo pipefail
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/xcode"

require_xcode "setup:deps:install:swiftui"
project=$(find_xcodeproj "setup:deps:install:swiftui")

resolve_args=()
if [[ "${usage_frozen:-false}" == "true" ]]; then
  resolve_args+=(-onlyUsePackageVersionsFromResolvedFile)
fi

print_subheader "Resolving packages ..."
xcodebuild -resolvePackageDependencies \
  -project "${project}" \
  -clonedSourcePackagesDirPath .build/SourcePackages \
  ${resolve_args[@]+"${resolve_args[@]}"}
