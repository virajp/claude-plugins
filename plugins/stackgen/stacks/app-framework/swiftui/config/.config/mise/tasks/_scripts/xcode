#!/usr/bin/env bash

#MISE description="The Xcode check and the project lookup the SwiftUI tasks share"
#MISE hide=true

# Sourced after `helpers`; each function takes the calling task's name first.

# `command -v xcodebuild` is no test: every Mac carries a /usr/bin/xcodebuild stub.
require_xcode() {
  local task="$1" version_output selected
  if ! version_output=$(xcodebuild -version 2>/dev/null); then
    print_error "${task}: no Xcode is selected — xcodebuild -version failed."
    print_yellow "Install Xcode, then select it: sudo xcode-select -s /Applications/Xcode.app"
    exit 1
  fi
  selected=$(printf '%s\n' "${version_output}" | awk 'NR==1{print $2}')
  if [ -z "${XCODE_VERSION:-}" ]; then
    print_error "${task}: no Xcode is pinned — XCODE_VERSION is unset or empty."
    print_yellow "Run /vwf:setup to pin it — Xcode ${selected} is selected — then re-run."
    exit 1
  fi
  if [ "${selected}" != "${XCODE_VERSION}" ]; then
    print_error "${task}: this repo builds with Xcode ${XCODE_VERSION}, but Xcode ${selected} is selected."
    print_yellow "Select Xcode ${XCODE_VERSION} with xcode-select -s, or point DEVELOPER_DIR at it, then re-run."
    exit 1
  fi
}

# Called as `$(find_xcodeproj <task>)`: stdout is the answer, so messages go to stderr.
find_xcodeproj() {
  local task="$1"
  local projects=()
  shopt -s nullglob
  projects=(*.xcodeproj)
  shopt -u nullglob
  if [ "${#projects[@]}" -eq 0 ]; then
    print_error "${task}: no *.xcodeproj at the repo root."
    print_yellow "Create the app's project in Xcode (File > New > Project > App), save it at the repo root, commit it, then re-run." >&2
    exit 1
  fi
  if [ "${#projects[@]}" -gt 1 ]; then
    print_error "${task}: more than one *.xcodeproj at the repo root: ${projects[*]}."
    print_yellow "The app is one project; move or remove the others, then re-run." >&2
    exit 1
  fi
  printf '%s\n' "${projects[0]}"
}
