#!/usr/bin/env bash

#MISE description="Delete build output, the resolved package checkouts and the generated project's derived files"
#MISE hide=true

set -euo pipefail
# helpers ships in the toolchain-manager pack, not this one, so there is no
# path here for -x to follow.
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# `tuist clean dependencies` removes the package checkouts `tuist install`
# fetched — this project's alone. A bare `tuist clean` would also empty Tuist's
# global caches, which every other Tuist project on the machine shares, so the
# category is named. It runs only when `tuist` is on PATH: `setup:deps:all`
# runs cleanup before install, on a machine that may not have run
# `mise install` yet, and a missing Tuist has nothing of this project's to
# clean that the removals below do not already cover.
#
# `Derived/` is what `tuist generate` writes beside the project — synthesized
# accessors and Info.plists — and `.build/` any SwiftPM build output at the
# root; both are regenerated by the next install. `Package.resolved` is NOT
# deleted: it is the committed lockfile, and the next install resolves against
# it.
#
# No header: whatever called it — `setup:deps:all`, or a person — frames it.

if command -v tuist >/dev/null 2>&1; then
  tuist clean dependencies
fi

rm -rf .build Derived
