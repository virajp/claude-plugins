#!/usr/bin/env bash

#MISE description="Delete build output, the resolved package checkouts and the generated project's derived files"
#MISE hide=true

set -euo pipefail
# helpers ships in the toolchain-manager pack, not this one, so there is no
# path here for -x to follow.
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# Plain removals, no Tuist call: `setup:deps:all` runs cleanup before install,
# on a machine that may not have run `mise install` yet, and deleting the
# directories is all `tuist clean dependencies` would do for this project —
# while a bare `tuist clean` would also empty Tuist's global caches, which
# every other Tuist project on the machine shares.
#
# `Tuist/.build/` is where `tuist install` checks the packages out; `Derived/`
# is what `tuist generate` writes beside the project — synthesized accessors
# and Info.plists — and the repo holds one project, so there is one, at the
# root; `.build/` is any SwiftPM build output at the root. All three are
# regenerated by the next install. `Package.resolved` is NOT deleted: it is the
# committed lockfile, and the next install resolves against it.
#
# No header: whatever called it — `setup:deps:all`, or a person — frames it.

rm -rf .build Tuist/.build Derived
