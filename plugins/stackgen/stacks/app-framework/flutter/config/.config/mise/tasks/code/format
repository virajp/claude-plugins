#!/usr/bin/env bash

#MISE description="Check or format the repo's files"
#MISE dir="{{ config_root }}"

#USAGE flag "--debug" help="emit debug logs"
#USAGE flag "--fix" help="apply fixes"
#USAGE arg "[files]" var=#true help="files to format (default: the whole repo)"

set -euo pipefail
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# The import sorter is a formatter, not a lint: a gate that rewrites cannot run read-only.

files=()
eval "files+=(${usage_files:-})"

if [[ "${usage_debug:-false}" == "true" ]]; then
  log_level="debug"
else
  log_level="warn"
fi

dart_targets=()
if [ ${#files[@]} -gt 0 ]; then
  for f in "${files[@]}"; do
    case "${f}" in
      lib/*.dart) dart_targets+=("${f}") ;;
    esac
  done
else
  dart_targets=(lib/)
fi

format_args=()
sorter_args=()
if [[ "${usage_fix:-false}" == "true" ]]; then
  action="fmt"
else
  action="check"
  format_args=(--set-exit-if-changed --output none)
  sorter_args=(--exit-if-changed)
fi

print_header "Formatting files ..."

# dprint reads each path as a glob with no literal form: never escape one by hand.
dprint_files=()
for f in ${files[@]+"${files[@]}"}; do
  case "${f}" in
    /* | ./*) dprint_files+=("${f}") ;;
    *) dprint_files+=("./${f}") ;;
  esac
done

print_subheader "Formatting with dprint ..."
dprint "${action}" \
  --config .config/dprint.json \
  --allow-no-files \
  --log-level "${log_level}" \
  -- ${dprint_files[@]+"${dprint_files[@]}"}

# Keep shfmt in any overlay, and its flags in step with the shell gate's.
if command -v shfmt >/dev/null 2>&1; then
  shell_scope=()
  while IFS= read -r shell_file; do
    if [ -n "${shell_file}" ]; then
      shell_scope+=("${shell_file}")
    fi
  done < <(shell_files_in_scope ${files[@]+"${files[@]}"})

  if [ "${#shell_scope[@]}" -gt 0 ]; then
    print_subheader "Formatting shell scripts ..."
    if [ "${action}" = "fmt" ]; then
      shfmt -w -i 2 -ci "${shell_scope[@]}"
    else
      shfmt -d -i 2 -ci "${shell_scope[@]}"
    fi
  fi
fi

if [ ${#dart_targets[@]} -gt 0 ]; then
  print_subheader "Formatting Dart sources ..."
  dart format ${format_args[@]+"${format_args[@]}"} "${dart_targets[@]}"

  print_subheader "Sorting Dart imports ..."
  if [ ${#files[@]} -gt 0 ]; then
    dart run import_sorter:main ${sorter_args[@]+"${sorter_args[@]}"} "${dart_targets[@]}"
  else
    dart run import_sorter:main ${sorter_args[@]+"${sorter_args[@]}"}
  fi
fi
