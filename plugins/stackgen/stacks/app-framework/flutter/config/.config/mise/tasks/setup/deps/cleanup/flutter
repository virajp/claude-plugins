#!/usr/bin/env bash

#MISE description="Delete build output and the resolved package set"
#MISE hide=true

set -euo pipefail
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# `pubspec.lock` IS deleted: a lockfile from a previous SDK can leave the repo unbuildable.

print_subheader "Deleting build output ..."
flutter clean

print_subheader "Deleting the lockfile ..."
find . -type f -name "pubspec.lock" -exec rm -f {} + || true
