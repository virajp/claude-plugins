# ktlint's defaults for this repo. Every ktlint task passes this file with
# --editorconfig; a property an .editorconfig on a source file's path sets wins
# over the value here, so keep layout decisions in this file alone.

[*.{kt,kts}]
ktlint_code_style = ktlint_official
indent_style = space
indent_size = 4
max_line_length = 120
insert_final_newline = true
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
