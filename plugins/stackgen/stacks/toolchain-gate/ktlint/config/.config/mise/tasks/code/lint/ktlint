#!/usr/bin/env bash

#MISE description="Lint the Kotlin sources with ktlint"
#MISE dir="{{ config_root }}"
#MISE hide=true

#USAGE flag "--debug" help="emit debug logs"
#USAGE flag "--fix" help="apply fixes"
#USAGE arg "[files]" var=#true help="files to lint (default: the whole repo)"

set -euo pipefail
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# `--fix` is ignored: rewriting is `code:format:ktlint`'s, which runs first under it.

if ! command -v ktlint >/dev/null 2>&1; then
  print_warn "ktlint is not installed; skipping. Run: mise install"
  exit 0
fi
if [ ! -f .config/ktlint.editorconfig ]; then
  print_warn ".config/ktlint.editorconfig is missing; skipping."
  exit 0
fi

files=()
eval "files+=(${usage_files:-})"

# Keep this exclusion list the same as `code:format:ktlint`'s.
kotlin_targets=()
add_kotlin_target() {
  case "/$1" in
    */build/* | */.gradle/* | */.kotlin/* | */generated/*) ;;
    *.kt | *.kts)
      if [ -f "$1" ]; then
        kotlin_targets+=("$1")
      fi
      ;;
  esac
}

in_git=false
if [ ${#files[@]} -eq 0 ] && command -v git >/dev/null 2>&1; then
  if [ -n "${GIT_DIR:-}" ]; then
    in_git=true
  fi
  dir="${PWD}"
  while [ "${in_git}" = "false" ]; do
    if [ -e "${dir}/.git" ]; then
      in_git=true
    elif [ -z "${dir}" ]; then
      break
    else
      dir="${dir%/*}"
    fi
  done
fi

if [ ${#files[@]} -gt 0 ]; then
  for f in "${files[@]}"; do
    add_kotlin_target "${f}"
  done
elif [ "${in_git}" = "true" ]; then
  # To a file, not a process substitution, so a failed listing stops the task.
  git_list="$(mktemp "${TMPDIR:-/tmp}/code-lint.XXXXXX")"
  trap 'rm -f "${git_list}"' EXIT
  git_status=0
  git -c core.quotePath=off ls-files -z --cached --others --exclude-standard -- '*.kt' '*.kts' \
    >"${git_list}" || git_status=$?
  if [ "${git_status}" -ne 0 ]; then
    print_error "git ls-files failed (exit ${git_status})"
    exit "${git_status}"
  fi
  # Mid-merge git lists a conflicted path once per stage; skip the repeats.
  previous=""
  while IFS= read -r -d '' f; do
    if [ "${f}" != "${previous}" ]; then
      add_kotlin_target "${f}"
    fi
    previous="${f}"
  done <"${git_list}"
else
  while IFS= read -r -d '' f; do
    add_kotlin_target "${f#./}"
  done < <(find . \( -name build -o -name .gradle -o -name .kotlin -o -name generated \) -prune \
    -o \( -name '*.kt' -o -name '*.kts' \) -print0)
fi

ktlint_args=(--relative --editorconfig=.config/ktlint.editorconfig)
if [[ "${usage_debug:-false}" == "true" ]]; then
  ktlint_args+=(--log-level=debug)
fi

if [ ${#kotlin_targets[@]} -gt 0 ]; then
  print_subheader "Linting Kotlin sources with ktlint ..."
  ktlint "${ktlint_args[@]}" "${kotlin_targets[@]}"
fi
