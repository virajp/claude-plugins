// Editor fragment: `/vwf:init` merges it into the editor settings; a key after its block wins.
{
  "extensions": [
    "swiftlang.swift-vscode",
  ],

  "settings": {
    // Not on save: sourcekit-lsp cannot read `.config/swift-format.json`; `code:format` formats.
    "[swift]": {
      "editor.defaultFormatter": "swiftlang.swift-vscode",
      "editor.formatOnSave": false,
    },

    "files.exclude": {
      "**/.build": true,
      "**/.swiftpm": true,
    },
    "files.watcherExclude": {
      "**/.build": true,
      "**/.swiftpm": true,
    },
    "search.exclude": {
      "**/.build": true,
      "**/.swiftpm": true,
    },
  },

  "nesting": {
    "Package.swift": [
      "Package.resolved",
    ],
  },
}
