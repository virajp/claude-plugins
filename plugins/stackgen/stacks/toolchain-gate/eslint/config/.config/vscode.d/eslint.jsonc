// Editor fragment: `/vwf:init` merges it into the editor settings; a key after its block wins.
{
  "extensions": [
    "dbaeumer.vscode-eslint",
  ],

  "settings": {
    // Unset, the editor could lint the legacy way while the gate lints flat.
    "eslint.useFlatConfig": true,
    "eslint.enable": true,

    // dprint owns layout, not ESLint.
    "eslint.format.enable": false,

    "eslint.codeActionsOnSave.mode": "all",
    "eslint.codeActionsOnSave.options": {},
    "eslint.codeActionsOnSave.rules": null,

    "eslint.codeAction.disableRuleComment": {
      "commentStyle": "line",
      "enable": true,
      "location": "separateLine",
    },
    "eslint.codeAction.showDocumentation": {
      "enable": true,
    },

    "eslint.lintTask.enable": true,
    "eslint.lintTask.options": "",
    "eslint.execArgv": [],
    "eslint.debug": false,
  },
}
