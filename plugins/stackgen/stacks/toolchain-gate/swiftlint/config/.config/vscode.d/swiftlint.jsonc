// Editor fragment: `/vwf:init` merges it into the editor settings; a key after its block wins.
{
  "extensions": [
    "vknabel.vscode-swiftlint",
  ],

  "settings": {
    // SwiftLint's own discovery never looks under `.config/`.
    "swiftlint.configSearchPaths": [
      ".config/swiftlint.yml",
    ],
  },
}
