// Editor fragment: `/vwf:init` merges it into the editor settings; a key after its block wins.
{
  "extensions": [
    "dart-code.dart-code",
    "dart-code.flutter",
  ],

  "settings": {
    // Dart is the one language dprint does not format.
    "[dart]": {
      "editor.defaultFormatter": "Dart-Code.dart-code",
    },

    "files.exclude": {
      "**/.dart_tool": true,
    },
    "files.watcherExclude": {
      "**/.dart_tool": true,
    },
    "search.exclude": {
      "**/.dart_tool": true,
    },
  },

  "nesting": {
    "pubspec.yaml": [
      "pubspec.lock",
      "analysis_options.yaml",
    ],
  },
}
