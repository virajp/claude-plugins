#!/usr/bin/env bash

#MISE description="Lint the Python sources with ruff"
#MISE dir="{{ config_root }}"
#MISE hide=true

#USAGE flag "--debug" help="emit debug logs"
#USAGE flag "--fix" help="apply fixes"
#USAGE arg "[files]" var=#true help="files to lint (default: the whole repo)"

set -euo pipefail
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

lint_args=()
if [[ "${usage_debug:-false}" == "true" ]]; then
  lint_args+=(--verbose)
fi
if [[ "${usage_fix:-false}" == "true" ]]; then
  lint_args+=(--fix)
fi

# Whole project even with a file list: ruff's per-file settings resolve from the root.
print_subheader "Linting Python sources ..."
uv run ruff check ${lint_args[@]+"${lint_args[@]}"} .
