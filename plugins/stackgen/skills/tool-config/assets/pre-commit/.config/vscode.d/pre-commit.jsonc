// Editor fragment — the local gate's contribution to the repo's editor
// settings. `/vwf:init` merges every `.config/vscode.d/*.jsonc` into the two
// editor files inside one marked block; a key written by hand after that block
// wins.
//
// Nesting, and the YAML language server. The gate itself contributes no
// setting: an editor that ran the hooks would be a second definition of the
// gate, which is the one thing stackgen:tool-config forbids. The YAML keys
// are here because the hook config is the YAML file every repo on this gate
// carries, and the server's schema-aware completion and hover are what make
// editing it safe.
{
  "settings": {
    "yaml.completion": true,
    // The repo formatter owns YAML; the language server formatting it too
    // would be two formatters disagreeing on save.
    "yaml.format.enable": false,
    "yaml.hover": true,
  },

  // Both files are under `.config/`, and the convention file is only ever read
  // because the hook config wires it. Showing it as a child says so.
  "nesting": {
    "pre-commit-config.yaml": [
      "git-conventional-commits.yaml",
    ],
  },

  // The companion to the `yaml.*` keys above; drop one and the settings it
  // serves go dead.
  "extensions": [
    "redhat.vscode-yaml",
  ],
}
