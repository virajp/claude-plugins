#!/usr/bin/env bash

#MISE description="Lint the repo's shell scripts with shellcheck"
#MISE dir="{{ config_root }}"

#USAGE flag "--debug" help="emit debug logs"
#USAGE flag "--fix" help="apply fixes"
#USAGE arg "[files]" var=#true help="files to lint (default: every tracked shell script)"

set -euo pipefail
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

files=()
eval "files+=(${usage_files:-})"

if ! command -v shellcheck >/dev/null 2>&1; then
  exit 0
fi

shell_scope=()
while IFS= read -r shell_file; do
  if [ -n "${shell_file}" ]; then
    shell_scope+=("${shell_file}")
  fi
done < <(shell_files_in_scope ${files[@]+"${files[@]}"})

# `-x` follows the sourced `_scripts/` libraries.
if [ "${#shell_scope[@]}" -gt 0 ]; then
  shellcheck -x "${shell_scope[@]}"
fi
