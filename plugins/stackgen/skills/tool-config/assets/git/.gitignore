# The repo's ignore set, in banner sections.

# >>> git
# ==== macOS ====
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ==== Editors ====
# .vscode/ is deliberately not here: what a repo puts there is shared.
.idea/
*.swp
*.swo

# ==== AI tooling ====
# One developer's agent state; the shared half of .claude/ stays tracked.
.claude/settings.local.json
.claude/worktrees/
.claude/cache/
.claude/todos.json
.worktrees/
.opencode/

# ==== mise ====
# Bare names match at any depth; the last two are spelled out, their names not starting with `mise`.
mise.local.toml
mise.*.local.toml
.mise.local.toml
**/mise.local.lock
.config/mise/config*.local.toml
.config/mise/conf.d/*.local.toml

# ==== Secrets and env ====
# .env.example is tracked: its negation stays after `.env.*`.
.env
.env.*
!.env.example
# Private keys and identities: the one hit that is always real.
*.pem
*.key
*.p12

# ==== Scratch ====
# Local-only working notes, never reviewed and never shipped.
docs/scratchpad/

# ==== Reports ====
# Gate output is regenerable, and a scanner report quotes what it found.
gitleaks-report.*
grype-report.*
sbom.*
# <<< git
