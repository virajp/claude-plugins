#!/usr/bin/env bash
# Synced from bootstrap: repo/tools/python/tasks/code-lint-uv. Do not edit this file.
# The next sync writes it again, and each change in this file is lost.

#MISE description="Fail when a uv.lock does not agree with its pyproject.toml"
#MISE hide=true

#USAGE flag "--all" help="lint every file of the repository, not only the uncommitted files"
#USAGE flag "--debug" help="accepted for the code:lint contract"
#USAGE flag "--fix" help="accepted for the code:lint contract; run mise run setup:deps:50-python --upgrade to write the lockfile"
#USAGE arg "[files]" var=#true help="the files to lint; only a pyproject.toml or a uv.lock selects its project; the default is the uncommitted files"
#FILES include="pyproject.toml uv.lock"

set -euo pipefail
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# Shipped with the python tool. Without uv, the task does not apply and prints
# nothing.
mise x -- which uv > /dev/null 2>&1 || exit 0
cd "${MISE_PROJECT_ROOT}"

# code:lint passes its flags and files to each code:lint:* task. The list
# comes from gate_files (the #FILES header above). An empty list: nothing
# to do.
args=()
[[ "${usage_all:-false}" == "true" ]] && args+=(--all)
[[ "${usage_debug:-false}" == "true" ]] && args+=(--debug)
[[ "${usage_fix:-false}" == "true" ]] && args+=(--fix)
FILES=()
[[ -n "${usage_files:-}" ]] && eval "FILES=(${usage_files})"
list=$(gate_files "$0" ${args[@]+"${args[@]}"} ${FILES[@]+"${FILES[@]}"}) || exit $?
trap 'rm -f "${list}"' EXIT
[[ -s ${list} ]] || exit 0

# A pyproject.toml or a uv.lock of the list selects its project, when the
# project has both files. No project: nothing to do.
PROJECTS=()
while IFS= read -r file; do
  dir=$(dirname "${file}")
  [[ -f "${dir}/uv.lock" && -f "${dir}/pyproject.toml" ]] || continue
  [[ " ${PROJECTS[*]-} " == *" ${dir} "* ]] || PROJECTS+=("${dir}")
done < "${list}"
((${#PROJECTS[@]})) || exit 0

print_header "Checking the uv lockfiles ..."
for dir in "${PROJECTS[@]}"; do
  print_subheader "Checking ${dir}/uv.lock ..."
  mise x -- uv lock --check --directory "${dir}"
done
