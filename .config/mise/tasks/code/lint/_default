#!/usr/bin/env bash
# Synced from bootstrap: tools/linter/.config/mise/tasks/code/lint/_default.tmpl. Do not edit this file.
# The next sync replaces it, and a manual change is lost.
#MISE description="Lint files"
#MISE dir="{{ config_root }}"

#USAGE flag "--debug" help="emit debug logs"
#USAGE flag "--fix" help="apply fixes"
#USAGE arg "[files]" var=#true help="the files to lint in this repository; the default is the whole tree"

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

cd $MISE_PROJECT_ROOT

print_header "Linting files ..."

[[ "${usage_debug:-false}" == "true" ]] && LOG_LEVEL="--debug" || LOG_LEVEL=""
[[ "${usage_fix:-false}" == "true" ]] && FIX="--fix" || FIX=""
# Unquoted on purpose where it is used: empty adds no argument.
[[ "${usage_debug:-false}" == "true" ]] && DEBUG="--debug" || DEBUG=""

# The pre-commit hook passes the staged files.
FILES=()
[[ -n "${usage_files:-}" ]] && eval "FILES=(${usage_files})"

print_subheader "Running the linter ..."
mise x -- linter \
  ${LOG_LEVEL} \
  ${FIX} \
  ${FILES[@]+"${FILES[@]}"}

# The shell files go to ShellCheck: the given ones, else every tracked one. It
# cannot parse zsh or a template, so they are skipped. Only warnings and errors
# fail; the info and style notes are advice.
SHELL_FILES=()
while IFS= read -r file; do
  [[ "${file}" == *.tmpl ]] && continue
  head -n 1 "${file}" | grep -q zsh && continue
  SHELL_FILES+=("${file}")
done < <(shell_files_in_scope ${FILES[@]+"${FILES[@]}"})
if ((${#SHELL_FILES[@]})); then
  print_subheader "Checking the shell scripts with ShellCheck ..."
  mise x -- shellcheck --severity=warning "${SHELL_FILES[@]}"
fi

# The linters of a language that the linter does not cover: each
# code:lint:<name> task, from a tool or from this repository. Each gets the
# same files, and picks the ones of its language.
for task in $(own_tasks code:lint); do
  mise run "${task}" ${FIX} ${DEBUG} ${FILES[@]+"${FILES[@]}"}
done

print_success "Linting done"
