#!/usr/bin/env bash
# Synced from bootstrap: repo/tools/linter/tasks/code-lint-shellcheck. Do not edit this file.
# The next sync writes it again, and each change in this file is lost.

#MISE description="Check the shell scripts with ShellCheck"
#MISE hide=true

#USAGE flag "--all" help="check every shell script of the repository"
#USAGE flag "--debug" help="emit debug logs"
#USAGE flag "--fix" help="accepted and ignored: ShellCheck has no fixes"
#USAGE arg "[files]" var=#true help="the files to check; the default is the uncommitted files"
#FILES include="*.sh *.bash" shebang="sh bash dash ksh" exclude="*.tmpl"

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# Shipped with the linter tool. Without ShellCheck, the task does not apply
# and prints nothing.
mise x -- which shellcheck > /dev/null 2>&1 || exit 0
cd "${MISE_PROJECT_ROOT}"

# The list of gate_files (the #FILES header above). With no file, the gate
# does not apply and prints nothing.
args=()
[[ "${usage_all:-false}" == "true" ]] && args+=(--all)
[[ "${usage_debug:-false}" == "true" ]] && args+=(--debug)
[[ "${usage_fix:-false}" == "true" ]] && args+=(--fix)
FILES=()
[[ -n "${usage_files:-}" ]] && eval "FILES=(${usage_files})"
list=$(gate_files "$0" ${args[@]+"${args[@]}"} ${FILES[@]+"${FILES[@]}"}) || exit $?
trap 'rm -f "${list}"' EXIT
[[ -s "${list}" ]] || exit 0

# Only warnings and errors fail; the info and style notes are advice.
print_header "Checking the shell scripts with ShellCheck ..."
tr '\n' '\0' < "${list}" | xargs -0 mise x -- shellcheck --severity=warning
