#!/usr/bin/env bash
# Synced from bootstrap: repo/tools/linter/tasks/code-lint-linter. Do not edit this file.
# The next sync writes it again, and each change in this file is lost.

#MISE description="Lint the files with the linter"
#MISE hide=true

#USAGE flag "--all" help="lint every file of the repository"
#USAGE flag "--debug" help="emit debug logs"
#USAGE flag "--fix" help="apply fixes"
#USAGE arg "[files]" var=#true help="the files to lint; the default is the uncommitted files"
#FILES include="*.astro *.css *.html *.json *.jsonc *.md *.toml *.yaml *.yml *.js *.mjs *.cjs *.jsx *.ts *.mts *.cts *.tsx tsconfig.json tsconfig.*.json tsconfig-strict.json **/.vscode/*.json" exclude="**/node_modules/ **/dist/ **/.turbo/ **/.astro/ **/*.d.ts **/AGENTS.md .agents/**/*.md .claude/**/*.md .github/**/*.md **/worktrees/** **/.worktrees/** **/superpowers/** **/coverage/** graphify-out/** **/graphify-out/**"

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# Shipped with the linter tool. Without the linter, the task does not apply
# and prints nothing.
mise x -- which linter > /dev/null 2>&1 || exit 0
cd "${MISE_PROJECT_ROOT}"

# The #FILES header above: the file types of @virajp.dev/linter 2.1.0 (with
# the JSONC file names of its json preset), less the paths that a gate never
# lints. --no-ignore turns off the ignores of the linter config (its built-in
# list and .config/linter.yaml), so gate_files is the only list of the files.
FLAGS=()
[[ "${usage_debug:-false}" == "true" ]] && FLAGS+=(--debug)
[[ "${usage_fix:-false}" == "true" ]] && FLAGS+=(--fix)

# The list of gate_files. With no file, the gate does not apply and prints
# nothing.
args=()
[[ "${usage_all:-false}" == "true" ]] && args+=(--all)
args+=(${FLAGS[@]+"${FLAGS[@]}"})
FILES=()
[[ -n "${usage_files:-}" ]] && eval "FILES=(${usage_files})"
list=$(gate_files "$0" ${args[@]+"${args[@]}"} ${FILES[@]+"${FILES[@]}"}) || exit $?
trap 'rm -f "${list}"' EXIT
[[ -s "${list}" ]] || exit 0

print_header "Linting the files with the linter ..."
tr '\n' '\0' < "${list}" | xargs -0 mise x -- linter --no-ignore ${FLAGS[@]+"${FLAGS[@]}"}
