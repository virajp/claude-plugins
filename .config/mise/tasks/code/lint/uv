#!/usr/bin/env bash
# Synced from bootstrap: tools/python/.config/mise/tasks/code/lint/uv. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

#MISE description="Fail when a uv.lock does not agree with its pyproject.toml"
#MISE hide=true

#USAGE flag "--debug" help="accepted for the code:lint contract"
#USAGE flag "--fix" help="accepted for the code:lint contract; run mise run setup:deps:python --upgrade to write the lockfile"
#USAGE arg "[files]" var=#true help="the files to lint; only a pyproject.toml or a uv.lock selects its project; the default is each project with a uv.lock"

set -euo pipefail
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# Shipped with the python tool. Without uv or without a uv.lock that has a
# pyproject.toml next to it, the task does not apply and prints nothing.
mise x -- which uv > /dev/null 2>&1 || exit 0
cd "${MISE_PROJECT_ROOT}"

# code:lint passes its files to each code:lint:* task. Only a pyproject.toml
# or a uv.lock selects its project. Given files without one: nothing to do.
FILES=()
[[ -n "${usage_files:-}" ]] && eval "FILES=(${usage_files})"
if ! ((${#FILES[@]})); then
  # A failed git stops the task, with the error of git.
  LIST=$(git -c core.quotePath=off ls-files --cached --others --exclude-standard -- 'uv.lock' '*/uv.lock' | sort -u)
  while IFS= read -r file; do
    [[ -n "${file}" ]] && FILES+=("${file}")
  done <<< "${LIST}"
fi
PROJECTS=()
for file in ${FILES[@]+"${FILES[@]}"}; do
  case "${file}" in
    uv.lock | */uv.lock | pyproject.toml | */pyproject.toml) ;;
    *)
      continue
      ;;
  esac
  dir=$(dirname "${file}")
  [[ -f "${dir}/uv.lock" && -f "${dir}/pyproject.toml" ]] || continue
  [[ " ${PROJECTS[*]-} " == *" ${dir} "* ]] || PROJECTS+=("${dir}")
done
((${#PROJECTS[@]})) || exit 0

print_header "Checking the uv lockfiles ..."
for dir in "${PROJECTS[@]}"; do
  print_subheader "Checking ${dir}/uv.lock ..."
  mise x -- uv lock --check --directory "${dir}"
done
