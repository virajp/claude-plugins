#!/usr/bin/env bash
# Synced from bootstrap: repo/tools/mise/tasks/code-format.tmpl. Do not edit this file.
# The next sync writes it again, and each change in this file is lost.
#MISE description="Check or format files"

#USAGE flag "--all" help="format every file of this repository, not only the uncommitted files"
#USAGE flag "--debug" help="emit debug logs"
#USAGE flag "--fix" help="apply fixes"
#USAGE arg "[files]" var=#true help="the files to format; the default is the uncommitted files"

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# Unquoted on purpose where they are used: empty adds no argument.
[[ "${usage_debug:-false}" == "true" ]] && DEBUG="--debug" || DEBUG=""
[[ "${usage_fix:-false}" == "true" ]] && FIX="--fix" || FIX=""

# The pre-commit hook passes the staged files. Without files and without
# --all, each gate examines the uncommitted files of this repository.
FILES=()
[[ -n "${usage_files:-}" ]] && eval "FILES=(${usage_files})"
ALL=""
if [[ "${usage_all:-false}" == "true" ]]; then
  if ((${#FILES[@]})); then
    print_error "Use --all or files, not both."
    exit 2
  fi
  ALL="--all"
fi

# The formatters: each code:format:<name> task, from a tool or from this
# repository, in the order of its number (05-dprint first). Each gets the
# same flags and files, and gets its own list from gate_files of helpers.
# --all goes only to a gate that declares it: an older gate of a repository
# without it gets --fix, --debug and the files.
for task in $(own_tasks code:format); do
  gate_all=""
  if [[ -n "${ALL}" ]] && grep -q '^#USAGE flag "--all"' "${MISE_PROJECT_ROOT}/.config/mise/tasks/${task//://}"; then
    gate_all="${ALL}"
  fi
  mise run "${task}" ${gate_all} ${FIX} ${DEBUG} ${FILES[@]+"${FILES[@]}"}
done
print_success "Formatting done"
