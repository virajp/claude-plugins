#!/usr/bin/env bash

#MISE description="Check or format the repo's files"
#MISE dir="{{ config_root }}"

#USAGE flag "--debug" help="emit debug logs"
#USAGE flag "--fix" help="apply fixes"
#USAGE arg "[files]" var=#true help="files to format (default: the whole repo)"

set -euo pipefail
# helpers ships in the toolchain-manager pack, not this one, so there is no
# path here for -x to follow.
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# Overlays the toolchain manager's `code:format`. dprint keeps owning whitespace
# for every language in the repo — that does not stop mattering once JavaScript
# arrives — and this pack adds the one thing dprint cannot do: `package.json`
# key order, which is a convention rather than a format.
#
# This task is what the `format` pre-commit hook calls, which is why it takes an
# optional file list: the hook passes the staged files, a person passes nothing
# and gets the whole tree.

files=()
eval "files+=(${usage_files:-})"

if [[ "${usage_debug:-false}" == "true" ]]; then
  log_level="debug"
else
  log_level="warn"
fi

# The sorter takes paths, so a file list narrows it to the manifests in scope;
# with no list it takes the whole tree by glob.
sort_targets=()
if [ ${#files[@]} -gt 0 ]; then
  for f in "${files[@]}"; do
    case "${f}" in
      package.json | */package.json) sort_targets+=("${f}") ;;
    esac
  done
else
  sort_targets=("**/package.json" --ignore "**/node_modules")
fi

# The sorter has no `--fix`: sorting is its default and `--check` is the
# read-only mode, the inverse of dprint's pair.
if [[ "${usage_fix:-false}" == "true" ]]; then
  action="fmt"
  sort_args=()
else
  action="check"
  sort_args=(--check)
fi

print_header "Formatting files ..."

print_subheader "Formatting with dprint ..."
dprint "${action}" \
  --config .config/dprint.json \
  --allow-no-files \
  --log-level "${log_level}" \
  ${files[@]+"${files[@]}"}

if [ ${#sort_targets[@]} -gt 0 ]; then
  print_subheader "Sorting package.json files ..."
  pnpm dlx sort-package-json ${sort_args[@]+"${sort_args[@]}"} "${sort_targets[@]}"
fi
