#!/usr/bin/env bash
# Synced from bootstrap: repo/tools/dprint/tasks/code-format-dprint. Do not edit this file.
# The next sync writes it again, and each change in this file is lost.

#MISE description="Check or format the files with dprint"
#MISE hide=true

#USAGE flag "--all" help="format every file of the repository"
#USAGE flag "--debug" help="emit debug logs"
#USAGE flag "--fix" help="apply fixes"
#USAGE arg "[files]" var=#true help="the files to format; the default is the uncommitted files"

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# Shipped with the dprint tool. Without dprint, the task does not apply and
# prints nothing.
mise x -- which dprint > /dev/null 2>&1 || exit 0
cd "${MISE_PROJECT_ROOT}"

[[ "${usage_debug:-false}" == "true" ]] && LOG_LEVEL="debug" || LOG_LEVEL="warn"
[[ "${usage_fix:-false}" == "true" ]] && CMD="fmt" || CMD="check"

# The list of gate_files (no #FILES header: every file of the set). dprint
# picks the files of its plugins. With no file, the gate does not apply and
# prints nothing.
args=()
[[ "${usage_all:-false}" == "true" ]] && args+=(--all)
[[ "${usage_debug:-false}" == "true" ]] && args+=(--debug)
[[ "${usage_fix:-false}" == "true" ]] && args+=(--fix)
FILES=()
[[ -n "${usage_files:-}" ]] && eval "FILES=(${usage_files})"
list=$(gate_files "$0" ${args[@]+"${args[@]}"} ${FILES[@]+"${FILES[@]}"}) || exit $?
trap 'rm -f "${list}"' EXIT
[[ -s "${list}" ]] || exit 0

print_header "Formatting the files with dprint ..."
mise x -- dprint "${CMD}" --allow-no-files --log-level "${LOG_LEVEL}" --stdin-files < "${list}"
