#!/usr/bin/env bash
# Synced from bootstrap: repo/tools/mise/tasks/code-lsp-check. Do not edit this file.
# The next sync writes it again, and each change in this file is lost.

#MISE description="Check that each LSP server of the selected tools resolves in the dev env"

set -euo pipefail
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# BOOTSTRAP_BIN, a local build, replaces the bootstrap of mise. Without an
# engine, the task stops with code 2: mise x answers a missing command with
# code 1, the code of any other failure. Its header comes first, so the status
# lines go under it.
if [[ -n ${BOOTSTRAP_BIN:-} ]]; then
  bin=("${BOOTSTRAP_BIN}")
elif mise x -- which bootstrap > /dev/null 2>&1; then
  bin=(mise x -- bootstrap)
else
  print_header "Checking the LSP servers ..."
  print_error "code:lsp:check needs bootstrap."
  print_warn "- install it: mise use -g github:virajp/bootstrap" >&2
  exit 2
fi
cd "${MISE_PROJECT_ROOT}"

# The servers of the selected tools: only a tool in dev, and a source pin whose
# requires_found is met. The engine prints its message and its fix on stderr.
# Code 2 goes through as 2, any other failure is 1.
rc=0
answer=$("${bin[@]}" lsp --json) || rc=$?
if ((rc)); then
  ((rc == 2)) && exit 2
  exit 1
fi

# data.checks gives the real command and the source of each server; the
# entries of data.servers launch it through mise.
servers=$(mise x -- jq -r '.data.checks // {} | to_entries[] | [.key, .value.command, .value.source] | @tsv' <<< "${answer}") || exit 1

# A repo without a server: the task does not apply and prints nothing.
[[ -n ${servers} ]] || exit 0

print_header "Checking the LSP servers ..."

# Each check resolves a command and starts no server. A pinned server must be a
# binary that mise manages in dev, never any binary on PATH; a host server comes
# from Xcode.
missing=0
while IFS=$'\t' read -r name cmd src; do
  if [[ ${src} == "host" ]]; then
    if path=$(xcrun --find "${cmd}" 2> /dev/null); then
      print_success "${name}: ${path}"
    else
      print_error "${name}: ${cmd} not found - install the Xcode Command Line Tools (xcode-select --install) or Xcode"
      missing=1
    fi
  elif path=$(MISE_ENV=dev mise which "${cmd}" 2> /dev/null); then
    print_success "${name}: ${path}"
  else
    print_error "${name}: ${cmd} not found - run MISE_ENV=dev mise install"
    missing=1
  fi
done <<< "${servers}"

exit "${missing}"
