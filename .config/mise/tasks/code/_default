#!/usr/bin/env zsh
# Synced from bootstrap: repo/tools/mise/tasks/code. Do not edit this file.
# The next sync writes it again, and each change in this file is lost.
#MISE description="Format and lint the uncommitted files (every file with --all), and scan all code"
#MISE dir="."

#USAGE flag "--all" help="format and lint every file of this repository, not only the uncommitted files"
#USAGE flag "--debug" help="emit debug logs"

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# Each subtask accepts --debug and passes it on to its own subtasks, and
# code:format and code:lint accept --all; code:sec scans all code. Unquoted on
# purpose: empty adds no argument.
[[ "${usage_debug:-false}" == "true" ]] && FLAGS="--debug" || FLAGS=""
[[ "${usage_all:-false}" == "true" ]] && ALL="--all" || ALL=""

mise run code:format ${ALL} ${FLAGS}

mise run code:lint ${ALL} ${FLAGS}

mise run code:sec ${FLAGS}
