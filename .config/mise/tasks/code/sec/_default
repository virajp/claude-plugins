#!/usr/bin/env bash
# Synced from bootstrap: tools/_security_base/.config/mise/tasks/code/sec/_default. Do not edit this file.
# The next sync replaces it, and a manual change is lost.
#MISE description="Security check (grype + osv-scanner + gitleaks)"

#USAGE flag "--debug" help="emit debug logs"
#USAGE flag "--staged" help="scan only the staged changes for secrets, and skip grype (for the pre-commit hook)"

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# Unquoted on purpose where they are used: empty adds no argument.
[[ "${usage_staged:-false}" == "true" ]] && STAGED="--staged" || STAGED=""
[[ "${usage_debug:-false}" == "true" ]] && DEBUG="--debug" || DEBUG=""

# The hook scans what is staged: the commit is the content that leaves the
# machine. grype reads the lockfiles of the whole tree, so it belongs to the
# full run and to CI, not to each commit.
if [[ -n "${STAGED}" ]]; then
  print_header "Scanning the staged changes for secrets ..."
else
  print_header "Scanning for security problems ..."
fi

# The scanners of the pack `security` must be there: own_tasks skips a missing
# or non-executable task without a word, and the gate would pass unscanned.
for task in code:sec:gitleaks code:sec:grype code:sec:osv-scanner; do
  if ! has_own_task "${task}"; then
    print_error "The task ${task} is missing or not executable - run mise run init"
    exit 1
  fi
done

# Each code:sec:<scanner> task, from a scanner tool or from this repository.
# With --staged, a scanner that has no staged mode prints nothing.
for task in $(own_tasks code:sec); do
  mise run "${task}" ${STAGED} ${DEBUG}
done

[[ -n "${STAGED}" ]] || print_success "Scanning done"
