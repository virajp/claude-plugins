#!/usr/bin/env bash
# Synced from bootstrap: tools/gitleaks/.config/mise/tasks/code/sec/gitleaks. Do not edit this file.
# The next sync replaces it, and a manual change is lost.
#MISE description="Scan for secrets with gitleaks"

#USAGE flag "--debug" help="emit debug logs"
#USAGE flag "--staged" help="scan only the staged changes (for the pre-commit hook)"

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# The hook scans what is staged: the commit is the content that leaves the
# machine.
if [[ "${usage_staged:-false}" == "true" ]]; then
  [[ "${usage_debug:-false}" == "true" ]] && FLAGS="--verbose" || FLAGS=""
  mise x -- gitleaks git --staged --config "$MISE_PROJECT_ROOT/.config/gitleaks.toml" --redact 50 ${FLAGS}
  exit 0
fi

# gitleaks reads no .gitignore: `gitleaks dir` scans every file, also the
# ignored ones such as graphify-out/ and node_modules/. It takes one path only.
# Thus copy the files that git knows about (tracked, and new files that are
# not ignored) into a temporary folder, and scan that folder once. The report
# paths stay relative to the repository.
print_subheader "Scanning the files for secrets with gitleaks ..."
[[ "${usage_debug:-false}" == "true" ]] && FLAGS="--verbose" || FLAGS=""
SCAN_DIR=$(mktemp -d "${TMPDIR:-/tmp}/code-sec.XXXXXX")
trap 'rm -rf -- "${SCAN_DIR}"' EXIT
(
  cd "${MISE_PROJECT_ROOT}"
  # A tracked file that is deleted in the working tree is not on disk.
  git ls-files -z --cached --others --exclude-standard \
    | while IFS= read -r -d '' file; do
      [[ -f "${file}" && ! -L "${file}" ]] && printf '%s\0' "${file}"
    done \
    | tar --null -T - -cf - \
    | tar -xf - -C "${SCAN_DIR}"
)
# The gitleaks of this repository, found from the repository root.
GITLEAKS=$(cd "${MISE_PROJECT_ROOT}" && mise which gitleaks)
(cd "${SCAN_DIR}" && "${GITLEAKS}" dir . --config "${MISE_PROJECT_ROOT}/.config/gitleaks.toml" --redact 50 ${FLAGS})
