#!/usr/bin/env bash
# Synced from bootstrap: tools/grype/.config/mise/tasks/code/sec/grype. Do not edit this file.
# The next sync replaces it, and a manual change is lost.
#MISE description="Scan the dependencies with grype"

#USAGE flag "--debug" help="emit debug logs"
#USAGE flag "--staged" help="do nothing: grype has no staged mode"

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# grype reads the lockfiles of the whole tree, so it belongs to the full run
# and to CI, not to each commit.
[[ "${usage_staged:-false}" == "true" ]] && exit 0

# A git submodule is a separate repository with its own `code:sec`. Thus grype
# skips each submodule here, nested ones included.
GRYPE_EXCLUDES=()
while IFS= read -r submodule; do
  [[ -n "${submodule}" ]] || continue
  GRYPE_EXCLUDES+=(--exclude "./${submodule}/**")
done < <(git -C "${MISE_PROJECT_ROOT}" submodule --quiet foreach --recursive 'echo $displaypath' 2> /dev/null)

print_subheader "Scanning the dependencies with grype ..."
[[ "${usage_debug:-false}" == "true" ]] && FLAGS="-vv" || FLAGS=""
mise x -- grype . --config .config/grype.yaml --name ${MISE_PROJECT_ROOT} ${GRYPE_EXCLUDES[@]+"${GRYPE_EXCLUDES[@]}"} ${FLAGS}
