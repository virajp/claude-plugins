#!/usr/bin/env bash
# Synced from bootstrap: tools/osv-scanner/.config/mise/tasks/code/sec/osv-scanner. Do not edit this file.
# The next sync replaces it, and a manual change is lost.
#MISE description="Scan the dependencies with osv-scanner"

#USAGE flag "--debug" help="emit debug logs"
#USAGE flag "--staged" help="do nothing: osv-scanner has no staged mode"

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# osv-scanner reads the lockfiles of the whole tree, so it belongs to the full
# run and to CI, not to each commit.
[[ "${usage_staged:-false}" == "true" ]] && exit 0

# A git submodule is a separate repository with its own `code:sec`. Thus
# osv-scanner skips each submodule here, nested ones included.
OSV_EXCLUDES=()
while IFS= read -r submodule; do
  [[ -n "${submodule}" ]] || continue
  # osv-scanner matches the regex against the full path of each directory.
  OSV_EXCLUDES+=(--x-exclude "r:(^|/)$(printf '%s' "${submodule}" | sed 's/[][\\.*^$()+?{}|]/\\&/g')\$")
done < <(git -C "${MISE_PROJECT_ROOT}" submodule --quiet foreach --recursive 'echo $displaypath' 2> /dev/null)

# Without --allow-no-lockfiles, a repo with no lockfile fails with exit 128.
print_subheader "Scanning the dependencies with osv-scanner ..."
[[ "${usage_debug:-false}" == "true" ]] && FLAGS="info" || FLAGS="warn"
mise x -- osv-scanner scan source --recursive --allow-no-lockfiles \
  ${OSV_EXCLUDES[@]+"${OSV_EXCLUDES[@]}"} \
  --config "${MISE_PROJECT_ROOT}/.config/osv-scanner.toml" --verbosity "${FLAGS}" "${MISE_PROJECT_ROOT}"
