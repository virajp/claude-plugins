#!/usr/bin/env bash
# Synced from bootstrap: repo/tools/mise/.config/mise/tasks/code/worktrees. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

#MISE description="List the worktrees and branches of this repo and its declared members: a short table and an HTML page in a terminal, JSON Lines for an agent"
#MISE hide=false
#MISE tools.yq="latest"

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/worktrees-page"

# The glyphs are UTF-8 bytes: most are Nerd Font private-use codepoints, and an
# editor or a copy can lose them without a message. The host, folder, tree,
# branch, up and mixed glyphs have the same codepoints as the claude-status repo.
readonly G_GITHUB=$'\xef\x82\x9b'       # U+F09B
readonly G_GITLAB=$'\xf3\xb0\xae\xa0'   # U+F0BA0
readonly G_REMOTE=$'\xef\x90\x81'       # U+F401
readonly G_GIT=$'\xee\x9c\x82'          # U+E702
readonly G_FOLDER=$'\xef\x81\xbb'       # U+F07B
readonly G_TREE=$'\xf0\x9f\x8c\xb2'     # U+1F332
readonly G_BRANCH=$'\xee\x82\xa0'       # U+E0A0
readonly G_UP=$'\xe2\x86\x91'           # U+2191
readonly G_DOWN=$'\xe2\x86\x93'         # U+2193
readonly G_MIX=$'\xc2\xb1'              # U+00B1
readonly G_OK=$'\xe2\x9c\x93'           # U+2713
readonly G_SYNC=$'\xe2\x89\xa1'         # U+2261
readonly G_DRIFT=$'\xe2\x89\xa0'        # U+2260
readonly G_WARN=$'\xef\x81\xb1'         # U+F071
readonly G_LOCK=$'\xf0\x9f\x94\x92'     # U+1F512
readonly G_DETACHED=$'\xe2\x8c\x80'     # U+2300
readonly G_MERGED=$'\xef\x90\x99'       # U+F419
readonly G_UNMERGED=$'\xe2\x97\x8b'     # U+25CB
readonly G_STASH=$'\xef\x86\x87'        # U+F187
readonly G_OP=$'\xe2\x9f\xb3'           # U+27F3
readonly G_GONE=$'\xf3\xb0\x85\xa4'     # U+F0164
readonly G_LOCAL=$'\xef\x84\x89'        # U+F109
readonly G_NOFOLDER=$'\xf3\xb1\xa7\xb9' # U+F19F9
readonly G_FETCH=$'\xef\x80\x99'        # U+F019
readonly G_PIN=$'\xf0\x9f\x93\x8c'      # U+1F4CC
readonly G_NA=$'\xc2\xb7'               # U+00B7

# One legend for the table and for the page: "<section>|<glyph> <text>|...".
LEGEND=(
  "Row|${G_FOLDER} main worktree|${G_TREE} linked worktree|${G_BRANCH} branch, no worktree|${G_DETACHED} detached"
  "Base, origin|${G_OK} level|${G_UP} ahead|${G_DOWN} behind|${G_GONE} upstream gone|${G_LOCAL} local only|${G_NA} not applicable"
  "Sync|${G_SYNC} has the main HEAD|${G_DRIFT} drifted"
  "State|${G_OK} clean|+ files added|- files deleted|${G_MIX} files mixed|${G_WARN} conflict|${G_OP} rebase or merge stopped"
  "|${G_LOCK} locked|${G_NOFOLDER} folder missing|${G_STASH} stash|${G_PIN} not at pin|${G_MERGED} merged|${G_UNMERGED} not merged"
  "Repo|${G_GITHUB} GitHub|${G_GITLAB} GitLab|${G_REMOTE} other remote|${G_GIT} no origin|${G_FETCH} not on disk"
)

NOW="$(date +%s)"
SEEN=$'\n'

# One index for each row. A row of kind "repo" uses the R_* values and the other
# kinds use the W_* values. Bash 3.2 has no associative arrays, thus the parallel
# lists. REPO holds the label of the repo of each row.
KIND=() REPO=()
R_ROLE=() R_HOST=() R_GLYPH=() R_DEFAULT=() R_FETCHED=() R_PINNED=() R_NOTE=() R_FIX=()
W_BRANCH=() W_DETACHED=() W_COMMIT=() W_AGE=() W_BASE=() W_BA=() W_BB=() W_PA=() W_PB=()
W_ORIGIN=() W_OA=() W_OB=() W_SYNC=() W_CONFLICT=() W_DIRTY=() W_DGLYPH=() W_CODES=()
W_OP=() W_LOCKED=() W_MISSING=() W_STASH=() W_MERGED=() W_NOTPIN=() W_PATH=()
# The items that need attention, in the order of the page.
A_RANK=() A_GLYPH=() A_COLOR=() A_REPO=() A_BRANCH=() A_MSG=() A_CMD=()

# The main checkout of the repo at $1. git names the git folder of a submodule
# as its main worktree, so read the checkout from core.worktree.
main_checkout() {
  local p
  p="$(git -C "$1" worktree list --porcelain | sed -n '1s/^worktree //p')"
  if [[ ! -e "${p}/.git" ]] && [[ -n "$(git -C "${p}" config core.worktree 2> /dev/null)" ]]; then
    p="$(cd "${p}" && cd "$(git config core.worktree)" && pwd -P)"
  fi
  echo "${p}"
}

# The root of the table: the outermost superproject of this repo, or the vwf
# base repo that the membership file of this repo names.
resolve_base() {
  local p super host
  p="$(main_checkout "${MISE_PROJECT_ROOT}")"
  super="$(git -C "${p}" rev-parse --show-superproject-working-tree)"
  while [[ -n "${super}" ]]; do
    p="$(main_checkout "${super}")"
    super="$(git -C "${p}" rev-parse --show-superproject-working-tree)"
  done
  if [[ ! -f "${p}/.config/vwf.yaml" && -f "${p}/.config/vwf-membership.yaml" ]]; then
    host="$(yq '.host // ""' "${p}/.config/vwf-membership.yaml")" || host=''
    if [[ -n "${host}" ]] && git -C "${p}/${host}" rev-parse --git-dir > /dev/null 2>&1; then
      p="$(main_checkout "${p}/${host}")"
    fi
  fi
  echo "${p}"
}

# A path relative to the base repo, "../x" for a repo next to it, else absolute.
display_path() {
  local p="$1"
  if [[ "${p}" == "${BASE}" ]]; then
    echo "."
  elif [[ "${p}" == "${BASE}"/* ]]; then
    echo "${p#"${BASE}"/}"
  elif [[ "${p}" == "${BASE%/*}"/* ]]; then
    echo "../${p#"${BASE%/*}"/}"
  else
    echo "${p}"
  fi
}

# "git " or "git -C <path> ", for the commands of the attention list.
git_in() {
  if [[ "$1" == "." ]]; then echo "git"; else echo "git -C $1"; fi
}

# The age of a unix time, for example "3h".
age_of() {
  local s=$((NOW - $1))
  if ((s < 3600)); then
    echo "$((s / 60))m"
  elif ((s < 86400)); then
    echo "$((s / 3600))h"
  else
    echo "$((s / 86400))d"
  fi
}

# The default branch: origin/HEAD, else develop or main when it exists, else
# the branch of the main worktree.
default_branch() {
  local ref
  ref="$(git -C "$1" symbolic-ref -q refs/remotes/origin/HEAD 2> /dev/null)" || ref=''
  if [[ -n "${ref}" ]]; then
    echo "${ref#refs/remotes/origin/}"
  elif git -C "$1" rev-parse --verify -q refs/heads/develop > /dev/null; then
    echo "develop"
  elif git -C "$1" rev-parse --verify -q refs/heads/main > /dev/null; then
    echo "main"
  else
    git -C "$1" branch --show-current
  fi
}

# The base of a branch: main and develop compare with each other, and any other
# branch with the default branch. Empty when the base is the branch or is missing.
row_base() {
  local base="$2"
  case "$1" in
    main)
      base="develop"
      ;;
    develop)
      base="main"
      ;;
  esac
  if [[ "${base}" != "$1" ]] && git -C "${RP}" rev-parse --verify -q "refs/heads/${base}" > /dev/null; then
    echo "${base}"
  fi
}

# Sets AHEAD and BEHIND of the commit $2 against the ref $1. Both are empty when
# the ref is missing.
counts() {
  local c
  AHEAD='' BEHIND=''
  if [[ -n "$1" ]] && git -C "${RP}" rev-parse --verify -q "$1^{commit}" > /dev/null; then
    c="$(git -C "${RP}" rev-list --left-right --count "$1...$2")"
    AHEAD="${c##*[[:space:]]}"
    BEHIND="${c%%[[:space:]]*}"
  fi
  return 0
}

# Sets ORIGIN (counts, gone or local), OA, OB and TIME of the local branch $1.
ref_facts() {
  local up track
  IFS=: read -r up track TIME <<< "$(git -C "${RP}" for-each-ref \
    --format='%(upstream:short):%(upstream:track,nobracket):%(committerdate:unix)' "refs/heads/$1")"
  ORIGIN="counts" OA=0 OB=0
  if [[ -z "${up}" ]]; then
    ORIGIN="local"
  elif [[ "${track}" == "gone" ]]; then
    ORIGIN="gone"
  else
    if [[ "${track}" =~ ahead\ ([0-9]+) ]]; then OA="${BASH_REMATCH[1]}"; fi
    if [[ "${track}" =~ behind\ ([0-9]+) ]]; then OB="${BASH_REMATCH[1]}"; fi
  fi
  return 0
}

# The stash count of the branch $1, from the stash list of the repo.
stash_count() {
  if [[ -z "${STASHES}" ]]; then
    echo 0
  else
    printf '%s\n' "${STASHES}" | awk -v b="$1: " \
      'index($0, "WIP on " b) == 1 || index($0, "On " b) == 1 { n++ } END { print n + 0 }'
  fi
}

# The operation that stopped in the worktree $1. Sets OP, and OP_BRANCH with the
# branch of a rebase, because git shows a worktree in a rebase as detached.
stopped_op() {
  local d head
  OP='' OP_BRANCH=''
  d="$(git -C "$1" rev-parse --path-format=absolute --git-dir)"
  if [[ -d "${d}/rebase-merge" || -d "${d}/rebase-apply" ]]; then
    OP="rebase"
    for head in "${d}/rebase-merge/head-name" "${d}/rebase-apply/head-name"; do
      if [[ -f "${head}" ]]; then OP_BRANCH="$(sed 's|^refs/heads/||' "${head}")"; fi
    done
  elif [[ -f "${d}/MERGE_HEAD" ]]; then
    OP="merge"
  elif [[ -f "${d}/CHERRY_PICK_HEAD" ]]; then
    OP="cherry-pick"
  elif [[ -f "${d}/REVERT_HEAD" ]]; then
    OP="revert"
  elif [[ -f "${d}/BISECT_LOG" ]]; then
    OP="bisect"
  fi
  return 0
}

# Sets CONFLICT, DIRTY, DGLYPH and CODES of the worktree $1. CODES has the counts
# of the `git status -s` codes, for example "M2 ??1". Conflicts are not in DIRTY.
worktree_changes() {
  local out codes c n adds=0 dels=0 other=0
  CONFLICT=0 DIRTY=0 DGLYPH='' CODES=''
  out="$(git -C "$1" status --porcelain 2> /dev/null)" || out=''
  [[ -z "${out}" ]] && return 0
  # One code for each line: the staged letter, else the unstaged letter.
  codes="$(printf '%s\n' "${out}" | awk '{
    x = substr($0, 1, 1); y = substr($0, 2, 1)
    if (x == "?") print "??"
    else if (x == "U" || y == "U" || x y == "AA" || x y == "DD") print "U"
    else if (x == " ") print y
    else print x
  }')"
  for c in U M T A D R C '??'; do
    n="$(printf '%s\n' "${codes}" | grep -cxF -- "${c}")" || n=0
    [[ "${n}" -gt 0 ]] || continue
    if [[ "${c}" == "U" ]]; then
      CONFLICT="${n}"
      continue
    fi
    CODES="${CODES:+${CODES} }${c}${n}"
    case "${c}" in
      A | '??')
        adds=$((adds + n))
        ;;
      D)
        dels=$((dels + n))
        ;;
      *)
        other=$((other + n))
        ;;
    esac
  done
  DIRTY=$((adds + dels + other))
  # As in claude-status: + only adds, - only deletes, and a mix is mixed.
  if ((DIRTY == 0)); then
    DGLYPH=''
  elif ((other == 0 && dels == 0)); then
    DGLYPH="+"
  elif ((other == 0 && adds == 0)); then
    DGLYPH="-"
  else
    DGLYPH="${G_MIX}"
  fi
  return 0
}

attention() {
  A_RANK+=("$1") A_GLYPH+=("$2") A_COLOR+=("$3") A_REPO+=("$4") A_BRANCH+=("$5") A_MSG+=("$6") A_CMD+=("$7")
}

# Adds one row with the values of the caller. The caller has the worktree facts
# in its local variables.
add_row() {
  KIND+=("$1") REPO+=("${LABEL}")
  R_ROLE+=("") R_HOST+=("") R_GLYPH+=("") R_DEFAULT+=("") R_FETCHED+=("") R_PINNED+=("") R_NOTE+=("") R_FIX+=("")
  W_BRANCH+=("${branch}") W_DETACHED+=("${detached}") W_COMMIT+=("${head:0:7}") W_AGE+=("$(age_of "${TIME}")")
  W_BASE+=("${rbase}") W_BA+=("${base_a}") W_BB+=("${base_b}") W_PA+=("${pin_a}") W_PB+=("${pin_b}")
  W_ORIGIN+=("${ORIGIN}") W_OA+=("${OA}") W_OB+=("${OB}") W_SYNC+=("${sync}")
  W_CONFLICT+=("${CONFLICT}") W_DIRTY+=("${DIRTY}") W_DGLYPH+=("${DGLYPH}") W_CODES+=("${CODES}")
  W_OP+=("${OP}") W_LOCKED+=("${locked}") W_MISSING+=("${missing}") W_STASH+=("${stash}")
  W_MERGED+=("${merged}") W_NOTPIN+=("${notpin}") W_PATH+=("${path}")
}

# Adds the row of a repo. $1 role, $2 origin URL, $3 default, $4 fetched,
# $5 pinned text, $6 note, $7 fix.
add_repo_row() {
  local host="no origin" glyph="${G_GIT}" i
  case "$2" in
    "") ;;
    *github.com[:/]*)
      host="GitHub" glyph="${G_GITHUB}"
      ;;
    *gitlab.*[:/]*)
      host="GitLab" glyph="${G_GITLAB}"
      ;;
    *)
      host="other remote" glyph="${G_REMOTE}"
      ;;
  esac
  i=${#KIND[@]}
  KIND+=("repo") REPO+=("${LABEL}")
  R_ROLE[i]="$1" R_HOST[i]="${host}" R_GLYPH[i]="${glyph}" R_DEFAULT[i]="$3" R_FETCHED[i]="$4"
  R_PINNED[i]="$5" R_NOTE[i]="$6" R_FIX[i]="$7"
  W_BRANCH[i]="" W_DETACHED[i]="" W_COMMIT[i]="" W_AGE[i]="" W_BASE[i]="" W_BA[i]="" W_BB[i]="" W_PA[i]="" W_PB[i]=""
  W_ORIGIN[i]="" W_OA[i]="" W_OB[i]="" W_SYNC[i]="" W_CONFLICT[i]="" W_DIRTY[i]="" W_DGLYPH[i]="" W_CODES[i]=""
  W_OP[i]="" W_LOCKED[i]="" W_MISSING[i]="" W_STASH[i]="" W_MERGED[i]="" W_NOTPIN[i]="" W_PATH[i]=""
}

# Adds one repo, all its worktrees and branches, and then its submodules.
# $1 path, $2 role, $3 parent label, $4 pinned commit.
collect_repo() {
  local RP="$1" role="$2" parent="$3" pinned="$4"
  local LABEL url default fetched_file fetched='' pinned_text='' STASHES attached=$'\n'
  local AHEAD BEHIND ORIGIN OA OB TIME OP OP_BRANCH CONFLICT DIRTY DGLYPH CODES
  local line wt='' head='' branch='' detached='' locked='' prunable='' bare='' main_head='' kind
  local rbase base_a base_b pin_a pin_b sync missing stash merged notpin path
  local -a wts=() wheads=() wbranches=() wlocked=() wprune=()
  local i

  LABEL="$(display_path "${RP}")"
  if [[ "${role}" == "root" ]]; then
    LABEL="$(basename -s .git "$(git -C "${RP}" config --get remote.origin.url 2> /dev/null || echo "${RP}")")"
  fi
  url="$(git -C "${RP}" config --get remote.origin.url 2> /dev/null)" || url=''
  default="$(default_branch "${RP}")"
  fetched_file="$(git -C "${RP}" rev-parse --path-format=absolute --git-path FETCH_HEAD)"
  if [[ -f "${fetched_file}" ]]; then
    fetched="$(age_of "$(stat -f %m "${fetched_file}" 2> /dev/null || stat -c %Y "${fetched_file}")")"
  fi
  if [[ -n "${pinned}" ]]; then
    pinned_text="${parent} at ${pinned:0:7}"
  fi
  add_repo_row "${role}" "${url}" "${default}" "${fetched}" "${pinned_text}" "" ""
  STASHES="$(git -C "${RP}" stash list --format=%gs 2> /dev/null)" || STASHES=''

  # Read all the worktrees first: a row calls git, and git must not read the loop input.
  while IFS= read -r line; do
    case "${line}" in
      worktree\ *)
        wt="${line#worktree }"
        ;;
      HEAD\ *)
        head="${line#HEAD }"
        ;;
      branch\ *)
        branch="${line#branch refs/heads/}"
        ;;
      locked*)
        locked="1"
        ;;
      prunable*)
        prunable="1"
        ;;
      bare)
        bare="1"
        ;;
      "")
        if [[ -z "${bare}" ]]; then
          wts+=("${wt}") wheads+=("${head}") wbranches+=("${branch}") wlocked+=("${locked}") wprune+=("${prunable}")
        fi
        wt='' head='' branch='' locked='' prunable='' bare=''
        ;;
    esac
  done < <(git -C "${RP}" worktree list --porcelain)

  for ((i = 0; i < ${#wts[@]}; i++)); do
    wt="${wts[i]}" head="${wheads[i]}" branch="${wbranches[i]}" locked="${wlocked[i]}"
    kind="worktree"
    if ((i == 0)); then
      kind="main_worktree" wt="${RP}" main_head="${head}"
    fi
    path="$(display_path "${wt}")"
    missing='' CONFLICT=0 DIRTY=0 DGLYPH='' CODES='' OP='' OP_BRANCH=''
    if [[ -n "${wprune[i]}" || ! -d "${wt}" ]]; then
      missing="1"
    else
      stopped_op "${wt}"
      worktree_changes "${wt}"
      if [[ -z "${branch}" && -n "${OP_BRANCH}" ]]; then branch="${OP_BRANCH}"; fi
    fi
    detached=''
    ORIGIN="none" OA=0 OB=0
    if [[ -z "${branch}" ]]; then
      detached="1"
      branch="${head:0:7}"
      TIME="$(git -C "${RP}" log -1 --format=%ct "${head}")"
    else
      attached="${attached}${branch}"$'\n'
      ref_facts "${branch}"
      if [[ -z "${TIME}" ]]; then TIME="$(git -C "${RP}" log -1 --format=%ct "${head}")"; fi
    fi
    if [[ -n "${detached}" ]]; then rbase="${default}"; else rbase="$(row_base "${branch}" "${default}")"; fi
    counts "${rbase}" "${head}"
    if [[ -z "${AHEAD}" ]]; then rbase=''; fi
    base_a="${AHEAD}" base_b="${BEHIND}"
    counts "${pinned}" "${head}"
    pin_a="${AHEAD}" pin_b="${BEHIND}"
    sync=''
    if git -C "${RP}" merge-base --is-ancestor "${main_head}" "${head}" 2> /dev/null; then sync="1"; fi
    stash=0
    if [[ -z "${detached}" ]]; then stash="$(stash_count "${branch}")"; fi
    merged=''
    notpin=''
    if ((i == 0)) && [[ -n "${pin_a}" && "${pin_a}${pin_b}" != "00" ]]; then notpin="1"; fi
    add_row "${kind}"
    worktree_attention
  done

  # The branches that no worktree holds.
  while IFS= read -r branch; do
    case "${attached}" in
      *$'\n'"${branch}"$'\n'*)
        continue
        ;;
    esac
    head="$(git -C "${RP}" rev-parse "refs/heads/${branch}")"
    detached='' locked='' missing='' path='' CONFLICT=0 DIRTY=0 DGLYPH='' CODES='' OP=''
    ref_facts "${branch}"
    rbase="$(row_base "${branch}" "${default}")"
    counts "${rbase}" "${head}"
    if [[ -z "${AHEAD}" ]]; then rbase=''; fi
    base_a="${AHEAD}" base_b="${BEHIND}"
    counts "${pinned}" "${head}"
    pin_a="${AHEAD}" pin_b="${BEHIND}"
    sync=''
    if git -C "${RP}" merge-base --is-ancestor "${main_head}" "${head}" 2> /dev/null; then sync="1"; fi
    stash="$(stash_count "${branch}")"
    merged="no"
    if [[ -n "${rbase}" && "${base_a}" == "0" ]]; then merged="yes"; fi
    notpin=''
    add_row "branch"
    branch_attention
  done < <(git -C "${RP}" for-each-ref --format='%(refname:lstrip=2)' refs/heads)

  collect_submodules "${RP}" "${LABEL}" "${default}"
}

# The attention items of the worktree row that add_row just added.
worktree_attention() {
  local g
  g="$(git_in "${path}")"
  if [[ -n "${missing}" ]]; then
    attention 1 "${G_NOFOLDER}" red "${LABEL}" "${branch}" "The worktree folder is missing." "$(git_in "$(display_path "${RP}")") worktree prune"
    return 0
  fi
  if [[ -n "${OP}" ]]; then
    local cap msg
    cap="$(printf '%s' "${OP:0:1}" | tr '[:lower:]' '[:upper:]')${OP:1}"
    msg="${cap} stopped."
    if ((CONFLICT > 0)); then msg="${cap} stopped with ${CONFLICT} conflict$(plural "${CONFLICT}")."; fi
    attention 1 "${G_WARN}" red "${LABEL}" "${branch}" "${msg}" "${g} status"
  elif ((CONFLICT > 0)); then
    attention 1 "${G_WARN}" red "${LABEL}" "${branch}" "${CONFLICT} conflict$(plural "${CONFLICT}")." "${g} status"
  elif [[ -n "${detached}" ]]; then
    attention 2 "${G_DETACHED}" yellow "${LABEL}" "${branch}" "No branch holds this worktree." "${g} switch -c <name>"
  fi
  if [[ "${ORIGIN}" == "counts" && "${OB}" -gt 0 ]]; then
    attention 2 "${G_DOWN}" yellow "${LABEL}" "${branch}" "${OB} commit$(plural "${OB}") behind origin.${fetched:+ Last fetch ${fetched} ago.}" "${g} pull"
  fi
  if [[ -n "${notpin}" ]]; then
    local at="not at"
    if [[ "${pin_b}" == "0" ]]; then
      at="${pin_a} commit$(plural "${pin_a}") after"
    elif [[ "${pin_a}" == "0" ]]; then
      at="${pin_b} commit$(plural "${pin_b}") before"
    fi
    attention 2 "${G_PIN}" yellow "${LABEL}" "${branch}" "The main worktree is ${at} the pinned commit." "${g} log ${pinned:0:7}..HEAD"
  fi
  return 0
}

# The attention item of the branch row that add_row just added. A core branch or
# the default branch stays, also when it is merged.
branch_attention() {
  [[ "${merged}" == "yes" ]] || return 0
  case "${branch}" in
    main | develop | "${default}")
      return 0
      ;;
  esac
  local msg="Merged. You can delete it."
  if [[ "${ORIGIN}" == "gone" ]]; then msg="Merged, and the upstream is gone. You can delete it."; fi
  attention 3 "${G_MERGED}" green "${LABEL}" "${branch}" "${msg}" "$(git_in "$(display_path "${RP}")") branch -d ${branch}"
}

plural() {
  if [[ "$1" != "1" ]]; then printf 's'; fi
}

# Adds the submodules of the repo at $1. $2 is its label and $3 its default branch.
collect_submodules() {
  local r="$1" parent="$2" default="$3" key sub name url abs pinned
  [[ -f "${r}/.gitmodules" ]] || return 0
  local -a keys=() subs=()
  while read -r key sub; do
    keys+=("${key}") subs+=("${sub}")
  done < <(git config -f "${r}/.gitmodules" --get-regexp '^submodule\..*\.path$' 2> /dev/null || true)
  local i
  for ((i = 0; i < ${#subs[@]}; i++)); do
    sub="${subs[i]}"
    abs="${r}/${sub}"
    name="${keys[i]#submodule.}"
    name="${name%.path}"
    SEEN="${SEEN}${abs}"$'\n'
    pinned="$(git -C "${r}" ls-tree "${default}" -- "${sub}" 2> /dev/null | awk '{print $3}')" || pinned=''
    if [[ -e "${abs}/.git" ]]; then
      collect_repo "${abs}" "submodule" "${parent}/${default}" "${pinned}"
    else
      url="$(git config -f "${r}/.gitmodules" --get "submodule.${name}.url" 2> /dev/null)" || url=''
      add_missing "${abs}" "submodule" "${url}" "not initialised" "mise run setup:worktree" "The submodule is not initialised."
    fi
  done
}

# Adds a repo that is not on disk. $1 path, $2 role, $3 URL, $4 note, $5 fix, $6 message.
add_missing() {
  local LABEL
  LABEL="$(display_path "$1")"
  add_repo_row "$2" "$3" "" "" "" "$4" "$5"
  attention 2 "${G_FETCH}" yellow "${LABEL}" "" "$6" "$5"
}

# Adds one declared member that is not a submodule. $1 path relative to the base,
# $2 URL. A folder below the root without its own .git is part of the root tree.
collect_member() {
  local abs role="member" fix='' parent
  case "$1" in
    /*)
      abs="$1"
      ;;
    *)
      abs="${BASE}/$1"
      ;;
  esac
  # A real path, also for a member that is not on disk: "../x" must not stay below the base.
  if [[ -d "${abs}" ]]; then
    abs="$(cd "${abs}" && pwd -P)"
  elif parent="$(cd "$(dirname "${abs}")" 2> /dev/null && pwd -P)"; then
    abs="${parent}/$(basename "${abs}")"
  fi
  case "${SEEN}" in
    *$'\n'"${abs}"$'\n'*)
      return 0
      ;;
  esac
  SEEN="${SEEN}${abs}"$'\n'
  if [[ "${abs}" != "${BASE}"/* ]]; then role="sibling"; fi
  if [[ -e "${abs}/.git" ]]; then
    collect_repo "${abs}" "${role}" "" ""
  elif [[ "${role}" == "sibling" ]]; then
    if [[ -n "$2" ]]; then fix="git clone $2 $(display_path "${abs}")"; fi
    add_missing "${abs}" "${role}" "$2" "not on this machine" "${fix}" "The sibling is not on this machine."
  fi
  return 0
}

# The declared members, in this order: the MEMBERS value of the mise config, then
# the `members:` list of the vwf config. Submodules are already in SEEN.
collect_members() {
  local list m p u
  list="$(yq -p toml '.env.MEMBERS // ""' "${BASE}/.config/mise.toml" 2> /dev/null)" || list=''
  # Unquoted on purpose: the value is one space-separated string.
  # shellcheck disable=SC2086
  for m in ${list}; do
    collect_member "${m}" ""
  done
  [[ -f "${BASE}/.config/vwf.yaml" ]] || return 0
  list="$(yq '(.members // []) | map([.path, .url // ""]) | @tsv' "${BASE}/.config/vwf.yaml" 2> /dev/null)" || list=''
  while IFS=$'\t' read -r p u; do
    if [[ -n "${p}" ]]; then collect_member "${p}" "${u}"; fi
  done <<< "${list}"
}

# ---- The terminal table ----

# Sets VW to the display width of $1. It counts the lead bytes, so the locale has
# no effect. An emoji glyph takes two columns.
vwidth() {
  local LC_ALL=C s="$1" noemoji
  noemoji="${s//$'\xf0\x9f'/}"
  VW=$(((${#s} - ${#noemoji}) / 2))
  s="${s//[$'\x80'-$'\xbf']/}"
  VW=$((VW + ${#s}))
}

color_of() {
  case "$1" in
    green)
      printf '%s' "${COLOR_GREEN}"
      ;;
    yellow)
      printf '%s' "${COLOR_YELLOW}"
      ;;
    red)
      printf '%s' "${COLOR_RED}"
      ;;
    dim)
      printf '\033[2m'
      ;;
    bold)
      printf '%s' "${STYLE_BOLD}"
      ;;
  esac
}

# $1 in the color $2 when the output is styled.
paint() {
  if [[ -n "$2" ]] && style_enabled; then
    printf '%b%s%b' "$(color_of "$2")" "$1" "${STYLE_NORMAL}"
  else
    printf '%s' "$1"
  fi
}

# Sets CELL and CELL_COLOR of the counts $1 and $2.
count_cell() {
  CELL='' CELL_COLOR=''
  if [[ -z "$1" ]]; then
    CELL="${G_NA}" CELL_COLOR="dim"
  elif [[ "$1" == "0" && "$2" == "0" ]]; then
    CELL="${G_OK}" CELL_COLOR="green"
  else
    if [[ "$1" != "0" ]]; then CELL="${G_UP}$1"; fi
    if [[ "$2" != "0" ]]; then
      CELL="${CELL:+${CELL} }${G_DOWN}$2"
      CELL_COLOR="yellow"
    fi
  fi
  return 0
}

# Sets CELL and CELL_COLOR of the origin of the row $1.
origin_cell() {
  case "${W_ORIGIN[$1]}" in
    gone)
      CELL="${G_GONE}" CELL_COLOR="red"
      ;;
    local)
      CELL="${G_LOCAL}" CELL_COLOR="dim"
      ;;
    none)
      CELL="${G_NA}" CELL_COLOR="dim"
      ;;
    *)
      count_cell "${W_OA[$1]}" "${W_OB[$1]}"
      ;;
  esac
}

# Sets STATE_PARTS of the row $1: lines of "<glyph>|<color>|<word>". The page and
# the JSON use the same parts.
state_parts() {
  local i="$1" p=''
  if [[ "${KIND[i]}" == "branch" ]]; then
    if [[ "${W_MERGED[i]}" == "yes" ]]; then
      p="${G_MERGED}|green|merged"$'\n'
    else
      p="${G_UNMERGED}|yellow|not merged"$'\n'
    fi
  elif [[ -n "${W_MISSING[i]}" ]]; then
    p="${G_NOFOLDER}|red|folder missing"$'\n'
  else
    if [[ -n "${W_NOTPIN[i]}" ]]; then p="${p}${G_PIN}|yellow|not at the pinned commit"$'\n'; fi
    if [[ -n "${W_LOCKED[i]}" ]]; then p="${p}${G_LOCK}|yellow|locked"$'\n'; fi
    if ((W_CONFLICT[i] > 0)); then p="${p}${G_WARN}${W_CONFLICT[i]}|red|conflict: U${W_CONFLICT[i]}"$'\n'; fi
    if ((W_DIRTY[i] > 0)); then p="${p}${W_DGLYPH[i]}${W_DIRTY[i]}|yellow|dirty: ${W_CODES[i]}"$'\n'; fi
    if [[ -n "${W_OP[i]}" ]]; then p="${p}${G_OP}|red|${W_OP[i]} stopped"$'\n'; fi
    if ((W_CONFLICT[i] == 0 && W_DIRTY[i] == 0)) && [[ -z "${W_OP[i]}" ]]; then p="${p}${G_OK}|green|clean"$'\n'; fi
  fi
  STATE_PARTS="${p}"
}

print_table() {
  local i n w_branch=6 w_base=4 w_origin=6 w_state=5 repos=0 worktrees=0 branches=0
  local -a c_branch=() c_base=() c_bcolor=() c_origin=() c_ocolor=() c_state=() c_scolor=()
  local g color word plain painted
  for ((i = 0; i < ${#KIND[@]}; i++)); do
    if [[ "${KIND[i]}" == "repo" ]]; then
      repos=$((repos + 1))
      continue
    fi
    if [[ "${KIND[i]}" == "branch" ]]; then branches=$((branches + 1)); else worktrees=$((worktrees + 1)); fi
    c_branch[i]="${W_BRANCH[i]}"
    if [[ -n "${W_DETACHED[i]}" ]]; then c_branch[i]="${G_DETACHED} ${W_BRANCH[i]}"; fi
    vwidth "${c_branch[i]}"
    if ((VW > w_branch)); then w_branch=${VW}; fi
    count_cell "${W_BA[i]}" "${W_BB[i]}"
    c_base[i]="${CELL}" c_bcolor[i]="${CELL_COLOR}"
    vwidth "${CELL}"
    if ((VW > w_base)); then w_base=${VW}; fi
    origin_cell "${i}"
    c_origin[i]="${CELL}" c_ocolor[i]="${CELL_COLOR}"
    vwidth "${CELL}"
    if ((VW > w_origin)); then w_origin=${VW}; fi
    state_parts "${i}"
    plain='' painted=''
    while IFS='|' read -r g color word; do
      [[ -n "${g}" ]] || continue
      plain="${plain:+${plain} }${g}"
      painted="${painted:+${painted} }$(paint "${g}" "${color}")"
    done <<< "${STATE_PARTS}"
    if ((W_STASH[i] > 0)); then
      plain="${plain} ${G_STASH}${W_STASH[i]}"
      painted="${painted} $(paint "${G_STASH}${W_STASH[i]}" yellow)"
    fi
    c_state[i]="${plain}" c_scolor[i]="${painted}"
    vwidth "${plain}"
    if ((VW > w_state)); then w_state=${VW}; fi
  done

  print_header "Listing the worktrees ..."
  paint "$(printf '     %-*s  %-*s  %-*s  SYNC  %-*s  AGE' "${w_branch}" BRANCH "${w_base}" BASE "${w_origin}" ORIGIN "${w_state}" STATE)" yellow
  printf '\n'
  for ((i = 0; i < ${#KIND[@]}; i++)); do
    if [[ "${KIND[i]}" == "repo" ]]; then
      paint "${R_GLYPH[i]} ${REPO[i]}" bold
      plain="${R_ROLE[i]}"
      if [[ -n "${R_DEFAULT[i]}" ]]; then plain="${plain} ${G_NA} ${R_DEFAULT[i]}"; fi
      if [[ -n "${R_FETCHED[i]}" ]]; then plain="${plain} ${G_NA} fetched ${R_FETCHED[i]}"; fi
      printf '  '
      paint "${plain}" dim
      printf '\n'
      if [[ -n "${R_NOTE[i]}" ]]; then
        printf '  '
        paint "${G_FETCH}" yellow
        printf '  '
        paint "${R_NOTE[i]}" dim
        printf '\n'
      fi
      continue
    fi
    case "${KIND[i]}" in
      main_worktree)
        g="${G_FOLDER}  "
        ;;
      worktree)
        g="${G_TREE} "
        ;;
      *)
        g="${G_BRANCH}  "
        ;;
    esac
    printf '  %s' "${g}"
    pad_cell "${c_branch[i]}" "" "${w_branch}"
    pad_cell "${c_base[i]}" "${c_bcolor[i]}" "${w_base}"
    pad_cell "${c_origin[i]}" "${c_ocolor[i]}" "${w_origin}"
    if [[ -n "${W_SYNC[i]}" ]]; then pad_cell "${G_SYNC}" green 4; else pad_cell "${G_DRIFT}" red 4; fi
    vwidth "${c_state[i]}"
    printf '%s%*s  ' "${c_scolor[i]}" "$((w_state - VW))" ''
    paint "${W_AGE[i]}" dim
    printf '\n'
  done

  n=${#A_RANK[@]}
  print_newline
  plain="${repos} repo$(plural "${repos}") ${G_NA} ${worktrees} worktree$(plural "${worktrees}") ${G_NA} ${branches} branch"
  if [[ "${branches}" != "1" ]]; then plain="${plain}es"; fi
  if ((n > 0)); then
    if ((n == 1)); then paint "${G_WARN} 1 needs attention" yellow; else paint "${G_WARN} ${n} need attention" yellow; fi
  else
    paint "${G_OK} nothing needs attention" green
  fi
  printf '  '
  paint "${G_NA}  ${plain}" dim
  printf '\n'
  if [[ -n "${PAGE}" ]]; then
    if style_enabled; then
      printf 'Details: \033]8;;file://%s\033\\\033[4m%s\033[0m\033]8;;\033\\\n' "${PAGE}" "${PAGE}"
    else
      printf 'Details: %s\n' "${PAGE}"
    fi
  fi
  print_newline
  local entry section rest
  for entry in "${LEGEND[@]}"; do
    section="${entry%%|*}"
    rest="${entry#*|}"
    paint "$(printf '%-13s%s' "${section}" "${rest//|/  }")" dim
    printf '\n'
  done
}

# Prints $1 in the color $2, padded to the width $3, then the column gap.
pad_cell() {
  vwidth "$1"
  paint "$1" "$2"
  printf '%*s  ' "$(($3 - VW))" ''
}

# ---- The output for an agent ----

# $1 as a JSON string, or null when it is empty.
json_str() {
  local s="$1"
  if [[ -z "${s}" ]]; then
    printf 'null'
    return 0
  fi
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  printf '"%s"' "${s}"
}

# A JSON object of counts. $1 ahead, $2 behind, $3 optional ref.
json_counts() {
  if [[ -z "$1" ]]; then
    printf 'null'
  elif [[ -n "${3:-}" ]]; then
    printf '{"ref": %s, "ahead": %s, "behind": %s}' "$(json_str "$3")" "$1" "$2"
  else
    printf '{"ahead": %s, "behind": %s}' "$1" "$2"
  fi
}

print_jsonl() {
  local i line origin words g color word sep
  for ((i = 0; i < ${#KIND[@]}; i++)); do
    if [[ "${KIND[i]}" == "repo" ]]; then
      printf '{"kind": "repo", "repo": %s, "role": %s, "host": %s, "default": %s, "fetched": %s, "pinned": %s, "note": %s, "fix": %s}\n' \
        "$(json_str "${REPO[i]}")" "$(json_str "${R_ROLE[i]}")" "$(json_str "${R_HOST[i]}")" "$(json_str "${R_DEFAULT[i]}")" \
        "$(json_str "${R_FETCHED[i]}")" "$(json_str "${R_PINNED[i]}")" "$(json_str "${R_NOTE[i]}")" "$(json_str "${R_FIX[i]}")"
      continue
    fi
    case "${W_ORIGIN[i]}" in
      none)
        origin="null"
        ;;
      gone | local)
        origin="\"${W_ORIGIN[i]}\""
        ;;
      *)
        origin="$(json_counts "${W_OA[i]}" "${W_OB[i]}")"
        ;;
    esac
    state_parts "${i}"
    words='' sep=''
    while IFS='|' read -r g color word; do
      [[ -n "${g}" ]] || continue
      words="${words}${sep}$(json_str "${word}")"
      sep=', '
    done <<< "${STATE_PARTS}"
    line="$(json_str "${W_BRANCH[i]}")"
    if [[ -n "${W_DETACHED[i]}" ]]; then line="null"; fi
    printf '{"kind": "%s", "repo": %s, "branch": %s, "commit": "%s", "base": %s, "pinned": %s, "origin": %s, "sync": "%s", "state": [%s], "age": "%s", "stash": %s, "path": %s}\n' \
      "${KIND[i]}" "$(json_str "${REPO[i]}")" "${line}" "${W_COMMIT[i]}" \
      "$(json_counts "${W_BA[i]}" "${W_BB[i]}" "${W_BASE[i]}")" "$(json_counts "${W_PA[i]}" "${W_PB[i]}")" "${origin}" \
      "$(if [[ -n "${W_SYNC[i]}" ]]; then printf 'in-sync'; else printf 'drifted'; fi)" "${words}" "${W_AGE[i]}" "${W_STASH[i]}" "$(json_str "${W_PATH[i]}")"
  done
}

# The attention items of a non-terminal run are in JSON Lines too.
print_jsonl_attention() {
  local r i
  for r in 1 2 3; do
    for ((i = 0; i < ${#A_RANK[@]}; i++)); do
      [[ "${A_RANK[i]}" == "${r}" ]] || continue
      printf '{"kind": "attention", "repo": %s, "branch": %s, "message": %s, "command": %s}\n' \
        "$(json_str "${A_REPO[i]}")" "$(json_str "${A_BRANCH[i]}")" "$(json_str "${A_MSG[i]}")" "$(json_str "${A_CMD[i]}")"
    done
  done
}

BASE="$(resolve_base)"
collect_repo "${BASE}" "root" "" ""
collect_members

# A terminal gets the short table and a link to the page. Any other reader gets
# JSON Lines with no header, no color and no page, because it reads each line.
if [[ -t 1 ]]; then
  PAGE="$(write_worktrees_page)" || PAGE=''
  print_table
else
  print_jsonl
  print_jsonl_attention
fi
