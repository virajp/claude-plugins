#!/usr/bin/env bash
# Synced from bootstrap: tools/git/.config/mise/tasks/code/merge/main. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

#MISE description="Land develop on main — merge it, or open a pull request"
#MISE tools.pre-commit="latest"
#MISE tools.yq="latest"

set -euo pipefail
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/merge"

# Release. Both branches are fixed: `develop` reaches `main`, so there is
# nothing to name and nothing to get wrong. Run it from `develop` — the task
# refuses from anywhere else, and says so before touching a branch.
#
# Under `merge_model = "pr"` of `[branch.main]` of `.config/bootstrap.toml` the same
# pair becomes the request this opens: `develop` → `main`.

CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
if [ "${CURRENT_BRANCH}" != "develop" ]; then
  print_error "run code:merge:main from 'develop'."
  print_warn "- you are on '${CURRENT_BRANCH}'"
  print_warn "- run \`mise run code:merge:develop\` first, then merge develop into main"
  exit 1
fi

merge_to_destination_branch main develop
