#!/usr/bin/env bash
# Synced from bootstrap: repo/tools/git/tasks/git-merge-develop. Do not edit this file.
# The next sync writes it again, and each change in this file is lost.

#MISE description="Land a feature branch on develop — merge it, or open a pull request"
#MISE tools.pre-commit="latest"
#MISE tools.yq="latest"

#USAGE arg "[source]" help="the branch to merge into develop; the default is the current branch"

set -euo pipefail
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/merge"

# The sync writes this task only when develop is in core_branches of
# `.config/bootstrap/repo.toml`. Name the branch when you run it from another
# worktree than the one the work was done in.
#
# Everything the merge refuses, and why — and which path its `landing` takes
# afterwards — is in `_scripts/merge`.

# `usage_source` is set by mise from the `#USAGE arg` above, so shellcheck
# cannot see the assignment. An empty source is the current branch.
# shellcheck disable=SC2154
merge_to_destination_branch develop "${usage_source:-}"
