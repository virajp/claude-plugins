#!/usr/bin/env bash
# Synced from bootstrap: repo/tools/git/tasks/git-merge-main. Do not edit this file.
# The next sync writes it again, and each change in this file is lost.

#MISE description="Land a branch on main — merge it, or open a pull request"
#MISE tools.pre-commit="latest"
#MISE tools.yq="latest"

#USAGE arg "[source]" help="the branch to merge into main; the default is develop when develop is a core branch, else the current branch"

set -euo pipefail
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/merge"

# The sync writes this task only when main is in core_branches of
# `.config/bootstrap/repo.toml`. With develop there too, develop is the source
# when none is named. The library decides which source may merge in
# (`merge_from` of `[branches.main]`), and refuses a source equal to main.
#
# Under `landing = "pr"` of `[branches.main]` the same pair becomes the request
# this opens.

# `usage_source` is set by mise from the `#USAGE arg` above, so shellcheck
# cannot see the assignment.
# shellcheck disable=SC2154
SOURCE="${usage_source:-}"
if [ -z "${SOURCE}" ]; then
  CORE=$(bootstrap_get repo.core_branches) || exit $?
  HAS_DEVELOP=$(yq -p json -o yaml '(.value // []) | any_c(. == "develop")' <<< "${CORE}") || {
    print_error "cannot read core_branches of .config/bootstrap/repo.toml."
    exit 1
  }
  if [ "${HAS_DEVELOP}" = true ]; then
    SOURCE=develop
  else
    SOURCE=$(git rev-parse --abbrev-ref HEAD)
  fi
fi

merge_to_destination_branch main "${SOURCE}"
