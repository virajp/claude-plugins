#!/usr/bin/env bash
# Synced from bootstrap: repo/tools/git/tasks/git-worktree-create. Do not edit this file.
# The next sync writes it again, and each change in this file is lost.

#MISE description="Create a worktree for a branch, and set it up"
#MISE tools.yq="latest"

#USAGE arg "<branch>" help="the branch of the worktree; a branch that does not exist is created"
#USAGE flag "--from <base>" help="the base of a new branch; the default is the current branch"
#USAGE flag "--no-setup" help="skip git:worktree:setup in the new worktree; mise trust still runs"

set -euo pipefail
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/checks"

# The worktree is in `.worktrees/<branch>` of the main checkout, or in
# `worktrees/<branch>` when only `worktrees/` exists. A branch that exists
# here is checked out; a branch only on origin becomes a local branch that
# tracks it; any other branch is new, cut from --from or the current branch.
# A core branch (core_branches of `.config/bootstrap/repo.toml`) never gets a
# worktree of this task: the merges check it out in the main checkout.

# The `usage_*` variables are set by mise from the `#USAGE` lines above, so
# ShellCheck cannot see the assignments.
# shellcheck disable=SC2154
BRANCH="${usage_branch}"
# shellcheck disable=SC2154
FROM="${usage_from:-}"
# shellcheck disable=SC2154
NO_SETUP="${usage_no_setup:-false}"

print_header "Creating the worktree of ${BRANCH} ..."

CORE=$(bootstrap_get repo.core_branches) || exit $?
CORE_LIST=$(yq -p json -o yaml '(.value // [])[]' <<< "${CORE}") || {
  print_error "cannot read core_branches of .config/bootstrap/repo.toml."
  exit 1
}
if grep -qxF -- "${BRANCH}" <<< "${CORE_LIST}"; then
  print_error "'${BRANCH}' is a core branch, and a core branch gets no worktree."
  exit 2
fi

MAIN_WORKTREE_PATH=$(get_main_worktree_path)
DIR=.worktrees
if [ ! -e "${MAIN_WORKTREE_PATH}/.worktrees" ] && [ -d "${MAIN_WORKTREE_PATH}/worktrees" ]; then
  DIR=worktrees
fi
WORKTREE="${MAIN_WORKTREE_PATH}/${DIR}/${BRANCH}"

if [ -e "${WORKTREE}" ]; then
  print_error "${WORKTREE} already exists."
  exit 1
fi

# require_no_from: --from is a usage error for a branch that exists.
require_no_from() {
  if [ -n "${FROM}" ]; then
    print_error "--from is for a new branch, and '${BRANCH}' exists${1:+ on origin}."
    exit 2
  fi
}

FROM_ORIGIN=false

if git show-ref --verify --quiet "refs/heads/${BRANCH}"; then
  require_no_from
  ADD=("${WORKTREE}" "${BRANCH}")
  KIND="the branch ${BRANCH}"
elif git show-ref --verify --quiet "refs/remotes/origin/${BRANCH}"; then
  require_no_from origin
  ADD=(--track -b "${BRANCH}" "${WORKTREE}" "origin/${BRANCH}")
  KIND="a local branch ${BRANCH} that tracks origin/${BRANCH}"
  FROM_ORIGIN=true
else
  ADD=(-b "${BRANCH}" "${WORKTREE}" "${FROM:-HEAD}")
  KIND="the new branch ${BRANCH} from ${FROM:-the current branch}"
fi

# git refuses a branch that another worktree has checked out, and says so.
print_info "Adding ${WORKTREE} on ${KIND}"
if ! git worktree add --quiet "${ADD[@]}"; then
  print_error "git worktree add failed."
  exit 1
fi
print_success "Added ${WORKTREE}"

# On a failure after the add, the worktree stays, with the commands that finish
# or undo it.
keep_worktree() {
  print_error "$1"
  print_warn "- the worktree stays at ${WORKTREE}"
  print_warn "- set it up again: \`mise run --cd ${WORKTREE} git:worktree:setup\`"
  print_warn "- or delete it: \`mise run git:worktree:delete ${BRANCH}\`"
  exit 1
}

# A branch only on origin may hold a mise config or a setup task that someone
# else pushed: trust and setup run it as is, with no review step.
if [ "${FROM_ORIGIN}" = true ]; then
  print_warn "The mise config of the worktree comes from origin/${BRANCH}, and it is trusted and run as is."
fi
print_wait "Trusting the mise config of the worktree ... "
TRUST_OUT=$(cd "${WORKTREE}" && mise trust 2>&1) || {
  print_error
  printf '%s\n' "${TRUST_OUT}" >&2
  keep_worktree "mise trust failed in ${WORKTREE}."
}
print_success

if [ "${NO_SETUP}" = true ]; then
  print_info "Skipping git:worktree:setup (--no-setup)"
elif ! mise run --cd "${WORKTREE}" git:worktree:setup; then
  keep_worktree "git:worktree:setup failed in ${WORKTREE}."
fi

print_newline
print_success "The worktree of ${BRANCH} is ready at ${WORKTREE}"
