#!/usr/bin/env bash
# Synced from bootstrap: repo/tools/git/tasks/git-worktree-delete. Do not edit this file.
# The next sync writes it again, and each change in this file is lost.

#MISE description="Delete the worktree of a branch, and the branch when a core branch has it"
#MISE tools.yq="latest"

#USAGE arg "<branch>" help="the branch whose worktree to delete"

set -euo pipefail
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# The worktree is found by its branch in `git worktree list`, at any path. git
# refuses to remove a worktree with changes. The branch goes only when a core
# branch (core_branches of `.config/bootstrap/repo.toml`) has each of its
# commits: `git branch -d` would compare with the HEAD of this checkout, which
# can be any branch.

# `usage_branch` is set by mise from the `#USAGE arg` above, so shellcheck
# cannot see the assignment.
# shellcheck disable=SC2154
BRANCH="${usage_branch}"

print_header "Deleting the worktree of ${BRANCH} ..."

CORE=$(bootstrap_get repo.core_branches) || exit $?
CORE_LIST=$(yq -p json -o yaml '(.value // [])[]' <<< "${CORE}") || {
  print_error "cannot read core_branches of .config/bootstrap/repo.toml."
  exit 1
}
if grep -qxF -- "${BRANCH}" <<< "${CORE_LIST}"; then
  print_error "'${BRANCH}' is a core branch, and this task never deletes a core branch."
  exit 2
fi

WORKTREE=$(git worktree list --porcelain | B="refs/heads/${BRANCH}" awk '
  /^worktree / { path = substr($0, 10) }
  /^branch / && substr($0, 8) == ENVIRON["B"] { print path; exit }')
if [ -z "${WORKTREE}" ]; then
  print_error "no worktree has the branch '${BRANCH}'."
  exit 1
fi

# The folder of the run, with each symlink resolved, against the folder of the
# worktree.
HERE=$(git -C "${MISE_ORIGINAL_CWD:-${PWD}}" rev-parse --show-toplevel 2> /dev/null) || HERE=''
HERE=$(cd -P -- "${HERE:-/}" && pwd) || HERE=''
THERE=$(cd -P -- "${WORKTREE}" 2> /dev/null && pwd) || THERE="${WORKTREE}"
if [ "${HERE}" = "${THERE}" ]; then
  print_error "this run is inside ${WORKTREE}, the worktree it would remove."
  print_warn "- run it from another worktree"
  exit 2
fi

print_info "Removing ${WORKTREE}"
if ! git worktree remove "${WORKTREE}"; then
  print_error "git worktree remove failed."
  exit 1
fi
print_success "Removed ${WORKTREE}"

# The local ref of each core branch, else its ref on origin; a core branch
# with neither is skipped.
MERGED_INTO=''
while IFS= read -r core; do
  [ -n "${core}" ] || continue
  if git show-ref --verify --quiet "refs/heads/${core}"; then
    REF="refs/heads/${core}"
  elif git show-ref --verify --quiet "refs/remotes/origin/${core}"; then
    REF="refs/remotes/origin/${core}"
  else
    continue
  fi
  if git merge-base --is-ancestor "refs/heads/${BRANCH}" "${REF}"; then
    MERGED_INTO="${REF#refs/heads/}"
    MERGED_INTO="${MERGED_INTO#refs/remotes/}"
    break
  fi
done <<< "${CORE_LIST}"

if [ -z "${MERGED_INTO}" ]; then
  print_error "no core branch has each commit of '${BRANCH}', so the branch stays."
  print_warn "- delete it anyway: \`git branch -D ${BRANCH}\`"
  exit 1
fi

# -D is safe here: the test above proved that ${MERGED_INTO} has the branch.
if ! git branch -D "${BRANCH}" > /dev/null; then
  print_error "git branch -D ${BRANCH} failed."
  exit 1
fi
print_success "Deleted the branch ${BRANCH}, merged into ${MERGED_INTO}"
