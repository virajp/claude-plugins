#!/usr/bin/env bash
# Synced from bootstrap: tools/repo-sync/.config/mise/tasks/setup/configs/_default.tmpl. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

#MISE description="Sync the shared files of this repository's tools from bootstrap"

#USAGE flag "--dry-run" help="show the changes without writing them"

set -euo pipefail
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# This task only clones. `setup:configs:sync` then runs in a new process with
# the sync code of this clone, not with the local copy that the sync replaces.
# Thus a change to the sync code applies in the same run.
#
# The clone is a cache in a fixed folder, which each consumer of this machine
# uses. Each run fetches the default branch into it, so the sync still uses the
# pushed main. A lock folder next to the cache makes a second run wait until
# the first has updated the cache and copied it. The sync then reads only its
# own copy, so the next run can update the cache.
url=${REPO_SYNC_URL:-git@github.com:virajp/bootstrap.git}
cache="${XDG_CACHE_HOME:-${HOME}/.cache}/bootstrap"
lock="${cache}.lock"
held=''
copy=''

cleanup() {
  [[ -n ${held} ]] && rm -rf -- "${lock}"
  [[ -n ${copy} ]] && rm -rf -- "${copy}"
  return 0
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# BatchMode and no terminal prompt: a missing key or no access fails here
# instead of waiting for a password nobody will type.
git_remote() { GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="ssh -o BatchMode=yes" git "$@"; }

# 0 when the lock of a dead holder was removed. The removal is in its own
# lock: without it, a second waiter can remove the lock that the first waiter
# took after the removal. A folder (lock or takeover) without a pid that is
# older than one minute is from a run that stopped before it wrote the pid.
remove_stale_lock() {
  local pid stale=1
  mkdir -- "${lock}.takeover" 2> /dev/null || {
    if [[ -n $(find "${lock}.takeover" -maxdepth 0 -mmin +1 2> /dev/null) ]]; then
      rm -rf -- "${lock}.takeover"
    fi
    return 1
  }
  pid=$(cat -- "${lock}/pid" 2> /dev/null) || pid=''
  if [[ -n ${pid} ]]; then
    kill -0 "${pid}" 2> /dev/null || stale=0
  elif [[ -n $(find "${lock}" -maxdepth 0 -mmin +1 2> /dev/null) ]]; then
    stale=0
  fi
  ((stale)) || rm -rf -- "${lock}"
  rmdir -- "${lock}.takeover"
  return "${stale}"
}

print_header "Fetching bootstrap ..."
mkdir -p -- "${cache%/*}"
waited=''
until mkdir -- "${lock}" 2> /dev/null; do
  remove_stale_lock && continue
  # No pid yet: the holder only now took the lock, or the lock is gone.
  pid=$(cat -- "${lock}/pid" 2> /dev/null) || pid=''
  if [[ -n ${pid} && -z ${waited} ]]; then
    print_info "Waiting for another sync of bootstrap (pid ${pid}) ..."
    waited=1
  fi
  sleep 1
done
held=1
printf '%s\n' "$$" > "${lock}/pid"

# A cache that is not a clone of the URL, for example after a test with
# REPO_SYNC_URL, is cloned again.
origin=$(git -C "${cache}" remote get-url origin 2> /dev/null) || origin=''
if [[ ${origin} == "${url}" && -e ${cache}/.git ]]; then
  print_info "Updating the clone in ${cache}"
  if ! git_remote -C "${cache}" fetch --quiet --depth 1 origin HEAD; then
    print_error "Cannot fetch ${url} - nothing synced"
    exit 5
  fi
  git -C "${cache}" reset --quiet --hard FETCH_HEAD
  git -C "${cache}" clean --quiet -ffdx
else
  print_info "Cloning into ${cache}"
  rm -rf -- "${cache}"
  if ! git_remote clone --quiet --depth 1 --single-branch -- "${url}" "${cache}"; then
    rm -rf -- "${cache}"
    print_error "Cannot clone ${url} - nothing synced"
    exit 5
  fi
fi

copy=$(mktemp -d "${TMPDIR:-/tmp}/bootstrap.XXXXXX")
cp -R -- "${cache}/." "${copy}"
rm -rf -- "${lock}"
held=''

# Unquoted on purpose: empty adds no argument.
[[ "${usage_dry_run:-false}" == "true" ]] && DRY_RUN="--dry-run" || DRY_RUN=""
REPO_SYNC_CLONE="${copy}" mise run setup:configs:sync ${DRY_RUN}
