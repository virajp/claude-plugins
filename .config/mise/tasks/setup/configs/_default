#!/usr/bin/env bash
# Synced from bootstrap: repo/tools/repo-sync/.config/mise/tasks/setup/configs/_default.tmpl. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

#MISE description="Sync the shared files of this repository's tools from bootstrap"
#MISE tools.pre-commit="latest"

#USAGE flag "--dry-run" help="show the changes without writing them"
#USAGE flag "--verbose" help="list each file, also an unchanged one"

set -euo pipefail
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# This task only refreshes the cache clone and copies it. The Go engine then
# runs in a child process with that copy, so a change to the sync code applies
# in the same run. sync-engine/VERSION of the copy selects the engine release.
# The cache is ~/.cache/sync-engine/, which each consumer of this machine
# uses, and each run fetches main into it. The code below is sync-engine/clone
# of the bootstrap clone: the sync embeds it when it renders this template. A
# lock makes a second run wait until the first has updated the cache and copied
# it. The sync then reads only its own copy.
# The shared cache and clone of the sync engine. A caller sources this library,
# calls _se_clone_init, and sets its own traps with _se_clone_cleanup. The
# cache is ~/.cache/sync-engine/: the clone in repo/, the lock in lock/.
#
# An entry task calls _se_clone_init, _se_lock, _se_legacy_cleanup, _se_fetch,
# _se_copy, _se_unlock and _se_clone_cleanup.
#
# Variables, internal only:
#   SYNC_ENGINE_CACHE  the cache folder; tests use it
#   SYNC_ENGINE_URL    the clone URL; tests use it for an unpushed change
#   XDG_CACHE_HOME, HOME, TMPDIR  the default cache and the temporary copy
#
# Contract: docs/design/sync-engine.md

# Sets the paths from the environment.
_se_clone_init() {
  _SE_OLD_HELD=''
  _SE_CACHE=${SYNC_ENGINE_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/sync-engine}
  _SE_REPO=$_SE_CACHE/repo
  _SE_LOCK=$_SE_CACHE/lock
  _SE_URL=${SYNC_ENGINE_URL:-https://github.com/virajp/bootstrap.git}
  _SE_BRANCH=main
  _SE_HELD=''
  _SE_COPY=''
}

# _se_clone_styled <fd>: 0 when the output on that descriptor shows glyphs. The
# rule of style_enabled of helpers: this file cannot use helpers or
# sync-engine/common, because an entry task embeds it alone.
_se_clone_styled() {
  if [[ -n ${FORCE_COLOR:-} && ${FORCE_COLOR} != 0 ]]; then
    return 0
  fi
  [[ -z ${NO_COLOR:-} && -t $1 && ${TERM:-dumb} != dumb ]]
}

# _se_say <info|error> <text>: through the helpers of the caller, else on
# stderr. The Mac entry task has no helpers.
_se_say() {
  local level=$1 text=$2
  if declare -F print_info > /dev/null; then
    if [[ ${level} == error ]]; then
      print_error "${text}"
    else
      print_info "${text}"
    fi
  elif ! _se_clone_styled 2; then
    printf 'sync-engine: %s\n' "${text}" >&2
  elif [[ ${level} == error ]]; then
    printf '❌ %s\n' "${text}" >&2
  else
    printf 'ℹ️ %s\n' "${text}" >&2
  fi
}

# The URL without its scheme, user name, `user@host:path` form, trailing `/`
# and trailing `.git`, so the SSH and https URLs of one repo match.
_se_normalize_url() {
  local u=$1
  if [[ ${u} == *://* ]]; then
    u=${u#*://}
    [[ ${u%%/*} == *@* ]] && u=${u#*@}
  elif [[ ${u} == *:* && ${u%%:*} != */* ]]; then
    u=${u#*@}
    u=${u/:/\/}
  fi
  u=${u%/}
  u=${u%.git}
  u=${u%/}
  printf '%s' "${u}"
}

# BatchMode and no terminal prompt: a missing key or no access fails here
# instead of waiting for a password nobody will type.
_se_git_remote() { GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="ssh -o BatchMode=yes" git "$@"; }

# 0 when the lock of a dead holder was removed. The removal is in its own
# lock: without it, a second waiter can remove the lock that the first waiter
# took after the removal. A folder (lock or takeover) without a pid that is
# older than one minute is from a run that stopped before it wrote the pid.
_se_stale_lock() {
  local lock=$1 pid stale=1
  mkdir -- "${lock}.takeover" 2> /dev/null || {
    if [[ -n $(find "${lock}.takeover" -maxdepth 0 -mmin +1 2> /dev/null) ]]; then
      rm -rf -- "${lock}.takeover"
    fi
    return 1
  }
  pid=$(cat -- "${lock}/pid" 2> /dev/null) || pid=''
  if [[ -n ${pid} ]]; then
    kill -0 "${pid}" 2> /dev/null || stale=0
  elif [[ -n $(find "${lock}" -maxdepth 0 -mmin +1 2> /dev/null) ]]; then
    stale=0
  fi
  ((stale)) || rm -rf -- "${lock}"
  rmdir -- "${lock}.takeover"
  return "${stale}"
}

# Waits until this run holds the lock of the cache.
_se_lock() {
  local pid waited=''
  mkdir -p -- "${_SE_CACHE}"
  until mkdir -- "${_SE_LOCK}" 2> /dev/null; do
    _se_stale_lock "${_SE_LOCK}" && continue
    # No pid yet: the holder only now took the lock, or the lock is gone.
    pid=$(cat -- "${_SE_LOCK}/pid" 2> /dev/null) || pid=''
    if [[ -n ${pid} && -z ${waited} ]]; then
      _se_say info "Waiting for another sync (pid ${pid}) ..."
      waited=1
    fi
    sleep 1
  done
  _SE_HELD=1
  printf '%s\n' "$$" > "${_SE_LOCK}/pid"
}

_se_unlock() {
  if [[ -n ${_SE_HELD} ]]; then
    rm -rf -- "${_SE_LOCK}"
    _SE_HELD=''
  fi
}

# Removes the cache of the old stubs. An old stub that holds the old lock can
# be in its copy, so the removal needs that lock. With a live holder, the run
# skips the removal and a later run does it. A failed removal is not an error
# of the sync. The cache of the old Mac task stays: its entry task handles it.
_se_legacy_cleanup() {
  local base=${XDG_CACHE_HOME:-$HOME/.cache}
  local old=$base/bootstrap
  local old_lock=$base/bootstrap.lock
  local had_old=''
  [[ -e ${old} || -e ${old_lock} ]] || return 0
  if ! mkdir -- "${old_lock}" 2> /dev/null; then
    _se_stale_lock "${old_lock}" || true
    mkdir -- "${old_lock}" 2> /dev/null || return 0
  fi
  _SE_OLD_HELD=${old_lock}
  if [[ -e ${old} ]]; then
    had_old=1
  fi
  rm -rf -- "${old}" 2> /dev/null || true
  rm -rf -- "${old_lock}" 2> /dev/null || true
  _SE_OLD_HELD=''
  if [[ -n ${had_old} && ! -e ${old} ]]; then
    _se_say info "Removed the old cache ${old}"
  fi
  return 0
}

# Brings the clone to the newest commit of the branch: cloned when missing or
# empty, refreshed when its origin is the URL, cloned again when it has another
# origin. A folder that is not a clone is never deleted. The raw config value,
# because `git remote get-url` expands `insteadOf`. A caller often runs this
# function in an `||` list, where `set -e` does not apply, so each step that
# can fail is examined here. Returns 2 for a folder that is not a clone and 5
# when git fails.
_se_fetch() {
  local entry origin clone=''
  unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE

  # A clone of the URL at the cache root is the old layout. Any other repository
  # there stays: SYNC_ENGINE_CACHE can name a checkout of another project. The
  # config file itself, so no other repository's config answers: a `.git` file
  # (a worktree, a submodule) has none, and it stops here too.
  if [[ -e ${_SE_CACHE}/.git ]]; then
    origin=$(git config --file "${_SE_CACHE}/.git/config" --get remote.origin.url 2> /dev/null) || origin=''
    if [[ -z ${origin} || $(_se_normalize_url "${origin}") != "$(_se_normalize_url "${_SE_URL}")" ]]; then
      _se_say error "${_SE_CACHE} is a git repository with the origin '${origin}', not an old clone of ${_SE_URL} - move it, or set SYNC_ENGINE_CACHE to another folder"
      return 2
    fi
    for entry in "${_SE_CACHE}"/* "${_SE_CACHE}"/.[!.]* "${_SE_CACHE}"/..?*; do
      [[ -e ${entry} || -L ${entry} ]] || continue
      case ${entry##*/} in
        repo | lock | lock.takeover | macos-generated.tsv)
          continue
          ;;
      esac
      rm -rf -- "${entry}"
    done
    _se_say info "Removed an old clone at ${_SE_CACHE}"
  fi

  if [[ ! -e ${_SE_REPO} ]] || { [[ -d ${_SE_REPO} && ! -L ${_SE_REPO} ]] && [[ -z $(ls -A -- "${_SE_REPO}") ]]; }; then
    clone=1
  elif [[ -d ${_SE_REPO} && -e ${_SE_REPO}/.git ]]; then
    origin=$(git -C "${_SE_REPO}" config --get remote.origin.url 2> /dev/null) || origin=''
    if [[ -n ${origin} && $(_se_normalize_url "${origin}") == "$(_se_normalize_url "${_SE_URL}")" ]]; then
      _se_say info "Updating the clone in ${_SE_REPO}"
      # From the URL, not from origin: the compare drops the scheme, and the
      # transport must not come from the cached origin.
      if ! _se_git_remote -C "${_SE_REPO}" fetch --quiet --depth 1 -- "${_SE_URL}" "${_SE_BRANCH}"; then
        _se_say error "Cannot fetch ${_SE_URL} - nothing synced"
        return 5
      fi
      if ! git -C "${_SE_REPO}" reset --quiet --hard FETCH_HEAD || ! git -C "${_SE_REPO}" clean --quiet -ffdx; then
        _se_say error "Cannot update the clone in ${_SE_REPO} - nothing synced"
        return 5
      fi
    else
      _se_say info "The clone in ${_SE_REPO} has the origin '${origin}', not ${_SE_URL} - cloning again"
      clone=1
    fi
  else
    _se_say error "${_SE_REPO} is not a git clone and not empty - move it, or set SYNC_ENGINE_CACHE to another folder"
    return 2
  fi

  [[ -n ${clone} ]] || return 0
  _se_say info "Cloning into ${_SE_REPO}"
  rm -rf -- "${_SE_REPO}"
  mkdir -p -- "${_SE_REPO%/*}"
  if ! _se_git_remote clone --quiet --depth 1 --single-branch --branch "${_SE_BRANCH}" -- "${_SE_URL}" "${_SE_REPO}"; then
    rm -rf -- "${_SE_REPO}"
    _se_say error "Cannot clone ${_SE_URL} - nothing synced"
    return 5
  fi
}

# _se_copy <prefix>: copies the clone to a new temporary folder, so the sync
# reads only its own copy and the next run can update the cache.
_se_copy() {
  local prefix=$1
  _SE_COPY=$(mktemp -d "${TMPDIR:-/tmp}/${prefix}.XXXXXX") || {
    _SE_COPY=''
    return 1
  }
  cp -R -- "${_SE_REPO}/." "${_SE_COPY}" || return 1
}

# For the EXIT trap of the caller: releases a held lock and a held old lock,
# and removes the copy.
_se_clone_cleanup() {
  _se_unlock
  if [[ -n ${_SE_OLD_HELD} ]]; then
    rm -rf -- "${_SE_OLD_HELD}"
    _SE_OLD_HELD=''
  fi
  if [[ -n ${_SE_COPY} ]]; then
    rm -rf -- "${_SE_COPY}"
  fi
  return 0
}

_se_clone_init
trap _se_clone_cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

print_header "Fetching bootstrap ..."
_se_lock
_se_legacy_cleanup
rc=0
_se_fetch || rc=$?
((rc == 0)) || exit "${rc}"
_se_copy bootstrap || exit 1
_se_unlock

# Unquoted on purpose: empty adds no argument.
[[ "${usage_dry_run:-false}" == "true" ]] && DRY_RUN="--dry-run" || DRY_RUN=""
if [[ "${usage_verbose:-false}" == "true" ]]; then
  export SYNC_ENGINE_VERBOSE=1
fi

# The engine: SYNC_ENGINE_BIN, a local build, else the release that
# sync-engine/VERSION of the copy names. VERSION has one line, MAJOR.MINOR.PATCH.
if [[ -n ${SYNC_ENGINE_BIN:-} ]]; then
  if [[ ! -f ${SYNC_ENGINE_BIN} || ! -x ${SYNC_ENGINE_BIN} ]]; then
    print_error "SYNC_ENGINE_BIN ${SYNC_ENGINE_BIN} is not an executable file - nothing synced"
    exit 2
  fi
  engine=("${SYNC_ENGINE_BIN}")
else
  version=''
  IFS= read -r version 2> /dev/null < "${_SE_COPY}/sync-engine/VERSION" || true
  if [[ ! ${version} =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    print_error "sync-engine/VERSION of the clone is not MAJOR.MINOR.PATCH ('${version}') - nothing synced"
    exit 5
  fi
  if ! mise install "github:virajp/bootstrap@${version}"; then
    print_error "cannot install the sync engine ${version} (github:virajp/bootstrap) - nothing synced"
    exit 5
  fi
  engine=(mise x "github:virajp/bootstrap@${version}" -- sync-engine)
fi

# sync_repo <folder>: run the engine in the folder of a repository, with that
# folder as MISE_PROJECT_ROOT, as mise runs a task. The first failure stops the
# task with its code.
sync_repo() {
  local rc=0
  print_header "Syncing the shared files from bootstrap ..."
  # The tools come from the pack base and from the [tools.*] and [packs.*]
  # tables of .config/bootstrap.toml.
  # shellcheck disable=SC2086
  (cd -- "$1" && MISE_PROJECT_ROOT=$1 SYNC_ENGINE_CLONE="${_SE_COPY}" "${engine[@]}" repo ${DRY_RUN}) || rc=$?
  ((rc == 0)) || exit "${rc}"
}

sync_repo "${MISE_PROJECT_ROOT}"
