#!/usr/bin/env bash
# Synced from bootstrap: tools/repo-sync/.config/mise/tasks/setup/configs/sync. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

#MISE description="Sync the shared files from the bootstrap clone of setup:configs"
#MISE hide=true
#MISE tools.pre-commit="latest"
#MISE tools.gomplate="latest"

#USAGE flag "--dry-run" help="show the changes without writing them"

set -euo pipefail
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# `setup:configs` passes its clone. The sync code then comes from the commit
# that it syncs, so a change to that code applies in the same run. Without a
# clone, the local copy runs and clones by itself.
lib="${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/repo-sync"
if [[ -n ${REPO_SYNC_CLONE:-} ]]; then
  lib="${REPO_SYNC_CLONE}/tools/repo-sync/.config/mise/tasks/_scripts/repo-sync"
fi
# shellcheck source=/dev/null
source "${lib}"

print_header "Syncing the shared files from bootstrap ..."

# The tools come from the pack base and from the [tools.*] and [packs.*]
# tables of .config/bootstrap.toml.
if [[ "${usage_dry_run:-false}" == "true" ]]; then
  repo_sync --dry-run
else
  repo_sync
fi
