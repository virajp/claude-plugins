#!/usr/bin/env bash
# Synced from bootstrap: repo/tools/repo-sync/.config/mise/tasks/setup/configs/sync. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

#MISE description="Sync the shared files from the bootstrap clone of setup:configs"
#MISE hide=true
#MISE tools.pre-commit="latest"

#USAGE flag "--dry-run" help="show the changes without writing them"

set -euo pipefail
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# `setup:configs` passes its clone. The sync code comes from the commit that it
# syncs, so a change to that code applies in the same run. A consumer has no
# local copy of the sync code, so without a clone this task stops.
if [[ -z ${SYNC_ENGINE_CLONE:-} ]]; then
  print_error "SYNC_ENGINE_CLONE is not set - run mise run setup:configs, which clones bootstrap"
  exit 2
fi
# shellcheck source=/dev/null
source "${SYNC_ENGINE_CLONE}/sync-engine/repo-sync"

print_header "Syncing the shared files from bootstrap ..."

# The tools come from the pack base and from the [tools.*] and [packs.*]
# tables of .config/bootstrap.toml.
if [[ "${usage_dry_run:-false}" == "true" ]]; then
  repo_sync --dry-run
else
  repo_sync
fi
