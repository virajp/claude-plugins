#!/usr/bin/env bash
# Synced from bootstrap: repo/tools/claude/tasks/setup-ai. Do not edit this file.
# The next sync writes it again, and each change in this file is lost.

#MISE description="Install the Claude Code plugins of the repository, and uninstall the project plugins that left its list"
#MISE hide=true
#USAGE flag "--upgrade" help="also update the marketplaces and the listed plugins"

set -euo pipefail
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# A git submodule shares the Claude Code setup of its root repository: the
# task does not apply there.
SUPERPROJECT=$(git -C "${MISE_PROJECT_ROOT}" rev-parse --show-superproject-working-tree 2> /dev/null) || SUPERPROJECT=''
[[ -z "${SUPERPROJECT}" ]] || exit 0

print_header "Setting up the Claude Code plugins ..."

if ! mise x -- which claude > /dev/null 2>&1; then
  print_warn "claude is not on PATH — skipping AI setup."
  print_yellow "Install it from https://claude.com/code, then run this task again."
  exit 0
fi
# The project scope is the working directory.
cd "${MISE_PROJECT_ROOT}"
ROOT=$(pwd -P)

# One step: `claude` writes its progress to stdout and its errors to stderr.
# The progress is discarded. On a failure, the error goes under the step, and
# the next steps still run: one failed plugin does not block the others.
FAILED=0
claude_step() {
  local label=$1 err line
  shift
  print_wait "${label} ... "
  if err=$(mise x -- claude "$@" 2>&1 > /dev/null < /dev/null); then
    print_success
  else
    print_error
    while IFS= read -r line; do
      [[ -n "${line}" ]] && print_error "  ${line}"
    done <<< "${err}"
    FAILED=1
  fi
}

# The `<plugin>|<scope>` lines of the plugins of this repository: each one at
# user scope, and each one at project scope whose project is this repository.
plugins_here() {
  local list plugin scope path
  list=$(mise x -- claude plugin list --json | mise x -- jq -r '.[] | select(.scope == "user" or .scope == "project") | "\(.id)|\(.scope)|\(.projectPath // "")"')
  while IFS='|' read -r plugin scope path; do
    [[ -n "${plugin}" ]] || continue
    if [[ "${scope}" == project ]]; then
      path=$(cd "${path}" 2> /dev/null && pwd -P) || continue
      [[ "${path}" == "${ROOT}" ]] || continue
    fi
    printf '%s|%s\n' "${plugin}" "${scope}"
  done <<< "${list}"
}

# The installed plugins, read once, before any change.
INSTALLED=$(plugins_here)

# The plugins of [tools.claude.plugins.user] and [tools.claude.plugins.project]
# in .config/bootstrap/tools.toml, with the entries that other tools contribute:
# `"<plugin>@<marketplace>" = "<source>"`, one `<plugin>|<source>` line each.
# A failed read of `bootstrap config get`, for example with no catalog of
# bootstrap, stops the task with the code of bootstrap_get.
ANSWER=$(bootstrap_get tools.claude.plugins.user) || exit $?
WANTED_USER=$(mise x -- jq -r '(.value // {}) | to_entries | .[] | .key + "|" + .value' <<< "${ANSWER}")
ANSWER=$(bootstrap_get tools.claude.plugins.project) || exit $?
WANTED_PROJECT=$(mise x -- jq -r '(.value // {}) | to_entries | .[] | .key + "|" + .value' <<< "${ANSWER}")

# The record of the project plugins that this task installed:
# `tools.claude.plugins.installed`, a list of `<plugin>@<marketplace>`. A plugin
# that is not in the record is never uninstalled.
ANSWER=$(bootstrap_get tools.claude.plugins.installed) || exit $?
RECORD_BEFORE=$(mise x -- jq -r '(.value // []) | .[]' <<< "${ANSWER}")
RECORD=''

# A recorded plugin that is no longer installed at project scope leaves the
# record.
while IFS= read -r PLUGIN; do
  [[ -n "${PLUGIN}" ]] || continue
  grep -Fqx "${PLUGIN}|project" <<< "${INSTALLED}" || continue
  RECORD+="${PLUGIN}"$'\n'
done <<< "${RECORD_BEFORE}"

record_add() {
  grep -Fqx "$1" <<< "${RECORD}" || RECORD+="$1"$'\n'
}

# Each listed plugin that is missing at its scope is installed. Its marketplace
# is added first from <source>, at the same scope, when no scope has it. Each
# listed project plugin that is installed, before or now, goes in the record.
# PRESENT gets the `<plugin>|<scope>` line of each listed plugin that is
# installed.
PRESENT=''
MARKETPLACES=$(mise x -- claude plugin marketplace list --json | mise x -- jq -r '.[].name') || MARKETPLACES=''
for SCOPE in user project; do
  if [[ "${SCOPE}" == user ]]; then WANTED=${WANTED_USER}; else WANTED=${WANTED_PROJECT}; fi
  while IFS='|' read -r PLUGIN SOURCE; do
    [[ -n "${PLUGIN}" ]] || continue
    if ! grep -Fqx "${PLUGIN}|${SCOPE}" <<< "${INSTALLED}"; then
      MARKETPLACE=${PLUGIN##*@}
      if ! grep -Fqx "${MARKETPLACE}" <<< "${MARKETPLACES}"; then
        claude_step "Adding the marketplace ${MARKETPLACE} (${SCOPE})" plugin marketplace add --scope "${SCOPE}" "${SOURCE}"
        MARKETPLACES+=$'\n'"${MARKETPLACE}"
      fi
      BEFORE=${FAILED}
      FAILED=0
      claude_step "Installing ${PLUGIN} (${SCOPE})" plugin install --scope "${SCOPE}" "${PLUGIN}"
      if ((FAILED)); then
        continue
      fi
      FAILED=${BEFORE}
    fi
    PRESENT+="${PLUGIN}|${SCOPE}"$'\n'
    if [[ "${SCOPE}" == project ]]; then
      record_add "${PLUGIN}"
    fi
  done <<< "${WANTED}"
done

# A recorded plugin that is no longer in [tools.claude.plugins.project] is
# uninstalled at project scope, with the dependencies that only it needed. A
# failed uninstall keeps it in the record, so the next run tries again.
KEPT=''
while IFS= read -r PLUGIN; do
  [[ -n "${PLUGIN}" ]] || continue
  if cut -d '|' -f 1 <<< "${WANTED_PROJECT}" | grep -Fqx "${PLUGIN}"; then
    KEPT+="${PLUGIN}"$'\n'
    continue
  fi
  BEFORE=${FAILED}
  FAILED=0
  claude_step "Uninstalling ${PLUGIN} (project)" plugin uninstall --scope project --prune -y "${PLUGIN}"
  if ((FAILED)); then
    KEPT+="${PLUGIN}"$'\n'
  fi
  ((FAILED |= BEFORE)) || true
done <<< "${RECORD}"
RECORD=${KEPT}

# With --upgrade, the marketplaces, then each listed plugin that is installed,
# at its scope. claude has no command that updates all plugins.
if [[ "${usage_upgrade:-false}" == "true" ]]; then
  claude_step "Updating the marketplaces" plugin marketplace update
  while IFS='|' read -r PLUGIN SCOPE; do
    [[ -n "${PLUGIN}" ]] || continue
    claude_step "Updating ${PLUGIN} (${SCOPE})" plugin update --scope "${SCOPE}" "${PLUGIN}"
  done <<< "${PRESENT}"
fi

# The record is written only when it changed. A failed write is a failed step:
# the next run corrects the record from the installed plugins.
if [[ "${RECORD}" != "${RECORD_BEFORE:+${RECORD_BEFORE}$'\n'}" ]]; then
  BIN=(mise x -- bootstrap)
  [[ -z "${BOOTSTRAP_BIN:-}" ]] || BIN=("${BOOTSTRAP_BIN}")
  LIST=$(printf '%s' "${RECORD}" | mise x -- jq -Rnc '[inputs | select(length > 0)]')
  print_wait "Recording the project plugins of setup:ai ... "
  if ERR=$("${BIN[@]}" config set tools.claude.plugins.installed "${LIST}" 2>&1 > /dev/null < /dev/null); then
    print_success
  else
    print_error
    while IFS= read -r LINE; do
      [[ -n "${LINE}" ]] && print_error "  ${LINE}"
    done <<< "${ERR}"
    FAILED=1
  fi
fi

if ((FAILED)); then
  print_error "Some Claude Code steps failed. The errors are above."
  exit 1
fi
