#!/usr/bin/env bash
# Synced from bootstrap: tools/claude/.config/mise/tasks/setup/ai. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

#MISE description="Install the Claude Code plugins of the repository, then update the marketplaces and plugins"
#MISE hide=true

set -euo pipefail
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# A git submodule shares the Claude Code setup of its root repository: the
# task does not apply there.
SUPERPROJECT=$(git -C "${MISE_PROJECT_ROOT}" rev-parse --show-superproject-working-tree 2> /dev/null) || SUPERPROJECT=''
[[ -z "${SUPERPROJECT}" ]] || exit 0

print_header "Installing and updating the Claude Code plugins ..."

if ! mise x -- which claude > /dev/null 2>&1; then
  print_warn "claude is not on PATH — skipping AI setup."
  print_yellow "Install it from https://claude.com/code, then run this task again."
  exit 0
fi
# The project scope is the working directory.
cd "${MISE_PROJECT_ROOT}"
ROOT=$(pwd -P)

# One step: `claude` writes its progress to stdout and its errors to stderr.
# The progress is discarded. On a failure, the error goes under the step, and
# the next steps still run: one failed plugin does not block the others.
FAILED=0
claude_step() {
  local label=$1 err line
  shift
  print_wait "${label} ... "
  if err=$(mise x -- claude "$@" 2>&1 > /dev/null < /dev/null); then
    print_success
  else
    print_error
    while IFS= read -r line; do
      [[ -n "${line}" ]] && print_error "  ${line}"
    done <<< "${err}"
    FAILED=1
  fi
}

# The `<plugin>|<scope>` lines of the plugins of this repository: each one at
# user scope, and each one at project scope whose project is this repository.
plugins_here() {
  local list plugin scope path
  list=$(mise x -- claude plugin list --json | mise x -- jq -r '.[] | select(.scope == "user" or .scope == "project") | "\(.id)|\(.scope)|\(.projectPath // "")"')
  while IFS='|' read -r plugin scope path; do
    [[ -n "${plugin}" ]] || continue
    if [[ "${scope}" == project ]]; then
      path=$(cd "${path}" 2> /dev/null && pwd -P) || continue
      [[ "${path}" == "${ROOT}" ]] || continue
    fi
    printf '%s|%s\n' "${plugin}" "${scope}"
  done <<< "${list}"
}

INSTALLED=$(plugins_here)

# The vwf workflow plugin, at user scope from its installer, when this
# repository does not have it at any scope.
if ! grep -Eq '^vwf@virajp-plugins\|' <<< "${INSTALLED}"; then
  if mise x -- which pnpx > /dev/null 2>&1; then
    print_wait "Installing vwf@virajp-plugins (user) ... "
    if ERR=$(mise x -- pnpx @virajp.dev/claude-plugins@latest --all 2>&1 > /dev/null < /dev/null); then
      print_success
    else
      print_error
      print_error "  ${ERR}"
      FAILED=1
    fi
  else
    print_warn "vwf@virajp-plugins is not installed, and pnpx is not available. Run: pnpx @virajp.dev/claude-plugins@latest --all"
  fi
fi

# The plugins of [claude.plugins.user] and [claude.plugins.project] in
# .config/bootstrap.toml: `"<plugin>@<marketplace>" = "<source>"`. The task
# installs each one that is missing at its scope. It first adds the
# marketplace from <source> at the same scope, when no scope has it.
VALUES=.config/bootstrap.toml
if [[ -f "${VALUES}" ]]; then
  MARKETPLACES=$(mise x -- claude plugin marketplace list --json | mise x -- jq -r '.[].name') || MARKETPLACES=''
  for SCOPE in user project; do
    WANTED=$(mise x -- yq -p toml -o yaml ".claude.plugins.${SCOPE} // {} | to_entries | .[] | .key + \"|\" + .value" "${VALUES}")
    while IFS='|' read -r PLUGIN SOURCE; do
      [[ -n "${PLUGIN}" ]] || continue
      grep -Fqx "${PLUGIN}|${SCOPE}" <<< "${INSTALLED}" && continue
      MARKETPLACE=${PLUGIN##*@}
      if ! grep -Fqx "${MARKETPLACE}" <<< "${MARKETPLACES}"; then
        claude_step "Adding the marketplace ${MARKETPLACE} (${SCOPE})" plugin marketplace add --scope "${SCOPE}" "${SOURCE}"
        MARKETPLACES+=$'\n'"${MARKETPLACE}"
      fi
      claude_step "Installing ${PLUGIN} (${SCOPE})" plugin install --scope "${SCOPE}" "${PLUGIN}"
    done <<< "${WANTED}"
  done
fi

claude_step "Updating the marketplaces" plugin marketplace update

# claude has no command that updates all plugins, so each plugin of this
# repository gets its own update.
while IFS='|' read -r PLUGIN SCOPE; do
  [[ -n "${PLUGIN}" ]] || continue
  claude_step "Updating ${PLUGIN} (${SCOPE})" plugin update --scope "${SCOPE}" "${PLUGIN}"
done <<< "$(plugins_here)"

claude_step "Removing the plugins that nothing references" plugin autoremove --scope project --yes

if ((FAILED)); then
  print_error "Some Claude Code steps failed. The errors are above."
  exit 1
fi
