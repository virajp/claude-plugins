#!/usr/bin/env bash
# Synced from bootstrap: tools/pre-commit/.config/mise/tasks/setup/precommit. Do not edit this file.
# The next sync replaces it, and a manual change is lost.
#MISE description="Install pre-commit hooks; --upgrade also updates them"
#MISE hide=true
#MISE tools.pre-commit="latest"

#USAGE flag "--upgrade" help="also update the hook revisions"

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

print_header "Setting up pre-commit hooks ..."

if [[ "${usage_upgrade:-false}" == "true" ]]; then
  print_subheader "Updating pre-commit hooks ..."
  pre-commit autoupdate --config .config/pre-commit-config.yaml
fi

print_subheader "Installing pre-commit ..."
git config --local --unset-all core.hooksPath || true
pre-commit install --config .config/pre-commit-config.yaml --all --install-hooks --overwrite
