#!/usr/bin/env bash
# Synced from bootstrap: tools/mise/.config/mise/tasks/setup/mise. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

#MISE description="Setup MISE: reshim, doctor, install; --upgrade also upgrades"
#MISE hide=true

#USAGE flag "--upgrade" help="also upgrade the installed tools"

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

print_header "Setting up MISE ..."

# Reshim mise to ensure all tools are available
print_subheader "Reshimming mise ..."
mise reshim

# Run mise doctor
print_subheader "Running mise doctor ..."
mise doctor --quiet --silent > /dev/null

# Install mise tools, and upgrade them only on request
print_subheader "Installing mise tools ..."
mise install --yes --jobs 10
if [[ "${usage_upgrade:-false}" == "true" ]]; then
  print_subheader "Upgrading mise tools ..."
  mise upgrade --yes --jobs 10 --local
fi
