#!/usr/bin/env bash

#MISE description="Setup MISE: reshim, doctor, install & upgrade"
#MISE hide=false

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# Reshim mise to ensure all tools are available
print_header "Reshimming mise ..."
mise reshim

# Run mise doctor
print_header "Running mise doctor ..."
mise doctor --quiet --silent >/dev/null

# Install & upgrade mise
print_header "Setting up MISE ..."
mise install

print_header "Upgrading mise tools ..."
mise upgrade --local || true

# Refresh the lock files for every platform `lockfile_platforms` names, in both
# environments — CI installs with `--locked` and fails on a tool whose entry has
# no linux-x64 URL. The ci pass also rewrites mise.lock; that is idempotent.
print_header "Locking tool URLs ..."
mise lock
MISE_ENV=ci mise lock
