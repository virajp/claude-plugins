#!/usr/bin/env bash

#MISE description="Set up mise: reshim, doctor, install tools from the lockfile; --upgrade (dev only) bumps the lockfile first"
#MISE hide=true

#USAGE flag "--upgrade" help="Dev only: bump the lockfile for every environment with mise lock --bump and update the formatter plugins with dprint config update"
#USAGE flag "--lock-only" help="Write a missing lockfile, or add missing tools to a present one without bumping any locked version, installing only the uv and Python it locks with, then exit without reshimming, installing the rest or running doctor"

set -euo pipefail
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

UPGRADE="${usage_upgrade:-false}"
LOCK_ONLY="${usage_lock_only:-false}"

if [ "$LOCK_ONLY" = "true" ] && [ "$UPGRADE" = "true" ]; then
  print_error "--lock-only and --upgrade cannot be combined: --lock-only never moves an existing lockfile."
  exit 1
fi

IS_DEV=false
[[ ",${MISE_ENV:-}," == *",dev,"* ]] && IS_DEV=true

# An upgrade moves the committed lockfiles, which is a developer's decision made
# on a developer's machine — never the pipeline's, and never a deployed
# runtime's. Refused before anything runs, so a wrong environment changes
# nothing.
if [ "$UPGRADE" = "true" ] && [ "$IS_DEV" = "false" ]; then
  print_error "--upgrade runs only in dev: MISE_ENV is '${MISE_ENV:-}', which does not include dev."
  exit 1
fi

CONFIG_DIR="${MISE_PROJECT_ROOT}/.config"
LOCKFILE="${CONFIG_DIR}/mise/mise.lock"

# A lockfile is written in exactly two cases: none exists yet on a developer's
# machine, or the user asked for `--upgrade`. Outside dev a missing lockfile is
# an error, never a prompt to re-resolve "latest": the pipeline installs what a
# developer committed, or nothing. Refused before anything runs.
NO_LOCKFILE=false
if [ ! -f "$LOCKFILE" ]; then
  NO_LOCKFILE=true
  if [ "$IS_DEV" = "false" ]; then
    print_error "No lockfile at .config/mise/mise.lock: MISE_ENV is '${MISE_ENV:-}', which does not include dev. Run setup in dev to create it, and commit it."
    exit 1
  fi
fi

# The one lock holds every environment's tools, so it is written with every
# environment active at once; a single-environment `mise lock` drops the rest.
# The list is alphabetical though mise merges last-wins: order is moot only because a tool is pinned in one file.
lock_envs() {
  {
    find "$CONFIG_DIR" -maxdepth 1 -name 'mise.*.toml' ! -name '*.local.toml'
    find "$CONFIG_DIR/mise/conf.d" -maxdepth 1 -name '*.*.toml' ! -name '*.local.toml' 2>/dev/null || true
  } | while read -r file; do
    name="${file##*/}"
    name="${name%.toml}"
    echo "${name##*.}"
  done | sort -u | paste -sd, -
}
LOCK_ENVS="$(lock_envs)"

have_task() { mise tasks 2>/dev/null | awk 'NR>1 {print $1}' | grep -qx "$1"; }

SIDECARS="${CONFIG_DIR}/mise/locks"
list_sidecars() { { find "$SIDECARS" -mindepth 2 -maxdepth 2 2>/dev/null || true; } | sort; }

# EXIT trap while the lock is written: any failure restores or removes the lock and removes only the sidecars this run created.
undo_failed_lock() {
  local dir
  if [ -n "$LOCK_BACKUP" ]; then
    cp "$LOCK_BACKUP" "$LOCKFILE"
    rm -f "$LOCK_BACKUP"
  else
    rm -f "$LOCKFILE"
  fi
  comm -13 <(printf '%s\n' "$SIDECARS_BEFORE") <(list_sidecars) | while read -r dir; do
    [ -n "$dir" ] || continue
    rm -rf "$dir"
    rmdir "${dir%/*}" 2>/dev/null || true
  done
  [ -e "$SIDECARS" ] && [ "$HAD_SIDECARS" = "false" ] && { rmdir "$SIDECARS" 2>/dev/null || true; }
  print_error "Locking failed — the lockfile was put back as it was and the sidecars this run wrote were removed, so the next run locks again."
}

# One `mise lock` over every environment, never --bump: a missing lock is written, a present one only gains missing tools.
write_lock() {
  if [ "$NO_LOCKFILE" = "true" ]; then
    print_subheader "No lockfile at .config/mise/mise.lock — locking MISE_ENV=${LOCK_ENVS} once ..."
  else
    print_subheader "Adding missing tools to .config/mise/mise.lock for MISE_ENV=${LOCK_ENVS}, keeping every locked version ..."
  fi
  local tool uv_python=""
  LOCK_BACKUP=""
  if [ "$NO_LOCKFILE" = "false" ]; then
    LOCK_BACKUP="$(mktemp)"
    cp "$LOCKFILE" "$LOCK_BACKUP"
  fi
  HAD_SIDECARS=false
  [ -e "$SIDECARS" ] && HAD_SIDECARS=true
  SIDECARS_BEFORE="$(list_sidecars)"
  trap undo_failed_lock EXIT
  # Python dependency locks need the pinned uv and Python, not PATH's; unlocked, as ci's `locked = true` is in the union and the lock may lack them.
  for tool in uv python; do
    # --local: declared by this repo's config, never the user's global one.
    if [ -n "$(MISE_LOCKED=false MISE_ENV="$LOCK_ENVS" mise ls --current --local "$tool" 2>/dev/null)" ]; then
      MISE_LOCKED=false MISE_ENV="$LOCK_ENVS" mise install "$tool"
      # Named outright: on a first lock uv does not find the just-installed Python on its search path.
      [ "$tool" = "python" ] && uv_python="$(MISE_LOCKED=false MISE_ENV="$LOCK_ENVS" mise which python)"
    fi
  done
  # A subshell scopes UV_PYTHON to the lock, and leaves it unset when no Python is pinned.
  (
    [ -n "$uv_python" ] && export UV_PYTHON="$uv_python"
    MISE_ENV="$LOCK_ENVS" mise lock
  )
  trap - EXIT
  [ -z "$LOCK_BACKUP" ] || rm -f "$LOCK_BACKUP"
}

# --lock-only: the lock step alone, filling a present lock too, so a caller can commit it without installing the toolchain.
if [ "$LOCK_ONLY" = "true" ]; then
  write_lock
  exit 0
fi

print_subheader "Reshimming mise ..."
mise reshim

if [ "$NO_LOCKFILE" = "true" ]; then
  write_lock
fi

# `--upgrade` on `mise lock` is the lockfile FORMAT upgrade — harmless when the
# format is already current.
if [ "$UPGRADE" = "true" ]; then
  print_subheader "Bumping the lockfile for MISE_ENV=${LOCK_ENVS} ..."
  MISE_ENV="$LOCK_ENVS" mise lock --bump --upgrade
fi

print_subheader "Installing mise tools from the lockfile ..."
mise install --locked

# After the install: with `task.run_auto_install = false` nothing is installed before this task.
print_subheader "Running mise doctor ..."
mise doctor --quiet --silent >/dev/null

# Everything below rewrites a pinned version the shape lock records — the
# plugin URLs in `dprint.json` — so it is an upgrade the user asks for with
# `--upgrade`, never a side effect of setting a machine up.
if [ "$UPGRADE" = "true" ]; then
  # The two tools that keep their own plugin or rule set outside mise's
  # lockfile, so `mise lock --bump` does not reach them. Both are probed rather
  # than assumed: the formatter's config is landed by stackgen:tool-config, and
  # the linter arrives as an optional `setup:lint` a linter pack fills.
  # Whether this run has a terminal a command can prompt ON — which is not the
  # same question as `[ -t 0 ]`. A tool that asks for confirmation opens
  # `/dev/tty` directly rather than reading stdin, so it works with stdin piped
  # and output captured, and fails only when the process has no controlling
  # terminal at all: a CI runner, a daemon, an agent's shell.
  can_prompt() { (exec 3<>/dev/tty) >/dev/null 2>&1; }

  if [ -f "${MISE_PROJECT_ROOT}/.config/dprint.json" ] && command -v dprint >/dev/null 2>&1; then
    # `dprint config update` prompts before moving a PROCESS plugin, because
    # accepting one means accepting a new checksum for a binary it will execute.
    # It reads that answer from the terminal, so piping `N` does not reach it and
    # the whole task dies with "Device not configured (os error 6)" wherever
    # there is none. Skipped rather than forced with `-y`: the prompt is a
    # supply-chain decision, and a runner is not who should be answering it.
    if can_prompt; then
      print_subheader "Updating formatter plugins ..."
      dprint config update --config "${MISE_PROJECT_ROOT}/.config/dprint.json"
    else
      print_subheader "Skipping formatter plugin updates ..."
      print_warn "No terminal to prompt on — formatter plugins were left as pinned."
      print_yellow "Run this in a terminal to update them:"
      print_yellow "  dprint config update --config .config/dprint.json"
    fi
  fi
else
  print_yellow "Tools installed from the lockfile — pass --upgrade (dev only) to bump the lockfile and update the formatter plugins."
fi

if have_task setup:lint; then
  print_subheader "Initialising the linter ..."
  mise run setup:lint
fi
