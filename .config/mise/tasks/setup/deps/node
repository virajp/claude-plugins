#!/usr/bin/env bash
# Synced from bootstrap: tools/node/.config/mise/tasks/setup/deps/node. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

#MISE description="Install the Node dependencies, then report the outdated and vulnerable ones; --upgrade upgrades them"
#MISE hide=true

#USAGE flag "--upgrade" help="upgrade the dependencies to the latest versions in their package.json ranges instead of installing from the lockfile"

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# Shipped with the node tool. Without a package.json, this is not a Node
# project, so the task does not apply and prints nothing.
[[ -f "${MISE_PROJECT_ROOT}/package.json" ]] || exit 0

# mise installs pnpm itself, so the task never runs `pnpm self-update`. An
# upgrade stays inside the ranges of each package.json, and `--no-save` keeps
# the ranges as they are: only the lockfile changes. To keep a package at its
# locked version, list it in `update.ignoreDeps` of pnpm-workspace.yaml.
if [[ "${usage_upgrade:-false}" == "true" ]]; then
  print_header "Upgrading Node dependencies ..."
  mise x -- pnpm update --dir "${MISE_PROJECT_ROOT}" --recursive --no-save
else
  print_header "Installing Node dependencies ..."
  # The lockfile decides the versions; an install never changes it.
  mise x -- pnpm install --dir "${MISE_PROJECT_ROOT}" --frozen-lockfile
fi

print_subheader "Checking for outdated Node dependencies ..."
# A report only: `pnpm outdated` exits 1 when a dependency is outdated.
mise x -- pnpm outdated --dir "${MISE_PROJECT_ROOT}" --recursive --long || true

print_subheader "Auditing Node dependencies for known vulnerabilities ..."
# Exits 1 for a vulnerability at or above `audit.level` of pnpm-workspace.yaml,
# and that stops the setup.
mise x -- pnpm audit --dir "${MISE_PROJECT_ROOT}"
