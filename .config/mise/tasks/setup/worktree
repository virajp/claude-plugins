#!/usr/bin/env bash
# Synced from bootstrap: tools/mise/.config/mise/tasks/setup/worktree.tmpl. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

#MISE description="Initialise a fresh git worktree: checkout submodules, copy local files, install tools, secrets and deps (lighter than setup)"
#MISE hide=false

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/checks"

# The same install steps as `setup`, without --upgrade and without the steps
# that configure the machine rather than the checkout: the linter init and
# `setup:ai`. The hooks stay: the root shares the main checkout's hooks, but a
# submodule checked out in a linked worktree gets a new git directory under
# `.git/worktrees/<name>/modules/`, with no hooks in it.

print_header "Checking out submodules ..."
git -C "${MISE_PROJECT_ROOT}" submodule update --init --recursive

mise run setup:mise

for task in $(own_tasks setup:secrets); do
  mise run "${task}"
done

for task in $(own_tasks setup:deps); do
  mise run "${task}"
done

if has_own_task setup:precommit; then
  mise run setup:precommit
fi

line_sep1
print_success "Worktree ready!"
