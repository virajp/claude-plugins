#!/usr/bin/env bash
# Synced from bootstrap: tools/git/.config/mise/tasks/_scripts/merge. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

#MISE description="The merge both code:merge:* tasks run"
#MISE hide=true

# One function, three entrypoints. `code/merge/develop`, `code/merge/main` and
# `code/merge/_default` differ only in the branches they name, and keeping the
# sequence here is what stops them drifting into different merges.
#
# **The branch model follows from the branches that exist** (`branch_exists` in
# `checks`):
#
#   - `main` and `develop`: work is authored on feature branches, integrated on
#     `develop`, and reaches `main` only by merge. The tasks are
#     `code:merge:develop` and `code:merge:main`.
#   - only one of them: any feature branch merges into that branch. The task is
#     `code:merge`.
#
# `repo_sync` writes the tasks of the model it detects, and removes the others.
#
# **The merge config is in the values file.** Each repository reads the table
# `[branch.<destination>]` of its own `.config/bootstrap.toml`, also the root
# of a repository with submodules and each submodule. The table has `merge_model`, and one of `merge_from` (the
# only branches that can merge in) and `merge_never` (the branches that never
# merge in). Without both lists, the defaults are the branch model: into `main`
# with `develop`, only from `develop`; into any other destination, never from
# `main`. A feature branch that skipped `develop` has not been through the
# branch the pipeline builds, and `main` is where nothing is authored.
#
# It merges `--no-ff` on purpose. A fast-forward would leave `main` and
# `develop` as the same commit with no record that a merge happened, and the
# merge commit is what makes "what shipped" a question git can answer.
#
# **The merge model chooses HOW the source reaches the destination, never
# WHETHER.** Each destination has its own `merge_model`. The branch rules above
# hold under both values, and every predicate below runs under both:
#
#   direct  the default: merge locally and push the destination. A solo repo, or
#           one whose review happens before the branch lands.
#   pr      push the branch and open a pull request against the destination.
#           Nothing merges locally; the forge is what merges.
#
# The choice is the repo's, and this file names no forge until it has to open
# a request.

set -euo pipefail
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/checks"

# The gate every merge passes before it touches a branch: run the hooks over the
# WHOLE tree and fail if any of them rewrote a file.
#
# This is a safety net, not the working gate. `code:precommit` is what a human
# runs before staging, so fixups land inside the commit that caused them; by the
# time a merge runs, a hook that still has something to say means a commit went
# in without one. Refusing here — rather than committing the fixup, or amending
# it onto someone else's commit — leaves the repair on the branch where it
# belongs and names the files that need it.
precommit_safety_net() {
  local config="${MISE_PROJECT_ROOT}/.config/pre-commit-config.yaml"

  if [ ! -f "${config}" ]; then
    print_warn "No .config/pre-commit-config.yaml — skipping the hook safety net."
    return 0
  fi
  if ! command -v pre-commit > /dev/null 2>&1; then
    print_warn "pre-commit is not on PATH — skipping the hook safety net."
    print_yellow "Run \`mise run setup\` to install the dev toolchain."
    return 0
  fi

  print_wait "Running the hooks over every file ... "
  local hooks_passed=true
  # no-commit-to-branch guards a commit, and the safety net makes none. It is
  # skipped here because `code:merge:main` runs from `develop`, which the hook
  # can protect. A SKIP that the caller set is kept.
  if ! SKIP="${SKIP:+${SKIP},}no-commit-to-branch" pre-commit run --config "${config}" --all-files > /dev/null 2>&1; then
    hooks_passed=false
  fi

  # A non-zero exit means one of two different things — a hook failed outright,
  # or a formatting hook rewrote a file and reported the rewrite as a failure —
  # and the status cannot tell them apart. The working tree can: the checks
  # above already refused a dirty tree, so anything dirty NOW was written by a
  # hook just then. That case is the common one and gets the file list, so the
  # answer to "what do I do about this" is on screen. Edits inside a submodule
  # are skipped for the reason `has_uncommitted_changes` gives.
  local dirty
  dirty="$(git status --porcelain --ignore-submodules=dirty)"
  if [ -n "${dirty}" ]; then
    print_error
    print_error "- The hooks rewrote files, so this branch was committed without them:"
    while IFS= read -r line; do
      [ -n "${line}" ] && print_warn "  ${line}"
    done <<< "${dirty}"
    print_error "- Commit the fixes on this branch, then merge again."
    exit 1
  fi

  if [ "${hooks_passed}" = false ]; then
    print_error
    print_error "- A hook failed without changing anything, so it needs a fix by hand."
    print_error "- Run \`mise run code:precommit\` to see it."
    exit 1
  fi
  print_success
}

# The `pr` half of the merge model: publish the branch and let the forge merge it.
#
# Nothing is checked out and no branch is merged, so the main-worktree hop the
# direct path needs does not apply here — the one thing this changes locally is
# the source branch's upstream.
open_pull_request() {
  local DESTINATION_BRANCH="$1"
  local SOURCE_BRANCH="$2"

  print_wait "Pushing ${SOURCE_BRANCH} to origin ... "
  if ! git push --follow-tags -u origin "${SOURCE_BRANCH}" > /dev/null 2>&1; then
    print_error
    print_error "FAILED to push '${SOURCE_BRANCH}' to origin!"
    exit 1
  fi
  print_success

  # `gh` is tried first when both are installed. Two forge CLIs on one machine is
  # far more often a GitHub repo on a laptop that still has glab than the
  # reverse, and the request has to be opened against ONE forge.
  if mise x -- which gh > /dev/null 2>&1; then
    print_yellow "Opening a pull request into ${DESTINATION_BRANCH} ..."
    mise x -- gh pr create --base "${DESTINATION_BRANCH}" --head "${SOURCE_BRANCH}" --fill
  elif mise x -- which glab > /dev/null 2>&1; then
    print_yellow "Opening a merge request into ${DESTINATION_BRANCH} ..."
    mise x -- glab mr create --target-branch "${DESTINATION_BRANCH}" --source-branch "${SOURCE_BRANCH}" --fill
  else
    # Not a failure. The branch is pushed, which was the part that needed a
    # shell; opening the request is a click, and no forge CLI on PATH is the
    # normal state of a machine whose forge has neither.
    print_warn "No forge CLI on PATH — the branch is pushed, no request was opened."
    print_yellow "  branch:      ${SOURCE_BRANCH}"
    print_yellow "  destination: ${DESTINATION_BRANCH}"
    print_yellow "Open the pull request on your forge."
  fi

  print_newline
  print_success "Branch pushed — the merge happens on the forge."
}

# read_merge_config <destination>
#
# Sets MERGE_MODE (`direct` or `pr`), and MERGE_FROM and MERGE_NEVER (branch
# names, one on each line) from `[branch.<destination>]` of
# `.config/bootstrap.toml`. Without the file, the table or a key, the defaults
# of the branch model apply. Stops when the table sets both lists, or when yq
# cannot read the file.
read_merge_config() {
  local DESTINATION_BRANCH="$1"
  local FILE="${MISE_PROJECT_ROOT}/.config/bootstrap.toml"
  local HAS_FROM=false HAS_NEVER=false
  MERGE_MODE=''
  MERGE_FROM=''
  MERGE_NEVER=''

  # yq reads the table by name through strenv, so a branch name with "-" or
  # "/" is one key. A failed read stops the merge: a branch rule that cannot
  # be read must not become "any branch".
  merge_yq() {
    B="${DESTINATION_BRANCH}" yq -p toml -o yaml "$1" "${FILE}"
  }
  if [ -f "${FILE}" ]; then
    if ! MERGE_MODE=$(merge_yq '.branch[strenv(B)].merge_model // ""') ||
      ! HAS_FROM=$(merge_yq '.branch[strenv(B)] | has("merge_from")') ||
      ! HAS_NEVER=$(merge_yq '.branch[strenv(B)] | has("merge_never")') ||
      ! MERGE_FROM=$(merge_yq '(.branch[strenv(B)].merge_from // [])[]') ||
      ! MERGE_NEVER=$(merge_yq '(.branch[strenv(B)].merge_never // [])[]'); then
      print_error "cannot read the merge config of .config/bootstrap.toml."
      exit 1
    fi
  fi

  if [ "${HAS_FROM}" = true ] && [ "${HAS_NEVER}" = true ]; then
    print_error "[branch.${DESTINATION_BRANCH}] sets both merge_from and merge_never."
    print_warn "- keep one of them in .config/bootstrap.toml"
    exit 1
  fi
  if [ "${HAS_FROM}" = false ] && [ "${HAS_NEVER}" = false ]; then
    if [ "${DESTINATION_BRANCH}" = "main" ] && branch_exists develop; then
      MERGE_FROM=develop
    else
      MERGE_NEVER=main
    fi
  fi

  # `direct` is both the default and the behaviour every repo had before the
  # setting existed. Anything that is not `pr` reads as `direct` rather than
  # erroring: a typo in a config value should not stand between a branch and
  # its merge.
  [ "${MERGE_MODE}" = "pr" ] || MERGE_MODE="direct"
}

# merge_to_destination_branch <destination> [<source>]
#
# <source> defaults to the branch you are standing on, which is the shape
# `code:merge:develop` uses. `code:merge:main` names both.
merge_to_destination_branch() {
  local DESTINATION_BRANCH="$1"
  local CURRENT_BRANCH
  CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
  local SOURCE_BRANCH="${2:-${CURRENT_BRANCH}}"

  local MERGE_MODE MERGE_FROM MERGE_NEVER
  read_merge_config "${DESTINATION_BRANCH}"

  print_header "Landing ${SOURCE_BRANCH} on ${DESTINATION_BRANCH} (${MERGE_MODE}) ..."

  if [ -n "${MERGE_FROM}" ] && ! grep -qxF -- "${SOURCE_BRANCH}" <<< "${MERGE_FROM}"; then
    print_error "merges INTO '${DESTINATION_BRANCH}' are only allowed from: $(paste -sd ' ' - <<< "${MERGE_FROM}")"
    print_warn "- the source is '${SOURCE_BRANCH}'"
    print_warn "- merge_from of .config/bootstrap.toml decides this"
    exit 1
  fi
  if [ -n "${MERGE_NEVER}" ] && grep -qxF -- "${SOURCE_BRANCH}" <<< "${MERGE_NEVER}"; then
    print_error "merges FROM '${SOURCE_BRANCH}' into '${DESTINATION_BRANCH}' are not allowed."
    print_warn "- merge_never of .config/bootstrap.toml decides this"
    exit 1
  fi

  if [ "${SOURCE_BRANCH}" = "${DESTINATION_BRANCH}" ]; then
    print_error "'${SOURCE_BRANCH}' cannot be merged into itself."
    exit 1
  fi

  if [ "${CURRENT_BRANCH}" = "${DESTINATION_BRANCH}" ]; then
    print_error "you are already on '${DESTINATION_BRANCH}'."
    print_warn "- run this from the branch being merged, so it is the one that is checked"
    exit 1
  fi

  # The destination has to EXIST, and it is asked here rather than discovered at
  # the checkout below. Otherwise the run passes every predicate above, runs the
  # whole-tree hook pass, hops to the main worktree, and only then fails on
  # `git checkout`, having spent minutes to say something knowable in one command.
  if ! branch_exists "${DESTINATION_BRANCH}"; then
    print_error "branch '${DESTINATION_BRANCH}' does not exist here or on origin."
    print_warn "- create it (\`git branch ${DESTINATION_BRANCH}\`), then run"
    print_warn "  \`mise run setup:configs\` so the merge tasks match the branches"
    exit 1
  fi

  # A branch checked out in a linked worktree cannot be checked out again in
  # another, so the checkout below has to happen in the main worktree. Where we
  # end up afterwards differs by case: from a linked worktree the main worktree
  # goes back to whatever branch it was on, and from the main worktree we return
  # to the branch the merge was launched from.
  local IS_WORKTREE=false
  local MAIN_WORKTREE_PATH=""
  local MAIN_WORKTREE_BRANCH=""
  local RESTORE_BRANCH=""
  local ORIGINAL_DIR="${PWD}"

  if is_git_worktree; then
    IS_WORKTREE=true
    MAIN_WORKTREE_PATH=$(get_main_worktree_path)
    MAIN_WORKTREE_BRANCH=$(git -C "${MAIN_WORKTREE_PATH}" rev-parse --abbrev-ref HEAD)
    if [ "${MAIN_WORKTREE_BRANCH}" != "${DESTINATION_BRANCH}" ]; then
      RESTORE_BRANCH="${MAIN_WORKTREE_BRANCH}"
    fi
  else
    RESTORE_BRANCH="${CURRENT_BRANCH}"
  fi

  print_wait "Checking if any untracked files exist ... "
  if has_untracked_files; then
    print_error
    print_error "- Untracked files exist, please commit or remove them and try again."
    exit 1
  fi
  print_success

  print_wait "Checking if any uncommitted changes exist ... "
  if has_uncommitted_changes; then
    print_error
    print_error "- Uncommitted changes exist, please commit or remove them and try again."
    exit 1
  fi
  print_success

  # Unpushed work is refused rather than pushed for us: the merge is about to
  # publish this branch's commits into the destination, and a commit the remote
  # has never seen is one the pipeline has never built. Only the SOURCE branch is
  # asked — an unrelated local branch's unpushed work is not this merge's
  # business.
  #
  # Under `pr` the question does not arise: publishing the source branch is that
  # path's FIRST act, so refusing unpushed commits would refuse the normal case —
  # a branch committed a minute ago and not yet pushed anywhere.
  if [ "${MERGE_MODE}" = "direct" ]; then
    print_wait "Checking if any unpushed commits exist on ${SOURCE_BRANCH} ... "
    if is_local_branch "${SOURCE_BRANCH}"; then
      print_yellow "local branch"
    elif has_unpushed_commits "${SOURCE_BRANCH}"; then
      print_error
      print_error "- Unpushed commits exist on '${SOURCE_BRANCH}', please push them and try again."
      exit 1
    else
      print_success
    fi
  fi

  precommit_safety_net

  # The fork. Everything above is the policy both models share; everything below
  # is the local merge, which only `direct` performs.
  if [ "${MERGE_MODE}" = "pr" ]; then
    open_pull_request "${DESTINATION_BRANCH}" "${SOURCE_BRANCH}"
    return 0
  fi

  if [ "${IS_WORKTREE}" = true ]; then
    print_wait "Switching to main worktree at ${MAIN_WORKTREE_PATH} ... "
    if ! cd "${MAIN_WORKTREE_PATH}"; then
      print_error
      print_error "FAILED to switch to main worktree at '${MAIN_WORKTREE_PATH}'!"
      exit 1
    fi
    print_success
  fi

  print_wait "Checkout ${DESTINATION_BRANCH} branch ... "
  if ! git checkout "${DESTINATION_BRANCH}" > /dev/null 2>&1; then
    print_error
    print_error "FAILED to checkout '${DESTINATION_BRANCH}' branch!"
    exit 1
  fi
  print_success

  # Tags come with it because `main` is where releases are cut, and a stale tag
  # list is how a version gets reused.
  print_wait "Pulling latest changes from ${DESTINATION_BRANCH} branch ... "
  if ! git pull origin "${DESTINATION_BRANCH}" --tags > /dev/null 2>&1; then
    [ -n "${RESTORE_BRANCH}" ] && git checkout "${RESTORE_BRANCH}" -q > /dev/null 2>&1
    print_error
    print_error "FAILED to pull latest changes from '${DESTINATION_BRANCH}' branch!"
    exit 1
  fi
  print_success

  # **A conflict stops here, and the tree is left mid-merge on purpose.**
  # Aborting would discard the one piece of information worth having — which
  # files disagree — and resolving it is a judgement call this task cannot make.
  print_wait "Merging ${SOURCE_BRANCH} into ${DESTINATION_BRANCH} ... "
  if ! git merge --no-ff --no-edit "${SOURCE_BRANCH}" > /dev/null 2>&1; then
    print_error
    print_error "FAILED to merge ${SOURCE_BRANCH} into ${DESTINATION_BRANCH}!"
    print_warn "- the tree is left mid-merge; resolve the conflicts and commit,"
    print_warn "  or run \`git merge --abort\` to undo it"
    exit 1
  fi
  print_success

  print_wait "Pushing ${DESTINATION_BRANCH} branch to origin ... "
  if ! git push origin "${DESTINATION_BRANCH}" --follow-tags > /dev/null 2>&1; then
    print_error
    print_error "FAILED to push ${DESTINATION_BRANCH} branch to origin!"
    exit 1
  fi
  print_success

  if [ -n "${RESTORE_BRANCH}" ]; then
    if [ "${IS_WORKTREE}" = true ]; then
      print_wait "Restoring main worktree to ${RESTORE_BRANCH} branch ... "
    else
      print_wait "Checkout back to ${RESTORE_BRANCH} branch ... "
    fi
    if ! git checkout "${RESTORE_BRANCH}" > /dev/null 2>&1; then
      print_error
      print_error "FAILED to checkout back to '${RESTORE_BRANCH}' branch!"
      exit 1
    fi
    print_success
  fi

  cd "${ORIGINAL_DIR}" || true

  print_newline
  print_success "Merge completed successfully!"
}
