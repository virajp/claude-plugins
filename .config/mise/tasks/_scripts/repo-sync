#!/usr/bin/env bash
# Synced from bootstrap: tools/repo-sync/.config/mise/tasks/_scripts/repo-sync. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

#MISE description="Helper functions to sync shared files from the bootstrap repo"
#MISE hide=true

# repo-sync — copy the shared files of the selected tools from the private
# `bootstrap` repo into this repo. Meant to be *sourced* by a mise task, not
# executed:
#
#   source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/repo-sync"
#   repo_sync [--dry-run | --check]
#
# `--check` examines only the rules of the values file that need no clone:
# the values file, the local git repository and `.config/fnox.toml` (no fnox
# `default` profile). It makes no clone, writes no
# file and does not set `bootstrap_commit`. It runs each of these checks,
# prints each message, and returns the highest code. The rules that need the
# clone (an unknown tool or pack, a pack loop, the `envs` of a mise tool, an
# `[overrides]` path, a `remove` line that is not shipped, a root-only tool in
# a submodule) are for the sync only.
#
# The values file selects tools and packs with one table each; the only key of
# an entry is `env`, a list of environments:
#
#   [tools.node]                a tool folder `tools/node/` of bootstrap
#   env = ["dev", "ci"]         optional: without it, the tool's `default_envs`
#   [packs.security]            a pack of `tools/packs.toml`, without `p:`
#   env = ["dev"]               optional: each tool of the pack gets it; without
#                               it, each tool gets its own `default_envs`
#
# The pack `base` is always added, and each of its tools gets its own
# `default_envs`. No `[tools]` and no `[packs]` is valid: then only `base`.
# A list (`tools = [...]`, `packs = [...]`) is the old format and stops the
# sync.
#
# `tools/packs.toml` holds the packs: `[pack.<name>]` with `depends` and an
# optional `required`, each a list of tool folders, or `p:<name>` for a pack
# that is expanded in turn. A pack name must not be a tool folder.
#
# Each tool is a folder `tools/<tool>/` in `bootstrap`, which holds its files
# at the path they get here, and a `tools.toml` manifest:
#
#   default_envs = ["dev"]      the environments of the tool when no `env` names
#                               them
#   depends    = ["python"]     tools added with this one
#   root_only  = false          true: refused in a git submodule; a pack
#                               tool is skipped there
#   extensions = ["a.b"]        VS Code extensions, for `.vscode/extensions.json`
#   seed       = ["bunfig.toml"] files written only when missing; the repo owns
#                               them after that
#   [seed_requires]             optional: a seed written only when this repo
#                               has the file, `"pnpm-workspace.yaml" = "package.json"`
#   [[precommit]]               `repos:` entries of `.config/pre-commit-config.yaml`
#   [mise.<section>]            the mise config of the tool, in mise syntax; an
#                               entry of `[mise.tools]` can also have `envs`,
#                               `requires` and `files` (see "mise config")
#   [mise_env.<env>.<section>]  optional: more mise config for one environment
#
# One call clones the default branch once (shallow, over SSH) and syncs every
# file of every selected tool from that one clone.
#
# After a sync without a failure, the sync sets the top-level
# `bootstrap_commit` of the values file to the full commit of that clone. It
# replaces only that line, or it adds the line after the header comments.
# This is the only change that the sync makes to the values file. An agent
# compares the value with main of bootstrap to find what changed since.
#
# Environments: `environments` of the values file, from dev (necessary) and
# ci. Without the key, only dev. The environments of each tool:
#   * A tool of `[tools.*]` or of a pack gets its `env`, else its
#     `default_envs`. A tool that is selected more than once gets each of them.
#   * A dependency of a tool (its `depends`, and the tool that defines each
#     mise `depends`) gets each environment of each tool that needs it.
#   * `environments` limits every result.
#   * The `envs` of a mise tool (default dev) lists the environments that it
#     allows. A tool in an environment that one of its mise tools does not
#     allow stops the sync, as does an `env` name that is not in
#     `environments`.
#   * Each tool must be in dev: an `env` of the values file or a
#     `default_envs` without dev stops the sync.
#
# mise config: the sync generates `.config/mise/conf.d/<tool>/mise.<env>.toml`
# for each selected environment and each tool with `[mise]` tables.
# `.config/mise.toml` is the only file for every environment; no `mise.toml`
# is generated.
#   * Each mise tool of a tool is in the environments of its tool.
#   * `[tools]`, `[tool_alias]` and `[plugins]` follow each entry. `[settings]`,
#     `[env]` and the other shared sections go to each environment of the
#     tool. `[vars]`, `[secrets]`, `[shell_alias]`, `[hooks]`, `[tasks]`, the
#     daemons and the like go to dev only, when the tool is in dev.
#   * `[mise_env.<env>]` is added to that environment as it is, when the tool
#     is in it.
#   * The `mise` tool also gets `setup-all` and `setup-<submodule>` in dev, from
#     the git submodules of this repo.
#   * The mise `depends` of an entry adds the tool that defines that mise tool.
#   * The `requires` of an entry, a file name, keeps the entry only when this
#     repo has a file of that name, at the root or down to 4 folders below
#     it, and not ignored by git. The generated file has no `requires`.
#   * The `files` of an entry with `requires` lists paths of its tool folder,
#     for example the tasks of that mise tool. Without the `requires` file, the
#     sync does not write them, and it removes a copy with the bootstrap
#     header. A file that two entries list needs both files. `files` without
#     `requires`, or a path that is not a file of the tool folder, stops the
#     sync. The generated file has no `files`.
#   * A shipped `conf.d/*/mise.<env>.toml` of an environment that is not
#     selected is skipped.
#   * Afterwards, a file in `conf.d/*/` with the bootstrap header that this
#     run did not write is removed: it belongs to a tool, an environment or a
#     layout that is gone. A file without the header, such as a seed, is never
#     touched.
#   * `[overrides.mise.<section>...]` and `[overrides.mise_env.<env>.<section>...]`
#     of the values file replace the defaults of the tools. The path after
#     `overrides.` is the path in a tools.toml, without the tool name: each
#     selected tool with a value at that path gets the override.
#     `[overrides.mise_env.<env>]` is for that environment only, and it wins
#     over `[overrides.mise]`. A table merges key by key; any other value
#     replaces the default. A path that no selected tool has, and the `envs`,
#     the `depends`, the `requires` and the `files` of a mise tool, stop the
#     sync. Each overridden line gets an `# override: <values file>` comment.
#   * `conf.d/zz-repo/` is the repo's own folder, and it must load last: mise
#     loads the folders in name order and a later one wins. A tool folder
#     whose name sorts after `zz-repo` in byte order stops the sync.
#
# Templates: a file that ends in `.tmpl` is rendered with gomplate, formatted
# with this repo's dprint config when dprint is available, and written without
# the suffix. The context is the values file (`<% .repo_name %>`,
# `<% .member.<name>.label %>`) plus:
#   .submodules  the git submodules only, nested ones included
#   .members     the member names: the git submodules (the name of their
#                `[member.<name>]` table, else their path), then each other
#                `[member.<name>]` of the values file — a folder of a monorepo,
#                which must exist
#   .member_folders  a map from each member name to its folder
#   .member_types    a map from each member name to `submodule` or `folder`
#   .tools       the selected tools, packs expanded, dependencies included
#   .extensions  the VS Code extensions of those tools and of the `extensions`
#                list of the values file, sorted, no duplicates. In the root
#                repository, also those of each git submodule (the tools and
#                the `extensions` list of its values file)
#   .precommit   the `[[precommit]]` entries of those tools, in tool order, then
#                the entries of this repo's `.config/repo-sync/pre-commit.yaml`.
#                A `no-commit-to-branch` hook loses each `"--branch", "<b>"`
#                pair of a core branch (main, develop) that does not exist or
#                that has `direct_commit = true` in `[branch.<b>]`. A hook with
#                no pair left goes, and an entry with no hook left goes
# The delimiters are `<% %>`, because `{{ }}` belongs to mise and `[[ ]]` to
# bash, and both must reach the output unchanged. gomplate reads the TOML too.
# The calling task provides gomplate and pre-commit with
# `#MISE tools.<tool>="latest"`, and this script calls them without `mise x --`:
# `mise x` finds only the tools of a config file, and a repo before its first
# sync, or a shell without MISE_ENV=dev, has no config that names them.
# The gate `code:lint:repo-sync` has no such directive: it runs only when
# `mise x -- which gomplate` finds gomplate in the config of the repo.
#
# Merge tasks: the branch model follows the branches that exist, here or on
# origin. With `main` and `develop`, the sync writes `code/merge/develop` and
# `code/merge/main`; with only one of them, `code/merge/_default`. It removes the
# merge tasks of the other model: they are not seeds, so the repo does not own
# them. With neither branch, the sync stops.
#
# .gitignore: the shared ignore set, with `[overrides.gitignore]` of the
# values file applied. Each line of `remove` is commented out, then the lines
# of `add` go at the end. A later line wins, so `add` can also negate a shared
# pattern with `!`. A line of `remove` that the shared set does not have, a
# line in both lists, the old `[overrides.graphifyignore]` and the old
# `.config/repo-sync/gitignore` stop the sync.
#
# Failure handling
#   * A file takes the mode of its source, also when it exists already. To
#     make a template executable, make its `.tmpl` executable.
#   * A destination is only replaced after a complete copy or render, so a
#     failure always leaves the existing file as it was.
#   * A bad file does not stop the others; a failed clone, an unknown tool or
#     pack, a bad environment or a root-only tool in a submodule stops the
#     whole run.
#
# Return codes
#   0  success (or nothing to change)
#   2  usage error, a values file in the old list format, a pack loop, a pack
#      name that is also a tool folder, an environment that is not in
#      `environments` or that a mise tool does not allow, an `env` or a
#      `default_envs` without dev, a tool folder that sorts after `zz-repo`,
#      a root-only tool in a submodule, a repo with neither `main` nor
#      `develop`, a template that cannot render, a bad `[overrides]`, a
#      `direct_commit` that is not a boolean, that is in a `[branch.*]` table
#      other than main and develop or of a branch that does not exist, or that
#      is true for main but not for develop when both exist, or a `[mise]`
#      config that cannot be generated
#   3  a tool or a pack that is not in bootstrap (fix the values file)
#   5  the clone failed (network, SSH key or access to the repo), or
#      `pre-commit autoupdate` could not resolve the hook revisions
#   1  anything else (local filesystem errors, ...)
# With `--check`, 0 when each local rule passes, else the highest code of its
# checks; `--check` with `--dry-run` is a usage error, 2.
#
# Environment:
#   REPO_SYNC_URL     the repo to clone (default git@github.com:virajp/bootstrap.git);
#                     `--check` does not read it
#   REPO_SYNC_CLONE   an existing clone to use instead of a new one; set by
#                     `setup:configs`, which also loads this file from it;
#                     `--check` does not read it
#   REPO_SYNC_VALUES  the values file
#                     (default $MISE_PROJECT_ROOT/.config/bootstrap.toml)
#   REPO_SYNC_NO_AUTOUPDATE  1: skip `pre-commit autoupdate`, so the hook
#                     revisions stay as the tools.toml files have them and no
#                     network is needed (for tests)

_rs_log() { printf '%s\n' "repo-sync: $*" >&2; }

# Print the permission bits of <path>, for example 755.
_rs_mode() { stat -c %a -- "$1" 2> /dev/null || stat -f %Lp -- "$1"; }

# Show <path> relative to the current directory when it is under it.
_rs_path() { [[ $1 == "$PWD"/* ]] && printf '%s' "${1#"$PWD"/}" || printf '%s' "$1"; }

# Temp files and directories still on disk; removed if the task exits early.
_RS_TMPS=()
# The manifests of the clone, read once by `_rs_mise_index`.
_RS_MANIFESTS='' _RS_MANIFESTS_DIR=''
_rs_cleanup() {
  ((${#_RS_TMPS[@]})) && rm -rf -- "${_RS_TMPS[@]}"
  return 0
}
trap _rs_cleanup EXIT
trap '_rs_cleanup; exit 130' INT
trap '_rs_cleanup; exit 143' TERM

# Print the repo's members, one per line as `<name> <folder> <type>` with a
# tab between them: the git submodules first, then the other `[member.<name>]`
# tables of <values>. A submodule without a table has the `repo_name` of its
# own values file as its name, else its path with each `/` changed to `_`. A
# name has only letters, digits, `-` and `_`, and two members never have the
# same name. A table has an optional `folder` (the default is the name) and
# an optional `type`, `submodule` or `folder`; without `type`, the folder
# decides it. A folder member must exist, and no member is the repo itself
# (`.`). Returns 2, after a message, when a member breaks one of these rules.
_rs_members() {
  local values=$1 name=$2 path rows key folder type found submodules='' tab=$'\t'
  if [[ -f ${MISE_PROJECT_ROOT}/.gitmodules ]]; then
    # shellcheck disable=SC2016
    submodules=$(git -C "$MISE_PROJECT_ROOT" submodule --quiet foreach --recursive 'echo $displaypath' 2> /dev/null) || submodules=''
  fi
  rows=$(_rs_gomplate -c "v=${values}" \
  -i '<% if has .v "member" %><% range $k, $x := .v.member %><% $k %>	<% if has $x "folder" %><% $x.folder %><% else %><% $k %><% end %>	<% if has $x "type" %><% $x.type %><% end %>
<% end %><% end %>') || return 2
  while IFS="$tab" read -r key folder type; do
    [[ -n $key ]] || continue
    folder=${folder%/}
    if [[ $folder == "." || -z $folder ]]; then
      _rs_log "$name: [member.${key}] in $(_rs_path "$values") has the folder of the repo itself - a member is a submodule or a folder below the root"
      return 2
    fi
    case $type in
      '' | submodule | folder) ;;
      *)
        _rs_log "$name: [member.${key}] in $(_rs_path "$values") has the type '${type}' - use submodule or folder"
        return 2
        ;;
    esac
    if grep -qxF -- "$folder" <<< "$submodules"; then
      if [[ $type == folder ]]; then
        _rs_log "$name: [member.${key}] in $(_rs_path "$values") has type folder, but ${folder} is a submodule"
        return 2
      fi
    elif [[ $type == submodule ]]; then
      _rs_log "$name: [member.${key}] in $(_rs_path "$values") has type submodule, but ${folder} is not in .gitmodules"
      return 2
    elif [[ ! -d ${MISE_PROJECT_ROOT}/${folder} ]]; then
      _rs_log "$name: [member.${key}] in $(_rs_path "$values") is not a submodule or a folder of the repo"
      return 2
    fi
  done <<< "$rows"
  # The submodules, each with the name of its table, else the `repo_name` of
  # its own values file, else its path with each `/` changed to `_`.
  local out='' sub_values
  while IFS= read -r path; do
    [[ -n $path ]] || continue
    found=''
    while IFS="$tab" read -r key folder type; do
      [[ -n $key && ${folder%/} == "$path" ]] && found=$key
    done <<< "$rows"
    sub_values="${MISE_PROJECT_ROOT}/${path}/.config/bootstrap.toml"
    if [[ -z $found && -f $sub_values ]]; then
      found=$(_rs_gomplate -c "v=${sub_values}" -i '<% if has .v "repo_name" %><% .v.repo_name %><% end %>') || found=''
    fi
    [[ -n $found ]] || found=${path//\//_}
    out+="${found}${tab}${path}${tab}submodule"$'\n'
  done <<< "$submodules"
  # Then the folder members.
  while IFS="$tab" read -r key folder type; do
    [[ -n $key ]] || continue
    folder=${folder%/}
    grep -qxF -- "$folder" <<< "$submodules" && continue
    out+="${key}${tab}${folder}${tab}folder"$'\n'
  done <<< "$rows"
  # A name is a flag (`--<name>`) and a part of a shell variable of the tasks.
  local seen=''
  while IFS="$tab" read -r key folder type; do
    [[ -n $key ]] || continue
    if [[ ! $key =~ ^[A-Za-z0-9_-]+$ ]]; then
      _rs_log "$name: the member ${folder} has the name '${key}' - a member name has only letters, digits, - and _; use a [member.<name>] table with such a name in $(_rs_path "$values")"
      return 2
    fi
    if grep -qxF -- "$key" <<< "$seen"; then
      _rs_log "$name: two members have the name '${key}' - write a [member.<name>] table with another name for one of them in $(_rs_path "$values")"
      return 2
    fi
    seen+="${key}"$'\n'
  done <<< "$out"
  printf '%s' "$out"
}

# gomplate with the template delimiters this repo uses. The calling task puts
# gomplate on PATH with its tools directive.
_rs_gomplate() { gomplate --left-delim '<%' --right-delim '%>' "$@"; }

# Print the items of the list <key> in the TOML file <file>, one per line;
# nothing when the key is absent.
_rs_list() {
  local file=$1 key=$2
  _rs_gomplate -c "v=${file}" -i "<% if has .v \"${key}\" %><% range (index .v \"${key}\") %><% . %>
<% end %><% end %>"
}

# The fixed pack that every repo gets.
_RS_BASE_PACK=base

# Print the `[tools.<name>]` and `[packs.<name>]` entries of <values> as
# `tools|packs <name> <env,...|->` lines (`-`: no `env`). Returns 2, after a
# message, for the old list format or an entry with another key than `env`.
_rs_values_sel() {
  local values=$1 out kind table name key
  out=$(_rs_gomplate -c "v=${values}" -i '<% range $t := coll.Slice "tools" "packs" %><% if has $.v $t %><% $x := index $.v $t %><% if not (test.IsKind "map" $x) %>list <% $t %>
<% else %><% range $k, $e := $x %><% if not (test.IsKind "map" $e) %>bad <% $t %> <% $k %> -
<% else %><% range $ek, $ev := $e %><% if ne $ek "env" %>bad <% $t %> <% $k %> <% $ek %>
<% end %><% end %><% if has $e "env" %><% if not (test.IsKind "slice" $e.env) %>bad <% $t %> <% $k %> env
<% else %><% $t %> <% $k %> <% join $e.env "," %>
<% end %><% else %><% $t %> <% $k %> -
<% end %><% end %><% end %><% end %><% end %><% end %>') || {

    _rs_log "cannot read $(_rs_path "$values")"
    return 2
  }
  while read -r kind table name key; do
    if [[ $kind == list ]]; then
      name=security
      [[ $table == tools ]] && name=node
      _rs_log "$table in $(_rs_path "$values") is a list, the old format - write one table for each entry, for example [$table.$name] env = [\"dev\"]; the pack $_RS_BASE_PACK is always added"
      return 2
    fi
    [[ $kind == bad ]] || continue
    if [[ $key == - ]]; then
      key='must be a table'
    elif [[ $key == env ]]; then
      key='env must be a list, for example env = ["dev"]'
    else
      key="'$key' is not a key of an entry; the only key is env, a list"
    fi
    _rs_log "[$table.$name] in $(_rs_path "$values"): $key"
    return 2
  done <<< "$out"
  printf '%s\n' "$out"
}

# Print the tools of the pack <name> as `<tool> <env,...|-> <source>` lines,
# packs in it expanded in turn. The tools.toml `[pack.*]` lines are in <packs>
# (`pack <name>` and `item <name> <entry>`); <chain> is the ` <pack> ` words of
# the packs that include this one. Returns 2 for a loop and 3 for an unknown
# pack, after a message.
_rs_pack() {
  local packs=$1 name=$2 envs=$3 src=$4 chain=$5 kind pack item loop word
  if [[ $chain == *" $name "* ]]; then
    loop=$name
    for word in ${chain#* "$name" }; do
      loop+=" -> $word"
    done
    _rs_log "tools/packs.toml: a pack loop: $loop -> $name"
    return 2
  fi
  if [[ $packs != *$'\n'"pack $name"$'\n'* ]]; then
    word=${chain% }
    _rs_log "pack '$name' is not in bootstrap$([[ -n ${chain// /} ]] && printf ' (named in pack %s)' "${word##* }")"
    return 3
  fi
  chain+="$name "
  while read -r kind pack item; do
    [[ $kind == item && $pack == "$name" ]] || continue
    if [[ $item == p:* ]]; then
      _rs_pack "$packs" "${item#p:}" "$envs" "$src" "$chain" || return
    else
      printf '%s %s %s\n' "$item" "$envs" "$src"
    fi
  done <<< "$packs"
}

# Print the selection of the clone <dir> for the values lines <sel> of
# `_rs_values_sel` as `<tool> <env,...|-> <source>` lines: the pack base, each
# `[packs.*]`, then each `[tools.*]`. <source> is `default` for the pack base,
# else the values table, for example `packs.security`. Returns 2 or 3, after a
# message, on a problem of tools/packs.toml or of a pack.
_rs_selected() {
  local dir=$1 sel=$2 packs kind name envs
  packs=$'\n'
  if [[ -f $dir/tools/packs.toml ]]; then
    packs+=$(_rs_gomplate -c "p=${dir}/tools/packs.toml" -i '<% if has .p "pack" %><% range $k, $p := .p.pack %>pack <% $k %>
<% range $key := coll.Slice "depends" "required" %><% if has $p $key %><% range index $p $key %>item <% $k %> <% . %>
<% end %><% end %><% end %><% end %><% end %>') || {

      _rs_log "cannot read tools/packs.toml"
      return 2
    }
    packs+=$'\n'
  fi
  while read -r kind name; do
    if [[ $kind == pack && -d $dir/tools/$name ]]; then
      _rs_log "tools/packs.toml: pack '$name' is also a tool folder - rename one"
      return 2
    fi
  done <<< "$packs"
  _rs_pack "$packs" "$_RS_BASE_PACK" - default ' ' || return
  while read -r kind name envs; do
    [[ $kind == packs ]] || continue
    _rs_pack "$packs" "$name" "$envs" "packs.$name" ' ' || return
  done <<< "$sel"
  while read -r kind name envs; do
    [[ $kind == tools ]] && printf '%s %s %s\n' "$name" "$envs" "tools.$name"
  done <<< "$sel"
  return 0
}

# The fields of the manifest `$t` as `<field> <value>` lines, for gomplate.
# A caller binds `$t` and replaces `@P@` with the prefix of each line.
_RS_MANIFEST_TEMPLATE='<% range $t.default_envs %>@P@default_env <% . %>
<% end %><% range $t.depends %>@P@depends <% . %>
<% end %><% range $t.extensions %>@P@extension <% . %>
<% end %><% range $t.seed %>@P@seed <% . %>
<% end %><% if has $t "seed_requires" %><% range $k, $v := $t.seed_requires %>@P@seed_requires <% $k %> <% $v %>
<% end %><% end %><% if and (has $t "mise") (has $t.mise "tools") %><% range $k, $v := $t.mise.tools %>@P@mise <% $k %><% if and (test.IsKind "map" $v) (has $v "envs") %> <% join $v.envs "," %><% else %> -<% end %><% if and (test.IsKind "map" $v) (has $v "depends") %><% if test.IsKind "string" $v.depends %> <% $v.depends %><% else %><% range $v.depends %> <% . %><% end %><% end %><% end %>
<% if and (test.IsKind "map" $v) (has $v "requires") %>@P@mise_requires <% $k %> <% $v.requires %>
<% end %><% if and (test.IsKind "map" $v) (has $v "files") %><% range $v.files %>@P@mise_files <% $k %> <% . %>
<% end %><% end %><% end %><% end %>@P@root_only <% $t.root_only %>
'

# Print the manifest of <tool> in the clone <dir> as `<field> <value>` lines:
# `default_env`, `depends`, `extension`, `seed`, `seed_requires <seed> <file>`,
# `mise <mise-tool> <envs,...|-> [<mise-depends>...]`,
# `mise_requires <mise-tool> <file>`, `mise_files <mise-tool> <path>`, and one
# `root_only true|false`. The `mise_requires` line of an entry comes before its
# `mise_files` lines.
# `_rs_mise_index` reads each manifest of <dir> in one call, so this only
# selects the lines of <tool>. A tool that it did not read is read alone.
_rs_manifest() {
  local dir=$1 tool=$2
  if [[ $dir == "$_RS_MANIFESTS_DIR" && $_RS_MANIFESTS == *$'\n'"$tool "* ]]; then
    awk -v t="$tool" '$1 == t { sub(/^[^ ]* /, ""); print }' <<< "$_RS_MANIFESTS"
    return 0
  fi
  _rs_gomplate -c "t=${dir}/tools/${tool}/tools.toml" -i "<% \$t := .t %>${_RS_MANIFEST_TEMPLATE//@P@/}"
}

# Set _RS_MISE_DEFS to the ` <mise-tool>=<tool> ` words of every tool in the
# clone <dir>, selected or not: the mise `depends` of an entry find their tool
# here. Returns 2, after a message, when two tools define the same mise tool,
# when the default_envs of a tool, selected or not, has no dev, for `files`
# of an entry without `requires` or with a path that is not a file of its tool
# folder,
# or for a tool folder named zz-repo or that sorts after it in byte order:
# mise loads the folders of conf.d/ in name order and a later one wins, so the
# repo's own conf.d/zz-repo/ must load last and no tool may write there.
# It also sets _RS_MANIFESTS to the manifest of each tool, as
# `<tool> <field> <value>` lines from one gomplate call, for `_rs_manifest`.
_rs_mise_index() {
  local dir=$1 manifest tool name names path late tools='' args=()
  late=$(cd "$dir/tools" && printf '%s\n' */ | sed 's#/$##' | LC_ALL=C awk '$0 >= "zz-repo" { print; exit }') || {
    _rs_log "cannot list the tool folders of the clone"
    return 2
  }
  if [[ -n $late ]]; then
    _rs_log "tool folder tools/$late sorts after zz-repo or is named zz-repo - rename it, because conf.d/zz-repo/ must load last"
    return 2
  fi
  for manifest in "$dir"/tools/*/tools.toml; do
    tool=${manifest%/tools.toml}
    tool=${tool##*/}
    tools+="$tool "
    args+=(-c "tool_${tool}=${manifest}")
  done
  _RS_MANIFESTS_DIR='' _RS_MANIFESTS=$'\n'
  _RS_MANIFESTS+=$(REPO_SYNC_TOOLS=$tools _rs_gomplate "${args[@]}" \
    -i "<% range (env.Getenv \"REPO_SYNC_TOOLS\" | strings.TrimSpace | strings.Split \" \") %><% \$n := . %><% \$t := index \$ (printf \"tool_%s\" .) %>${_RS_MANIFEST_TEMPLATE//@P@/<% \$n %> }<% end %>" 2> /dev/null) || {
    # Read each file alone, to name the one that fails.
    for tool in $tools; do
      if ! _rs_manifest "$dir" "$tool" > /dev/null 2>&1; then
        _rs_log "cannot read tools/$tool/tools.toml"
        return 2
      fi
    done
    _rs_log "cannot read the tools.toml files of the clone"
    return 2
  }
  _RS_MANIFESTS+=$'\n'
  _RS_MANIFESTS_DIR=$dir
  _RS_MISE_DEFS=' '
  for tool in $tools; do
    names=$(_rs_manifest "$dir" "$tool")
    # Each tool must be in dev, selected or not, so this repo's own test
    # finds a tool without dev before a consumer selects it.
    if [[ $'\n'$names$'\n' != *$'\n'"default_env dev"$'\n'* ]]; then
      _rs_log "default_envs of tools/$tool/tools.toml has no dev - each tool must be in dev, for example default_envs = [\"dev\", \"ci\"]"
      return 2
    fi
    for name in $(printf '%s\n' "$names" | awk '$1 == "mise" { print $2 }'); do
      if [[ $_RS_MISE_DEFS == *" $name="* ]]; then
        _rs_log "mise tool '$name' is defined in tools/$tool and in another tool - keep one"
        return 2
      fi
      _RS_MISE_DEFS+="$name=$tool "
    done
    while read -r name path; do
      [[ -n $name ]] || continue
      if [[ $'\n'$names$'\n' != *$'\n'"mise_requires $name "* ]]; then
        _rs_log "files of mise tool '$name' in tools/$tool/tools.toml: the entry has no requires - add requires, or remove files"
        return 2
      fi
      if [[ $path == /* || $path == ../* || $path == */../* || $path == tools.toml || ! -f $dir/tools/$tool/$path ]]; then
        _rs_log "files of mise tool '$name' in tools/$tool/tools.toml: '$path' is not a file of tools/$tool"
        return 2
      fi
    done < <(printf '%s\n' "$names" | awk '$1 == "mise_files" { print $2, $3 }')
  done
}

# Print the tool that defines the mise tool <name>, or nothing.
_rs_mise_owner() {
  local def=${_RS_MISE_DEFS#* "$1="}
  [[ $def != "$_RS_MISE_DEFS" ]] && printf '%s' "${def%% *}"
}

# Examine the `env` of each entry of the values lines <sel> of
# `_rs_values_sel` for <values>, against _RS_ENVS of `_rs_envs`. An `env` of
# the values file names only environments of this repo, and always dev: each
# tool must be in dev. Returns 2, after a message, at the first problem.
_rs_env_rules() {
  local values=$1 sel=$2 kind name envs env
  # An `env` of the values file names only environments of this repo, and
  # always dev: each tool must be in dev.
  local has_dev
  while read -r kind name envs; do
    [[ -n $kind && $envs != - ]] || continue
    if [[ -z $envs ]]; then
      _rs_log "env of [$kind.$name] in $(_rs_path "$values") is empty - name an environment, or remove env to use default_envs"
      return 2
    fi
    has_dev=0
    [[ ,$envs, == *,dev,* ]] && has_dev=1
    # Split on commas only, so an item with a space fails the name check.
    envs+=,
    while [[ -n $envs ]]; do
      env=${envs%%,*} envs=${envs#*,}
      if ! _rs_env_name "$env"; then
        _rs_log "env of [$kind.$name] in $(_rs_path "$values"): '$env' is not one of ${_RS_ENV_NAMES// /, }"
        return 2
      fi
      if [[ $_RS_ENVS != *" $env "* ]]; then
        _rs_log "env '$env' of [$kind.$name] in $(_rs_path "$values") is not in environments:${_RS_ENVS% }"
        return 2
      fi
    done
    if ((!has_dev)); then
      _rs_log "env of [$kind.$name] in $(_rs_path "$values") has no dev - each tool must be in dev, for example env = [\"dev\", \"ci\"]"
      return 2
    fi
  done <<< "$sel"
  return 0
}

# Resolve the tools and packs of <values> against the clone <dir>, packs
# expanded and dependencies included, into _RS_TOOLS (space separated, a
# dependency before the tool that needs it), _RS_SEL (the
# `<tool> <env,...|-> <source>` lines of `_rs_selected`), _RS_DEPS
# (`<tool> <dependency>...` lines), _RS_DEFAULT_ENVS (` <tool>:<env> ` words),
# _RS_EXTENSIONS (one per line, sorted, unique), _RS_SEEDS
# (` <tool>/<path> ` words), _RS_SEED_REQUIRES (` <tool>/<path>=<file> `
# words), _RS_MISE_ENTRIES (`<tool> <mise-tool> <envs,...|-> [<mise-depends>...]`
# lines), _RS_MISE_REQUIRES (` <mise-tool>=<file> ` words) and
# _RS_FILE_REQUIRES (` <tool>/<path>=<file> ` words, from `files`). A mise
# `depends` adds the tool that defines it. Returns 2 or 3,
# after a message, on any problem.
_rs_resolve() {
  local dir=$1 values=$2 sel tool field value pending in_submodule name envs
  sel=$(_rs_values_sel "$values") || return 2
  _rs_env_rules "$values" "$sel" || return 2
  _RS_SEL=$(_rs_selected "$dir" "$sel") || return
  in_submodule=$(git -C "$MISE_PROJECT_ROOT" rev-parse --show-superproject-working-tree 2> /dev/null) || in_submodule=''
  # In a submodule, a root_only tool of a pack is skipped: the pack base adds
  # vscode to each repository. A [tools.*] entry of it still stops the sync.
  if [[ -n $in_submodule ]]; then
    local kept='' src
    while read -r name envs src; do
      [[ -n $name ]] || continue
      if [[ $src != tools.* ]] && _rs_manifest "$dir" "$name" 2> /dev/null | grep -qx 'root_only true'; then
        continue
      fi
      kept+="$name $envs $src"$'\n'
    done <<< "$_RS_SEL"
    _RS_SEL=${kept%$'\n'}
  fi

  _RS_TOOLS=' ' _RS_SEEDS=' ' _RS_SEED_REQUIRES=' ' _RS_EXTENSIONS='' _RS_MISE_ENTRIES=''
  _RS_MISE_REQUIRES=' ' _RS_FILE_REQUIRES=' '
  _RS_DEPS='' _RS_DEFAULT_ENVS=' '
  # Depth-first, so each dependency lands before the tool that named it. A
  # stack of words rather than recursion: bash 3.2 has no local arrays worth
  # passing around, and the manifests are tiny.
  pending=$(printf '%s\n' "$_RS_SEL" | awk '{ print $1 }' | tr '\n' ' ')
  local visiting=' '
  while [[ -n ${pending// /} ]]; do
    tool=${pending%% *}
    pending=${pending#* }
    [[ -n $tool && $_RS_TOOLS != *" $tool "* ]] || continue
    if [[ ! -f $dir/tools/$tool/tools.toml ]]; then
      _rs_log "tool '$tool' is not in bootstrap"
      return 3
    fi
    local deps='' all='' manifest entry owner
    manifest=$(_rs_manifest "$dir" "$tool") || {
      _rs_log "cannot read tools/$tool/tools.toml"
      return 2
    }
    while read -r field value; do
      case $field in
        depends)
          all+=" $value"
          [[ $_RS_TOOLS != *" $value "* ]] && deps+="$value "
          ;;
        mise)
          read -r entry _ value <<< "$value"
          for name in $value; do
            owner=$(_rs_mise_owner "$name") || owner=''
            if [[ -z $owner ]]; then
              _rs_log "mise tool '$entry' of tools/$tool depends on '$name', which no tool defines"
              return 2
            fi
            [[ $owner != "$tool" ]] && all+=" $owner"
            [[ $owner != "$tool" && $_RS_TOOLS != *" $owner "* ]] && deps+="$owner "
          done
          ;;
      esac
    done <<< "$manifest"
    if [[ -n $deps && $visiting != *" $tool "* ]]; then
      # Come back to this tool after its dependencies.
      visiting+="$tool "
      pending="$deps$tool $pending"
      continue
    fi
    [[ -n $all ]] && _RS_DEPS+="$tool$all"$'\n'
    while read -r field value; do
      case $field in
        default_env)
          if ! _rs_env_name "$value"; then
            _rs_log "default_envs of tools/$tool/tools.toml: '$value' is not one of ${_RS_ENV_NAMES// /, }"
            return 2
          fi
          _RS_DEFAULT_ENVS+="$tool:$value "
          ;;
        extension)
          _RS_EXTENSIONS+="$value"$'\n'
          ;;
        seed)
          _RS_SEEDS+="$tool/$value "
          ;;
        seed_requires)
          # `<seed> <file>`: neither path has a space.
          _RS_SEED_REQUIRES+="$tool/${value% *}=${value#* } "
          ;;
        mise)
          _RS_MISE_ENTRIES+="$tool $value"$'\n'
          ;;
        mise_requires)
          # `<mise-tool> <file>`: neither has a space.
          _RS_MISE_REQUIRES+="${value% *}=${value#* } "
          ;;
        mise_files)
          # `<mise-tool> <path>`. The `mise_requires` line of the entry came
          # first, and `_rs_mise_index` made sure that it exists.
          name=${_RS_MISE_REQUIRES#* "${value% *}="}
          _RS_FILE_REQUIRES+="$tool/${value#* }=${name%% *} "
          ;;
        root_only)
          if [[ $value == true && -n $in_submodule ]]; then
            _rs_log "tool '$tool' is for the root repository only - remove it from the tools of this submodule"
            return 2
          fi
          ;;
      esac
    done <<< "$manifest"
    _RS_TOOLS+="$tool "
  done
  _RS_EXTENSIONS=$(printf '%s' "$_RS_EXTENSIONS" | sort -u)
}

# Print the VS Code extensions of the tools of <values>, packs expanded and
# dependencies included, one per line. Like `_rs_resolve`, a mise `depends`
# adds the tool that defines it. Nothing is checked: a problem in a member's
# values file is for that member's own sync to report.
_rs_tool_extensions() {
  local dir=$1 values=$2 pending tool field value seen=' ' entry name owner sel
  sel=$(_rs_values_sel "$values" 2> /dev/null) || sel=''
  pending=$(_rs_selected "$dir" "$sel" 2> /dev/null | awk '{ print $1 }' | tr '\n' ' ') || pending=''
  while [[ -n ${pending// /} ]]; do
    tool=${pending%% *}
    pending=${pending#* }
    [[ -n $tool && $seen != *" $tool "* && -f $dir/tools/$tool/tools.toml ]] || continue
    seen+="$tool "
    while read -r field value; do
      case $field in
        extension)
          printf '%s\n' "$value"
          ;;
        depends)
          pending+=" $value "
          ;;
        mise)
          read -r entry _ value <<< "$value"
          for name in $value; do
            owner=$(_rs_mise_owner "$name") || owner=''
            [[ -n $owner ]] && pending+=" $owner "
          done
          ;;
      esac
    done < <(_rs_manifest "$dir" "$tool" 2> /dev/null)
  done
}

# Add to _RS_EXTENSIONS the `extensions` list of <values>. In the root
# repository, also add the extensions of each git submodule: the tools of its
# `.config/bootstrap.toml` and its own `extensions` list. VS Code opens the
# root only, so the root recommends the extensions of the whole tree.
_rs_extensions() {
  local dir=$1 values=$2 sub subvalues extra
  extra=$(_rs_list "$values" extensions) || extra=''
  if [[ -z $(git -C "$MISE_PROJECT_ROOT" rev-parse --show-superproject-working-tree 2> /dev/null) && -f ${MISE_PROJECT_ROOT}/.gitmodules ]]; then
    while IFS= read -r sub; do
      subvalues="${MISE_PROJECT_ROOT}/${sub}/.config/bootstrap.toml"
      [[ -f $subvalues ]] || subvalues="${MISE_PROJECT_ROOT}/${sub}/.config/repo-config.toml"
      [[ -n $sub && -f $subvalues ]] || continue
      extra+=$'\n'$(_rs_tool_extensions "$dir" "$subvalues")
      extra+=$'\n'$(_rs_list "$subvalues" extensions 2> /dev/null) || true
    done < <(git -C "$MISE_PROJECT_ROOT" submodule --quiet foreach --recursive 'echo $displaypath' 2> /dev/null)
  fi
  _RS_EXTENSIONS=$(printf '%s\n%s\n' "$_RS_EXTENSIONS" "$extra" | grep -v '^$' | sort -u) || _RS_EXTENSIONS=''
}

# A branch that exists here or on origin; the same test as `branch_exists` in
# `checks`, which a first sync does not have yet.
_rs_branch_exists() {
  git -C "$MISE_PROJECT_ROOT" show-ref --verify --quiet "refs/heads/$1" ||
    git -C "$MISE_PROJECT_ROOT" show-ref --verify --quiet "refs/remotes/origin/$1"
}

# Set _RS_SKIP to the ` git/<path> ` words of the merge tasks of the other
# branch model. Returns 2, after a message, when neither branch exists.
_rs_merge_model() {
  local tasks=git/.config/mise/tasks/code/merge
  local main=0 develop=0
  _rs_branch_exists main && main=1
  _rs_branch_exists develop && develop=1
  if ((main && develop)); then
    _RS_SKIP=" $tasks/_default "
  elif ((main || develop)); then
    _RS_SKIP=" $tasks/develop $tasks/main "
  else
    _rs_log "the repo has neither 'main' nor 'develop' - create one, then sync again"
    return 2
  fi
}

# Validate `direct_commit` of the `[branch.*]` tables of <values>, a boolean
# for `[branch.main]` and `[branch.develop]` only, also when it is false. The
# branch must exist, and with both branches, main can be true only when
# develop is true too. Sets _RS_HOOK_DROP to the ` <branch> ` words whose
# `--branch` pair leaves the no-commit-to-branch hook (`_rs_context`): each
# branch with `direct_commit = true`, and main or develop when it does not
# exist. Returns 2, after a message for each problem.
_rs_direct_commit() {
  local values=$1 out name value show rc=0 main=0 develop=0 tab=$'\t'
  show=$(_rs_path "$values")
  _RS_HOOK_DROP=' '
  out=$(_rs_gomplate -c "v=${values}" -i '<% if and (has .v "branch") (test.IsKind "map" .v.branch) %><% range $k, $b := .v.branch %><% if and (test.IsKind "map" $b) (has $b "direct_commit") %><% $k %>	<% if test.IsKind "bool" $b.direct_commit %><% $b.direct_commit %><% else %>bad<% end %>
<% end %><% end %><% end %>') || {
    _rs_log "cannot read [branch] of $show"
    return 2
  }
  _rs_branch_exists main && main=1
  _rs_branch_exists develop && develop=1
  while IFS="$tab" read -r name value; do
    [[ -n $name ]] || continue
    if [[ $name != main && $name != develop ]]; then
      _rs_log "[branch.${name}] in $show: direct_commit is a key of [branch.main] and [branch.develop] only"
      rc=2
    elif [[ $value == bad ]]; then
      _rs_log "[branch.${name}] in $show: direct_commit must be true or false"
      rc=2
    elif ! _rs_branch_exists "$name"; then
      _rs_log "[branch.${name}] in $show has direct_commit, but the branch '${name}' does not exist - create it, or remove the key"
      rc=2
    elif [[ $value == true ]]; then
      _RS_HOOK_DROP+="$name "
    fi
  done <<< "$out"
  if ((main && develop)) && [[ $_RS_HOOK_DROP == *" main "* && $_RS_HOOK_DROP != *" develop "* ]]; then
    _rs_log "[branch.main] in $show has direct_commit = true, but [branch.develop] does not - with main and develop, set direct_commit = true for develop too, or remove it from main"
    rc=2
  fi
  ((main)) || _RS_HOOK_DROP+="main "
  ((develop)) || _RS_HOOK_DROP+="develop "
  return "$rc"
}

# Examine `.config/fnox.toml` of this repo, when it exists: a repository does
# not use the fnox `default` profile. The top-level `[secrets]` table is that
# profile, so the file must not have it, also empty. The file must have 1 or
# more `[profiles.<name>]` tables, and no `[profiles.default]`. Returns 2,
# after a message for each problem.
_rs_fnox_profiles() {
  local values=$1 file="${MISE_PROJECT_ROOT}/.config/fnox.toml" out kind name repo rc=0
  [[ -f $file ]] || return 0
  repo=$(_rs_gomplate -c "v=${values}" -i '<% if has .v "repo_name" %><% .v.repo_name %><% end %>') || repo=''
  [[ -n $repo ]] || repo='<repo_name>'
  out=$(_rs_gomplate -c "f=${file}" -i '<% if has .f "secrets" %>secrets
<% end %><% if has .f "profiles" %><% if test.IsKind "map" .f.profiles %><% range $k, $p := .f.profiles %>profile <% $k %>
<% end %><% else %>bad
<% end %><% end %>') || {
    _rs_log "cannot read .config/fnox.toml"
    return 2
  }
  local count=0
  while read -r kind name; do
    case $kind in
      secrets)
        _rs_log ".config/fnox.toml has a top-level [secrets] table, the fnox default profile - move each secret to [profiles.${repo}.secrets], then delete the table (M25 of docs/sync/migrate.md)"
        rc=2
        ;;
      bad)
        _rs_log "profiles in .config/fnox.toml must be [profiles.<name>] tables (M25 of docs/sync/migrate.md)"
        rc=2
        ;;
      profile)
        if [[ $name == default ]]; then
          _rs_log "[profiles.default] in .config/fnox.toml: a repository does not use the fnox default profile - rename it, for example to [profiles.${repo}] (M25 of docs/sync/migrate.md)"
          rc=2
        else
          ((count += 1))
        fi
        ;;
    esac
  done <<< "$out"
  if ((count == 0)); then
    _rs_log ".config/fnox.toml has no named profile - add [profiles.${repo}.secrets]; a repository does not use the fnox default profile (M25 of docs/sync/migrate.md)"
    rc=2
  fi
  return "$rc"
}

# Remove the file <path> of <tool> from this repo, if it exists.
_rs_remove() {
  local tool=$1 path=$2 dry_run=$3 dest show
  dest="${MISE_PROJECT_ROOT}/${path}"
  show=$(_rs_path "$dest")
  [[ -e $dest ]] || return 0
  if ((dry_run)); then
    _rs_log "would remove $show"
    return 0
  fi
  rm -f -- "$dest" || {
    _rs_log "cannot remove $show"
    return 1
  }
  _rs_log "removed    $show"
}

# Set _RS_REQ_SKIP to the ` <tool>/<path>=<file> ` words of _RS_FILE_REQUIRES
# whose <file> this repo does not have (`_rs_has_file`). A path that more than
# one entry lists is skipped when one of its files is missing.
_rs_file_skips() {
  local word key file
  _RS_REQ_SKIP=' '
  for word in $_RS_FILE_REQUIRES; do
    key=${word%=*} file=${word#*=}
    [[ $_RS_REQ_SKIP != *" $key="* ]] || continue
    _rs_has_file "$file" || _RS_REQ_SKIP+="$word "
  done
}

# Do not write the file <path> of <tool>: its `files` entry needs a file that
# this repo does not have. Remove a copy with the bootstrap header, from a
# sync before the repo lost the file or before the entry had `files`. A copy
# without the header is the repo's own, and it stays.
_rs_skip_required() {
  local tool=$1 path=$2 dry_run=$3 requires dest show
  requires=${_RS_REQ_SKIP#* "$tool/$path="}
  requires=${requires%% *}
  dest="${MISE_PROJECT_ROOT}/${path%.tmpl}"
  show=$(_rs_path "$dest")
  if [[ -f $dest ]] && head -n 3 -- "$dest" | grep -qE 'Synced from (bootstrap|repo-config): '; then
    if ((dry_run)); then
      _rs_log "would remove $show (no $requires)"
      return 0
    fi
    rm -f -- "$dest" || {
      _rs_log "cannot remove $show"
      return 1
    }
    _rs_log "removed    $show (no $requires)"
    return 0
  fi
  _rs_log "skip file  $show (no $requires)"
}

# The environment names that a tools.toml can use in `default_envs` and
# `envs`, in their order. bootstrap is only for dev and ci. `environments` of
# the values file limits them.
_RS_ENV_NAMES='dev ci'
_rs_env_name() {
  [[ -n $1 && $1 != *[[:space:]]* && " $_RS_ENV_NAMES " == *" $1 "* ]]
}

# Set _RS_ENVS to the ` <env> ` words of `environments` in <values>, in the
# order of _RS_ENV_NAMES. Without the key, only dev. Returns 2, after a
# message, for a name other than dev or ci, or no dev.
_rs_envs() {
  local values=$1 list name
  list=$(_rs_list "$values" environments) || {
    _rs_log "cannot read $(_rs_path "$values")"
    return 2
  }
  if [[ -z ${list//[$'\n ']/} ]]; then
    _rs_log "$(_rs_path "$values") lists no environments - using dev only; add environments = [\"dev\", ...]"
    list=dev
  fi
  for name in $list; do
    [[ $name == dev || $name == ci ]] && continue
    _rs_log "environment '$name' in $(_rs_path "$values") is not one of dev, ci"
    return 2
  done
  list=" $(printf '%s ' $list)"
  if [[ $list != *" dev "* ]]; then
    _rs_log "environments in $(_rs_path "$values") must include dev"
    return 2
  fi
  _RS_ENVS=' '
  for name in $_RS_ENV_NAMES; do
    [[ $list == *" $name "* ]] && _RS_ENVS+="$name "
  done
  return 0
}

# Succeed when this repo has a file named <name>, at the root or down to 4
# folders below it, that git tracks or does not ignore. A git submodule is
# not searched: it has its own sync.
_rs_has_file() {
  local name=$1 found
  # A `*` of a pathspec also matches a `/`, so awk limits the depth. awk reads
  # to the end: an early exit can fail git with SIGPIPE.
  found=$(git -C "$MISE_PROJECT_ROOT" ls-files --cached --others --exclude-standard -- \
    "$name" "*/$name" 2> /dev/null \
    | awk -v n="$name" -F/ '!f && $NF == n && NF <= 5 { print; f = 1 }') || found=''
  [[ -n $found ]]
}

# Set _RS_TOOL_ENVS to the ` <tool>:<env> ` words and _RS_MISE_ENVS to the
# ` <mise-tool>:<env> ` words of the selected environments. A tool of _RS_SEL
# gets its `env`, else its `default_envs`; then, until nothing changes, each
# dependency of _RS_DEPS gets each environment of each tool that needs it. A
# tool that runs in CI needs its dependencies there too. `environments`
# limits every result. Each mise tool gets the environments of its tool,
# unless its `requires` file is missing (`_rs_has_file`).
# Returns 2, after a message, for an unknown name in `envs`, or for a tool in
# an environment that one of its mise tools does not allow in its `envs`
# (default dev).
_rs_mise_env() {
  local tool envs src deps dep entry allowed from env name changed=1
  _RS_TOOL_ENVS=' '
  # ` <tool>:<env>=<source> `: why the tool is in the environment, for the
  # message of a mise tool that does not allow it.
  local reasons=' '
  while read -r tool envs src; do
    [[ -n $tool ]] || continue
    if [[ $envs == - ]]; then
      envs=''
      for env in $_RS_DEFAULT_ENVS; do
        [[ $env == "$tool":* ]] && envs+="${env#*:},"
      done
      src=default
    fi
    for env in ${envs//,/ }; do
      [[ $_RS_ENVS == *" $env "* && $_RS_TOOL_ENVS != *" $tool:$env "* ]] || continue
      _RS_TOOL_ENVS+="$tool:$env "
      reasons+="$tool:$env=$src "
    done
  done <<< "$_RS_SEL"
  while ((changed)); do
    changed=0
    while read -r tool deps; do
      [[ -n $tool ]] || continue
      for env in $_RS_ENVS; do
        [[ $_RS_TOOL_ENVS == *" $tool:$env "* ]] || continue
        for dep in $deps; do
          if [[ $_RS_TOOL_ENVS != *" $dep:$env "* ]]; then
            _RS_TOOL_ENVS+="$dep:$env "
            reasons+="$dep:$env=$tool "
            changed=1
          fi
        done
      done
    done <<< "$_RS_DEPS"
  done
  _RS_MISE_ENVS=' '
  local requires present
  while read -r tool entry allowed _; do
    [[ -n $entry ]] || continue
    [[ $allowed == - ]] && allowed=dev
    present=1
    requires=${_RS_MISE_REQUIRES#* "$entry="}
    if [[ $requires != "$_RS_MISE_REQUIRES" ]]; then
      _rs_has_file "${requires%% *}" || present=0
    fi
    for name in ${allowed//,/ }; do
      if ! _rs_env_name "$name"; then
        _rs_log "envs of mise tool '$entry' in tools/$tool/tools.toml: '$name' is not one of ${_RS_ENV_NAMES// /, }"
        return 2
      fi
    done
    for env in $_RS_ENVS; do
      [[ $_RS_TOOL_ENVS == *" $tool:$env "* ]] || continue
      if [[ ,$allowed, != *",$env,"* ]]; then
        from=${reasons#* "$tool:$env="}
        from=${from%% *}
        case $from in
          default)
            _rs_log "tools/$tool/tools.toml: default_envs has '$env', but its mise tool '$entry' allows only ${allowed//,/, }"
            ;;
          tools.* | packs.*)
            _rs_log "env '$env' of [$from] in the values file: mise tool '$entry' of tools/$tool allows only ${allowed//,/, }"
            ;;
          *)
            _rs_log "tools/$from needs tools/$tool in '$env', but its mise tool '$entry' allows only ${allowed//,/, }"
            ;;
        esac
        return 2
      fi
      ((present)) || continue
      [[ $_RS_MISE_ENVS == *" $entry:$env "* ]] || _RS_MISE_ENVS+="$entry:$env "
    done
  done <<< "$_RS_MISE_ENTRIES"
  return 0
}

# The templates that the override check and the mise template share.
# `rs_leaves` prints the key path of each value of the table .v that is not a
# table, as a JSON list after the path .p, one per line. `rs_has` prints 1 when
# the table .v has a value at the path .p that is not a table.
_RS_DEFINES='<% define "rs_leaves" %><% range $k, $x := .v %><% $p := coll.Append $k $.p %><% if test.IsKind "map" $x %><% template "rs_leaves" (dict "p" $p "v" $x) %><% else %><% $p | data.ToJSON %>
<% end %><% end %><% end -%>
<% define "rs_has" %><% $v := .v %><% $ok := true %><% range .p %><% if not (test.IsKind "map" $v) %><% $ok = false %><% else if not (has $v .) %><% $ok = false %><% else %><% $v = index $v . %><% end %><% end %><% if and $ok (not (test.IsKind "map" $v)) %>1<% end %><% end -%>
'

# The template that examines `[overrides]` of the values file (`.o`) against
# the tools.toml of each selected tool (`.tool_<name>`, the names in
# REPO_SYNC_TOOLS). It prints one `<problem> <path> <arg>` line, tab
# separated, for each problem:
#   table    a key of [overrides] that must be a table and is not
#   key      a key of [overrides] other than mise, mise_env and gitignore
#   gikey    a key of [overrides.gitignore] other than add and remove
#   gilist   an add or a remove that is not a list of one-line strings
#   giempty  an empty line in add or remove
#   envname  an environment of [overrides.mise_env] that is not dev or ci
#   env      an environment that is not in REPO_SYNC_ENVS
#   lock     an `envs`, a `depends`, a `requires` or a `files` of a mise tool
#   none     a value that no selected tool has; <arg> is the path in tools.toml
# It also prints an `add <path> <line>` or a `remove <path> <line>` line for
# each line of [overrides.gitignore], without the spaces at the start and the
# end. <path> is overrides.gitignore.<list>.
_RS_OVERRIDES_TEMPLATE="$_RS_DEFINES"'<% if has .o "overrides" -%>
<% $ov := .o.overrides -%>
<% $envs := env.Getenv "REPO_SYNC_ENVS" -%>
<% $tools := strings.Split " " (env.Getenv "REPO_SYNC_TOOLS") -%>
<% if not (test.IsKind "map" $ov) %>table	overrides	-
<% else -%>
<% range $k, $x := $ov -%>
<% if not (has (coll.Slice "mise" "mise_env" "gitignore") $k) %>key	overrides.<% $k %>	-
<% else if not (test.IsKind "map" $x) %>table	overrides.<% $k %>	-
<% else if eq $k "gitignore" -%>
<% range $gk, $gv := $x -%>
<% if not (has (coll.Slice "add" "remove") $gk) %>gikey	overrides.<% $k %>.<% $gk %>	-
<% else if not (test.IsKind "slice" $gv) %>gilist	overrides.<% $k %>.<% $gk %>	-
<% else -%>
<% range $gv -%>
<% if not (test.IsKind "string" .) %>gilist	overrides.<% $k %>.<% $gk %>	-
<% else if or (strings.Contains "\n" .) (strings.Contains "\t" .) %>gilist	overrides.<% $k %>.<% $gk %>	-
<% else if not (strings.TrimSpace .) %>giempty	overrides.<% $k %>.<% $gk %>	-
<% else %><% $gk %>	overrides.<% $k %>.<% $gk %>	<% strings.TrimSpace . %>
<% end -%>
<% end -%>
<% end -%>
<% end -%>
<% else if eq $k "mise_env" -%>
<% range $e, $y := $x -%>
<% if not (has (coll.Slice "dev" "ci") $e) %>envname	overrides.mise_env.<% $e %>	<% $e %>
<% else if not (strings.Contains (printf " %s " $e) $envs) %>env	overrides.mise_env.<% $e %>	<% $e %>
<% else if not (test.IsKind "map" $y) %>table	overrides.mise_env.<% $e %>	-
<% end -%>
<% end -%>
<% end -%>
<% end -%>
<% range strings.Split "\n" (tmpl.Exec "rs_leaves" (dict "p" (coll.Slice) "v" $ov)) -%>
<% if . -%>
<% $p := data.JSONArray . -%>
<% $k := index $p 0 -%>
<% $rest := coll.Slice -%>
<% $only := "" -%>
<% if and (eq $k "mise") (gt (len $p) 1) %><% $rest = slice $p 1 -%>
<% else if and (eq $k "mise_env") (gt (len $p) 2) (has (coll.Slice "dev" "ci") (index $p 1)) (strings.Contains (printf " %s " (index $p 1)) $envs) %><% $rest = slice $p 2 %><% $only = index $p 1 %><% end -%>
<% if $rest -%>
<% if and (gt (len $rest) 2) (eq (index $rest 0) "tools") (has (coll.Slice "envs" "depends" "requires" "files") (index $rest 2)) -%>
lock	overrides.<% join $p "." %>	-
<% else -%>
<% $found := false -%>
<% range $tools -%>
<% if . -%>
<% $t := index $ (printf "tool_%s" .) -%>
<% if tmpl.Exec "rs_has" (dict "v" (index $t "mise") "p" $rest) %><% $found = true %><% end -%>
<% if has $t "mise_env" -%>
<% range $e, $y := $t.mise_env -%>
<% if and (strings.Contains (printf " %s " $e) $envs) (or (not $only) (eq $only $e)) (tmpl.Exec "rs_has" (dict "v" $y "p" $rest)) %><% $found = true %><% end -%>
<% end -%>
<% end -%>
<% end -%>
<% end -%>
<% if not $found -%>
none	overrides.<% join $p "." %>	<% if $only %>mise_env.<% $only %>.<% join $rest "." %> or <% end %>mise.<% join $rest "." %>
<% end -%>
<% end -%>
<% end -%>
<% end -%>
<% end -%>
<% end -%>
<% end -%>'

# Examine `[overrides]` of <values> against the tools.toml of each selected
# tool in the clone <dir>. Each value of `[overrides.mise]` and
# `[overrides.mise_env.<env>]` must replace a value that a selected tool has,
# at the same path below `[mise]` or `[mise_env.<env>]`. The `envs`, the
# `depends`, the `requires` and the `files` of a mise tool decide the tools,
# the files and the environments, so they cannot be overridden. Each line of `remove` of
# `[overrides.gitignore]` must be a line of the shipped file, and no line can
# be in `add` and in `remove`. Sets _RS_GI_ADD and _RS_GI_REMOVE to the
# `gitignore<tab><line>` lines of `add` and `remove`, and _RS_VALUES_NOTE to
# the values file for the override comments. Returns 2, after a message for
# each problem, also when the old `.config/repo-sync/gitignore` exists.
# With a third argument `local`, for `repo_sync --check`, it reads no clone:
# <dir> is not used, no tool is selected, and it skips the problems that need
# the tools or the shipped files (`none`, a `remove` line that is not
# shipped). When `_rs_envs` failed,
# _RS_ENVS is empty, and it also skips `env` and `envname`.
_rs_overrides() {
  local dir=$1 values=$2 only_local=0 out tool problem path arg rc=0 show
  [[ ${3:-} == local ]] && only_local=1
  local tools=${_RS_TOOLS:-} envs=${_RS_ENVS:-}
  ((only_local)) && tools=''
  show=$(_rs_path "$values")
  _RS_GI_ADD='' _RS_GI_REMOVE='' _RS_VALUES_NOTE=${values#"$MISE_PROJECT_ROOT"/}
  if [[ -f ${MISE_PROJECT_ROOT}/.config/repo-sync/gitignore ]]; then
    _rs_log ".config/repo-sync/gitignore is no longer used - move its lines to add of [overrides.gitignore] in $show, then delete it (M18 of docs/sync/migrate.md)"
    rc=2
  fi
  local args=(-c "o=${values}")
  for tool in $tools; do
    args+=(-c "tool_${tool}=${dir}/tools/${tool}/tools.toml")
  done
  out=$(REPO_SYNC_ENVS=$envs REPO_SYNC_TOOLS=$tools _rs_gomplate "${args[@]}" -i "$_RS_OVERRIDES_TEMPLATE") || {
    _rs_log "cannot read [overrides] of $show"
    return 2
  }
  while IFS=$'\t' read -r problem path arg; do
    case $problem in
      table)
        _rs_log "$path in $show must be a table"
        ;;
      key)
        if [[ $path == overrides.graphifyignore ]]; then
          _rs_log "$path in $show is no longer used: bootstrap does not ship .graphifyignore - remove the table (M24 of docs/sync/migrate.md)"
        else
          _rs_log "$path in $show: the only keys of [overrides] are mise, mise_env and gitignore"
        fi
        ;;
      gikey)
        _rs_log "$path in $show: the only keys of [${path%.*}] are add and remove"
        ;;
      gilist)
        _rs_log "$path in $show must be a list of one-line strings, for example [\"/build/\"]"
        ;;
      giempty)
        _rs_log "$path in $show has an empty line"
        ;;
      add | remove)
        # <path> is overrides.<ignore>.<list>.
        path=${path#overrides.}
        path=${path%.*}
        if [[ $problem == add ]]; then
          _RS_GI_ADD+="$path"$'\t'"$arg"$'\n'
        else
          _RS_GI_REMOVE+="$path"$'\t'"$arg"$'\n'
        fi
        continue
        ;;
      envname | env)
        # Without environments, `_rs_envs` already reported the cause.
        [[ -n ${envs// /} ]] || continue
        if [[ $problem == envname ]]; then
          _rs_log "$path in $show: '$arg' is not one of ${_RS_ENV_NAMES// /, }"
        else
          _rs_log "$path in $show: '$arg' is not in environments:${envs% }"
        fi
        ;;
      lock)
        _rs_log "$path in $show: the envs, the depends, the requires and the files of a mise tool cannot be overridden - use env of [tools.<tool>]"
        ;;
      none)
        ((only_local)) && continue
        _rs_log "$path in $show: no selected tool has $arg - the path after overrides. is the path in tools/<tool>/tools.toml"
        ;;
      *)
        continue
        ;;
    esac
    rc=2
  done <<< "$out"
  local ignore line shipped
  while IFS=$'\t' read -r ignore line; do
    [[ -n $line ]] || continue
    shipped=tools/git/.gitignore
    if [[ $'\n'$_RS_GI_ADD == *$'\n'"$ignore"$'\t'"$line"$'\n'* ]]; then
      _rs_log "overrides.$ignore in $show: '$line' is in add and in remove - keep one"
      rc=2
    elif ((only_local)); then
      continue
    elif ! RS_LINE=$line awk '{ gsub(/^[ \t]+|[ \t]+$/, "") } $0 == ENVIRON["RS_LINE"] { found = 1 } END { exit !found }' "$dir/$shipped" 2> /dev/null; then
      _rs_log "overrides.$ignore.remove in $show: '$line' is not a line of the shipped .$ignore ($shipped)"
      rc=2
    fi
  done <<< "$_RS_GI_REMOVE"
  return "$rc"
}

# The template that builds one environment, REPO_SYNC_ENV, from the `[mise]`
# and `[mise_env]` tables of a tools.toml (`.t`), as TOML. An entry is in the
# environment when ` <name>:<env> ` is in REPO_SYNC_ENVS. The other sections,
# and `[mise_env.<env>]`, are in it only when REPO_SYNC_IN is 1 (the tool is in
# the environment); the dev-only sections only in dev. A section that it does
# not know stops the render. REPO_SYNC_DEV_ALIASES adds `<name>=<command>`
# lines to `[shell_alias]` of dev.
# Before that, each value of `[overrides]` of the values file (`.o`) replaces
# the value at its path in `[mise]` and in `[mise_env.<env>]`, where the tool
# has it. A value of `[overrides.mise_env.<env>]` goes to `[mise_env.<env>]`,
# so it wins over `[overrides.mise]`. After the TOML, a `#@override <path>`
# line names each output path that an override changed.
_RS_MISE_TEMPLATE="$_RS_DEFINES"'<% $m := dict %><% if has .t "mise" %><% $m = .t.mise %><% end -%>
<% $env := env.Getenv "REPO_SYNC_ENV" -%>
<% $me := dict %><% if and (has .t "mise_env") (has .t.mise_env $env) %><% $me = index .t.mise_env $env %><% end -%>
<% $marks := coll.Slice -%>
<% if and (has .o "overrides") (test.IsKind "map" .o.overrides) -%>
<% $ov := .o.overrides -%>
<% range strings.Split "\n" (tmpl.Exec "rs_leaves" (dict "p" (coll.Slice) "v" $ov)) -%>
<% if . -%>
<% $p := data.JSONArray . -%>
<% $k := index $p 0 -%>
<% $rest := coll.Slice -%>
<% if and (eq $k "mise") (gt (len $p) 1) %><% $rest = slice $p 1 -%>
<% else if and (eq $k "mise_env") (gt (len $p) 2) (eq (index $p 1) $env) %><% $rest = slice $p 2 %><% end -%>
<% if $rest -%>
<% $v := $ov %><% range $p %><% $v = index $v . %><% end -%>
<% $n := $v %><% range math.Seq (math.Sub (len $rest) 1) 0 %><% $n = dict (index $rest .) $n %><% end -%>
<% $inm := tmpl.Exec "rs_has" (dict "v" $m "p" $rest) -%>
<% $ine := tmpl.Exec "rs_has" (dict "v" $me "p" $rest) -%>
<% if and $inm (eq $k "mise") %><% $m = coll.Merge $n $m %><% end -%>
<% if or $ine (and $inm (eq $k "mise_env")) %><% $me = coll.Merge $n $me %><% end -%>
<% if or $inm $ine %><% $marks = coll.Append (join $rest ".") $marks %><% end -%>
<% end -%>
<% end -%>
<% end -%>
<% end -%>
<% $envw := env.Getenv "REPO_SYNC_ENVS" -%>
<% $entry := coll.Slice "tools" "tool_alias" "plugins" -%>
<% $folder := coll.Slice "settings" "env" "tool_config" "task_config" "task_templates" "doctor" "deps" "oci" -%>
<% $devonly := coll.Slice "vars" "secrets" "redactions" "shell_alias" "hooks" "watch_files" "daemons" "daemon_groups" "daemons_settings" "daemon_providers" "tasks" -%>
<% $in := eq (env.Getenv "REPO_SYNC_IN") "1" -%>
<% $out := dict -%>
<% range $s, $body := $m -%>
<% if has $entry $s -%>
<% $a := dict -%>
<% range $k, $v := $body -%>
<% if and (eq $s "tools") (test.IsKind "map" $v) %><% $v = coll.Omit "envs" "requires" "files" $v %><% end -%>
<% if strings.Contains (printf " %s:%s " $k $env) $envw %><% $a = coll.Merge (dict $k $v) $a %><% end -%>
<% end -%>
<% if $a %><% $out = coll.Merge (dict $s $a) $out %><% end -%>
<% else if has $folder $s -%>
<% if $in %><% $out = coll.Merge (dict $s $body) $out %><% end -%>
<% else if has $devonly $s -%>
<% if and $in (eq $env "dev") %><% $out = coll.Merge (dict $s $body) $out %><% end -%>
<% else -%>
<% test.Fail (printf "[mise.%s] is not supported in a tools.toml" $s) -%>
<% end -%>
<% end -%>
<% range $s, $body := $me -%>
<% if not (or (has $entry $s) (has $folder $s) (has $devonly $s)) %><% test.Fail (printf "[mise_env.%s.%s] is not supported in a tools.toml" $env $s) %><% end -%>
<% if $in -%>
<% if has $out $s %><% $body = coll.Merge $body (index $out $s) %><% end -%>
<% $out = coll.Merge (dict $s $body) $out -%>
<% end -%>
<% end -%>
<% $extra := env.Getenv "REPO_SYNC_DEV_ALIASES" -%>
<% if and $in (eq $env "dev") $extra -%>
<% $al := dict %><% if has $out "shell_alias" %><% $al = index $out "shell_alias" %><% end -%>
<% range (strings.Split "\n" $extra) %><% if . %><% $kv := strings.SplitN "=" 2 . %><% $al = coll.Merge (dict (index $kv 0) (index $kv 1)) $al %><% end %><% end -%>
<% $out = coll.Merge (dict "shell_alias" $al) $out -%>
<% end -%>
<% if $out %><% $out | data.ToTOML %><% end -%>
<% range $marks %>#@override <% . %>
<% end -%>'

# Generate the mise config of <tool> from the `[mise]` and `[mise_env]` tables
# of its tools.toml in the clone <dir>, with `[overrides]` of <values> applied:
# one `mise.<env>.toml` for each selected environment with content, into
# tools/<tool>/.config/mise/conf.d/<tool>/ of the clone. Each line that an
# override changed gets an `# override: <values>` comment. The file loop then
# syncs it like a shipped file. Records each file in _RS_GENERATED. Returns 2,
# after a message, when the config cannot be generated; the existing files of
# the folder are then kept.
_rs_mise_render() {
  local dir=$1 tool=$2 values=$3 folder=$2 env name rel tmp err
  local note="# override: ${values#"$MISE_PROJECT_ROOT"/}"
  local out="${dir}/tools/${tool}/.config/mise/conf.d/${folder}"
  local header="# Synced from bootstrap: tools/${tool}/tools.toml. Do not edit this file.
# The next sync replaces it, and a manual change is lost.
"
  tmp="${dir}/.repo-sync-mise" err="${dir}/.repo-sync-mise-err"
  # `setup-all` and `setup-<submodule>` exist only in a repo with git
  # submodules. They depend on this repo, not on tools.toml, so the `mise`
  # tool, which has the `setup` alias, gets them here.
  local aliases='' subs sub
  if [[ $tool == mise && -f ${MISE_PROJECT_ROOT}/.gitmodules ]]; then
    subs=$(git -C "$MISE_PROJECT_ROOT" submodule --quiet foreach --recursive 'echo $displaypath' 2> /dev/null) || subs=''
    if [[ -n $subs ]]; then
      aliases='setup-all=mise run setup --all'
      for sub in $subs; do
        aliases+=$'\n'"setup-${sub}=mise run setup --${sub}"
      done
    fi
  fi
  local in
  for env in $_RS_ENVS; do
    name=mise.${env}.toml
    rel=".config/mise/conf.d/${folder}/${name}"
    in=0
    [[ $_RS_TOOL_ENVS == *" $tool:$env "* ]] && in=1
    # gomplate writes no file for an empty output, so the previous one must go.
    rm -f -- "$tmp"
    if ! REPO_SYNC_ENV=$env REPO_SYNC_ENVS=$_RS_MISE_ENVS REPO_SYNC_IN=$in REPO_SYNC_DEV_ALIASES=$aliases \
      _rs_gomplate -c "t=${dir}/tools/${tool}/tools.toml" -c "o=${values}" -i "$_RS_MISE_TEMPLATE" -o "$tmp" 2> "$err"; then
      _rs_log "tools/$tool/tools.toml: cannot generate the mise config: $(sed -n 's/.*error calling Fail: template generation failed: //p' "$err" | sed 's/"}$//')"
      for name in $_RS_ENVS; do
        _RS_SEEN+="${rel%/*}/mise.${name}.toml "
      done
      return 2
    fi
    [[ -e $tmp ]] || continue
    # The `#@override <path>` lines name the overridden keys. Mark each of
    # them in the TOML, then drop those lines. <path> is the table header and
    # the key, joined with dots and without quotes.
    awk -v note="$note" '
      FNR == NR { if (index($0, "#@override ") == 1) mark[substr($0, 12)] = 1; next }
      index($0, "#@override ") == 1 { next }
      /^[ \t]*\[/ { head = $0; gsub(/^[ \t]*\[+|\]+[ \t]*$|"/, "", head) }
      !/^[ \t]*\[/ && / = / {
        key = $0; sub(/ = .*/, "", key); gsub(/^[ \t]+|"/, "", key)
        if ((head == "" ? key : head "." key) in mark) $0 = $0 "  " note
      }
      { print }
    ' "$tmp" "$tmp" > "$tmp.marked" && mv -f -- "$tmp.marked" "$tmp" || return 1
    [[ -s $tmp && -n $(tr -d ' \n' < "$tmp") ]] || continue
    if [[ -e $out/$name ]]; then
      _rs_log "tools/$tool ships $rel and also generates it from [mise] - remove one"
      return 2
    fi
    mkdir -p -- "$out" &&
      { printf '%s\n' "$header" && cat -- "$tmp"; } > "$out/$name" &&
      chmod 644 "$out/$name" || return 1
    _RS_GENERATED+="$tool/$rel "
  done
  rm -f -- "$tmp" "$err"
}

# Remove each `.config/mise/conf.d/*/mise*.toml` with the bootstrap header
# that this run did not write or keep (_RS_SEEN): its tool or its layout is
# gone. A file without the header belongs to the repo and stays.
_rs_stale() {
  local dry_run=$1 file rel rc=0
  local root="${MISE_PROJECT_ROOT}/.config/mise/conf.d"
  [[ -d $root ]] || return 0
  while IFS= read -r file; do
    rel=${file#"$MISE_PROJECT_ROOT"/}
    [[ $_RS_SEEN != *" $rel "* ]] || continue
    # `repo-config` is the old name of this repository, in older copies.
    head -n 1 -- "$file" | grep -qE '^# Synced from (bootstrap|repo-config): ' || continue
    _rs_remove '' "$rel" "$dry_run" || rc=$?
    ((dry_run)) || rmdir -- "${file%/*}" 2> /dev/null || true
  done < <(find "$root" -mindepth 2 -maxdepth 2 -type f -name 'mise*.toml' | sort)
  return "$rc"
}

# Write the template context to <out>: the values of <values>, with
# `members`, `submodules`, `tools`, `extensions` and `precommit` merged in
# first, so a key of the same name in the values file cannot replace them.
# <dir> is the clone.
_rs_context() {
  local dir=$1 values=$2 out=$3 rows members folders types tool
  rows=$(_rs_members "$values" "template context") || return 2
  members=$(cut -f1 <<< "$rows")
  folders=$(cut -f2 <<< "$rows")
  types=$(cut -f3 <<< "$rows")
  # The git submodules alone: `members` also has the folder members.
  local submodules=''
  if [[ -f ${MISE_PROJECT_ROOT}/.gitmodules ]]; then
    submodules=$(git -C "$MISE_PROJECT_ROOT" submodule --quiet foreach --recursive 'echo $displaypath' 2> /dev/null) || submodules=''
  fi
  # One context per tool manifest, `tool_<name>`, for the `[[precommit]]`
  # entries; `repo_precommit` for the repo's own entries.
  local args=(-c "v=${values}")
  for tool in $_RS_TOOLS; do
    args+=(-c "tool_${tool}=${dir}/tools/${tool}/tools.toml")
  done
  local own="${MISE_PROJECT_ROOT}/.config/repo-sync/pre-commit.yaml"
  local has_own=''
  if [[ -f $own ]]; then
    args+=(-c "repo_precommit=${own}")
    has_own=1
  fi
  # The no-commit-to-branch hook loses each `--branch <b>` pair of a branch
  # in _RS_HOOK_DROP (`_rs_direct_commit`). Only that pair form changes. A
  # hook that had a pair and has none left goes, also with other args: without
  # `--branch`, the hook protects main and master. An entry with no hook left
  # goes too.
  REPO_SYNC_HOOK_DROP=$_RS_HOOK_DROP REPO_SYNC_OWN_PRECOMMIT=$has_own REPO_SYNC_MEMBERS=$members REPO_SYNC_MEMBER_FOLDERS=$folders REPO_SYNC_MEMBER_TYPES=$types REPO_SYNC_SUBMODULES=$submodules REPO_SYNC_TOOLS=$(printf '%s\n' $_RS_TOOLS) REPO_SYNC_EXTENSIONS=$_RS_EXTENSIONS \
    _rs_gomplate "${args[@]}" -o "$out" \
    -i '<% $ctx := dict %><% range (coll.Slice "members" "submodules" "tools" "extensions") %><% $l := coll.Slice %><% range (env.Getenv (printf "REPO_SYNC_%s" (strings.ToUpper .)) | strings.Split "\n") %><% if . %><% $l = coll.Append . $l %><% end %><% end %><% $ctx = coll.Merge $ctx (dict . $l) %><% end %><% $mf := dict %><% $mt := dict %><% $fl := env.Getenv "REPO_SYNC_MEMBER_FOLDERS" | strings.Split "\n" %><% $tl := env.Getenv "REPO_SYNC_MEMBER_TYPES" | strings.Split "\n" %><% range $i, $n := $ctx.members %><% $mf = coll.Merge (dict $n (index $fl $i)) $mf %><% $mt = coll.Merge (dict $n (index $tl $i)) $mt %><% end %><% $ctx = coll.Merge $ctx (dict "member_folders" $mf "member_types" $mt) %><% $pc := coll.Slice %><% range $ctx.tools %><% $t := index $ (printf "tool_%s" .) %><% if has $t "precommit" %><% range $t.precommit %><% $pc = coll.Append . $pc %><% end %><% end %><% end %><% if env.Getenv "REPO_SYNC_OWN_PRECOMMIT" %><% range $.repo_precommit %><% $pc = coll.Append . $pc %><% end %><% end %><% $drop := strings.Split " " (strings.TrimSpace (env.Getenv "REPO_SYNC_HOOK_DROP")) -%>
<% $npc := coll.Slice -%>
<% range $e := $pc -%>
<% $ne := $e %><% $keep := true -%>
<% if and (test.IsKind "map" $e) (has $e "hooks") (test.IsKind "slice" (index $e "hooks")) -%>
<% $hs := coll.Slice %><% $chg := false -%>
<% range $h := index $e "hooks" -%>
<% $nh := $h %><% $hk := true -%>
<% if and (test.IsKind "map" $h) (has $h "id") (eq (printf "%v" (index $h "id")) "no-commit-to-branch") (has $h "args") (test.IsKind "slice" (index $h "args")) -%>
<% $in := index $h "args" %><% $n := len $in %><% $a := coll.Slice %><% $had := false %><% $left := false %><% $skip := false -%>
<% range $i, $x := $in -%>
<% if $skip %><% $skip = false -%>
<% else if and (eq (printf "%v" $x) "--branch") (lt (math.Add $i 1) $n) -%>
<% $had = true %><% $skip = true %><% $b := index $in (math.Add $i 1) -%>
<% if not (has $drop (printf "%v" $b)) %><% $left = true %><% $a = coll.Append $b (coll.Append $x $a) %><% end -%>
<% else %><% $a = coll.Append $x $a %><% end -%>
<% end -%>
<% if $had -%>
<% if not $left %><% $hk = false %><% $chg = true -%>
<% else if ne (len $a) $n %><% $nh = coll.Merge (dict "args" $a) $h %><% $chg = true %><% end -%>
<% end -%>
<% end -%>
<% if $hk %><% $hs = coll.Append $nh $hs %><% end -%>
<% end -%>
<% if $chg %><% if $hs %><% $ne = coll.Merge (dict "hooks" $hs) $e %><% else %><% $keep = false %><% end %><% end -%>
<% end -%>
<% if $keep %><% $npc = coll.Append $ne $npc %><% end -%>
<% end -%>
<% $ctx = coll.Merge $ctx (dict "precommit" $npc) %><% coll.Merge $ctx .v | data.ToJSON %>' >&2
}

# Remove each synced file (with the bootstrap header) that is at the place
# of a folder in <dir> or above it, up to the repo root. Returns 1, after a
# message, when such a file is the repo's own.
_rs_unblock() {
  local dir=$1 dry_run=$2 show
  while [[ $dir == "$MISE_PROJECT_ROOT"/* ]]; do
    if [[ -f $dir && ! -L $dir ]]; then
      show=$(_rs_path "$dir")
      if ! head -n 3 -- "$dir" | grep -qE 'Synced from (bootstrap|repo-config): '; then
        _rs_log "$show is a file of this repo, but the sync needs a folder there - move it"
        return 1
      fi
      if ((dry_run)); then
        _rs_log "would remove $show (a folder replaces it)"
      else
        rm -f -- "$dir" || return 1
        _rs_log "removed    $show (a folder replaces it)"
      fi
      return 0
    fi
    dir=$(dirname -- "$dir")
  done
}

# Sync the file <path> of <tool> from the clone in <dir>, first step: render
# the file into a temp file. Leaves the destination untouched when it is a
# seed that exists, when it is a seed whose `seed_requires` file is missing,
# or on any failure. Else it adds `<tool><tab><path><tab><temp file>` to
# _RS_PENDING and sets _RS_DEFERRED, and `_rs_file_finish` does the rest after
# `_rs_format`.
_rs_file() {
  local dir=$1 tool=$2 path=$3 dry_run=$4 ctx=$5
  local src="${dir}/tools/${tool}/${path}" out=${path%.tmpl}
  local dest destdir tmp show rc=0 env
  _RS_DEFERRED=''
  dest="${MISE_PROJECT_ROOT}/${out}"
  show=$(_rs_path "$dest")
  # A mise file of an environment that this repo does not use. Not recorded,
  # so `_rs_stale` removes an old copy with the header.
  if [[ $out == .config/mise/conf.d/*/mise.*.toml ]]; then
    env=${out##*/mise.}
    env=${env%.toml}
    if [[ $_RS_ENVS != *" $env "* ]]; then
      _rs_log "skip env   $show"
      return 0
    fi
  fi
  # Written or kept: `_rs_stale` must not remove it, also after a failure.
  _RS_SEEN+="$out "

  if [[ $_RS_SEEDS == *" $tool/$path "* && -e $dest ]]; then
    _rs_log "kept seed  $show"
    return 0
  fi
  # A seed with `seed_requires` is only for a repo that has the named file.
  local requires=${_RS_SEED_REQUIRES#* "$tool/$path="}
  if [[ $requires != "$_RS_SEED_REQUIRES" ]]; then
    requires=${requires%% *}
    if [[ ! -e ${MISE_PROJECT_ROOT}/${requires} ]]; then
      _rs_log "skip seed  $show (no $requires)"
      return 0
    fi
  fi

  # A synced file can become a folder in a later layout, for example
  # code/format -> code/format/_default. Remove the old synced file that is in
  # the way. A file without the header is the repo's, so the sync stops there.
  _rs_unblock "$(dirname -- "$dest")" "$dry_run" || return 1

  if ((dry_run)); then
    destdir=${TMPDIR:-/tmp}
  else
    destdir=$(dirname -- "$dest")
    mkdir -p -- "$destdir" || {
      _rs_log "cannot create $(_rs_path "$destdir")"
      return 1
    }
  fi
  # Temp file in the destination directory so the final mv is atomic.
  tmp=$(mktemp "${destdir%/}/.repo-sync.XXXXXX") || {
    _rs_log "cannot create a temp file in $(_rs_path "$destdir")"
    return 1
  }
  _RS_TMPS+=("$tmp")

  if [[ $path == *.tmpl ]]; then
    if [[ -z $ctx ]]; then
      rc=2
    elif ! _rs_gomplate -c ".=${ctx}?type=application/json" -f "$src" -o "$tmp" >&2; then
      _rs_log "$tool/$path: gomplate failed to render the template"
      rc=2
    fi
  else
    cp -- "$src" "$tmp" || rc=1
  fi
  # The hook revisions: each one becomes the newest tag, chosen by
  # `pre-commit autoupdate` itself. The `rev` in a tools.toml is a real tag, so
  # an older repo-sync without this step still writes a config that runs. A later autoupdate in
  # this repo then picks the same tags, so it and the sync never undo each
  # other. It needs the network; on a failure the existing file stays.
  # REPO_SYNC_NO_AUTOUPDATE=1 skips it, for the tests.
  if ((rc == 0)) && [[ $out == .config/pre-commit-config.yaml ]]; then
    if [[ ${REPO_SYNC_NO_AUTOUPDATE:-} == 1 ]]; then
      _rs_log "$tool/$path: REPO_SYNC_NO_AUTOUPDATE=1 - pre-commit autoupdate skipped"
    elif ! command -v pre-commit > /dev/null 2>&1; then
      _rs_log "$tool/$path: pre-commit is not available to resolve the hook revisions"
      rc=5
    elif ! (cd "$MISE_PROJECT_ROOT" && pre-commit autoupdate --config "$tmp" > /dev/null 2>&1); then
      _rs_log "$tool/$path: pre-commit autoupdate failed - examine the network and the hook repositories"
      rc=5
    fi
  fi

  if ((rc != 0)); then
    rm -f -- "$tmp"
    [[ -e $dest ]] && _rs_log "kept existing $show"
    return "$rc"
  fi

  # A rendered template or a generated mise config goes through this repo's
  # formatter before the compare. Otherwise the format hook changes the
  # render, and the next sync writes it back: a loop. A plain file needs no
  # step, because dprint formats its source in bootstrap. The file goes to the
  # stage, at its path in this repo, and `_rs_format` formats the stage in one
  # dprint call.
  if [[ ($path == *.tmpl || $_RS_GENERATED == *" $tool/$path "*) && -n $_RS_STAGE ]]; then
    mkdir -p -- "$(dirname -- "$_RS_STAGE/$out")" && cp -- "$tmp" "$_RS_STAGE/$out" || true
  fi
  _RS_PENDING+="$tool"$'\t'"$path"$'\t'"$tmp"$'\n'
  _RS_DEFERRED=1
}

# Format the files of the stage in one dprint call. The stage has a copy of
# the dprint config of this repo at the same path, so the plugins and the
# excludes select the same files as in this repo. Without dprint, or if
# dprint fails for a file, the raw render of that file stays.
_rs_format() {
  [[ -n $_RS_STAGE ]] || return 0
  local files name
  files=$(cd "$_RS_STAGE" && find . -type f | sed 's#^\./##' | grep -vxE '\.?dprint\.jsonc?|\.config/dprint\.jsonc?') || files=''
  [[ -n $files ]] || return 0
  (cd "$MISE_PROJECT_ROOT" && mise x -- bash -c 'cd "$1" && dprint fmt --no-gitignore --allow-no-files --stdin-files' _ "$_RS_STAGE" <<< "$files") > /dev/null 2>&1 || true
}

# Sync the file <path> of <tool>, second step: take the formatted copy from the
# stage, apply the overrides, and compare and write the temp file <tmp> of
# `_rs_file`.
_rs_file_finish() {
  local dir=$1 tool=$2 path=$3 dry_run=$4 tmp=$5
  local src="${dir}/tools/${tool}/${path}" out=${path%.tmpl}
  local dest show rc=0
  dest="${MISE_PROJECT_ROOT}/${out}"
  show=$(_rs_path "$dest")
  if [[ -n $_RS_STAGE && -f $_RS_STAGE/$out ]]; then
    cp -- "$_RS_STAGE/$out" "$tmp" || true
  fi

  # [overrides.gitignore]: comment out each line of `remove`, then add the
  # lines of `add` at the end, so they win.
  if ((rc == 0)) && [[ $path == .gitignore && -n $_RS_GI_REMOVE$_RS_GI_ADD ]]; then
    local gi_add gi_remove
    gi_add=$(printf '%s' "$_RS_GI_ADD" | sed -n "s/^${path#.}"$'\t'"//p")
    gi_remove=$(printf '%s' "$_RS_GI_REMOVE" | sed -n "s/^${path#.}"$'\t'"//p")
    if [[ -n $gi_add$gi_remove ]]; then
      {
        RS_REMOVE=$gi_remove RS_NOTE="# override: removed by $_RS_VALUES_NOTE" awk '
          BEGIN { n = split(ENVIRON["RS_REMOVE"], r, "\n"); for (i = 1; i <= n; i++) if (r[i] != "") rm[r[i]] = 1 }
          { t = $0; gsub(/^[ \t]+|[ \t]+$/, "", t) }
          t in rm { print "# " t "  " ENVIRON["RS_NOTE"]; next }
          { print }
        ' "$tmp" &&
          if [[ -n $gi_add ]]; then
            printf '\n# ==== Overrides from %s ====\n%s\n' "$_RS_VALUES_NOTE" "$gi_add"
          fi
      } > "$tmp.gi" && mv -f -- "$tmp.gi" "$tmp" || rc=1
    fi
  fi
  if ((rc != 0)); then
    rm -f -- "$tmp"
    [[ -e $dest ]] && _rs_log "kept existing $show"
    return "$rc"
  fi

  # The file takes the mode of its source in bootstrap, also when it exists:
  # a template task is executable because its `.tmpl` is. mktemp creates 0600.
  local mode
  mode=$(_rs_mode "$src")
  if [[ -f $dest ]] && cmp -s -- "$tmp" "$dest"; then
    rm -f -- "$tmp"
    if [[ $(_rs_mode "$dest") == "$mode" ]]; then
      _rs_log "unchanged  $show"
    elif ((dry_run)); then
      _rs_log "would chmod $mode $show"
    else
      chmod "$mode" "$dest" || {
        _rs_log "cannot chmod $show"
        return 1
      }
      _rs_log "chmod $mode  $show"
    fi
    return 0
  fi

  if ((dry_run)); then
    _rs_log "would update $show"
    if [[ -f $dest ]]; then
      diff -u --label "$show (current)" --label "$show (bootstrap)" -- "$dest" "$tmp" >&2 || true
    fi
    rm -f -- "$tmp"
    return 0
  fi

  chmod "$mode" "$tmp"
  mv -f -- "$tmp" "$dest" || {
    rm -f -- "$tmp"
    _rs_log "cannot write $show"
    return 1
  }
  _rs_log "updated    $show"
}

# Set the top-level `bootstrap_commit` of <values> to <commit>, the bootstrap
# commit of this sync. A line that has the key before the first table is
# replaced. Else the key and its comment go after the header comments, when a
# blank line ends them, or else on the first line: a comment just above a key
# belongs to that key. Each other line stays as it is. With <dry_run> 1, only
# print the change.
_rs_record_commit() {
  local values=$1 commit=$2 dry_run=$3 show tmp line
  show=$(_rs_path "$values")
  line="bootstrap_commit = \"${commit}\""
  # Before the first table only: a key in a table is a different key.
  # An `exit` in a rule also runs END, so END gives the result.
  if awk -v line="$line" '/^[ \t]*\[/ { exit } $0 == line { found = 1; exit } END { exit !found }' "$values"; then
    return 0
  fi
  if ((dry_run)); then
    _rs_log "would set bootstrap_commit ${commit} in $show"
    return 0
  fi
  tmp=$(mktemp "${values}.XXXXXX") || {
    _rs_log "cannot write $show"
    return 1
  }
  _RS_TMPS+=("$tmp")
  awk -v line="$line" '
    # The first pass finds the key, and the line to insert before: after the
    # first blank line that ends the header comments, else the first line.
    FNR == NR {
      if (/^[ \t]*\[/) tables = 1
      if (!tables && /^bootstrap_commit[ \t]*=/) has = 1
      if (FNR == 1) { header = /^[ \t]*#/; at = 1 }
      if (header && !found && /^[ \t]*$/) { at = FNR + 1; found = 1 }
      if (header && !found && !/^[ \t]*#/) header = 0
      next
    }
    has && !done && /^bootstrap_commit[ \t]*=/ { print line; done = 1; next }
    !has && !done && FNR == at {
      print "# The bootstrap commit of the last sync. repo-sync writes it."
      print line
      done = 1
    }
    { print }
    END {
      if (!done) {
        print "# The bootstrap commit of the last sync. repo-sync writes it."
        print line
      }
    }
  ' "$values" "$values" > "$tmp" && chmod "$(_rs_mode "$values")" "$tmp" && mv -f -- "$tmp" "$values" || {
    _rs_log "cannot write $show"
    return 1
  }
  _rs_log "set bootstrap_commit ${commit} in $show"
}

# Warn about `core_tools` of <values>, a key that is no longer used.
_rs_core_tools() {
  local values=$1 old_core
  old_core=$(_rs_list "$values" core_tools) || old_core=''
  if [[ -n ${old_core//[$'\n ']/} ]]; then
    _rs_log "core_tools in $(_rs_path "$values") is no longer used - delete it; the env of each [tools.*] entry, else default_envs, decides its environments"
  fi
  return 0
}

# Run each check of `repo_sync --check` on <values>, in the order of the
# sync, and print each message. A check whose input failed is skipped: its
# cause is already reported. Returns the highest code, or 0 after a line that
# says the file is valid.
_rs_check() {
  local values=$1 rc=0 r sel='' sel_ok=1 envs_ok=1
  _RS_ENVS='' _RS_TOOLS=''
  _rs_envs "$values" || {
    r=$? envs_ok=0
    ((r <= rc)) || rc=$r
  }
  sel=$(_rs_values_sel "$values") || {
    r=$? sel_ok=0
    ((r <= rc)) || rc=$r
  }
  if ((envs_ok && sel_ok)); then
    _rs_env_rules "$values" "$sel" || {
      r=$?
      ((r <= rc)) || rc=$r
    }
  fi
  _rs_merge_model || {
    r=$?
    ((r <= rc)) || rc=$r
  }
  _rs_core_tools "$values"
  _rs_overrides '' "$values" local || {
    r=$?
    ((r <= rc)) || rc=$r
  }
  _rs_direct_commit "$values" || {
    r=$?
    ((r <= rc)) || rc=$r
  }
  _rs_fnox_profiles "$values" || {
    r=$?
    ((r <= rc)) || rc=$r
  }
  _rs_members "$values" "${values#"$MISE_PROJECT_ROOT"/}" > /dev/null || {
    r=$?
    ((r <= rc)) || rc=$r
  }
  ((rc == 0)) && _rs_log "$(_rs_path "$values"): valid (local rules)"
  return "$rc"
}

# repo_sync [--dry-run | --check]
#
# Clone bootstrap once, resolve the tools of the values file, then sync
# every file of every tool. Returns the most severe failure code, or 0.
# With --check, examine only the rules that need no clone (`_rs_check`).
repo_sync() {
  local dry_run=0 check=0
  while (($#)); do
    case $1 in
      --dry-run)
        dry_run=1
        shift
        ;;
      --check)
        check=1
        shift
        ;;
      *)
        _rs_log "usage: repo_sync [--dry-run | --check]"
        return 2
        ;;
    esac
  done
  if ((dry_run && check)); then
    _rs_log "usage: repo_sync [--dry-run | --check]"
    return 2
  fi

  local values=${REPO_SYNC_VALUES:-${MISE_PROJECT_ROOT:-$PWD}/.config/bootstrap.toml}
  # `.config/repo-config.toml` is the old name, from before this repository
  # was renamed to bootstrap.
  local old_values="${MISE_PROJECT_ROOT:-$PWD}/.config/repo-config.toml"
  if [[ -z ${REPO_SYNC_VALUES:-} && ! -f $values && -f $old_values ]]; then
    _rs_log "$(_rs_path "$old_values") is the old name of the values file - rename it to .config/bootstrap.toml"
    values=$old_values
  fi
  if [[ ! -f $values ]]; then
    _rs_log "values file $(_rs_path "$values") not found - it lists the tools to sync"
    return 2
  fi
  if ! command -v gomplate > /dev/null 2>&1; then
    _rs_log "gomplate is not available - add #MISE tools.gomplate=\"latest\" to the calling task"
    return 2
  fi
  if ((check)); then
    _rs_check "$values" || return
    return 0
  fi

  local url=${REPO_SYNC_URL:-git@github.com:virajp/bootstrap.git}
  local dir rev
  dir=$(mktemp -d "${TMPDIR:-/tmp}/repo-sync.XXXXXX") || {
    _rs_log "cannot create a temp directory"
    return 1
  }
  _RS_TMPS+=("$dir")
  if [[ -n ${REPO_SYNC_CLONE:-} ]]; then
    # A clone that `setup:configs` already made, so that this code and the
    # files come from the same commit. A private copy, because the sync writes
    # the generated mise config into its clone.
    if [[ ! -e $REPO_SYNC_CLONE/.git ]] || ! cp -R -- "$REPO_SYNC_CLONE/." "$dir"; then
      _rs_log "cannot use the clone $REPO_SYNC_CLONE - nothing synced; existing files were left untouched"
      return 5
    fi
  # BatchMode and no terminal prompt: a missing key or no access fails here
  # instead of waiting for a password nobody will type.
  elif ! GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="ssh -o BatchMode=yes" \
    git clone --quiet --depth 1 --single-branch -- "$url" "$dir" 2>&1 | sed 's/^/  /' >&2 ||
    [[ ! -e $dir/.git ]]; then
    _rs_log "cannot clone $url - nothing synced; existing files were left untouched"
    return 5
  fi
  rev=$(git -C "$dir" rev-parse --short HEAD)
  _rs_log "using bootstrap at ${rev}"
  # The full id, for `bootstrap_commit` after a sync without a failure.
  local commit
  commit=$(git -C "$dir" rev-parse HEAD) || commit=''

  # The formatter for rendered templates; empty when dprint is not available.
  _RS_DPRINT=''
  mise x -- which dprint > /dev/null 2>&1 && _RS_DPRINT=1

  local rc=0
  { _rs_envs "$values" && _rs_mise_index "$dir" && _rs_resolve "$dir" "$values" && _rs_extensions "$dir" "$values"; } || {
    rc=$?
    rm -rf -- "$dir"
    return "$rc"
  }
  _rs_log "tools:${_RS_TOOLS% }"
  _rs_log "environments:${_RS_ENVS% }"
  _rs_merge_model || {
    rc=$?
    rm -rf -- "$dir"
    return "$rc"
  }
  _rs_file_skips

  _rs_core_tools "$values"

  # The mise config of each tool, generated into the clone before the file
  # loop. A tool that fails keeps its existing files and counts as failed.
  local tool worst=0 failed=()
  _RS_SEEN=' ' _RS_GENERATED=' '
  { _rs_mise_env && _rs_overrides "$dir" "$values" && _rs_direct_commit "$values" && _rs_fnox_profiles "$values"; } || {
    rc=$?
    rm -rf -- "$dir"
    return "$rc"
  }
  for tool in $_RS_TOOLS; do
    rc=0
    _rs_mise_render "$dir" "$tool" "$values" || rc=$?
    if ((rc != 0)); then
      failed+=("$tool/tools.toml [mise]")
      ((rc > worst)) && worst=$rc
    fi
  done

  # The context is built once, and only when a template needs it. An empty
  # path tells `_rs_file` that it could not be built, so each template fails
  # and every plain file still syncs.
  local ctx=''
  if [[ -n $(find "$dir/tools" -name '*.tmpl' -type f -print -quit) ]]; then
    ctx=$(mktemp "${TMPDIR:-/tmp}/repo-sync-ctx.XXXXXX") || {
      rm -rf -- "$dir"
      return 1
    }
    _RS_TMPS+=("$ctx")
    _rs_context "$dir" "$values" "$ctx" || {
      _rs_log "cannot build the template context"
      ctx=''
    }
  fi

  # The stage of `_rs_format`, with a copy of the dprint config of this repo.
  _RS_STAGE='' _RS_PENDING=''
  local name
  if [[ -n $_RS_DPRINT ]] && _RS_STAGE=$(mktemp -d "${TMPDIR:-/tmp}/repo-sync-stage.XXXXXX"); then
    _RS_TMPS+=("$_RS_STAGE")
    for name in dprint.json dprint.jsonc .dprint.json .dprint.jsonc .config/dprint.json .config/dprint.jsonc; do
      if [[ -f $MISE_PROJECT_ROOT/$name ]]; then
        mkdir -p -- "$(dirname -- "$_RS_STAGE/$name")" && cp -- "$MISE_PROJECT_ROOT/$name" "$_RS_STAGE/$name"
      fi
    done
  else
    _RS_STAGE=''
  fi

  local path ok=0 total=0 tmp
  for tool in $_RS_TOOLS; do
    while IFS= read -r path; do
      [[ -n $path ]] || continue
      ((total += 1))
      rc=0 _RS_DEFERRED=''
      if [[ $_RS_SKIP == *" $tool/$path "* ]]; then
        _rs_remove "$tool" "$path" "$dry_run" || rc=$?
      elif [[ $_RS_REQ_SKIP == *" $tool/$path="* ]]; then
        _rs_skip_required "$tool" "$path" "$dry_run" || rc=$?
      else
        _rs_file "$dir" "$tool" "$path" "$dry_run" "$ctx" || rc=$?
      fi
      if ((rc != 0)); then
        failed+=("$tool/$path")
        ((rc > worst)) && worst=$rc
      elif [[ -z $_RS_DEFERRED ]]; then
        ((ok += 1))
      fi
    done < <(cd "$dir/tools/$tool" && find . -type f ! -name tools.toml | sed 's#^\./##' | sort)
  done

  _rs_format
  while IFS=$'\t' read -r tool path tmp; do
    [[ -n $tool ]] || continue
    rc=0
    _rs_file_finish "$dir" "$tool" "$path" "$dry_run" "$tmp" || rc=$?
    if ((rc == 0)); then
      ((ok += 1))
    else
      failed+=("$tool/$path")
      ((rc > worst)) && worst=$rc
    fi
  done <<< "$_RS_PENDING"
  [[ -n $_RS_STAGE ]] && rm -rf -- "$_RS_STAGE"
  rm -rf -- "$dir"

  rc=0
  _rs_stale "$dry_run" || rc=$?
  if ((rc != 0)); then
    failed+=("stale files in .config/mise/conf.d")
    ((rc > worst)) && worst=$rc
  fi

  if ((${#failed[@]} == 0)); then
    # Only a sync without a failure records its commit: then each file is
    # at that commit, and an agent can compare it with main of bootstrap.
    if [[ -n $commit ]]; then
      _rs_record_commit "$values" "$commit" "$dry_run" || return 1
    fi
    _rs_log "done: $ok/$total files in sync"
    return 0
  fi
  _rs_log "FAILED: ${failed[*]}"
  _rs_log "$ok/$total files in sync; existing copies of the rest were left untouched"
  return "$worst"
}
