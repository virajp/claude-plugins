#!/usr/bin/env bash
# Synced from bootstrap: repo/tools/mise/.config/mise/tasks/_scripts/worktrees-page. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

#MISE description="The HTML detail page of code:worktrees"
#MISE hide=true

# The page has its own small font: a subset of FiraCode Nerd Font with only the
# glyphs of the task. Thus it renders without a Nerd Font on the machine.
readonly WORKTREES_FONT=""

# $1 with the HTML characters escaped.
html_escape() {
  local s="$1"
  s="${s//&/&amp;}"
  s="${s//</&lt;}"
  s="${s//>/&gt;}"
  s="${s//\"/&quot;}"
  printf '%s' "${s}"
}

# A glyph span. $1 text, $2 color class, $3 title.
page_glyph() {
  if [[ -n "${3:-}" ]]; then
    printf '<span class="g %s" title="%s" aria-label="%s">%s</span>' "${2:-}" "$(html_escape "$3")" "$(html_escape "$3")" "$(html_escape "$1")"
  else
    printf '<span class="g %s">%s</span>' "${2:-}" "$(html_escape "$1")"
  fi
}

# A count cell. $1 ahead, $2 behind, $3 optional ref.
page_counts() {
  count_cell "$1" "$2"
  if [[ -n "${3:-}" ]]; then printf '<span class="ref">%s</span> ' "$(html_escape "$3")"; fi
  if [[ -n "$1" ]]; then
    page_glyph "${CELL}" "${CELL_COLOR}" "$1 ahead, $2 behind"
  else
    page_glyph "${CELL}" "${CELL_COLOR}"
  fi
}

page_styles() {
  cat << 'STYLE'
:root{color-scheme:light dark;--bg:#fff;--fg:#1f2328;--dim:#656d76;--line:#d0d7de;--band:#f6f8fa;--ok:#1a7f37;--warn:#9a6700;--bad:#cf222e}
@media(prefers-color-scheme:dark){:root{--bg:#0d1117;--fg:#e6edf3;--dim:#8b949e;--line:#30363d;--band:#161b22;--ok:#3fb950;--warn:#d29922;--bad:#f85149}}
*{box-sizing:border-box}body{margin:0 auto;max-width:1500px;padding:32px 24px 56px;background:var(--bg);color:var(--fg);font:16px/1.55 -apple-system,system-ui,sans-serif}
h1{font-size:28px;margin:0}h2{font-size:21px;margin:40px 0 12px}.sub{color:var(--dim);margin:4px 0 24px}
code,td.m{font-family:ui-monospace,Menlo,Consolas,monospace}.g{font-family:Glyphs,ui-monospace,Menlo,monospace;font-size:17px;white-space:nowrap}
.green{color:var(--ok)}.yellow{color:var(--warn)}.red{color:var(--bad)}.dim{color:var(--dim)}
.tiles{display:flex;flex-wrap:wrap;gap:12px}.tile{border:1px solid var(--line);border-radius:8px;padding:12px 18px;min-width:150px}.tile b{display:block;font-size:28px;line-height:1.2}.tile span{color:var(--dim);font-size:15px}
.scroll{overflow-x:auto;border:1px solid var(--line);border-radius:8px}table{border-collapse:collapse;width:100%}th,td{padding:8px 14px;text-align:left;white-space:nowrap;font-size:16px}
th{color:var(--dim);font-weight:600;border-bottom:1px solid var(--line)}td.m{font-size:15px}
tr.repo td{background:var(--band);border-top:1px solid var(--line);font-weight:600;font-size:17px}tr.repo .g{margin-right:8px}tr.repo span.i{font-weight:400;font-size:15px;color:var(--dim);margin-left:10px}
.ref{color:var(--dim);font-family:ui-monospace,Menlo,monospace;font-size:14.5px}
.legend{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px}.legend section{border:1px solid var(--line);border-radius:8px;padding:14px 18px}.legend section.wide{grid-column:span 2}
.legend h3{font-size:15px;font-weight:600;color:var(--dim);margin:0 0 10px}.legend ul{list-style:none;margin:0;padding:0;display:grid;gap:7px 20px}.legend .wide ul{grid-template-columns:1fr 1fr}
.legend li{display:grid;grid-template-columns:30px 1fr;align-items:baseline}.legend li .g{font-size:19px}
