footer{color:var(--dim);font-size:15px;margin-top:32px}
STYLE
}

page_tile() {
  printf '<div class="tile"><b class="%s">%s</b><span>%s</span></div>' "$3" "$1" "$2"
}

page_attention() {
  local r i b
  printf '<h2>Needs attention</h2>'
  if ((${#A_RANK[@]} == 0)); then
    printf '<p>%s Nothing needs attention.</p>' "$(page_glyph "${G_OK}" green)"
    return 0
  fi
  printf '<div class="scroll"><table><tr><th></th><th>Repo</th><th>Branch</th><th>What</th><th>Command</th></tr>'
  for r in 1 2 3; do
    for ((i = 0; i < ${#A_RANK[@]}; i++)); do
      [[ "${A_RANK[i]}" == "${r}" ]] || continue
      b="$(html_escape "${A_BRANCH[i]}")"
      printf '<tr><td>%s</td><td>%s</td><td class="m">%s</td><td>%s</td><td class="m">%s</td></tr>' \
        "$(page_glyph "${A_GLYPH[i]}" "${A_COLOR[i]}")" "$(html_escape "${A_REPO[i]}")" "${b:-${G_NA}}" \
        "$(html_escape "${A_MSG[i]}")" "$(html_escape "${A_CMD[i]}")"
    done
  done
  printf '</table></div>'
}

# The word after ": " of a state part, for example "M2 ??1" of "dirty: M2 ??1".
page_state() {
  local g color word out=''
  state_parts "$1"
  while IFS='|' read -r g color word; do
    [[ -n "${g}" ]] || continue
    out="${out}$(page_glyph "${g}" "${color}" "${word}") "
    case "${word}" in
      *": "*)
        out="${out}<span class=\"ref\">$(html_escape "${word#*: }")</span> "
        ;;
    esac
  done <<< "${STATE_PARTS}"
  printf '%s' "${out}"
}

page_row() {
  local i="$1" title glyph branch path
  case "${KIND[i]}" in
    main_worktree)
      glyph="${G_FOLDER}" title="main worktree"
      ;;
    worktree)
      glyph="${G_TREE}" title="linked worktree"
      ;;
    *)
      glyph="${G_BRANCH}" title="branch without a worktree"
      ;;
  esac
  branch="$(html_escape "${W_BRANCH[i]}")"
  if [[ -n "${W_DETACHED[i]}" ]]; then branch="$(page_glyph "${G_DETACHED}" yellow detached) ${branch}"; fi
  path="$(html_escape "${W_PATH[i]/#${HOME}/~}")"
  printf '<tr><td>%s</td><td class="m">%s</td><td class="m">%s</td><td>%s</td><td>%s</td><td>%s</td><td>' \
    "$(page_glyph "${glyph}" "" "${title}")" "${branch}" "${W_COMMIT[i]}" "${W_AGE[i]}" \
    "$(page_counts "${W_BA[i]}" "${W_BB[i]}" "${W_BASE[i]}")" "$(page_counts "${W_PA[i]}" "${W_PB[i]}")"
  case "${W_ORIGIN[i]}" in
    gone)
      page_glyph "${G_GONE}" red "upstream gone"
      ;;
    local)
      page_glyph "${G_LOCAL}" dim "local only"
      ;;
    none)
      page_glyph "${G_NA}" dim "no upstream"
      ;;
    *)
      page_counts "${W_OA[i]}" "${W_OB[i]}"
      ;;
  esac
  printf '</td><td>'
  if [[ -n "${W_SYNC[i]}" ]]; then
    page_glyph "${G_SYNC}" green "in-sync: has the HEAD of the main worktree"
  else
    page_glyph "${G_DRIFT}" red "drifted: does not have the HEAD of the main worktree"
  fi
  printf '</td><td>%s</td><td>' "$(page_state "${i}")"
  if ((W_STASH[i] > 0)); then page_glyph "${G_STASH}${W_STASH[i]}" yellow "stash"; else page_glyph "${G_NA}" dim; fi
  printf '</td><td class="m">%s</td></tr>' "${path:-${G_NA}}"
}

page_repo_row() {
  local i="$1" info
  info="${R_ROLE[i]} ${G_NA} ${R_HOST[i]}"
  if [[ -n "${R_DEFAULT[i]}" ]]; then info="${info} ${G_NA} default ${R_DEFAULT[i]}"; fi
  if [[ -n "${R_PINNED[i]}" ]]; then info="${info} ${G_NA} pinned by ${R_PINNED[i]}"; fi
  if [[ -n "${R_FETCHED[i]}" ]]; then info="${info} ${G_NA} fetched ${R_FETCHED[i]} ago"; fi
  printf '<tr class="repo"><td colspan="11">%s%s<span class="i">%s</span></td></tr>' \
    "$(page_glyph "${R_GLYPH[i]}")" "$(html_escape "${REPO[i]}")" "$(html_escape "${info}")"
  if [[ -n "${R_NOTE[i]}" ]]; then
    printf '<tr><td>%s</td><td colspan="10">%s.' "$(page_glyph "${G_FETCH}" yellow "${R_NOTE[i]}")" "$(printf '%s' "${R_NOTE[i]:0:1}" | tr '[:lower:]' '[:upper:]')$(html_escape "${R_NOTE[i]:1}")"
    if [[ -n "${R_FIX[i]}" ]]; then printf ' Run <code>%s</code>.' "$(html_escape "${R_FIX[i]}")"; fi
    printf '</td></tr>'
  fi
}

# The color of a legend glyph, the same as in the table.
legend_color() {
  case "$1" in
    "${G_OK}" | "${G_SYNC}" | "${G_MERGED}")
      printf 'green'
      ;;
    "${G_DRIFT}" | "${G_WARN}" | "${G_OP}" | "${G_GONE}" | "${G_NOFOLDER}")
      printf 'red'
      ;;
    "${G_DOWN}" | "${G_DETACHED}" | "+" | "-" | "${G_MIX}" | "${G_LOCK}" | "${G_STASH}" | "${G_PIN}" | "${G_UNMERGED}" | "${G_FETCH}")
      printf 'yellow'
      ;;
    "${G_LOCAL}" | "${G_NA}")
      printf 'dim'
      ;;
  esac
}

# One card for each section, with one glyph and its text on each line. An entry
# with no section name continues the section before it, in a card of two columns.
page_legend() {
  local i entry section rest item glyph class
  printf '<h2>Legend</h2><div class="legend">'
  for ((i = 0; i < ${#LEGEND[@]}; i++)); do
    entry="${LEGEND[i]}"
    section="${entry%%|*}"
    rest="${entry#*|}|"
    if [[ -n "${section}" ]]; then
      class=''
      if ((i + 1 < ${#LEGEND[@]})) && [[ "${LEGEND[i+1]}" == "|"* ]]; then class=' class="wide"'; fi
      printf '<section%s><h3>%s</h3><ul>' "${class}" "$(html_escape "${section}")"
    fi
    while [[ -n "${rest}" ]]; do
      item="${rest%%|*}"
      rest="${rest#*|}"
      glyph="${item%% *}"
      printf '<li>%s<span>%s</span></li>' "$(page_glyph "${glyph}" "$(legend_color "${glyph}")")" "$(html_escape "${item#* }")"
    done
    if ((i + 1 == ${#LEGEND[@]})) || [[ "${LEGEND[i+1]}" != "|"* ]]; then printf '</ul></section>'; fi
  done
  printf '</div>'
}

# Writes the page and prints its path. The folder and the page are only for this
# user, because /tmp is shared and the page has paths of the machine. Fails when
# another user owns the folder, and the table then has no link.
write_worktrees_page() {
  local dir="/tmp/code-worktrees" file tmp i repos=0 worktrees=0 branches=0 changed=0 name
  (umask 077 && mkdir -p "${dir}") || return 1
  if [[ -L "${dir}" || ! -O "${dir}" ]]; then return 1; fi
  name="$(html_escape "${REPO[0]}")"
  file="${dir}/${REPO[0]//\//_}.html"
  tmp="$(umask 077 && mktemp "${dir}/.page.XXXXXX")" || return 1
  for ((i = 0; i < ${#KIND[@]}; i++)); do
    case "${KIND[i]}" in
      repo)
        repos=$((repos + 1))
        ;;
      branch)
        branches=$((branches + 1))
        ;;
      *)
        worktrees=$((worktrees + 1))
        if ((W_DIRTY[i] > 0 || W_CONFLICT[i] > 0)); then changed=$((changed + 1)); fi
        ;;
    esac
  done
  {
    printf '<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>%s worktrees</title><style>' "${name}"
    printf "@font-face{font-family:Glyphs;src:url(data:font/woff2;base64,%s) format('woff2')}" "${WORKTREES_FONT}"
    page_styles
    printf '</style><h1>%s worktrees</h1><p class="sub">Written by <code>mise run code:worktrees</code> on %s.</p><div class="tiles">' "${name}" "$(date '+%Y-%m-%d %H:%M')"
    page_tile "${repos}" "repos" ""
    page_tile "${worktrees}" "worktrees" ""
    page_tile "${branches}" "branches, no worktree" ""
    page_tile "${changed}" "with changes" "yellow"
    page_tile "${#A_RANK[@]}" "need attention" "red"
    printf '</div>'
    page_attention
    printf '<h2>All repos</h2><div class="scroll"><table><tr><th></th><th>Branch</th><th>Commit</th><th>Age</th><th>Base</th><th>Pinned</th><th>Origin</th><th>Sync</th><th>State</th><th>Stash</th><th>Path</th></tr>'
    for ((i = 0; i < ${#KIND[@]}; i++)); do
      if [[ "${KIND[i]}" == "repo" ]]; then page_repo_row "${i}"; else page_row "${i}"; fi
    done
    printf '</table></div>'
    page_legend
    printf '<footer>This page shows the state when the task ran. Run the task again to refresh it.</footer></html>\n'
  } > "${tmp}" || {
    rm -f "${tmp}"
    return 1
  }
  mv -f "${tmp}" "${file}"
  printf '%s\n' "${file}"
}
