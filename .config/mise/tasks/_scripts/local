#!/usr/bin/env bash

#MISE description="This repo's own helper functions for mise tasks"
#MISE hide=true

# The repo-owned sidecar beside the pack's `helpers` library: every function
# here is THIS repo's, none of it ships in a stackgen pack, and `/vwf:init`
# never replaces it. Tasks source it on the line after they source `helpers`,
# spelled the same way, so the sidecar is reached exactly the way the library
# is. Nothing landed into a target repo may source it — a repo that gets the
# task library gets `helpers` and its own sidecar, not this one.
#
# Guarded and `readonly`-free for the same reason `helpers` is: a task sources
# it, and so may a library that task sources.
if [ -n "${MISE_LOCAL_SOURCED:-}" ]; then
  return 0
fi
MISE_LOCAL_SOURCED=1

# True when any component of the given version is exactly 13 or 17.
#
# The rule: this repo never issues 13 or 17 in any version line it maintains —
# the two plugin manifests, the installer and site packages, `config_format`,
# `blueprint_format`. It is about the COMPONENT, not the digits: `1.13.0`,
# `17.0.0` and `2.1.17` are refused, while `1.130.0` and `113.0.0` are ordinary
# versions that merely contain the characters.
#
# Takes `v1.13.0-rc.1+build.4` as readily as `1.13.0`: the leading `v`, the
# build metadata and the prerelease are stripped, in that order, before the
# split. Build metadata goes first because semver puts it last — `X.Y.Z-pre+b`
# — so cutting at `-` first would leave a `+b` tail on the prerelease.
#
# `p:plugins:local`'s `X.Y.Z+N` staging counter is therefore NOT a component and
# never trips this.
version_forbidden() {
  local version="${1:-}"
  version="${version#v}"
  version="${version%%+*}"
  version="${version%%-*}"

  local component
  # Splitting on `.` is the whole point of the unquoted expansion below, and the
  # local IFS is what scopes it to this function.
  local IFS='.'
  # shellcheck disable=SC2086
  for component in ${version}; do
    if [ "${component}" = "13" ] || [ "${component}" = "17" ]; then
      return 0
    fi
  done
  return 1
}

# Report one skipped version, through the shared warn printer.
#
# Printed rather than swallowed because a bump that lands somewhere other than
# the obvious next number is exactly the thing a person re-reads the scrollback
# for: `1.1.12` bumped by patch reads as `1.1.13` to everyone until this line
# says otherwise.
version_skip_note() {
  print_warn "Skipped ${1} — 13 and 17 are never issued as a version component. The version is now ${2}."
}
