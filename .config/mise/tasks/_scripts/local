#!/usr/bin/env bash

#MISE description="This repo's own helper functions for mise tasks"
#MISE hide=true

# This repo's own sidecar to `helpers`; nothing landed in a target repo may source it.
if [ -n "${MISE_LOCAL_SOURCED:-}" ]; then
  return 0
fi
MISE_LOCAL_SOURCED=1

# True when any component (not digit run) is 13 or 17; accepts a leading v, -pre and +build.
version_forbidden() {
  local version="${1:-}"
  version="${version#v}"
  version="${version%%+*}"
  version="${version%%-*}"

  local component
  local IFS='.'
  # shellcheck disable=SC2086
  for component in ${version}; do
    if [ "${component}" = "13" ] || [ "${component}" = "17" ]; then
      return 0
    fi
  done
  return 1
}

# Print X.Y.Z bumped by one level, computed before any write; refuses a non-plain version.
version_bump() {
  local level="${1:-}"
  local original="${2:-}"

  local version="${original#v}"
  version="${version%%+*}"
  version="${version%%-*}"

  local major minor patch count
  local IFS='.'
  # shellcheck disable=SC2086
  set -- ${version}
  IFS=' '
  count="$#"
  major="${1:-}"
  minor="${2:-}"
  patch="${3:-}"

  local component
  for component in "${major}" "${minor}" "${patch}"; do
    case "${component}" in
      '' | *[!0-9]*)
        print_error "Cannot bump '${original}': expected a plain X.Y.Z version."
        return 1
        ;;
    esac
  done
  if [ "${count}" -ne 3 ]; then
    print_error "Cannot bump '${original}': expected a plain X.Y.Z version."
    return 1
  fi

  case "${level}" in
    major)
      major=$((10#${major} + 1))
      minor=0
      patch=0
      ;;
    minor)
      minor=$((10#${minor} + 1))
      patch=0
      ;;
    patch)
      patch=$((10#${patch} + 1))
      ;;
    *)
      print_error "Unknown bump level '${level}': expected major, minor or patch."
      return 1
      ;;
  esac

  printf '%s.%s.%s\n' "${major}" "${minor}" "${patch}"
}

# Print the bump stepped past a forbidden component; refuses a level that cannot clear it.
version_next() {
  local level="${1:-}"
  local original="${2:-}"

  local next
  next="$(version_bump "${level}" "${original}")" || return 1

  local major minor patch
  local IFS='.'
  # shellcheck disable=SC2086
  set -- ${next}
  IFS=' '
  major="${1}"
  minor="${2}"
  patch="${3}"

  case "${level}" in
    patch)
      if version_forbidden "${major}.${minor}.0"; then
        print_error "A patch bump of ${original} cannot clear the forbidden component in ${major}.${minor} — set the version by hand."
        return 1
      fi
      ;;
    minor)
      if version_forbidden "${major}.0.0"; then
        print_error "A minor bump of ${original} cannot clear the forbidden major ${major} — set the version by hand."
        return 1
      fi
      ;;
  esac

  while version_forbidden "${major}.${minor}.${patch}"; do
    case "${level}" in
      major) major=$((major + 1)) ;;
      minor) minor=$((minor + 1)) ;;
      patch) patch=$((patch + 1)) ;;
    esac
  done

  printf '%s.%s.%s\n' "${major}" "${minor}" "${patch}"
}

# Report one skipped version.
version_skip_note() {
  print_warn "Skipped ${1} — 13 and 17 are never issued as a version component. The version is now ${2}."
}
