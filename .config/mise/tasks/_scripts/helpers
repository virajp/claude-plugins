#!/usr/bin/env bash

#MISE description="Helper functions for mise tasks"
#MISE hide=true

# The one library every task in this repo sources, so the whole task surface
# prints the same way. Siblings live beside it — `checks`, `merge`,
# `<name>.env` — and each is named without a leading underscore: `_scripts/` is
# already the segment that tells mise this directory holds no tasks, and a
# second underscore on every file inside it says nothing the directory has not.

# Sourced more than once in a run (a task sources it, and so does a library that
# task sources), so the guard is what keeps `readonly` from erroring the second
# time. Written with `${VAR:-}` so the file stays safe under `set -u`.
if [ -n "${MISE_HELPERS_SOURCED:-}" ]; then
  return 0
fi
MISE_HELPERS_SOURCED=1

# Style
readonly BOLD='\033[1m'
readonly NORMAL='\033[0m'
# Colors
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[0;33m'
readonly RED='\033[0;31m'
# Unused by the printers below — kept so the palette is complete for a task that
# wants a fourth colour without redefining one.
# shellcheck disable=SC2034
readonly BLUE='\033[0;34m'

# Print a full-width separator line built from the given character.
#
# Public, but rarely the right call: `print_header` and `print_subheader` below
# already emit theirs. Reach for it directly only where a rule is wanted without
# a title after it.
line_sep() {
  local COL
  # `stty size` fails whenever stdin is not a terminal — every `mise run` with
  # captured output, every CI job, every non-interactive shell. That failure is
  # expected, and the 80 below is the answer to it, but the fallback is only
  # ever READ if the status stops here: a bare `VAR=$(...)` takes the command's
  # exit status, and under the `set -euo pipefail` every task sets, `set -e`
  # kills the caller on the assignment line — silently, before a single
  # separator or title is printed. Hence the explicit `|| COL=''`.
  COL=$(stty size 2>/dev/null | awk '{print $2}') || COL=''
  local line
  printf -v line '%*s' "${COL:-80}" ''
  printf '%s\n' "${line// /$1}"
}

# A major section: a full-width `=` rule, then the title.
#
# The rule is BAKED IN rather than left to the caller. Every task that opened a
# section used to emit `line_sep "="` first, which meant the separator was a
# convention half the tasks remembered — and a task that forgot it read as part
# of the previous step. One call, one section, no way to get it half right.
print_header() {
  line_sep "="
  echo -e "${GREEN}${BOLD}$1${NORMAL}"
}

# A step inside a section: a full-width `-` rule, then the title.
print_subheader() {
  line_sep "-"
  echo -e "${GREEN}${BOLD}$1${NORMAL}"
}

# A single-step task calls NEITHER. A task that does one thing and prints one
# line does not open a section; the printers below are its whole vocabulary.
print_success() { echo -e "${GREEN}${BOLD}$1${NORMAL}"; }
print_ok() { echo -e "${GREEN}${BOLD}OK${NORMAL}"; }
print_wait() { echo -en "${YELLOW}${BOLD}$1${NORMAL}"; }
print_warn() { echo -e "${YELLOW}${BOLD}$1${NORMAL}"; }
print_yellow() { echo -e "${YELLOW}$1${NORMAL}"; }
print_newline() { echo ""; }

# Errors go to stderr, so a caller piping stdout into a report still sees them.
print_error() { echo -e "${RED}${BOLD}$1${NORMAL}" >&2; }

# The repo's members, one repo-relative path per line.
#
# Two sources, and which one answers depends on how the members are LINKED:
#
#   submodules  `.gitmodules` exists, so git already holds the list. Keeping a
#               second copy of it in the config would only let the two disagree.
#   siblings    no `.gitmodules`, so the list is `MEMBERS` — the marked position
#               in `.config/mise.toml` that the orchestrator shaping this repo
#               fills, space separated, each path relative to the repo root.
#
# Defined ONCE here rather than in each caller, which is the whole point: every
# task that walks the members — `setup:all --all`, `code:worktrees` — walks the
# same list, so a repo that changes how it links its members changes it in one
# place. A single-project repo has neither source and this prints nothing but
# blank output; every caller already skips empty lines.
#
# `$displaypath` is git's own variable and stays single-quoted so git, not this
# shell, expands it.
# shellcheck disable=SC2016
members() {
  if [ -f "${MISE_PROJECT_ROOT}/.gitmodules" ]; then
    git -C "${MISE_PROJECT_ROOT}" submodule --quiet foreach --recursive 'echo $displaypath' 2>/dev/null || true
  else
    # Unquoted ON PURPOSE: the value is one space-separated string — TOML `[env]`
    # values are strings, never arrays — and word splitting is what turns it back
    # into a list.
    # shellcheck disable=SC2086
    printf '%s\n' ${MEMBERS:-}
  fi
}

# The shell files in scope, one path per line: the paths given as arguments
# filtered down to shell, or every TRACKED shell file when no argument is given.
#
# Defined here because both `code:format` (shfmt) and `code:lint` (shellcheck)
# need the same answer, and an overlay that replaces either of those files still
# gets it. `git ls-files` rather than a `find`, so nothing ignored is ever
# rewritten. The shebang test is what catches the extension-less task files this
# library lives among — the shell a repo most wants checked, and the only shell
# with no `.sh` on the end.
shell_files_in_scope() {
  local candidates=()
  if [ "$#" -gt 0 ]; then
    candidates=("$@")
  else
    local tracked
    while IFS= read -r tracked; do
      if [ -n "${tracked}" ]; then
        candidates+=("${tracked}")
      fi
    done < <(git -C "${MISE_PROJECT_ROOT}" ls-files 2>/dev/null || true)
  fi

  local candidate
  for candidate in ${candidates[@]+"${candidates[@]}"}; do
    [ -f "${candidate}" ] || continue
    case "${candidate}" in
      *.sh | *.bash)
        printf '%s\n' "${candidate}"
        continue
        ;;
    esac
    if head -n 1 "${candidate}" 2>/dev/null | grep -qE '^#!.*[/ ](ba|da|k|z)?sh( |$)'; then
      printf '%s\n' "${candidate}"
    fi
  done
}
