#!/usr/bin/env bash
# Synced from bootstrap: tools/mise/.config/mise/tasks/_scripts/helpers. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

#MISE description="Helper functions for mise tasks"
#MISE hide=true

# The one library every task in this repo sources, so the whole task surface
# prints the same way. Siblings live beside it — `checks`, `merge`,
# `<name>.env` — and each is named without a leading underscore: `_scripts/` is
# already the segment that tells mise this directory holds no tasks, and a
# second underscore on every file inside it says nothing the directory has not.
#
# Universal: one copy for every repository. Do not edit it in a repository.
# Put a function that only one repository uses in a local sibling file.
#
# Written for bash 3.2 as well as 5.x: macOS still ships 3.2 as /bin/bash, and
# `#!/usr/bin/env bash` picks it up on any machine without a newer bash first on
# PATH. So no namerefs, no `${var,,}`, no associative arrays.

# Sourced more than once in a run (a task sources it, and so does a library that
# task sources), so the guard is what keeps `readonly` from erroring the second
# time. Written with `${VAR:-}` so the file stays safe under `set -u`.
if [ -n "${MISE_HELPERS_SOURCED:-}" ]; then
  return 0
fi
MISE_HELPERS_SOURCED=1

# Style
readonly STYLE_BOLD='\033[1m'
readonly STYLE_ITALIC='\033[3m'
readonly STYLE_NORMAL='\033[0m'
# Colors
readonly COLOR_GREEN='\033[0;32m'
readonly COLOR_YELLOW='\033[0;33m'
readonly COLOR_RED='\033[0;31m'

# Shown in front of a message when output is styled.
readonly EMOJI_SUCCESS='✅'
readonly EMOJI_WARN='⚠️'
readonly EMOJI_ERROR='❌'
readonly EMOJI_INFO='ℹ️'
readonly EMOJI_HEADER='🚀'
readonly EMOJI_SUBHEADER='📌'

# Shown INSTEAD of the emoji when output is plain. Without them a log file loses
# the one thing the emoji carried — whether a line was a success, a warning or a
# failure — and `grep '\[ERROR\]'` has nothing to find. A message-less call
# (`print_success`) would otherwise print an empty line.
readonly LABEL_SUCCESS='[OK]'
readonly LABEL_WARN='[WARN]'
readonly LABEL_ERROR='[ERROR]'
readonly LABEL_INFO='[INFO]'

# Whether output on the given file descriptor (default 1) should be styled.
#
# Decided per call, not once at source time, because stdout and stderr answer
# differently: `task > report.txt` leaves stderr on the terminal, so
# `print_error` stays styled while everything on stdout goes plain. A task that
# redirects a single print call gets the right answer for that call too.
#
#   FORCE_COLOR  set (and not `0`) forces styling on — for CI runners, which
#                render ANSI but never give the task a terminal.
#   NO_COLOR     set forces it off (https://no-color.org).
#   otherwise    on only when the descriptor is a terminal and TERM is not dumb.
style_enabled() {
  local fd="${1:-1}"
  if [ -n "${FORCE_COLOR:-}" ] && [ "${FORCE_COLOR}" != "0" ]; then
    return 0
  fi
  if [ -n "${NO_COLOR:-}" ]; then
    return 1
  fi
  [ -t "${fd}" ] && [ "${TERM:-dumb}" != "dumb" ]
}

# The one place a line is assembled; every printer below is a call to it.
#
#   print_line <fd> <newline> <codes> <emoji> <label> <message>
#
#   fd       1 or 2
#   newline  `yes`, or `no` for a line the next call completes
#   codes    ANSI codes wrapped around the message when styled; may be empty
#   emoji    prefix when styled; may be empty
#   label    prefix when plain; may be empty
#   message  may be empty, leaving only the prefix
#
# `%b` keeps the `echo -e` behavior the printers had before: a `\n` or `\t`
# inside a message is still interpreted.
print_line() {
  local fd="$1" newline="$2" codes="$3" emoji="$4" label="$5" msg="$6"
  local mark text
  if style_enabled "${fd}"; then
    mark="${emoji}"
    if [ -n "${codes}" ] && [ -n "${msg}" ]; then
      text="${codes}${msg}${STYLE_NORMAL}"
    else
      text="${msg}"
    fi
  else
    mark="${label}"
    text="${msg}"
  fi

  local out="${mark}"
  if [ -n "${mark}" ] && [ -n "${text}" ]; then
    out="${out} "
  fi
  out="${out}${text}"

  if [ "${newline}" = "yes" ]; then
    printf '%b\n' "${out}" >&"${fd}"
  else
    printf '%b' "${out}" >&"${fd}"
  fi
}

# Print a full-width separator line built from the given character.
#
# Public, but rarely the right call: `print_header` and `print_subheader` below
# already emit theirs. Reach for it directly only where a rule is wanted without
# a title after it.
_line_sep() {
  local COL
  # `stty size` fails whenever stdin is not a terminal — every `mise run` with
  # captured output, every CI job, every non-interactive shell. That failure is
  # expected, and the 80 below is the answer to it, but the fallback is only
  # ever READ if the status stops here: a bare `VAR=$(...)` takes the command's
  # exit status, and under the `set -euo pipefail` every task sets, `set -e`
  # kills the caller on the assignment line — silently, before a single
  # separator or title is printed. Hence the explicit `|| COL=''`.
  COL=$(stty size 2> /dev/null | awk '{print $2}') || COL=''
  local width="${COL:-80}"

  # The argument is a PATTERN, not a single character: `line_sep "-="` repeats
  # the pair. Repeat it enough times to cover the width (rounding up), then cut
  # to exactly `width`, so a multi-character pattern never wraps onto a second
  # line. `${#pattern}` and the cut count characters in a UTF-8 locale and bytes
  # under `LANG=C`; a double-width glyph (emoji, CJK) still counts as one, so
  # keep patterns to single-width characters.
  local pattern="${1:-=}"
  local reps=$(((width + ${#pattern} - 1) / ${#pattern}))
  local line
  printf -v line '%*s' "${reps}" ''
  line="${line// /${pattern}}"
  printf '%s\n' "${line:0:${width}}"
}

line_sep1() {
  _line_sep "──── ⋆⋅☆⋅⋆ ────"
}

line_sep2() {
  _line_sep "⋅"
}

# A major section: a full-width `=` rule, then the title in green and bold.
#
# The rule is BAKED IN rather than left to the caller. Every task that opened a
# section used to emit `line_sep "="` first, which meant the separator was a
# convention half the tasks remembered — and a task that forgot it read as part
# of the previous step. One call, one section, no way to get it half right.
print_header() {
  line_sep1
  print_line 1 yes "${COLOR_GREEN}${STYLE_BOLD}" "${EMOJI_HEADER}" '' "$*"
}

# A step inside a section: a full-width `-` rule, then the title in green.
# Not bold, so a step reads as subordinate to the section it sits in.
print_subheader() {
  line_sep2
  print_line 1 yes "${COLOR_GREEN}" "${EMOJI_SUBHEADER}" '' "$*"
}

# A single-step task calls NEITHER. A task that does one thing and prints one
# line does not open a section; the printers below are its whole vocabulary.
#
# The four status printers share one shape:
#
#   print_success [--bold] [message...]
#
# `--bold` is only recognised as the FIRST argument, so a message that happens
# to contain the word is never mistaken for the flag. The message is optional —
# `print_success` alone prints just the mark — and every remaining argument is
# joined with spaces, so an unquoted multi-word message still works.

print_success() {
  local bold=''
  if [ "${1:-}" = "--bold" ]; then
    bold=1
    shift
  fi
  print_line 1 yes "${COLOR_GREEN}${bold:+${STYLE_BOLD}}" "${EMOJI_SUCCESS}" "${LABEL_SUCCESS}" "$*"
}

print_warn() {
  local bold=''
  if [ "${1:-}" = "--bold" ]; then
    bold=1
    shift
  fi
  print_line 1 yes "${COLOR_YELLOW}${bold:+${STYLE_BOLD}}" "${EMOJI_WARN}" "${LABEL_WARN}" "$*"
}

# Errors go to stderr, so a caller piping stdout into a report still sees them.
print_error() {
  local bold=''
  if [ "${1:-}" = "--bold" ]; then
    bold=1
    shift
  fi
  print_line 2 yes "${COLOR_RED}${bold:+${STYLE_BOLD}}" "${EMOJI_ERROR}" "${LABEL_ERROR}" "$*"
}

# No color: info is the neutral line, and only bold sets it apart.
print_info() {
  local bold=''
  if [ "${1:-}" = "--bold" ]; then
    bold=1
    shift
  fi
  print_line 1 yes "${bold:+${STYLE_BOLD}}" "${EMOJI_INFO}" "${LABEL_INFO}" "$*"
}

# A one-line check: the message in yellow italics with no newline, so the
# status printer that follows completes the line —
#
#   print_wait "Checking docker..."; print_success
#
# prints `Checking docker... ✅` on a terminal and `Checking docker... [OK]` in
# a log.
print_wait() { print_line 1 no "${COLOR_YELLOW}${STYLE_ITALIC}" '' '' "$*"; }

# Kept for the tasks that already call them.
print_header_wait() { print_line 1 no "${COLOR_GREEN}${STYLE_BOLD}" '' '' "$*"; }
print_yellow() { print_line 1 yes "${COLOR_YELLOW}" '' '' "$*"; }
print_newline() { echo ""; }

# The task files are read from this repository's own task directory, never
# asked of mise. Inside a superproject mise also lists the parent's tasks, and
# runs a parent task in the PARENT's directory: a submodule that asked
# `mise tasks info setup:ai` would find the root's task and run it again.

# Whether this repository defines the task <name> itself, as a file task:
# `setup:ai` is `setup/ai`, or `setup/ai/_default`. For a step that only some
# repositories have, for example `setup:ai` or `setup:external:update`.
has_own_task() {
  local path="${MISE_PROJECT_ROOT}/.config/mise/tasks/${1//://}"
  { [ -f "${path}" ] && [ -x "${path}" ]; } || [ -x "${path}/_default" ]
}

# The tasks this repository defines in the group <group> (`setup:deps`), one
# name per line, sorted; nothing when it defines none. For a step that runs
# every tool's task in a group, without the parent's tasks that a wildcard
# `mise run 'setup:deps:*'` would add.
own_tasks() {
  local dir="${MISE_PROJECT_ROOT}/.config/mise/tasks/${1//://}" file name
  for file in "${dir}"/*; do
    [ -f "${file}" ] && [ -x "${file}" ] || continue
    name="$(basename "${file}")"
    case "${name}" in _*) continue ;; esac
    printf '%s:%s\n' "$1" "${name}"
  done
}

# The repo's members, one repo-relative path per line.
#
# Two sources, and which one answers depends on how the members are LINKED:
#
#   submodules  `.gitmodules` exists, so git already holds the list. Keeping a
#               second copy of it in the config would only let the two disagree.
#   siblings    no `.gitmodules`, so the list is `MEMBERS` — the marked position
#               in `.config/mise.toml` that the orchestrator shaping this repo
#               fills, space separated, each path relative to the repo root.
#
# Defined ONCE here rather than in each caller, which is the whole point: every
# task that walks the members — `setup --all`, `code:worktrees` — walks the
# same list, so a repo that changes how it links its members changes it in one
# place. A single-project repo has neither source and this prints nothing but
# blank output; every caller already skips empty lines.
#
# `$displaypath` is git's own variable and stays single-quoted so git, not this
# shell, expands it.
# shellcheck disable=SC2016
members() {
  if [ -f "${MISE_PROJECT_ROOT}/.gitmodules" ]; then
    git -C "${MISE_PROJECT_ROOT}" submodule --quiet foreach --recursive 'echo $displaypath' 2> /dev/null || true
  else
    # Unquoted ON PURPOSE: the value is one space-separated string — TOML `[env]`
    # values are strings, never arrays — and word splitting is what turns it back
    # into a list.
    # shellcheck disable=SC2086
    printf '%s\n' ${MEMBERS:-}
  fi
}

# The shell files in scope, one path per line: the paths given as arguments
# filtered down to shell, or every TRACKED shell file when no argument is given.
#
# Defined here because `code:lint` (shellcheck) needs it, and an overlay that
# replaces that file still gets it. `git ls-files` rather than a `find`, so
# nothing ignored is ever checked. The shebang test is what catches the extension-less task files this
# library lives among — the shell a repo most wants checked, and the only shell
# with no `.sh` on the end.
shell_files_in_scope() {
  local candidates=()
  if [ "$#" -gt 0 ]; then
    candidates=("$@")
  else
    local tracked
    while IFS= read -r tracked; do
      if [ -n "${tracked}" ]; then
        candidates+=("${tracked}")
      fi
    done < <(git -C "${MISE_PROJECT_ROOT}" ls-files 2> /dev/null || true)
  fi

  local candidate
  for candidate in ${candidates[@]+"${candidates[@]}"}; do
    [ -f "${candidate}" ] || continue
    case "${candidate}" in
      *.sh | *.bash)
        printf '%s\n' "${candidate}"
        continue
        ;;
    esac
    if head -n 1 "${candidate}" 2> /dev/null | grep -qE '^#!.*[/ ](ba|da|k|z)?sh( |$)'; then
      printf '%s\n' "${candidate}"
    fi
  done
}
