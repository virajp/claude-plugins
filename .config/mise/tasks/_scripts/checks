#!/usr/bin/env bash
# Synced from bootstrap: tools/mise/.config/mise/tasks/_scripts/checks. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

#MISE description="Predicates the merge tasks ask before touching a branch"
#MISE hide=true

# Each of these answers one question and answers it as an exit status, so a
# caller reads as `if has_untracked_files; then`. They print NOTHING — the
# caller owns the wording, because the same predicate is a hard error in one
# task and a note in another.

# Tracked files with modifications, staged or not.
#
# `--ignore-submodules=dirty` skips edits INSIDE a submodule: this repo tracks
# only the commit a submodule points to, so a merge here can never carry them. A
# submodule moved to a new commit is still reported — that pointer is this
# repo's own uncommitted change.
has_uncommitted_changes() {
  [ -n "$(git status --porcelain --ignore-submodules=dirty)" ]
}

# Files git is not tracking and .gitignore does not cover.
#
# Separate from the check above even though `git status --porcelain` lists both:
# an untracked file is a different mistake from an uncommitted edit — it is work
# that would be left behind by a branch switch rather than carried along — and
# the two deserve different messages.
has_untracked_files() {
  [ -n "$(git ls-files --others --exclude-standard)" ]
}

# A branch with no upstream, so "unpushed" cannot be measured against anything.
# Defaults to the branch you are standing on.
is_local_branch() {
  local branch="${1:-HEAD}"
  ! git rev-parse --abbrev-ref "${branch}@{u}" > /dev/null 2>&1
}

# Commits on ONE branch that its upstream does not have.
#
# Scoped to the branch on purpose. The repo-wide form
# (`git log --branches --not --remotes`) answers a different question — does any
# local branch anywhere hold unpushed work — and an unrelated experiment left
# lying around would then refuse a merge it has nothing to do with.
has_unpushed_commits() {
  local branch="${1:-HEAD}"
  [ -n "$(git log --oneline "${branch}@{u}..${branch}" 2> /dev/null)" ]
}

# A branch that exists here or on origin.
#
# The remote counts too: a fresh clone has only the default branch locally, and
# `git checkout <branch>` creates the local branch from origin when it runs.
branch_exists() {
  git show-ref --verify --quiet "refs/heads/$1" ||
    git show-ref --verify --quiet "refs/remotes/origin/$1"
}

# Whether this is a linked worktree rather than the main checkout.
#
# The distinction matters to a merge because a branch checked out in one
# worktree cannot be checked out in another — so a merge run from a linked
# worktree has to do its checkout in the main one.
is_git_worktree() {
  local git_dir git_common_dir
  # Outside a repo both calls fail, and "neither, so not a worktree" is the
  # right answer — but only if the status is discarded at the assignment. A bare
  # `VAR=$(...)` takes the command's status, which `set -e` acts on the moment
  # this predicate is called anywhere other than an `if`.
  git_dir=$(git rev-parse --git-dir 2> /dev/null) || git_dir=''
  git_common_dir=$(git rev-parse --git-common-dir 2> /dev/null) || git_common_dir=''
  [ "${git_dir}" != "${git_common_dir}" ]
}

# The absolute path of the main worktree, which `git worktree list` prints first.
get_main_worktree_path() {
  git worktree list --porcelain | awk 'NR==1{sub(/^worktree /, ""); print; exit}'
}
