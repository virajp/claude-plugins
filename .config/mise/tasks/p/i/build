#!/usr/bin/env bash
#MISE description="Bundle installer/ into bin/ and verify the publishable package"
#MISE dir="{{ config_root }}"

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

cd "$MISE_PROJECT_ROOT"

# bin/ is gitignored — without this step the tarball carries no entrypoint.
print_header "Bundling installer/ into bin/ ..."
pnpm exec tsup

if [[ ! -f bin/installer.mjs ]]; then
  print_error "tsup produced no bin/installer.mjs"
  exit 1
fi

print_header "Smoke-testing the bundle ..."
node bin/installer.mjs --help >/dev/null

print_header "Listing package contents (dry run) ..."
pnpm pack --dry-run

print_header "Package verified."
