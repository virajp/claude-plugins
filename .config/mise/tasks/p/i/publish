#!/usr/bin/env bash
#MISE description="Publish the installer to npmjs.org"
#MISE dir="{{ config_root }}"

#USAGE flag "--dry-run" help="run all checks and packaging without publishing"

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

cd "$MISE_PROJECT_ROOT"

# Local fallback — prefer p:i:release, so CI publishes with OIDC provenance.
print_header "Verifying npm authentication ..."
if ! npm whoami >/dev/null 2>&1; then
  print_error "Not logged in to npm. Run \`npm login\` first, then retry."
  exit 1
fi

mise run p:i:test
mise run p:i:build

VERSION="$(node -p "require('./package.json').version")"

if [[ "${usage_dry_run:-false}" == "true" ]]; then
  print_header "Dry-run publish of @virajp.dev/claude-plugins@${VERSION} ..."
  npm publish --access public --dry-run
  print_header "Dry run complete — nothing was published."
  exit 0
fi

print_header "Publishing @virajp.dev/claude-plugins@${VERSION} to npmjs.org ..."
npm publish --access public
print_header "Published @virajp.dev/claude-plugins@${VERSION}!"
