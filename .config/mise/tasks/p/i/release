#!/usr/bin/env bash
#MISE description="Tag the installer release on main and watch the publish pipeline"
#MISE dir="{{ config_root }}"

#USAGE flag "--ci" help="CI mode: stop after creating the tag (the caller pushes + dispatches); skips the interactive push and pipeline watch"

# Tags what main already carries; never bumps or commits.

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/local"

cd "$MISE_PROJECT_ROOT"

RELEASE_BRANCH="main"

# 1. A clean tree, so the tag names what was tested.
if [[ -n "$(git status --porcelain)" ]]; then
  print_error "Working tree is not clean. Commit or stash your changes first."
  exit 1
fi

# 2. Only from main — the workflow refuses a tag not reachable from it.
BRANCH="$(git rev-parse --abbrev-ref HEAD)"
if [[ "${BRANCH}" != "${RELEASE_BRANCH}" ]]; then
  print_error "On '${BRANCH}', not '${RELEASE_BRANCH}'. Bump with 'mise run p:i:version' on develop, commit, merge to ${RELEASE_BRANCH}, then run this."
  exit 1
fi

VERSION="$(node -p "require('./package.json').version")"

# 3. Refuse a hand-edited 13 or 17 component before tagging.
if version_forbidden "${VERSION}"; then
  print_error "Refusing to tag ${VERSION}: 13 and 17 are never issued as a version component. Bump past it with 'mise run p:i:version' on develop."
  exit 1
fi

# Namespaced — a bare `v*` glob would match every plugin tag.
TAG="installer-v${VERSION}"

# 4. The tag must not exist on the remote yet.
git fetch --tags --quiet origin
if git rev-parse -q --verify "refs/tags/${TAG}" >/dev/null; then
  print_error "${TAG} already exists. Bump with 'mise run p:i:version' on develop, commit, and merge to ${RELEASE_BRANCH} first."
  exit 1
fi

# 5. Tests must pass before anything is tagged.
mise run p:i:test

# 6. The annotated tag.
git tag -a "${TAG}" -m "${TAG}"

print_header "Created ${TAG}."

# 7. --ci: tag only; the calling workflow pushes and publishes.
if [[ "${usage_ci:-false}" == "true" ]]; then
  print_header "CI mode (--ci) — stopping after the tag; the workflow handles push + publish."
  exit 0
fi

# 8. Never push a tag we cannot then watch.
if ! command -v gh >/dev/null 2>&1; then
  print_error "gh (GitHub CLI) is required to push and watch the release. Install: brew install gh"
  exit 1
fi
if ! gh auth status >/dev/null 2>&1; then
  print_error "gh is not authenticated. Run: gh auth login"
  exit 1
fi

# main BEFORE the tag — the workflow checks the tag is reachable from origin/main.
print_header "Pushing ${RELEASE_BRANCH} and ${TAG} ..."
git push origin "${RELEASE_BRANCH}"
git push origin "${TAG}"

# 9. Find the tag's release.yml run by head commit, then follow it.
RELEASE_SHA="$(git rev-parse HEAD)"
print_header "Waiting for the release workflow to start ..."
RUN_ID=""
for _ in $(seq 1 30); do
  RUN_ID="$(gh run list --workflow=release.yml --limit 20 \
    --json databaseId,headSha \
    --jq "[.[] | select(.headSha==\"${RELEASE_SHA}\")][0].databaseId" 2>/dev/null || true)"
  if [[ -n "${RUN_ID}" && "${RUN_ID}" != "null" ]]; then
    break
  fi
  sleep 4
done

if [[ -z "${RUN_ID}" || "${RUN_ID}" == "null" ]]; then
  print_error "Release workflow run did not appear. Check manually: gh run list --workflow=release.yml"
  exit 1
fi

# --exit-status: this task fails when the pipeline does.
print_header "Watching release run ${RUN_ID} ..."
gh run watch "${RUN_ID}" --exit-status

print_header "Release pipeline succeeded — @virajp.dev/claude-plugins@${VERSION} published to npm."
