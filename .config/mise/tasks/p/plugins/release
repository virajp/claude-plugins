#!/usr/bin/env bash
#MISE description="Tag every plugin whose marketplace ref has no tag yet, and push"
#MISE dir="{{ config_root }}"

#USAGE flag "--dry-run" help="report what would be tagged and pushed; change nothing"

# Tags the refs .claude-plugin/marketplace.json already names; only from main, after the merge.

set -euo pipefail
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/local"

cd "$MISE_PROJECT_ROOT"

DRY_RUN="${usage_dry_run:-false}"
RELEASE_BRANCH="main"

# 1. A clean tree, so the tag names what was tested.
if [[ -n "$(git status --porcelain)" ]]; then
  print_error "Working tree is not clean. Commit or stash your changes first."
  exit 1
fi

# 2. Only from main — users read the manifest from it.
BRANCH="$(git rev-parse --abbrev-ref HEAD)"
if [[ "${BRANCH}" != "${RELEASE_BRANCH}" ]]; then
  print_error "On '${BRANCH}', not '${RELEASE_BRANCH}'. Merge to ${RELEASE_BRANCH} first — a plugin tag off it publishes content users' marketplace never lists."
  exit 1
fi

# 3. A stale manifest would tag the previous release's refs.
mise run p:plugins:marketplace --check

# 4. Every ref the manifest names, in entry order.
mapfile -t REFS < <(node -p "
  require('./.claude-plugin/marketplace.json')
    .plugins.map(p => p.source.ref).join('\n')
")

# 5. "Exists" means on the remote, not in this checkout.
git fetch --tags --quiet origin

TO_TAG=()
FORBIDDEN=()
for ref in "${REFS[@]}"; do
  if ! git rev-parse -q --verify "refs/tags/${ref}" >/dev/null; then
    # Only newly cut refs are checked; tags from before the 13/17 rule stand.
    if version_forbidden "${ref##*-v}"; then
      FORBIDDEN+=("${ref}")
    fi
    TO_TAG+=("${ref}")
    continue
  fi

  # An existing tag must point at HEAD; re-pointing it is not this task's call.
  tagged="$(git rev-list -n 1 "refs/tags/${ref}")"
  if [[ "${tagged}" != "$(git rev-parse HEAD)" ]]; then
    print_warn "${ref} already exists at ${tagged:0:8}, not HEAD — bump that plugin's version instead of reusing the tag."
  fi
done

# Refuse the whole run — tags are pushed together, never partially.
if [[ "${#FORBIDDEN[@]}" -gt 0 ]]; then
  print_error "Refusing to release ${FORBIDDEN[*]}: 13 and 17 are never issued as a version component. Bump that plugin's manifest past it, regenerate the marketplace manifest, and land it on ${RELEASE_BRANCH} first."
  exit 1
fi

if [[ "${#TO_TAG[@]}" -eq 0 ]]; then
  print_success "Every plugin ref already has its tag — nothing to release."
  exit 0
fi

print_header "Releasing ${#TO_TAG[@]} plugin(s):"
printf '  %s\n' "${TO_TAG[@]}"

if [[ "${DRY_RUN}" == "true" ]]; then
  print_warn "--dry-run — no tags created, nothing pushed."
  exit 0
fi

# 6. Annotated tags, then one push.
for ref in "${TO_TAG[@]}"; do
  git tag -a "${ref}" -m "${ref}"
done

print_header "Pushing ${#TO_TAG[@]} tag(s) ..."
git push origin "${TO_TAG[@]}"

print_success "Released: ${TO_TAG[*]}"
print_yellow "Users pick these up with 'claude plugin marketplace update virajp-plugins' then 'claude plugin update <name>'."
