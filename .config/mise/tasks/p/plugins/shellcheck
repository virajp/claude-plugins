#!/usr/bin/env bash
#MISE description="shellcheck and shfmt over every shell file a pack ships"
#MISE dir="{{ config_root }}"

# Keep SHFMT_FLAGS in step with the shipped `code:format` task's shfmt flags.

set -euo pipefail
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

cd "$MISE_PROJECT_ROOT"

for tool in shellcheck shfmt; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    print_error "$tool is not on PATH"
    print_warn "It is pinned in .config/mise/conf.d/tools.toml — run \`mise install\`, or"
    print_warn "\`mise x shellcheck@latest shfmt@latest -- mise run p:plugins:shellcheck\`"
    exit 1
  fi
done

SHFMT_FLAGS=(-i 2 -ci)
TASK_FLAGS=(-x -s bash -e SC2034 -e SC2154)

roots=()
hook_dirs=()
shopt -s nullglob
for pack in plugins/*/stacks/*/*; do
  [ -d "$pack/config/.config" ] && TASK_FLAGS+=(-P "$pack/config")
  [ -d "$pack/config/.config/mise/tasks" ] &&
    roots+=("$pack/config/.config/mise/tasks")
  [ -d "$pack/hooks" ] && hook_dirs+=("$pack/hooks")
done
# A stackgen:tool-config asset tree is a landed repo root, like a pack's config/.
for tree in plugins/stackgen/skills/tool-config/assets/*; do
  [ -d "$tree/.config" ] && TASK_FLAGS+=(-P "$tree")
  [ -d "$tree/.config/mise/tasks" ] && roots+=("$tree/.config/mise/tasks")
done
shopt -u nullglob

if [ "${#roots[@]}" -eq 0 ] && [ "${#hook_dirs[@]}" -eq 0 ]; then
  print_warn "No pack ships shell — nothing to check"
  exit 0
fi

task_files=()
if [ "${#roots[@]}" -gt 0 ]; then
  while IFS= read -r -d '' file; do
    task_files+=("$file")
  done < <(
    find "${roots[@]}" -type f \
      ! -name '*.mjs' ! -name '*.py' ! -name '*.env' \
      -print0 | sort -z
  )
fi

# Subtract metadata rather than glob `*.sh`, so a script missing the extension is still checked.
hook_files=()
if [ "${#hook_dirs[@]}" -gt 0 ]; then
  while IFS= read -r -d '' file; do
    hook_files+=("$file")
  done < <(
    find "${hook_dirs[@]}" -type f \
      ! -name '*.yaml' ! -name '*.yml' ! -name '*.json' ! -name '*.md' \
      -print0 | sort -z
  )
fi

total=$((${#task_files[@]} + ${#hook_files[@]}))
if [ "$total" -eq 0 ]; then
  print_warn "No shell under ${#roots[@]} task libraries and ${#hook_dirs[@]} hook tiers"
  exit 0
fi

failed=0

if [ "${#task_files[@]}" -gt 0 ]; then
  print_header "shellcheck over ${#task_files[@]} pack task files ..."
  if ! shellcheck "${TASK_FLAGS[@]}" "${task_files[@]}"; then
    print_error "shellcheck findings in the task libraries — see above"
    failed=1
  fi

  print_header "shfmt over ${#task_files[@]} pack task files ..."
  if ! shfmt -d "${SHFMT_FLAGS[@]}" "${task_files[@]}"; then
    print_error "shfmt findings — apply with \`shfmt -w ${SHFMT_FLAGS[*]} <file>\`"
    failed=1
  fi
fi

# Hooks take no shellcheck flags on purpose — see repo-shape.md.
if [ "${#hook_files[@]}" -gt 0 ]; then
  print_header "shellcheck over ${#hook_files[@]} pack hook scripts ..."
  if ! shellcheck "${hook_files[@]}"; then
    print_error "shellcheck findings in the hook scripts — see above"
    failed=1
  fi

  print_header "shfmt over ${#hook_files[@]} pack hook scripts ..."
  if ! shfmt -d "${SHFMT_FLAGS[@]}" "${hook_files[@]}"; then
    print_error "shfmt findings — apply with \`shfmt -w ${SHFMT_FLAGS[*]} <file>\`"
    failed=1
  fi
fi

[[ "$failed" -eq 0 ]] || exit 1

print_success "$total shell files across ${#roots[@]} task libraries and ${#hook_dirs[@]} hook tiers are clean"
