#!/usr/bin/env bash
#MISE description="Generate both marketplace manifests from the plugin manifests (--check to assert freshness)"
#MISE dir="{{ config_root }}"

# Runs the TypeScript directly — needs node >= 22.6 for type stripping.

set -euo pipefail
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

cd "$MISE_PROJECT_ROOT"

# "$@" passes --check through; deliberately not a #USAGE flag.
node scripts/src/marketplace.ts "$@"
