#!/usr/bin/env bash
# Synced from bootstrap: repo/tools/mise/tasks/test-e2e. Do not edit this file.
# The next sync writes it again, and each change in this file is lost.
#MISE description="Run the end-to-end tests: each test:e2e part"

#USAGE arg "[args]" var=#true help="the arguments and flags for each part, unchanged"

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# The parts: each test:e2e:NN-<name> task, from a tool or from this
# repository, in the order of its number. Each gets the raw arguments, with
# their quoting, so an undeclared flag of a part (--update) needs no --.
PARTS=$(own_tasks test:e2e) || PARTS=''
if [[ -z "${PARTS}" ]]; then
  print_info "No test:e2e part in this repository"
  exit 0
fi
for task in ${PARTS}; do
  mise run "${task}" "$@"
done
print_success "End-to-end testing done"
