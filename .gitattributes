# Synced from bootstrap: tools/git/.gitattributes. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

# The attributes of each stack, also of a stack that this repository does not
# use.

# LF in each file, so a change on a different platform never makes a diff of
# the full file.
* text=auto eol=lf

# The lockfiles are generated: a review collapses them, and the language
# statistics do not count them.
*.lock           linguist-generated
pnpm-lock.yaml   linguist-generated
Package.resolved linguist-generated

# Binary files: git does not change their line endings and shows no diff.
*.png   -text -diff
*.jpg   -text -diff
*.jpeg  -text -diff
*.gif   -text -diff
*.ico   -text -diff
*.webp  -text -diff
*.pdf   -text -diff
*.woff  -text -diff
*.woff2 -text -diff
*.ttf   -text -diff
*.otf   -text -diff
*.zip   -text -diff
