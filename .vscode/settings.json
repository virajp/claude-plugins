{
  // Synced from bootstrap: tools/vscode/.vscode/settings.json. Do not edit this file.
  // The next sync replaces it, and a manual change is lost.
  // Dart and Flutter files use the Flutter formatter, not dprint.
  "[dart]": {
    "editor.defaultFormatter": "Dart-Code.flutter",
    "editor.formatOnSave": true,
  },
  "diffEditor.ignoreTrimWhitespace": false,
  "diffEditor.renderSideBySide": false,
  "editor.autoIndent": "full",
  "editor.codeActions.triggerOnFocusChange": false,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "never",
    "source.sort.json": "explicit",
  },
  "editor.defaultColorDecorators": "always",
  "editor.defaultFormatter": "dprint.dprint",
  "editor.detectIndentation": false,
  "editor.formatOnSave": true,
  "editor.indentSize": 2,
  "editor.insertSpaces": true,
  "editor.quickSuggestions": {
    "comments": true,
    "other": true,
    "strings": true,
  },
  "editor.suggest.insertMode": "replace",
  "editor.tabSize": 2,
  "eslint.codeAction.disableRuleComment": {
    "commentStyle": "line",
    "enable": true,
    "location": "separateLine",
  },
  "eslint.codeAction.showDocumentation": {
    "enable": true,
  },
  "eslint.codeActionsOnSave.mode": "all",
  "eslint.codeActionsOnSave.options": {},
  "eslint.codeActionsOnSave.rules": null,
  "eslint.debug": false,
  "eslint.enable": true,
  "eslint.execArgv": [],
  "eslint.format.enable": false,
  "eslint.lintTask.enable": true,
  "eslint.lintTask.options": "",
  "eslint.useFlatConfig": true,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    ".envrc": "*.env, .env, .env.*, .env.*.secrets, .nvmrc",
    ".gitignore": ".dockerignore, .env, .gitattributes, .gitkeep, .gitmodules, .graphifyignore, .prettierignore",
    "*.js": "${capture}.d.ts, ${capture}.d.ts.map, ${capture}.js.map",
    "AGENTS.md": "CLAUDE.md",
    "dockerfile.projects": "docker-bake.hcl",
    "firebase.json": "*.rules, .firebaserc, firebase-debug.json, firestore.indexes.json",
    "linter.yaml": "git-conventional-commits.yaml, gitleaks.toml, grype.yaml, pre-commit-config.yaml, statusline.json",
    "mempalace.yaml": "entities.json",
    "mise.lock": "mise.*.lock",
    "mise.toml": "mise.*.lock, mise.lock, miserc.toml, root.toml",
    "package.json": ".markdownlint.yaml, .npmrc, .prettierrc.yaml, apphosting.*.yaml, apphosting.yaml, biome.jsonc, build.ts, doppler.yaml, dprint.jsonc, esbuild.mjs, eslint.config.mjs, pnpm-lock.yaml, pnpm-workspace.yaml, tsconfig.base.json, tsconfig.json, turbo.json, vitest.config.ts, waitOn.json, waitOnExternal.json",
    "pre-commit-config.yaml": "git-conventional-commits.yaml",
    "pubspec.yaml": ".envrc, .flutter-plugins, .flutter-plugins-dependencies, .metadata, .packages, analysis_options.yaml, dart_dependency_validator.yaml, devtools_options.yaml, l10n.yaml, pubspec.lock, pubspec_overrides.yaml",
    "readme.md": "CLAUDE.md, CONTRIBUTING.md, LICENSE, SECURITY.md, analysis_options.yaml, dprint.jsonc, eslint.config.mjs, todo.md",
  },
  "files.autoGuessEncoding": true,
  "files.exclude": {
    "**/.astro/": true,
    "**/.dart_tool": true,
    "**/.turbo/": true,
    "**/coverage/": true,
    "**/deploy/": true,
    "**/dist/": true,
    "**/node_modules/": true,
    "**/tsconfig.build.tsbuildinfo": true,
    "**/tsconfig.tsbuildinfo": true,
    "**/ui-debug.log": true,
    "graphify-out/": true,
    "pnpm-lock.yaml": true,
  },
  "files.watcherExclude": {
    "**/.dart_tool": true,
    "**/.git/objects.git/subtree-cache.hg/store.turbo/": true,
    "**/coverage/": true,
    "**/dist/": false,
    "**/node_modules/": true,
    "**/tsconfig.build.tsbuildinfo": true,
    "**/tsconfig.tsbuildinfo": true,
    "**/ui-debug.log": true,
  },
  "github.copilot.chat.commitMessageGeneration.instructions": [
    {
      "file": "~/.github/git-commit-guidelines.md",
    },
  ],
  "js/ts.preferences.importModuleSpecifier": "non-relative",
  "js/ts.preferences.includePackageJsonAutoImports": "on",
  "js/ts.preferences.quoteStyle": "double",
  "js/ts.suggest.autoImports": false,
  "js/ts.suggest.paths": true,
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "js/ts.tsserver.experimental.enableProjectDiagnostics": true,
  "js/ts.updateImportsOnFileMove.enabled": "never",
  "outline.showKeys": true,
  "search.exclude": {
    "***.log": true,
    "**/.turbo/": true,
    "**/bower_components": true,
    "**/coverage/": true,
    "**/dist/": true,
    "**/node_modules/": true,
    "**/tsconfig.build.tsbuildinfo": true,
    "**/tsconfig.tsbuildinfo": true,
    "**/ui-debug.log": true,
  },
  "todo-tree.general.tags": [
    "TODO",
    "FIXME",
    "HACK",
    "REVIEW",
    "NOTE",
    "REFACTOR",
    "REMOVE",
  ],
  "todo-tree.highlights.defaultHighlight": {
    "hideFromActivityBar": true,
    "hideFromStatusBar": false,
    "type": "text-and-comment",
  },
  "yaml.completion": true,
  "yaml.format.enable": false,
  "yaml.hover": true,
}
