// Shared with bootstrap: repo/tools/dprint/files/dprint.jsonc.merge.toml.
// A change in this file stays. A removed bootstrap item comes back at the next
// sync, unless .config/bootstrap/tools.toml has an override for it.
{
  // This repository's own excludes, on top of the shared config's.
  "excludes": [
    "**/node_modules/",
    "**/dist/",
    "**/build/",
    "**/.astro/",
    "**/.turbo/",
    "**/*-lock.json",
    "**/*-lock.yaml",
    "**/.config/mise/locks/",
    ".dev-marketplace/",
    // Plugin markdown keeps its hand-matched fold width.
    "plugins/**/*.md",
    // Payload, copied byte for byte into a target repo and formatted there by
    // the config stackgen:tool-config lands, never by this one.
    "plugins/*/stacks/*/*/config/",
    "plugins/*/stacks/*/*/templates/",
    "plugins/stackgen/skills/tool-config/assets/",
    "plugins/stackgen/skills/tool-config/templates/",
    "plugins/vwf/skills/init/assets/",
    "**/.claude/skills/flutter-interoperating-with-native-apis",
    "site/public/**/*.svg",
    "brag-output/",
    // Plan folders are written field by field by plan.mjs.
    "docs/plans/",
    // Design exports kept byte for byte.
    "docs/design/",
    "**/*.svg",
    "**/package-lock.json",
    "**/brag-output/**",
  ],
  "shuck": {
    "binaryNextLine": true,
    "indentWidth": 2,
    "spaceRedirects": true,
    "switchCaseIndent": true,
    "useTabs": false,
  },
  "newLineKind": "lf",
  "json": {
    "jsonTrailingCommaFiles": [
      "*.jsonc",
      ".vscode/settings.json",
    ],
    "preferSingleLine": false,
    "trailingCommas": "jsonc",
  },
  "markdown": {
    "emphasisKind": "asterisks",
    "strongKind": "asterisks",
    "tags": {
      "bash": "bash",
      "sh": "sh",
      "shell": "sh",
      "zsh": "zsh",
    },
    "textWrap": "maintainAndWrap",
  },
  "markup": {
    "astro.scriptIndent": true,
    "astro.styleIndent": true,
    "astroAttrShorthand": true,
    "component.selfClosing": true,
    "component.vSlotStyle": "vSlot",
    "default.vSlotStyle": "vSlot",
    "formatComments": true,
    "html.normal.selfClosing": true,
    "html.scriptIndent": true,
    "html.styleIndent": true,
    "html.void.selfClosing": true,
    "maxAttrsPerLine": 1,
    "named.vSlotStyle": "vSlot",
    "scriptIndent": true,
    "styleIndent": true,
    "svelte.scriptIndent": true,
    "svelte.styleIndent": true,
    "svg.selfClosing": true,
    "vBindSameNameShortHand": true,
    "vBindStyle": "short",
    "vForDelimiterStyle": "in",
    "vOnStyle": "short",
    "vSlotStyle": "vSlot",
    "vue.scriptIndent": true,
    "vue.styleIndent": true,
  },
  "ruff": {
    "indentWidth": 2,
    "lineLength": 120,
  },
  "tailwindcss": {},
  "toml": {
    "array.preferSingleLine": true,
    "array.spaceSurroundingBrackets": true,
    "comment.forceLeadingSpace": false,
    "indentEntries": "never",
    "indentTables": "never",
    "inlineTable.spaceSurroundingBraces": true,
    "sortArrays": false,
    "sortInlineTables": true,
    "sortKeys": true,
  },
  "typescript": {
    "arrowFunction.useParentheses": "force",
    "binaryExpression.linePerExpression": true,
    "enumDeclaration.memberSpacing": "newLine",
    "exportDeclaration.forceMultiLine": "whenMultiple",
    "exportDeclaration.sortTypeOnlyExports": "last",
    "importDeclaration.forceMultiLine": "whenMultiple",
    "importDeclaration.sortTypeOnlyImports": "first",
    "memberExpression.linePerExpression": true,
    "quoteProps": "consistent",
    "useBraces": "always",
  },
  "yaml": {
    "bracketSpacing": true,
    "formatComments": true,
    "proseWrap": "always",
  },
  "plugins": [
    "npm:@dprint/toml@0.9.0",
    "npm:@dprint/json@0.25.2",
    "npm:@dprint/markdown@0.28.2",
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:@dprint/shuck@0.2.2",
    "npm:@dprint/typescript@0.96.1",
    "npm:dprint-plugin-markup@0.27.6",
    "npm:dprint-plugin-tailwindcss@0.1.0",
    "npm:@dprint/ruff@0.11.3",
  ],
}
