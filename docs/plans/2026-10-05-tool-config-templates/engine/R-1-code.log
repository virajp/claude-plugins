  it(\"refuses a row whose content changed since the preview\", () => {\ntool-config-render.test.ts:480:  it(\"refuses a path that is absolute or climbs out of the repo\", () => {\ntool-config-render.test.ts:487:  it(\"refuses to write through a symlinked folder\", () => {\ntool-config-render.test.ts:499:  it(\"stops with the install remedy when mise is not on PATH\", () => {\ntool-config-render.test.ts:507:  it(\"refuses an untrusted mise config, naming the remedy\", () => {\ntool-config-render.test.ts:516:  it(\"keeps the files written when setup:all fails, and says so\", () => {\ntool-config-render.test.ts:526:  it(\"puts every file back byte for byte when validate-config fails\", () => {\ntool-config-render.test.ts:543:  it(\"refuses a pack call when the formatter is not installed, before the first byte\", () => {","is_error":false}]},"uuid":"dd10fe0c-0e7f-4c00-bedb-aa4619304fe6","timestamp":"2026-10-05T07:49:42.510Z","sourceToolAssistantUUID":"586f158b-b6f8-46b5-9b39-8376b305caa5","userType":"external","entrypoint":"cli","cwd":"/Users/virajpatel/Projects/github.com/virajp/claude-plugins/.worktrees/2026-10-05-tool-config-templates","sessionId":"69f6d805-2cf4-410f-bb9a-f18a900e1285","version":"2.1.289","gitBranch":"2026-10-05-tool-config-templates"}
