{"parentUuid":"4ed0873b-70be-4911-847b-dbd56b65db29","isSidechain":true,"promptId":"f3add2f7-ffac-43ca-818b-a54ab113212d","agentId":"a7b9a102584489b88","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QsQFopjHn3Qbvs9zPQgoeM","type":"tool_result","content":"     1\t#!/usr/bin/env node\n     2\t// stackgen:tool-config's script: renders a repo's universal tool configs from\n     3\t// two trees — `assets/`, copied as they are, and `templates/`, rendered from\n     4\t// `.config/stackgen.yaml` — and a pack's own `templates/`, showing every\n     5\t// change as a numbered row before it writes. The grammar is lib/cli.mjs's;\n     6\t// the output is JSON on stdout, always — exit 0 on success, 2 on a refused\n     7\t// call ({error, rows?}), 1 on an internal fault.\n     8\t//\n     9\t//   all          writes the given values into stackgen.yaml, then renders every\n    10\t//                asset and template; then `MISE_ENV=dev mise run setup:all`\n    11\t//   pack         writes the pack's `--set` values, renders its templates/, and\n    12\t//                re-renders the `…:all` tasks\n    13\t//   pack-remove  deletes the pack's conf.d folder and subtasks, drops its values,\n    14\t//                and re-renders the `…:all` tasks\n    15\t//   upgrade      moves each exact pin a CI-loaded mise file holds forward\n    16\t//\n    17\t// No file is recorded anywhere: each call compares a fresh render with the\n    18\t// repo as it stands. A file that differs is one row — `ok` takes the render,\n    19\t// `keep-existing` leaves the file. A call that writes then runs the formatter\n    20\t// over every file it wrote, when the repo has `.config/dprint.json`, and\n    21\t// `pre-commit validate-config` when it wrote the hook config; either failing\n    22\t// puts every file back byte for byte. Every tool runs as `mise x -- <tool>`\n    23\t// (lib/run.mjs), after `mise which` says it is installed.\n    24\t\n    25\timport { spawnSync } from \"node:child_process\";\n    26\timport {\n    27\t  chmodSync,\n    28\t  existsSync,\n    29\t  lstatSync,\n    30\t  mkdirSync,\n    31\t  readdirSync,\n    32\t  readFileSync,\n    33\t  realpathSync,\n    34\t  rmSync,\n    35\t  statSync,\n    36\t  writeFileSync,\n    37\t} from \"node:fs\";\n    38\timport {\n    39\t  dirname,\n    40\t  join,\n    41\t  relative,\n    42\t  resolve,\n    43\t  sep,\n    44\t} from \"node:path\";\n    45\timport { fileURLToPath } from \"node:url\";\n    46\timport { parseArgs } from \"./lib/cli.mjs\";\n    47\timport {\n    48\t  checkRelPath,\n    49\t  sha256,\n    50\t  splitLines,\n    51\t  UnsafePathError,\n    52\t} from \"./lib/paths.mjs\";\n    53\timport {\n    54\t  filledSlot,\n    55\t  isCiLoaded,\n    56\t  isExact,\n    57\t  isMarked,\n    58\t  pinExact,\n    59\t  pinsOf,\n    60\t  renderTemplate,\n    61\t  setPin,\n    62\t  splice,\n    63\t  SUBTASK_DIRS,\n    64\t  subtaskNames,\n    65\t  taskNames,\n    66\t  TASKS_DIR,\n    67\t  tierOf,\n    68\t  valueNames,\n    69\t  walk,\n    70\t} from \"./lib/render.mjs\";\n    71\timport {\n    72\t  checkAnswers,\n    73\t  numberRows,\n    74\t  previewStore,\n    75\t  publicRow,\n    76\t  RefusalError,\n    77\t} from \"./lib/rows.mjs\";\n    78\timport {\n    79\t  MISSING_MISE,\n    80\t  onPath,\n    81\t  Runner,\n    82\t} from \"./lib/run.mjs\";\n    83\timport {\n    84\t  STACKGEN_PATH,\n    85\t  stackgenText,\n    86\t  valuesFrom,\n    87\t  withPack,\n    88\t  withValues,\n    89\t} from \"./lib/stackgen-file.mjs\";\n    90\timport {\n    91\t  readStackgen,\n    92\t  ValuesError,\n    93\t} from \"./lib/values.mjs\";\n    94\timport { YamlError } from \"./lib/yaml.mjs\";\n    95\t\n    96\tconst SCRIPT_DIR = dirname(fileURLToPath(import.meta.url));\n    97\t\n    98\tconst DPRINT_CONFIG = \".config/dprint.json\";\n    99\tconst HOOK_CONFIG = \".config/pre-commit-config.yaml\";\n   100\tconst CONF_D = \".config/mise/conf.d\";\n   101\t\n   102\tconst modeOf = exec => (exec ? \"755\" : \"644\");\n   103\t\n   104\t// --- the workspace: the repo as the call would leave it --------------------------\n   105\t\n   106\tclass Workspace {\n   107\t  constructor(root) {\n   108\t    this.root = root;\n   109\t    this.files = new Map(); // path → text | null (deleted)\n   110\t    this.modes = new Map();\n   111\t    this.order = []; // touched paths, first touch first\n   112\t  }\n   113\t\n   114\t  /**\n   115\t   * The absolute path of a repo-relative one, for any read, write, delete or\n   116\t   * list: refused when it is absolute or climbs with `..`, when it or any\n   117\t   * parent inside the repo is a symlink, or when it resolves outside the root.\n   118\t   */\n   119\t  safe(path) {\n   120\t    checkRelPath(path);\n   121\t    this.realRoot ??= realpathSync(this.root);\n   122\t    const parts = path.split(\"/\").filter(p => p !== \"\" && p !== \".\");\n   123\t    let at = this.realRoot;\n   124\t    for (const part of parts) {\n   125\t      at = join(at, part);\n   126\t      let st;\n   127\t      try {\n   128\t        st = lstatSync(at);\n   129\t      }\n   130\t      catch (e) {\n   131\t        if (e.code === \"ENOENT\" || e.code === \"ENOTDIR\") {\n   132\t          break;\n   133\t        }\n   134\t        throw e;\n   135\t      }\n   136\t      if (st.isSymbolicLink()) {\n   137\t        throw new UnsafePathError(\n   138\t          `${path}: ${relative(this.realRoot, at)} is a symlink — refused`,\n   139\t        );\n   140\t      }\n   141\t    }\n   142\t    const abs = join(this.realRoot, ...parts);\n   143\t    if (abs !== this.realRoot && !abs.startsWith(this.realRoot + sep)) {\n   144\t      throw new UnsafePathError(`${path} resolves outside the repo — refused`);\n   145\t    }\n   146\t    return abs;\n   147\t  }\n   148\t\n   149\t  disk(path) {\n   150\t    const abs = this.safe(path);\n   151\t    return existsSync(abs) && statSync(abs).isFile()\n   152\t      ? readFileSync(abs, \"utf8\")\n   153\t      : null;\n   154\t  }\n   155\t\n   156\t  /** Whether the file on disk is executable; null when there is none. */\n   157\t  diskExec(path) {\n   158\t    const abs = this.safe(path);\n   159\t    return existsSync(abs) && statSync(abs).isFile()\n   160\t      ? (statSync(abs).mode & 0o111) !== 0\n   161\t      : null;\n   162\t  }\n   163\t\n   164\t  read(path) {\n   165\t    return this.files.has(path) ? this.files.get(path) : this.disk(path);\n   166\t  }\n   167\t\n   168\t  touch(path) {\n   169\t    if (!this.order.includes(path)) {\n   170\t      this.order.push(path);\n   171\t    }\n   172\t  }\n   173\t\n   174\t  write(path, text, mode) {\n   175\t    this.touch(path);\n   176\t    this.files.set(path, text);\n   177\t    this.modes.set(path, mode);\n   178\t  }\n   179\t\n   180\t  remove(path) {\n   181\t    this.touch(path);\n   182\t    this.files.set(path, null);\n   183\t    this.modes.delete(path);\n   184\t  }\n   185\t\n   186\t  /** Forget a planned change: the path reads as the disk has it. */\n   187\t  drop(path) {\n   188\t    this.order = this.order.filter(p => p !== path);\n   189\t    this.files.delete(path);\n   190\t    this.modes.delete(path);\n   191\t  }\n   192\t\n   193\t  /** Repo-relative files under `dir`, as the call would leave them. */\n   194\t  list(dir) {\n   195\t    const base = dir.replace(/\\/$/, \"\");\n   196\t    const out = new Set();\n   197\t    // the directory and its parents are held to safe(); a symlink inside it is never followed or listed\n   198\t    const visit = rel => {\n   199\t      const abs = this.safe(rel);\n   200\t      if (!existsSync(abs) || !statSync(abs).isDirectory()) {\n   201\t        return;\n   202\t      }\n   203\t      for (const d of readdirSync(abs, { withFileTypes: true })) {\n   204\t        if (d.isSymbolicLink()) {\n   205\t          continue;\n   206\t        }\n   207\t        const p = `${rel}/${d.name}`;\n   208\t        if (d.isDirectory()) {\n   209\t          visit(p);\n   210\t        }\n   211\t        else {\n   212\t          out.add(p);\n   213\t        }\n   214\t      }\n   215\t    };\n   216\t    visit(base);\n   217\t    for (const [p, text] of this.files) {\n   218\t      if (!p.startsWith(`${base}/`)) {\n   219\t        continue;\n   220\t      }\n   221\t      if (text === null) {\n   222\t        out.delete(p);\n   223\t      }\n   224\t      else {\n   225\t        out.add(p);\n   226\t      }\n   227\t    }\n   228\t    return [...out].sort();\n   229\t  }\n   230\t\n   231\t  /** The paths this call will write (not delete), before any is written. */\n   232\t  pending() {\n   233\t    return this.order.filter(p => typeof this.files.get(p) === \"string\");\n   234\t  }\n   235\t\n   236\t  /**\n   237\t   * Write every touched file. Returns what it wrote and deleted, and\n   238\t   * `restore()`, which puts each touched path back byte for byte.\n   239\t   */\n   240\t  writeFiles() {\n   241\t    const written = [];\n   242\t    const deleted = [];\n   243\t    // every path is held to safe() before the first byte is written\n   244\t    const targets = new Map(this.order.map(p => [p, this.safe(p)]));\n   245\t    const before = new Map();\n   246\t    for (const path of this.order) {\n   247\t      const abs = targets.get(path);\n   248\t      before.set(\n   249\t        path,\n   250\t        existsSync(abs) && statSync(abs).isFile()\n   251\t          ? { bytes: readFileSync(abs), mode: statSync(abs).mode & 0o777 }\n   252\t          : null,\n   253\t      );\n   254\t    }\n   255\t    for (const path of this.order) {\n   256\t      const text = this.files.get(path);\n   257\t      const abs = targets.get(path);\n   258\t      if (text === null) {\n   259\t        if (existsSync(abs)) {\n   260\t          rmSync(abs);\n   261\t          deleted.push(path);\n   262\t          // a folder the delete left empty goes too: pack-remove's conf.d/<slug>/\n   263\t          for (\n   264\t            let dir = dirname(abs);\n   265\t            dir.startsWith(this.realRoot + sep)\n   266\t            && readdirSync(dir).length === 0;\n   267\t            dir = dirname(dir)\n   268\t          ) {\n   269\t            rmSync(dir, { recursive: true });\n   270\t          }\n   271\t        }\n   272\t        continue;\n   273\t      }\n   274\t      mkdirSync(dirname(abs), { recursive: true });\n   275\t      writeFileSync(abs, text);\n   276\t      chmodSync(abs, parseInt(this.modes.get(path) ?? \"644\", 8));\n   277\t      written.push(path);\n   278\t    }\n   279\t    const restore = () => {\n   280\t      for (const [path, was] of before) {\n   281\t        const abs = targets.get(path);\n   282\t        if (was === null) {\n   283\t          rmSync(abs, { force: true });\n   284\t          continue;\n   285\t        }\n   286\t        mkdirSync(dirname(abs), { recursive: true });\n   287\t        writeFileSync(abs, was.bytes);\n   288\t        chmodSync(abs, was.mode);\n   289\t      }\n   290\t    };\n   291\t    return { written, deleted, restore };\n   292\t  }\n   293\t}\n   294\t\n   295\t// --- placing a file -------------------------------------------------------------\n   296\t\n   297\t/**\n   298\t * Plan one source file — an asset, or a rendered template — at `path`: a\n   299\t * source that renders empty deletes the repo's copy; a placeholder never\n   300\t * overwrites a filled slot; a marked file keeps every line outside its\n   301\t * markers; a CI-loaded mise file gets exact pins; and a render the repo's\n   302\t * formatter would leave as the file already reads is no change.\n   303\t */\n   304\tfunction place(ctx, path, source, exec) {\n   305\t  const { ws, env, notes } = ctx;\n   306\t  const existing = ws.disk(path);\n   307\t  ws.drop(path);\n   308\t  if (source.trim() === \"\") {\n   309\t    if (existing !== null) {\n   310\t      ws.remove(path);\n   311\t    }\n   312\t    return;\n   313\t  }\n   314\t  if (filledSlot(source, existing)) {\n   315\t    return;\n   316\t  }\n   317\t  let text = source;\n   318\t  if (existing !== null && isMarked(source)) {\n   319\t    const spliced = splice(existing, source);\n   320\t    if (spliced === null) {\n   321\t      notes.push(\n   322\t        `${path} has no single tool-config marker pair — its row replaces the whole file`,\n   323\t      );\n   324\t    }\n   325\t    text = spliced ?? source;\n   326\t  }\n   327\t  if (isCiLoaded(path)) {\n   328\t    text = pinExact(text, existing, tool => env.runner.latest(tool));\n   329\t  }\n   330\t  if (existing !== null && text !== existing) {\n   331\t    text = formatted(ctx, path, text) ?? text;\n   332\t  }\n   333\t  if (text === existing && ws.diskExec(path) === exec) {\n   334\t    return;\n   335\t  }\n   336\t  ws.write(path, text, modeOf(exec));\n   337\t}\n   338\t\n   339\t/** `text` as the repo's formatter would leave it — only once the repo has one installed. */\n   340\tfunction formatted(ctx, path, text) {\n   341\t  const { ws, env } = ctx;\n   342\t  if (ctx.formatter === undefined) {\n   343\t    ctx.formatter = ws.disk(DPRINT_CONFIG) !== null && env.runner.has(\"dprint\");\n   344\t  }\n   345\t  return ctx.formatter ? env.runner.format(path, text, DPRINT_CONFIG) : null;\n   346\t}\n   347\t\n   348\t/** Render one tree's templates in tier order: plain names, then subtask lists, then TASKS. */\n   349\tfunction renderTree(ctx, templates, values, { tiers = [0, 1, 2] } = {}) {\n   350\t  let names = valueNames(values);\n   351\t  for (const tier of [0, 1, 2]) {\n   352\t    if (tier === 1) {\n   353\t      names = { ...names, ...subtaskNames(ctx.ws) };\n   354\t    }\n   355\t    if (tier === 2) {\n   356\t      names = { ...names, TASKS: taskNames(ctx.ws) };\n   357\t    }\n   358\t    if (!tiers.includes(tier)) {\n   359\t      continue;\n   360\t    }\n   361\t    for (const t of templates.filter(t => t.tier === tier)) {\n   362\t      place(ctx, t.path, renderTemplate(t.text, names, t.path), t.exec);\n   363\t    }\n   364\t  }\n   365\t}\n   366\t\n   367\tfunction readTree(dir) {\n   368\t  return walk(dir).map(f => {\n   369\t    const text = readFileSync(f.abs, \"utf8\");\n   370\t    return { ...f, text, tier: tierOf(text) };\n   371\t  });\n   372\t}\n   373\t\n   374\t// --- stackgen.yaml ---------------------------------------------------------------\n   375\t\n   376\tfunction readDoc(ws) {\n   377\t  // the parsed file, held to safe() like every other path\n   378\t  ws.safe(STACKGEN_PATH);\n   379\t  return readStackgen(ws.root);\n   380\t}\n   381\t\n   382\t/** Plan the values file's new text; returns it, for the render to read. */\n   383\tfunction setDoc(ctx, doc) {\n   384\t  const text = stackgenText(doc);\n   385\t  const existing = ctx.ws.disk(STACKGEN_PATH);\n   386\t  // a pack call with no values never creates the file for `format` alone\n   387\t  const empty = Object.keys(doc).every(k => k === \"format\");\n   388\t  if (text !== existing && !(existing === null && empty)) {\n   389\t    ctx.ws.write(STACKGEN_PATH, text, \"644\");\n   390\t  }\n   391\t  return text;\n   392\t}\n   393\t\n   394\t// --- commands ----------------------------------------------------------------------\n   395\t\n   396\tfunction cmdAll(ctx, call) {\n   397\t  const doc = withValues(readDoc(ctx.ws), call.values);\n   398\t  if (!doc.repo_name) {\n   399\t    throw new RefusalError(\n   400\t      `all needs --repo-name: ${STACKGEN_PATH} holds no repo_name yet`,\n   401\t    );\n   402\t  }\n   403\t  const values = valuesFrom(setDoc(ctx, doc), ctx.ws.root);\n   404\t  for (const f of walk(ctx.assetsDir)) {\n   405\t    place(ctx, f.path, readFileSync(f.abs, \"utf8\"), f.exec);\n   406\t  }\n   407\t  renderTree(ctx, readTree(ctx.templatesDir), values);\n   408\t}\n   409\t\n   410\t/** The universal templates that list subtasks or tasks, re-rendered after a pack's files move. */\n   411\tfunction rerenderAll(ctx, text) {\n   412\t  const values = valuesFrom(text, ctx.ws.root);\n   413\t  renderTree(ctx, readTree(ctx.templatesDir), values, { tiers: [1, 2] });\n   414\t}\n   415\t\n   416\tfunction cmdPack(ctx, call) {\n   417\t  const slug = call.flags.slug;\n   418\t  const dir = resolve(call.flags.dir);\n   419\t  if (!existsSync(dir) || !statSync(dir).isDirectory()) {\n   420\t    throw new RefusalError(`--dir ${call.flags.dir} is not a folder`);\n   421\t  }\n   422\t  const text = setDoc(ctx, withPack(readDoc(ctx.ws), slug, call.sets));\n   423\t  const templates = readTree(join(dir, \"templates\"));\n   424\t  for (const t of templates) {\n   425\t    if (t.path === STACKGEN_PATH) {\n   426\t      throw new RefusalError(\n   427\t        `${slug}'s templates/ holds ${STACKGEN_PATH} — the values file is the script's alone`,\n   428\t      );\n   429\t    }\n   430\t  }\n   431\t  renderTree(ctx, templates, valuesFrom(text, ctx.ws.root, slug));\n   432\t  rerenderAll(ctx, text);\n   433\t}\n   434\t\n   435\tfunction cmdPackRemove(ctx, call) {\n   436\t  const slug = call.flags.slug;\n   437\t  const text = setDoc(ctx, withPack(readDoc(ctx.ws), slug, null));\n   438\t  const owned = [\n   439\t    ...ctx.ws.list(`${CONF_D}/${slug}/`),\n   440\t    ...Object\n   441\t      .values(SUBTASK_DIRS)\n   442\t      .map(d => `${TASKS_DIR}/${d}/${slug}`)\n   443\t      .filter(p => ctx.ws.read(p) !== null),\n   444\t  ];\n   445\t  for (const path of owned.sort()) {\n   446\t    ctx.ws.remove(path);\n   447\t  }\n   448\t  rerenderAll(ctx, text);\n   449\t}\n   450\t\n   451\t/** One row per exact pin a CI-loaded mise file holds that `mise latest` has moved past. */\n   452\tfunction cmdUpgrade(ctx) {\n   453\t  const { ws, env } = ctx;\n   454\t  const rows = [];\n   455\t  const files = [\n   456\t    \".config/mise.toml\",\n   457\t    ...ws.list(`${CONF_D}/`),\n   458\t  ]\n   459\t    .filter(isCiLoaded);\n   460\t  for (const path of files) {\n   461\t    const text = ws.disk(path);\n   462\t    for (const pin of pinsOf(text)) {\n   463\t      if (!isExact(pin.version)) {\n   464\t        continue;\n   465\t      }\n   466\t      const to = env.runner.latest(pin.tool);\n   467\t      if (\n   468\t        !isExact(to) || to.replace(/^v/, \"\") === pin.version.replace(/^v/, \"\")\n   469\t      ) {\n   470\t        continue;\n   471\t      }\n   472\t      rows.push({\n   473\t        kind: \"pin\",\n   474\t        path,\n   475\t        tool: pin.tool,\n   476\t        from: pin.version,\n   477\t        to,\n   478\t        _apply: () =>\n   479\t          ws.write(\n   480\t            path,\n   481\t            setPin(ws.read(path), pin.line, to),\n   482\t            modeOf(ws.diskExec(path)),\n   483\t          ),\n   484\t      });\n   485\t    }\n   486\t  }\n   487\t  return rows;\n   488\t}\n   489\t\n   490\t// --- rows -----------------------------------------------------------------------\n   491\t\n   492\t/** One count-aware line difference: what `after` adds and drops against `before`. */\n   493\tfunction lineDiff(before, after) {\n   494\t  const count = new Map();\n   495\t  for (const l of before) {\n   496\t    count.set(l, (count.get(l) ?? 0) + 1);\n   497\t  }\n   498\t  const added = [];\n   499\t  for (const l of after) {\n   500\t    if (count.get(l)) {\n   501\t      count.set(l, count.get(l) - 1);\n   502\t    }\n   503\t    else {\n   504\t      added.push(l);\n   505\t    }\n   506\t  }\n   507\t  const removed = [...count].flatMap(([l, n]) => Array(n).fill(l));\n   508\t  return { added, removed };\n   509\t}\n   510\t\n   511\t/** The create, write and delete rows: each planned path against the disk. */\n   512\tfunction fileRows(ws) {\n   513\t  const rows = [];\n   514\t  const short = t => (t === null ? null : sha256(t).slice(0, 12));\n   515\t  for (const path of ws.order) {\n   516\t    const before = ws.disk(path);\n   517\t    const after = ws.read(path);\n   518\t    const row = {\n   519\t      kind: before === null ? \"create\" : after === null ? \"delete\" : \"write\",\n   520\t      path,\n   521\t      before: short(before),\n   522\t      after: short(after),\n   523\t    };\n   524\t    if (before !== null && after !== null) {\n   525\t      Object.assign(\n   526\t        row,\n   527\t        lineDiff(splitLines(before).lines, splitLines(after).lines),\n   528\t      );\n   529\t      const exec = ws.modes.get(path) === \"755\";\n   530\t      if (ws.diskExec(path) !== exec) {\n   531\t        row.mode = ws.modes.get(path);\n   532\t      }\n   533\t    }\n   534\t    if (path === STACKGEN_PATH) {\n   535\t      // the call's own values: answering the call is answering them\n   536\t      row.answers = [\"ok\"];\n   537\t    }\n   538\t    rows.push(row);\n   539\t  }\n   540\t  return rows;\n   541\t}\n   542\t\n   543\t// --- landing -----------------------------------------------------------------------\n   544\t\n   545\t/**\n   546\t * Write the call's files, then — on `all` — `MISE_ENV=dev mise run setup:all`,\n   547\t * then the formatter over every file written, then `pre-commit\n   548\t * validate-config` when the hook config was written. A tool a step needs and\n   549\t * the repo has not installed refuses before the first byte (on `all`, after\n   550\t * setup:all has had its chance). A setup:all failure leaves the files\n   551\t * written; a formatter or validate failure puts every file back byte for byte.\n   552\t */\n   553\tfunction land(ws, env, all) {\n   554\t  const runner = env.runner;\n   555\t  const pending = ws.pending();\n   556\t  const formats = pending.length > 0 && ws.read(DPRINT_CONFIG) !== null;\n   557\t  const validates = pending.includes(HOOK_CONFIG);\n   558\t  if (!all) {\n   559\t    if (formats) {\n   560\t      runner.ensure(\"dprint\");\n   561\t    }\n   562\t    if (validates) {\n   563\t      runner.ensure(\"pre-commit\");\n   564\t    }\n   565\t  }\n   566\t  const { written, deleted, restore } = ws.writeFiles();\n   567\t  let setupOutput = \"\";\n   568\t  if (all) {\n   569\t    const kept = (why, output) =>\n   570\t      new RefusalError(\n   571\t        `${why} — the files this call wrote stay; re-run all once it passes${\n   572\t          output ? `:\\n${output}` : \"\"\n   573\t        }`,\n   574\t        undefined,\n   575\t        { written, deleted },\n   576\t      );\n   577\t    try {\n   578\t      runner.trust();\n   579\t    }\n   580\t    catch (e) {\n   581\t      throw e instanceof RefusalError ? kept(e.message) : e;\n   582\t    }\n   583\t    const setup = runner.setupAll();\n   584\t    if (!setup.ok) {\n   585\t      throw kept(\"MISE_ENV=dev mise run setup:all failed\", setup.output);\n   586\t    }\n   587\t    setupOutput = setup.output;\n   588\t  }\n   589\t  try {\n   590\t    if (formats && written.length) {\n   591\t      runner.tool(\"dprint\", [\n   592\t        \"fmt\",\n   593\t        \"--config\",\n   594\t        DPRINT_CONFIG,\n   595\t        \"--allow-no-files\",\n   596\t        ...written,\n   597\t      ]);\n   598\t    }\n   599\t    if (validates) {\n   600\t      runner.tool(\"pre-commit\", [\"validate-config\", HOOK_CONFIG]);\n   601\t    }\n   602\t  }\n   603\t  catch (e) {\n   604\t    restore();\n   605\t    if (e instanceof RefusalError) {\n   606\t      throw new RefusalError(\n   607\t        `${e.message}\\nevery file this call wrote is back as it was`,\n   608\t      );\n   609\t    }\n   610\t    throw e;\n   611\t  }\n   612\t  // a passing setup:all can still warn (a kept foreign hook manager): relay it\n   613\t  return { written, deleted, ...(setupOutput && { setup: setupOutput }) };\n   614\t}\n   615\t\n   616\t// --- main ------------------------------------------------------------------------------\n   617\t\n   618\tfunction repoRootOf(given) {\n   619\t  if (given) {\n   620\t    return resolve(given);\n   621\t  }\n   622\t  const git = spawnSync(\"git\", [\"rev-parse\", \"--show-toplevel\"], {\n   623\t    encoding: \"utf8\",\n   624\t  });\n   625\t  return git.status === 0 ? git.stdout.trim() : process.cwd();\n   626\t}\n   627\t\n   628\tfunction signatureOf(call, repoRoot) {\n   629\t  const { command, flags, sets } = call;\n   630\t  return sha256(JSON.stringify({ root: repoRoot, command, flags, sets }));\n   631\t}\n   632\t\n   633\tasync function run(argv) {\n   634\t  const call = parseArgs(argv);\n   635\t  const pluginRoot = resolve(\n   636\t    call.globals[\"plugin-root\"] || join(SCRIPT_DIR, \"..\", \"..\", \"..\"),\n   637\t  );\n   638\t  const repoRoot = repoRootOf(call.globals[\"repo-root\"]);\n   639\t  const env = { repoRoot, pluginRoot, runner: new Runner(repoRoot) };\n   640\t  const ws = new Workspace(repoRoot);\n   641\t  const skill = join(pluginRoot, \"skills\", \"tool-config\");\n   642\t  const ctx = {\n   643\t    ws,\n   644\t    env,\n   645\t    notes: [],\n   646\t    assetsDir: join(skill, \"assets\"),\n   647\t    templatesDir: join(skill, \"templates\"),\n   648\t  };\n   649\t\n   650\t  if (\n   651\t    (call.command === \"all\" || call.command === \"upgrade\") && !onPath(\"mise\")\n   652\t  ) {\n   653\t    throw new RefusalError(MISSING_MISE);\n   654\t  }\n   655\t  // trust is the person's to grant beforehand; an untrusted config stops here\n   656\t  env.runner.trust();\n   657\t\n   658\t  let raised = [];\n   659\t  if (call.command === \"all\") {\n   660\t    cmdAll(ctx, call);\n   661\t  }\n   662\t  else if (call.command === \"pack\") {\n   663\t    cmdPack(ctx, call);\n   664\t  }\n   665\t  else if (call.command === \"pack-remove\") {\n   666\t    cmdPackRemove(ctx, call);\n   667\t  }\n   668\t  else {\n   669\t    raised = cmdUpgrade(ctx);\n   670\t  }\n   671\t  const rows = numberRows([...fileRows(ws), ...raised]);\n   672\t  const store = previewStore(repoRoot);\n   673\t  const signature = signatureOf(call, repoRoot);\n   674\t  const extra = ctx.notes.length ? { notes: ctx.notes } : {};\n   675\t\n   676\t  if (call.preview) {\n   677\t    store.put(signature, rows);\n   678\t    return { preview: true, rows: rows.map(publicRow), ...extra };\n   679\t  }\n   680\t  if (call.answers === null && rows.length) {\n   681\t    store.put(signature, rows);\n   682\t    throw new RefusalError(\n   683\t      \"this call shows rows — answer each with --answers <id>:<answer>,…\",\n   684\t      rows,\n   685\t    );\n   686\t  }\n   687\t  if (rows.length || call.answers?.size) {\n   688\t    checkAnswers(rows, call.answers ?? new Map(), store.get(signature));\n   689\t  }\n   690\t  for (const row of rows) {\n   691\t    const answer = call.answers?.get(row.id);\n   692\t    if (row._apply) {\n   693\t      if (answer === \"ok\") {\n   694\t        row._apply();\n   695\t      }\n   696\t    }\n   697\t    else if (answer === \"keep-existing\") {\n   698\t      ws.drop(row.path);\n   699\t    }\n   700\t  }\n   701\t  const { written, deleted, setup } = land(ws, env, call.command === \"all\");\n   702\t  store.drop(signature);\n   703\t  return { written, deleted, ...(setup && { setup }), ...extra };\n   704\t}\n   705\t\n   706\ttry {\n   707\t  const out = await run(process.argv.slice(2));\n   708\t  process.stdout.write(JSON.stringify(out, null, 2) + \"\\n\");\n   709\t}\n   710\tcatch (e) {\n   711\t  // exitCode, never exit(): exit() can cut a large JSON body short on a pipe\n   712\t  if (\n   713\t    e instanceof RefusalError\n   714\t    || e instanceof UnsafePathError\n   715\t    || e instanceof ValuesError\n   716\t    || e instanceof YamlError\n   717\t  ) {\n   718\t    const body = {\n   719\t      error: e.message,\n   720\t      ...(e.rows && { rows: e.rows.map(publicRow) }),\n   721\t      ...e.extra,\n   722\t    };\n   723\t    process.stdout.write(JSON.stringify(body, null, 2) + \"\\n\");\n   724\t    process.exitCode = 2;\n   725\t  }\n   726\t  else {\n   727\t    process.stdout.write(\n   728\t      JSON.stringify({ error: String(e?.message ?? e) }, null, 2) + \"\\n\",\n   729\t    );\n   730\t    process.stderr.write(`${e?.stack ?? e}\\n`);\n   731\t    process.exitCode = 1;\n   732\t  }\n   733\t}","is_error":false}]},"uuid":"5281506f-3eb7-476e-aff4-b5e5a2d6ca9d","timestamp":"2026-10-05T07:44:42.698Z","sourceToolAssistantUUID":"4ed0873b-70be-4911-847b-dbd56b65db29","userType":"external","entrypoint":"cli","cwd":"/Users/virajpatel/Projects/github.com/virajp/claude-plugins/.worktrees/2026-10-05-tool-config-templates","sessionId":"69f6d805-2cf4-410f-bb9a-f18a900e1285","version":"2.1.289","gitBranch":"2026-10-05-tool-config-templates"}
