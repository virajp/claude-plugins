{"parentUuid":"51183d68-8b1e-484d-aee7-27434c7a7012","isSidechain":true,"promptId":"f3add2f7-ffac-43ca-818b-a54ab113212d","agentId":"a7b9a102584489b88","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EFZPK63c3ybVQB96BBhioG","type":"tool_result","content":"     1\t// What a render writes, file by file: `assets/` copied as they are,\n     2\t// `templates/` rendered with lib/template.mjs from the values plus the names\n     3\t// derived here on every render. Six files carry a `>>> tool-config` /\n     4\t// `<<< tool-config` marker pair: only the lines between them are rewritten,\n     5\t// and every line outside is the repo's own. Every other file is owned whole.\n     6\t// A mise file a CI environment loads has each `latest` pin made exact.\n     7\t\n     8\timport {\n     9\t  existsSync,\n    10\t  readdirSync,\n    11\t  statSync,\n    12\t} from \"node:fs\";\n    13\timport {\n    14\t  join,\n    15\t  relative,\n    16\t} from \"node:path\";\n    17\timport {\n    18\t  joinLines,\n    19\t  splitLines,\n    20\t} from \"./paths.mjs\";\n    21\timport { RefusalError } from \"./rows.mjs\";\n    22\timport {\n    23\t  render,\n    24\t  TemplateError,\n    25\t} from \"./template.mjs\";\n    26\t\n    27\texport const TASKS_DIR = \".config/mise/tasks\";\n    28\tconst CONF_D = \".config/mise/conf.d\";\n    29\t\n    30\t/** The `…:all` task folders, each with the derived name listing its subtasks. */\n    31\texport const SUBTASK_DIRS = {\n    32\t  CHECK_SUBTASKS: \"code/check\",\n    33\t  LINT_SUBTASKS: \"code/lint\",\n    34\t  FORMAT_SUBTASKS: \"code/format\",\n    35\t  AI_SUBTASKS: \"setup/ai\",\n    36\t  DEPS_INSTALL_SUBTASKS: \"setup/deps/install\",\n    37\t  DEPS_UPGRADE_SUBTASKS: \"setup/deps/upgrade\",\n    38\t  DEPS_OUTDATED_SUBTASKS: \"setup/deps/outdated\",\n    39\t  DEPS_AUDIT_SUBTASKS: \"setup/deps/audit\",\n    40\t  DEPS_CLEANUP_SUBTASKS: \"setup/deps/cleanup\",\n    41\t};\n    42\t\n    43\t/** The tools whose pin stays `latest` even where CI loads it. */\n    44\tconst FLOATING = new Set([\"node\", \"pnpm\"]);\n    45\t\n    46\t// --- the source trees ---------------------------------------------------------\n    47\t\n    48\t/** Every file under `dir`: its repo-relative path and whether it is executable. */\n    49\texport function walk(dir) {\n    50\t  if (!existsSync(dir)) {\n    51\t    return [];\n    52\t  }\n    53\t  const out = [];\n    54\t  const visit = abs => {\n    55\t    for (const d of readdirSync(abs, { withFileTypes: true })) {\n    56\t      const p = join(abs, d.name);\n    57\t      if (d.isDirectory()) {\n    58\t        visit(p);\n    59\t      }\n    60\t      else if (d.isFile()) {\n    61\t        out.push({\n    62\t          path: relative(dir, p).split(\"\\\\\").join(\"/\"),\n    63\t          abs: p,\n    64\t          exec: (statSync(p).mode & 0o111) !== 0,\n    65\t        });\n    66\t      }\n    67\t    }\n    68\t  };\n    69\t  visit(dir);\n    70\t  return out.sort((a, b) => (a.path < b.path ? -1 : a.path > b.path ? 1 : 0));\n    71\t}\n    72\t\n    73\t/** Which derived file names a template reads: 0 none, 1 a `*_SUBTASKS` list, 2 `TASKS`. */\n    74\texport function tierOf(text) {\n    75\t  if (/@@(?:#each |#if )?TASKS@@/.test(text)) {\n    76\t    return 2;\n    77\t  }\n    78\t  return /@@(?:#each |#if )?[A-Z_]+_SUBTASKS@@/.test(text) ? 1 : 0;\n    79\t}\n    80\t\n    81\t/** A template rendered, a TemplateError refused naming the file. */\n    82\texport function renderTemplate(text, values, source) {\n    83\t  try {\n    84\t    return render(text, values, { source });\n    85\t  }\n    86\t  catch (e) {\n    87\t    if (e instanceof TemplateError) {\n    88\t      throw new RefusalError(\n    89\t        `${e.message} — the render needs that value (a pack's own: --set <key>=<value>)`,\n    90\t      );\n    91\t    }\n    92\t    throw e;\n    93\t  }\n    94\t}\n    95\t\n    96\t// --- the marker pair ------------------------------------------------------------\n    97\t\n    98\tconst OPEN = /^\\s*(?:#|\\/\\/)\\s*>>> tool-config\\s*$/;\n    99\tconst CLOSE = /^\\s*(?:#|\\/\\/)\\s*<<< tool-config\\s*$/;\n   100\t\n   101\tfunction markers(lines) {\n   102\t  const open = lines.findIndex(l => OPEN.test(l));\n   103\t  const close = lines.findIndex(l => CLOSE.test(l));\n   104\t  if (\n   105\t    open < 0\n   106\t    || close <= open\n   107\t    || lines.filter(l => OPEN.test(l) || CLOSE.test(l)).length !== 2\n   108\t  ) {\n   109\t    return null;\n   110\t  }\n   111\t  return { open, close };\n   112\t}\n   113\t\n   114\t/** Whether a source file carries the marker pair. */\n   115\texport const isMarked = text => markers(splitLines(text).lines) !== null;\n   116\t\n   117\t/**\n   118\t * The repo's file with the source's marked lines in place of its own — or\n   119\t * null when the repo's file has no single marker pair to rewrite between.\n   120\t */\n   121\texport function splice(existing, source) {\n   122\t  const src = splitLines(source).lines;\n   123\t  const { lines, eol } = splitLines(existing);\n   124\t  const s = markers(src);\n   125\t  const e = markers(lines);\n   126\t  if (!s || !e) {\n   127\t    return null;\n   128\t  }\n   129\t  return joinLines(\n   130\t    [\n   131\t      ...lines.slice(0, e.open),\n   132\t      ...src.slice(s.open, s.close + 1),\n   133\t      ...lines.slice(e.close + 1),\n   134\t    ],\n   135\t    eol,\n   136\t  );\n   137\t}\n   138\t\n   139\t// --- slots --------------------------------------------------------------------\n   140\t\n   141\tconst PLACEHOLDER = /^#PLACEHOLDER\\s*$/m;\n   142\t\n   143\t/** A slot a pack or the repo has filled: the source is a placeholder, the file in place is not. */\n   144\texport const filledSlot = (source, existing) =>\n   145\t  existing !== null && PLACEHOLDER.test(source) && !PLACEHOLDER.test(existing);\n   146\t\n   147\t// --- pins -----------------------------------------------------------------------\n   148\t\n   149\t/** A mise file every CI environment loads: the base config, or a conf.d `mise{,.ci,.test}.toml`. */\n   150\texport const isCiLoaded = path =>\n   151\t  path === \".config/mise.toml\"\n   152\t  || /^\\.config\\/mise\\/conf\\.d\\/[^/]+\\/mise(?:\\.ci|\\.test)?\\.toml$/.test(path);\n   153\t\n   154\t/** An exact version: three numeric parts at least, an optional pre-release or build tail. */\n   155\texport const isExact = v =>\n   156\t  /^v?\\d+\\.\\d+\\.\\d+([-+.][0-9A-Za-z.-]+)?$/.test(v ?? \"\");\n   157\t\n   158\tconst HEADER = /^\\s*\\[([^\\]]+)\\]\\s*(?:#.*)?$/;\n   159\tconst TOOL_HEADER = /^tools\\.(?:\"([^\"]+)\"|([A-Za-z0-9_.:/@-]+))$/;\n   160\tconst VERSION_LINE = /^(\\s*version\\s*=\\s*)\"([^\"]*)\"(.*)$/;\n   161\tconst INLINE_PIN =\n   162\t  /^(\\s*)(?:\"([^\"]+)\"|([A-Za-z0-9_:/@.-]+))(\\s*=\\s*)\"([^\"]*)\"(.*)$/;\n   163\t\n   164\t/**\n   165\t * Every pin in a mise file: `{tool, version, line}` per `version = \"…\"` in a\n   166\t * `[tools.<name>]` table and per `<name> = \"…\"` in `[tools]`.\n   167\t */\n   168\texport function pinsOf(text) {\n   169\t  const out = [];\n   170\t  let table = null;\n   171\t  splitLines(text ?? \"\").lines.forEach((l, line) => {\n   172\t    const h = HEADER.exec(l);\n   173\t    if (h) {\n   174\t      table = h[1].trim();\n   175\t      return;\n   176\t    }\n   177\t    const t = table && TOOL_HEADER.exec(table);\n   178\t    if (t) {\n   179\t      const v = VERSION_LINE.exec(l);\n   180\t      if (v) {\n   181\t        out.push({ tool: t[1] ?? t[2], version: v[2], line });\n   182\t      }\n   183\t      return;\n   184\t    }\n   185\t    if (table === \"tools\") {\n   186\t      const m = INLINE_PIN.exec(l);\n   187\t      if (m) {\n   188\t        out.push({ tool: m[2] ?? m[3], version: m[5], line });\n   189\t      }\n   190\t    }\n   191\t  });\n   192\t  return out;\n   193\t}\n   194\t\n   195\t/** `text` with the pin on `line` set to `version`. */\n   196\texport function setPin(text, line, version) {\n   197\t  const { lines, eol } = splitLines(text);\n   198\t  lines[line] = VERSION_LINE.test(lines[line])\n   199\t    ? lines[line].replace(VERSION_LINE, `$1\"${version}\"$3`)\n   200\t    : lines[line].replace(\n   201\t      INLINE_PIN,\n   202\t      (_, ind, q, b, eq, _v, rest) =>\n   203\t        `${ind}${q ? `\"${q}\"` : b}${eq}\"${version}\"${rest}`,\n   204\t    );\n   205\t  return joinLines(lines, eol);\n   206\t}\n   207\t\n   208\t/**\n   209\t * A CI-loaded render with every `latest` pin made exact — the version the\n   210\t * repo's file already pins for that tool when it pins one exactly, else\n   211\t * `latest(tool)`. node and pnpm stay `latest`.\n   212\t */\n   213\texport function pinExact(text, existing, latest) {\n   214\t  const held = new Map(\n   215\t    pinsOf(existing).filter(p => isExact(p.version)).map(p => [\n   216\t      p.tool,\n   217\t      p.version,\n   218\t    ]),\n   219\t  );\n   220\t  let out = text;\n   221\t  for (const pin of pinsOf(text)) {\n   222\t    if (pin.version !== \"latest\" || FLOATING.has(pin.tool)) {\n   223\t      continue;\n   224\t    }\n   225\t    out = setPin(out, pin.line, held.get(pin.tool) ?? latest(pin.tool));\n   226\t  }\n   227\t  return out;\n   228\t}\n   229\t\n   230\t// --- derived names ------------------------------------------------------------\n   231\t\n   232\t/** A member's slug: its folder name, lowercased, every other run of characters a `-`. */\n   233\texport const slugOf = path =>\n   234\t  path\n   235\t    .split(\"/\")\n   236\t    .at(-1)\n   237\t    .toLowerCase()\n   238\t    .replace(/[^a-z0-9]+/g, \"-\")\n   239\t    .replace(/^-+|-+$/g, \"\");\n   240\t\n   241\t/** The names derived from the values alone, with the stored names' defaults filled. */\n   242\texport function valueNames(values) {\n   243\t  const out = {\n   244\t    MERGE_MODEL_DEVELOP: \"direct\",\n   245\t    MERGE_MODEL_MAIN: \"pr\",\n   246\t    MEMBERS: [],\n   247\t    SCOPES: [],\n   248\t    NODE: false,\n   249\t    EXTERNAL: false,\n   250\t    ...values,\n   251\t  };\n   252\t  if (out.PROJECT_NAME === undefined && out.REPO_NAME !== undefined) {\n   253\t    out.PROJECT_NAME = out.REPO_NAME;\n   254\t  }\n   255\t  out.MEMBERS_SPACED = out.MEMBERS.join(\" \");\n   256\t  const seen = new Map();\n   257\t  out.MEMBER_ENTRIES = out.MEMBERS.map(path => {\n   258\t    const slug = slugOf(path);\n   259\t    if (!slug) {\n   260\t      throw new RefusalError(`member ${path} has no slug — rename its folder`);\n   261\t    }\n   262\t    if (seen.has(slug)) {\n   263\t      throw new RefusalError(\n   264\t        `members ${\n   265\t          seen.get(slug)\n   266\t        } and ${path} share the slug ${slug} — their setup flags would collide`,\n   267\t      );\n   268\t    }\n   269\t    seen.set(slug, path);\n   270\t    return { path, slug };\n   271\t  });\n   272\t  return out;\n   273\t}\n   274\t\n   275\t/** Every `*_SUBTASKS` list: the task files directly in each folder, `all` excluded, sorted. */\n   276\texport function subtaskNames(ws) {\n   277\t  const out = {};\n   278\t  for (const [name, dir] of Object.entries(SUBTASK_DIRS)) {\n   279\t    const prefix = `${TASKS_DIR}/${dir}/`;\n   280\t    out[name] = ws\n   281\t      .list(prefix)\n   282\t      .map(p => p.slice(prefix.length))\n   283\t      .filter(leaf => !leaf.includes(\"/\") && leaf !== \"all\")\n   284\t      .sort();\n   285\t  }\n   286\t  return out;\n   287\t}\n   288\t\n   289\tconst DESCRIPTION = /^#MISE description=\"((?:[^\"\\\\]|\\\\.)*)\"\\s*$/m;\n   290\tconst TOML_TASK = /^tasks\\.(?:\"([^\"]+)\"|([A-Za-z0-9_:-]+))$/;\n   291\tconst TOML_DESCRIPTION = /^\\s*description\\s*=\\s*\"((?:[^\"\\\\]|\\\\.)*)\"/;\n   292\t\n   293\tconst unescape = s => s.replace(/\\\\(.)/g, \"$1\");\n   294\t\n   295\t/**\n   296\t * `TASKS`: every task the tree defines — each file task under the tasks\n   297\t * folder