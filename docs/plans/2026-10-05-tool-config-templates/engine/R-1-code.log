{"parentUuid":"42c5d133-651f-429d-93f9-66d16f84dda3","isSidechain":true,"promptId":"f3add2f7-ffac-43ca-818b-a54ab113212d","agentId":"a7b9a102584489b88","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Mntt84ocuGGGrysKMMTkkL","type":"tool_result","content":"     1\t// The `@@` template engine: `@@NAME@@` substitutes a value, `@@#if NAME@@ …\n     2\t// @@#else@@ … @@/if@@` and `@@#each NAME@@ … @@/each@@` are blocks, and `@@.@@`\n     3\t// or `@@.key@@` reads the innermost `#each` item. The delimiters are chosen to\n     4\t// pass mise's Tera `{{ … }}`/`{% … %}` and bash's `${…}` through untouched.\n     5\t// Strict throughout: an unknown name, a stray `@@`, an unbalanced block or an\n     6\t// unsafe value is a TemplateError naming the template and the line.\n     7\t\n     8\t/** A template fault: carries the template's `source` label and a 1-based `line`. */\n     9\texport class TemplateError extends Error {\n    10\t  constructor(source, line, message) {\n    11\t    super(`${source}:${line}: ${message}`);\n    12\t    this.name = \"TemplateError\";\n    13\t    this.source = source;\n    14\t    this.line = line;\n    15\t  }\n    16\t}\n    17\t\n    18\tconst REF = String.raw`[A-Z][A-Z0-9_]*|\\.(?:[A-Za-z_][A-Za-z0-9_]*)?`;\n    19\tconst TAG = new RegExp(\n    20\t  String.raw`@@(?:(#if|#each) (${REF})|(#else|\\/if|\\/each)|(${REF}))@@`,\n    21\t  \"g\",\n    22\t);\n    23\tconst BLOCK_LINE = new RegExp(\n    24\t  String\n    25\t    .raw`^[ \\t]*@@(?:(#if|#each) (${REF})|(#else|\\/if|\\/each))@@[ \\t]*(?:\\r?\\n)?$`,\n    26\t);\n    27\t// C0 and C1 controls (line breaks among them), DEL, and U+2028/U+2029.\n    28\tconst unsafe = text =>\n    29\t  [...text].some(ch => {\n    30\t    const code = ch.codePointAt(0);\n    31\t    return code <= 0x1f\n    32\t      || (code >= 0x7f && code <= 0x9f)\n    33\t      || code === 0x2028\n    34\t      || code === 0x2029;\n    35\t  });\n    36\t\n    37\t/** One token from a matched tag: a block tag, or a `var`. */\n    38\tfunction tagToken(m, line) {\n    39\t  if (m[1]) {\n    40\t    return { type: m[1].slice(1), ref: m[2], line };\n    41\t  }\n    42\t  if (m[3]) {\n    43\t    return { type: m[3] === \"#else\" ? \"else\" : m[3], line };\n    44\t  }\n    45\t  return { type: \"var\", ref: m[4], line };\n    46\t}\n    47\t\n    48\t/** Split the template into text and tag tokens, each with its source line. */\n    49\tfunction tokenize(template, source) {\n    50\t  const tokens = [];\n    51\t  const lines = template.match(/[^\\n]*\\n|[^\\n]+$/g) ?? [];\n    52\t  lines.forEach((text, i) => {\n    53\t    const line = i + 1;\n    54\t    const whole = BLOCK_LINE.exec(text);\n    55\t    if (whole) {\n    56\t      tokens.push(tagToken([null, whole[1], whole[2], whole[3]], line));\n    57\t      return;\n    58\t    }\n    59\t    let at = 0;\n    60\t    // Text keeps no `@@`: a malformed tag is refused here, taken branch or not.\n    61\t    const pushText = piece => {\n    62\t      if (piece.includes(\"@@\")) {\n    63\t        throw new TemplateError(\n    64\t          source,\n    65\t          line,\n    66\t          \"a stray @@ is left in the template\",\n    67\t        );\n    68\t      }\n    69\t      tokens.push({ type: \"text\", text: piece, line });\n    70\t    };\n    71\t    for (const m of text.matchAll(TAG)) {\n    72\t      if (m.index > at) {\n    73\t        pushText(text.slice(at, m.index));\n    74\t      }\n    75\t      tokens.push(tagToken(m, line));\n    76\t      at = m.index + m[0].length;\n    77\t    }\n    78\t    if (at < text.length) {\n    79\t      pushText(text.slice(at));\n    80\t    }\n    81\t  });\n    82\t  return tokens;\n    83\t}\n    84\t\n    85\t/** Build the block tree; a mismatched or unbalanced tag names both lines. */\n    86\tfunction parse(tokens, source) {\n    87\t  const root = { type: \"root\", body: [] };\n    88\t  const stack = [root];\n    89\t  for (const token of tok