{"parentUuid":"95b87e84-f447-476d-aed4-275ffcb8e4ac","isSidechain":true,"promptId":"f3add2f7-ffac-43ca-818b-a54ab113212d","agentId":"a7b9a102584489b88","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YZQGBSZNHs8cUuVm21Vv5G","type":"tool_result","content":"     1\t// The flag grammar. Four shapes, each of which `preview` may open:\n     2\t//\n     3\t//   [preview] all [--repo-name <n>] [--merge-model-develop direct|pr]\n     4\t//                 [--merge-model-main direct|pr] [--members <a,b>] [--scopes <a,b>]\n     5\t//                 [--node true|false] [--external true|false] [--forge <f>]\n     6\t//                 [--secrets <s>] [--answers <id>:<answer>,…]\n     7\t//   [preview] pack --slug <s> --dir <pack dir> [--set <key>=<value>]… [--answers …]\n     8\t//   [preview] pack-remove --slug <s> [--answers …]\n     9\t//   [preview] upgrade [--answers …]\n    10\t//\n    11\t// plus the globals --repo-root and --plugin-root, anywhere. `--key=value` and\n    12\t// `--key value` both read; a flag followed by another flag, or by nothing, is\n    13\t// empty — save a bool flag, which reads `true`. Lists are comma-separated, no\n    14\t// spaces; `--set` alone may repeat. Every value lands raw inside a quoted\n    15\t// string, so each is held to a character set that cannot break the quoting.\n    16\t\n    17\timport {\n    18\t  parseAnswers,\n    19\t  RefusalError,\n    20\t} from \"./rows.mjs\";\n    21\t\n    22\texport const COMMANDS = [\"all\", \"pack\", \"pack-remove\", \"upgrade\"];\n    23\t\n    24\tconst SURFACE =\n    25\t  \"the script takes all, pack, pack-remove or upgrade (each optionally after preview)\";\n    26\t\n    27\tconst GLOBALS = [\"repo-root\", \"plugin-root\"];\n    28\t\n    29\tconst WORD = /^[A-Za-z0-9._-]+$/;\n    30\tconst SLUG = /^[a-z0-9][a-z0-9-]*$/;\n    31\tconst MEMBER = /^[A-Za-z0-9._-]+(\\/[A-Za-z0-9._-]+)*$/;\n    32\tconst SET_KEY = /^[a-z][a-z0-9_]*$/;\n    33\t\n    34\tconst bool = (key, v) => {\n    35\t  if (v === \"\" || v === \"true\") {\n    36\t    return true;\n    37\t  }\n    38\t  if (v === \"false\") {\n    39\t    return false;\n    40\t  }\n    41\t  throw new RefusalError(`--${key} must be true or false, not ${v}`);\n    42\t};\n    43\t\n    44\tconst word = (key, v) => {\n    45\t  if (!WORD.test(v)) {\n    46\t    throw new RefusalError(\n    47\t      `--${key} ${JSON.stringify(v)} must be letters, digits, ., _ or -`,\n    48\t    );\n    49\t  }\n    50\t  return v;\n    51\t};\n    52\t\n    53\tconst mergeModel = (key, v) => {\n    54\t  if (v !== \"direct\" && v !== \"pr\") {\n    55\t    throw new RefusalError(`--${key} must be direct or pr, not ${v}`);\n    56\t  }\n    57\t  return v;\n    58\t};\n    59\t\n    60\tconst list = test => (key, v) => {\n    61\t  if (v === \"\") {\n    62\t    return [];\n    63\t  }\n    64\t  const items = v.split(\",\");\n    65\t  for (const item of items) {\n    66\t    if (\n    67\t      !test.test(item) || item.split(\"/\").some(s => s === \".\" || s === \"..\")\n    68\t    ) {\n    69\t      throw new RefusalError(\n    70\t        `--${key}: ${JSON.stringify(item)} is not a valid entry`,\n    71\t      );\n    72\t    }\n    73\t  }\n    74\t  if (new Set(items).size !== items.length) {\n    75\t    throw new RefusalError(`--${key} names an entry twice`);\n    76\t  }\n    77\t  return items;\n    78\t};\n    79\t\n    80\t/** `all`'s flags → the stackgen.yaml key each writes, and how its value reads. */\n    81\texport const ALL_FLAGS = {\n    82\t  \"repo-name\": [\"repo_name\", word],\n    83\t  \"merge-model-develop\": [\"merge_model.develop\", mergeModel],\n    84\t  \"merge-model-main\": [\"merge_model.main\", mergeModel],\n    85\t  members: [\"members\", list(MEMBER)],\n    86\t  scopes: [\"scopes\", list(WORD)],\n    87\t  node: [\"node\", bool],\n    88\t  external: [\"external\", bool],\n    89\t  forge: [\"forge\", word],\n    90\t  secrets: [\"secrets\", word],\n    91\t};\n    92\t\n    93\tconst FLAGS = {\n    94\t  all: Object.keys(ALL_FLAGS),\n    95\t  pack: [\"slug\", \"dir\", \"set\"],\n    96\t  \"pack-remove\": [\"slug\"],\n    97\t  upgrade: [],\n    98\t};\n    99\t\n   100\t/** `--set key=value` → [key, value]; the value is held like any other. */\n   101\tfunction setPair(text) {\n   102\t  const eq = text.indexOf(\"=\");\n   103\t  const key = eq > 0 ? text.slice(0, eq) : \"\";\n   104\t  const value = eq > 0 ? text.slice(eq + 1) : \"\";\n   105\t  if (!SET_KEY.test(key)) {\n   106\t    throw new RefusalError(\n   107\t      `--set ${\n   108\t        JSON.stringify(text)\n   109\t      } is not <key>=<value> with a lowercase key (letters, digits, _)`,\n   110\t    );\n   111\t  }\n   112\t  if (\n   113\t    [...value].some(c => {\n   114\t      const code = c.codePointAt(0);\n   115\t      return code <= 0x1f\n   116\t        || (code >= 0x7f && code <= 0x9f)\n   117\t        || code === 0x2028\n   118\t        || code === 0x2029;\n   119\t    })\n   120\t    || /[\"\\\\]|@@/.test(value)\n   121\t  ) {\n   122\t    throw new RefusalError(\n   123\t      `--set ${key}: the value holds a quote, a backslash, @@ or a control character`,\n   124\t    );\n   125\t  }\n   126\t  return [key, value];\n   127\t}\n   128\t\n   129\t/** argv (after the script) → the call: `{preview, command, flags, globals, answers}`. */\n   130\texport function parseArgs(argv) {\n   131\t  const args = [...argv];\n   132\t  const call = {\n   133\t    preview: false,\n   134\t    flags: {},\n   135\t    globals: {},\n   136\t    answers: null,\n   137\t  };\n   138\t  if (args[0] === \"preview\") {\n   139\t    call.preview = true;\n   140\t    args.shift();\n   141\t  }\n   142\t  const head = args.shift();\n   143\t  if (head === undefined || head.startsWith(\"--\")) {\n   144\t    throw new RefusalError(`name a command — ${SURFACE}`);\n   145\t  }\n   146\t  if (!COMMANDS.includes(head)) {\n   147\t    throw new RefusalError(`${head} is retired or unknown — ${SURFACE}`);\n   148\t  }\n   149\t  call.command = head;\n   150\t  const sets = [];\n   151\t  for (let i = 0; i < args.length; i++) {\n   152\t    const arg = args[i];\n   153\t    if (!arg.startsWith(\"--\")) {\n   154\t      throw new RefusalError(\n   155\t        head === \"all\"\n   156\t          ? `all takes no verb (${arg}) — ${SURFACE}; an exclude is a line in the repo's own part of the file`\n   157\t          : `unexpected argument: ${arg}`,\n   158\t      );\n   159\t    }\n   160\t    let key = arg.slice(2);\n   161\t    let value;\n   162\t    const eq = key.indexOf(\"=\");\n   163\t    if (eq >= 0) {\n   164\t      value = key.slice(eq + 1);\n   165\t      key = key.slice(0, eq);\n   166\t    }\n   167\t    else if (i + 1 < args.length && !args[i + 1].startsWith(\"--\")) {\n   168\t      value = args[++i];\n   169\t    }\n   170\t    else {\n   171\t      value = \"\";\n   172\t    }\n   173\t    if (!/^[a-z][a-z0-9-]*$/.test(key)) {\n   174\t      throw new RefusalError(`not a flag: ${arg}`);\n   175\t    }\n   176\t    if (GLOBALS.includes(key)) {\n   177\t      call.globals[key] = value;\n   178\t    }\n   179\t    else if (key === \"answers\") {\n   180\t      call.answers = value;\n   181\t    }\n   182\t    else if (key === \"for\") {\n   183\t      throw new RefusalError(\n   184\t        `--for is retired: a pack's lines come from its templates/ — ${SURFACE}`,\n   185\t      );\n   186\t    }\n   187\t    else if (!FLAGS[head].includes(key)) {\n   188\t      const names = FLAGS[head].map(k => `--${k}`).join(\", \") || \"none\";\n   189\t      throw new RefusalError(`unknown flag --${key} — valid: ${names}`);\n   190\t    }\n   191\t    else if (key === \"set\") {\n   192\t      sets.push(value);\n   193\t    }\n   194\t    else if (key in call.flags) {\n   195\t      throw new RefusalError(`--${key} is given twice`);\n   196\t    }\n   197\t    else {\n   198\t      call.flags[key] = value;\n   199\t    }\n   200\t  }\n   201\t\n   202\t  if (call.answers !== null) {\n   203\t    if (call.preview) {\n   204\t      throw new RefusalError(\"a preview never carries --answers\");\n   205\t    }\n   206\t    call.answers = parseAnswers(call.answers);\n   207\t  }\n   208\t  if (head === \"all\") {\n   209\t    call.values = {};\n   210\t    for (const [flag, value] of Object.entries(call.flags)) {\n   211\t      const [key, read] = ALL_FLAGS[flag];\n   212\t      call.values[key] = read(flag, value);\n   213\t    }\n   214\t  }\n   215\t  if (head === \"pack\" || head === \"pack-remove\") {\n   216\t    if (!call.flags.slug) {\n   217\t      throw new RefusalError(`${head} needs --slug`);\n   218\t    }\n   219\t    if (!SLUG.test(call.flags.slug)) {\n   220\t      throw new RefusalError(\n   221\t        `--slug ${\n   222\t          JSON.stringify(call.flags.slug)\n   223\t        } is not a pack slug (lowercase letters, digits, -)`,\n   224\t      );\n   225\t    }\n   226\t  }\n   227\t  if (head === \"pack\") {\n   228\t    if (!call.flags.dir) {\n   229\t      throw new RefusalError(\"pack needs --dir <the pack's folder>\");\n   230\t    }\n   231\t    call.sets = {};\n   232\t    for (const text of sets) {\n   233\t      const [key, value] = setPair(text);\n   234\t      if (key in call.sets) {\n   235\t        throw new RefusalError(`--set ${key} is given twice`);\n   236\t      }\n   237\t      call.sets[key] = value;\n   238\t    }\n   239\t  }\n   240\t  return call;\n   241\t}\n     1\t// The rows a call shows before it writes, numbered r1, r2, … in order, each\n     2\t// with the answers its kind takes, and the check that a call's `--answers`\n     3\t// names exactly the rows its preview showed, unchanged.\n     4\t\n     5\timport { spawnSync } from \"node:child_process\";\n     6\timport {\n     7\t  existsSync,\n     8\t  mkdirSync,\n     9\t  readFileSync,\n    10\t  writeFileSync,\n    11\t} from \"node:fs\";\n    12\timport { tmpdir } from \"node:os\";\n    13\timport {\n    14\t  dirname,\n    15\t  isAbsolute,\n    16\t  join,\n    17\t} from \"node:path\";\n    18\timport { sha256 } from \"./paths.mjs\";\n    19\t\n    20\t/**\n    21\t * The answers each kind of row takes: `ok` takes the render, `keep-existing`\n    22\t * leaves the file — or the pin — as it stands.\n    23\t */\n    24\texport const ANSWERS = {\n    25\t  create: [\"ok\"],\n    26\t  write: [\"ok\", \"keep-existing\"],\n    27\t  delete: [\"ok\", \"keep-existing\"],\n    28\t  pin: [\"ok\", \"keep-existing\"],\n    29\t};\n    30\t\n    31\tconst hidden = key => key === \"effects\" || key === \"id\" || key.startsWith(\"_\");\n    32\t\n    33\t/** What identifies a row's content: everything shown but its id. */\n    34\texport function fingerprint(row) {\n    35\t  const shown = Object.fromEntries(\n    36\t    Object.entries(row).filter(([k]) => !hidden(k)),\n    37\t  );\n    38\t  return sha256(JSON.stringify(shown)).slice(0, 16);\n    39\t}\n    40\t\n    41\t/** Number the rows in order and fingerprint each. */\n    42\texport function numberRows(rows) {\n    43\t  return rows.map((row, n) => {\n    44\t    const answers = row.answers ?? ANSWERS[row.kind];\n    45\t    if (!answers) {\n    46\t      throw new Error(`row kind ${row.kind} names no answers`);\n    47\t    }\n    48\t    const out = { ...row, answers, id: `r${n + 1}` };\n    49\t    out._fingerprint = fingerprint(out);\n    50\t    return out;\n    51\t  });\n    52\t}\n    53\t\n    54\t/** A row as the caller sees it: id first, nothing internal. */\n    55\texport function publicRow(row) {\n    56\t  const out = { id: row.id };\n    57\t  for (const [k, v] of Object.entries(row)) {\n    58\t    if (!hidden(k)) {\n    59\t      out[k] = v;\n    60\t    }\n    61\t  }\n    62\t  return out;\n    63\t}\n    64\t\n    65\t/** `r1:ok,r2:keep-existing` → Map, or a thrown refusal. */\n    66\texport function parseAnswers(text) {\n    67\t  const out = new Map();\n    68\t  if (text === \"\") {\n    69\t    return out;\n    70\t  }\n    71\t  for (const part of text.split(\",\")) {\n    72\t    const m = /^(r[1-9][0-9]*):([a-z][a-z0-9-]*)$/.exec(part);\n    73\t    if (!m) {\n    74\t      throw new RefusalError(\n    75\t        `answers: ${JSON.stringify(part)} is not <id>:<answer>`,\n    76\t      );\n    77\t    }\n    78\t    if (out.has(m[1])) {\n    79\t      throw new RefusalError(`answers: ${m[1]} is answered twice`);\n    80\t    }\n    81\t    out.set(m[1], m[2]);\n    82\t  }\n    83\t  return out;\n    84\t}\n    85\t\n    86\t/**\n    87\t * A refused call: exit 2, the message, and the rows shown again when there\n    88\t * are some; `extra` (`{written, deleted}` when files stayed) joins the body.\n    89\t */\n    90\texport class RefusalError extends Error {\n    91\t  constructor(message, rows, extra) {\n    92\t    super(message);\n    93\t    this.rows = rows;\n    94\t    this.extra = extra;\n    95\t  }\n    96\t}\n    97\t\n    98\t/**\n    99\t * Refuse unless `answers` names exactly the rebuilt rows' ids, each with one\n   100\t * of its answers, and every row matches the one the stored preview showed.\n   101\t */\n   102\texport function checkAnswers(rows, answers, stored) {\n   103\t  if (!stored) {\n   104\t    throw new RefusalError(\n   105\t      \"no preview on record for this call — run it with preview first, then answer its rows\",\n   106\t      rows,\n   107\t    );\n   108\t  }\n   109\t  const before = new Map(stored.map(r => [r.id, r.fingerprint]));\n   110\t  for (const row of rows) {\n   111\t    if (!before.has(row.id) || before.get(row.id) !== row._fingerprint) {\n   112\t      throw new RefusalError(\n   113\t        `row ${row.id} changed since the preview — answer the rows shown again`,\n   114\t        rows,\n   115\t      );\n   116\t    }\n   117\t  }\n   118\t  if (before.size !== rows.length) {\n   119\t    throw new RefusalError(\n   120\t      \"the rows changed since the preview — answer the rows shown again\",\n   121\t      rows,\n   122\t    );\n   123\t  }\n   124\t  const ids = new Set(rows.map(r => r.id));\n   125\t  for (const id of answers.keys()) {\n   126\t    if (!ids.has(id)) {\n   127\t      throw new RefusalError(`answers: no row ${id}`, rows);\n   128\t    }\n   129\t  }\n   130\t  for (const row of rows) {\n   131\t    const answer = answers.get(row.id);\n   132\t    if (answer === undefined) {\n   133\t      throw new RefusalError(`answers: row ${row.id} is not answered`, rows);\n   134\t    }\n   135\t    if (!row.answers.includes(answer)) {\n   136\t      throw new RefusalError(\n   137\t        `answers: ${row.id} takes ${row.answers.join(\" or \")}, not ${answer}`,\n   138\t        rows,\n   139\t      );\n   140\t    }\n   141\t  }\n   142\t}\n   143\t\n   144\t// --- the preview record --------------------------------------------------------\n   145\t// A preview's rows are kept in the repo's git dir, keyed by the call, so the\n   146\t// answering call can tell a row that changed in between. Never in the tree.\n   147\t\n   148\tfunction storePath(repoRoot) {\n   149\t  const git = spawnSync(\"git\", [\"-C\", repoRoot, \"rev-parse\", \"--git-dir\"], {\n   150\t    encoding: \"utf8\",\n   151\t  });\n   152\t  if (git.status === 0) {\n   153\t    const dir = git.stdout.trim();\n   154\t    return join(\n   155\t      isAbsolute(dir) ? dir : join(repoRoot, dir),\n   156\t      \"stackgen-tool-config-previews.json\",\n   157\t    );\n   158\t  }\n   159\t  return join(\n   160\t    tmpdir(),\n   161\t    `stackgen-tool-config-previews-${sha256(repoRoot).slice(0, 16)}.json`,\n   162\t  );\n   163\t}\n   164\t\n   165\texport function previewStore(repoRoot) {\n   166\t  const path = storePath(repoRoot);\n   167\t  const load =\n   168\t    () => (existsSync(path) ? JSON.parse(readFileSync(path, \"utf8\")) : {});\n   169\t  const save = all => {\n   170\t    mkdirSync(dirname(path), { recursive: true });\n   171\t    writeFileSync(path, JSON.stringify(all, null, 2) + \"\\n\");\n   172\t  };\n   173\t  return {\n   174\t    get: signature => load()[signature] ?? null,\n   175\t    put(signature, rows) {\n   176\t      const all = load();\n   177\t      all[signature] = rows.map(r => ({\n   178\t        id: r.id,\n   179\t        fingerprint: r._fingerprint,\n   180\t      }));\n   181\t      save(all);\n   182\t    },\n   183\t    drop(signature) {\n   184\t      const all = load();\n   185\t      if (!(signature in all)) {\n   186\t        return;\n   187\t      }\n   188\t      delete all[signature];\n   189\t      save(all);\n   190\t    },\n   191\t  };\n   192\t}\n     1\t// Every tool the script runs, it runs through mise, in the repo root: a tool\n     2\t// only ever as `MISE_ENV=dev mise x -- <tool> …`, the version the repo's config pins —\n     3\t// never `mise x <tool>@… --`, which can install a version the config does not\n     4\t// name — and never before `mise which <tool>` says it is installed. The repo's\n     5\t// mise config is trusted by the person beforehand; the script reads that\n     6\t// trust and never grants it.\n     7\t\n     8\timport { spawnSync } from \"node:child_process\";\n     9\timport {\n    10\t  realpathSync,\n    11\t  statSync,\n    12\t} from \"node:fs\";\n    13\timport { homedir } from \"node:os\";\n    14\timport {\n    15\t  delimiter,\n    16\t  join,\n    17\t  sep,\n    18\t} from \"node:path\";\n    19\timport { RefusalError } from \"./rows.mjs\";\n    20\t\n    21\texport const MISSING_MISE =\n    22\t  \"mise is not on PATH — install mise (https://mise.jdx.dev), then re-run.\";\n    23\t\n    24\t/** What installs every tool the repo's mise config pins. */\n    25\texport const SETUP_REMEDY = \"MISE_ENV=dev mise run setup:all\";\n    26\t\n    27\t/** dprint and pre-commit are pinned in conf.d/_base/mise.dev.toml — every tool runs in dev. */\n    28\tconst TOOL_ENV = { MISE_ENV: \"dev\" };\n    29\t\n    30\t/** A path as mise prints it — `~/…` under the home directory — made real for comparing. */\n    31\tfunction realOf(printed) {\n    32\t  const abs = printed === \"~\" || printed.startsWith(\"~/\")\n    33\t    ? join(homedir(), printed.slice(1))\n    34\t    : printed;\n    35\t  try {\n    36\t    return realpathSync(abs);\n    37\t  }\n    38\t  catch {\n    39\t    return abs;\n    40\t  }\n    41\t}\n    42\t\n    43\tconst TRUST_REMEDY =\n    44\t  \"trust it — add the repo's path to trusted_config_paths in the global mise config, or run `mise trust --all` in the repo — then re-run\";\n    45\t\n    46\t/** The last lines of a command's output, enough to say why it failed. */\n    47\tfunction tail(res) {\n    48\t  const text = `${res.stdout ?? \"\"}${res.stderr ?? \"\"}`.trim();\n    49\t  return text.length > 4000 ? `…${text.slice(-4000)}` : text;\n    50\t}\n    51\t\n    52\texport function onPath(bin, path = process.env.PATH ?? \"\") {\n    53\t  return path.split(delimiter).some(dir => {\n    54\t    try {\n    55\t      return dir && statSync(join(dir, bin)).isFile();\n    56\t    }\n    57\t    catch {\n    58\t      return false;\n    59\t    }\n    60\t  });\n    61\t}\n    62\t\n    63\texport class Runner {\n    64\t  constructor(repoRoot) {\n    65\t    this.repoRoot = repoRoot;\n    66\t    this.installed = new Set();\n    67\t  }\n    68\t\n    69\t  mise(args, env = {}) {\n    70\t    const res = spawnSync(\"mise\", args, {\n    71\t      cwd: this.repoRoot,\n    72\t      encoding: \"utf8\",\n    73\t      stdio: [\"ignore\", \"pipe\", \"pipe\"],\n    74\t      maxBuffer: 64 * 1024 * 1024,\n    75\t      env: { ...process.env, ...env },\n    76\t    });\n    77\t    if (res.error?.code === \"ENOENT\") {\n    78\t      throw new RefusalError(MISSING_MISE);\n    79\t    }\n    80\t    if (res.error) {\n    81\t      throw res.error;\n    82\t    }\n    83\t    return res;\n    84\t  }\n    85\t\n    86\t  /**\n    87\t   * Refuse when mise reads any config at or under the repo root as untrusted.\n    88\t   * Without mise on PATH there is nothing to ask — a call that needs mise is\n    89\t   * refused where it does.\n    90\t   */\n    91\t  trust() {\n    92\t    if (!onPath(\"mise\")) {\n    93\t      return;\n    94\t    }\n    95\t    const res = this.mise([\"trust\", \"--show\"]);\n    96\t    const root = realpathSync(this.repoRoot);\n    97\t    const untrusted = `${res.stdout ?? \"\"}`\n    98\t      .split(\"\\n\")\n    99\t      .map(l => /^(.*): untrusted$/.exec(l.trim())?.[1])\n   100\t      .filter(p => {\n   101\t        const real = p && realOf(p);\n   102\t        return real && (real === root || real.startsWith(root + sep));\n   103\t      });\n   104\t    if (untrusted.length) {\n   105\t      throw new RefusalError(\n   106\t        `the repo's mise config is not trusted (${\n   107\t          untrusted.join(\", \")\n   108\t        }) — ${TRUST_REMEDY}`,\n   109\t      );\n   110\t    }\n   111\t  }\n   112\t\n   113\t  /** Refuse unless the repo's mise config has `tool` installed. */\n   114\t  ensure(tool) {\n   115\t    if (this.installed.has(tool)) {\n   116\t      return;\n   117\t    }\n   118\t    const res = this.mise([\"which\", tool], TOOL_ENV);\n   119\t    if (res.status !== 0) {\n   120\t      throw new RefusalError(\n   121\t        `${tool} is not installed by the repo's mise config — run ${SETUP_REMEDY}, then re-run`,\n   122\t      );\n   123\t    }\n   124\t    this.installed.add(tool);\n   125\t  }\n   126\t\n   127\t  /** `mise x -- <tool> <args>` in the repo root, the one form a tool runs in; a failure refuses. */\n   128\t  tool(tool, args) {\n   129\t    this.ensure(tool);\n   130\t    const res = this.mise([\"x\", \"--\", tool, ...args], TOOL_ENV);\n   131\t    if (res.status !== 0) {\n   132\t      throw new RefusalError(\n   133\t        `mise x -- ${tool} ${args.join(\" \")} failed:\\n${tail(res)}`,\n   134\t      );\n   135\t    }\n   136\t    return res;\n   137\t  }\n   138\t\n   139\t  /** Whether the repo's mise config has `tool` installed — asked once, never refused. */\n   140\t  has(tool) {\n   141\t    if (!onPath(\"mise\")) {\n   142\t      return false;\n   143\t    }\n   144\t    try {\n   145\t      this.ensure(tool);\n   146\t      return true;\n   147\t    }\n   148\t    catch (e) {\n   149\t      if (e instanceof RefusalError) {\n   150\t        return false;\n   151\t      }\n   152\t      throw e;\n   153\t    }\n   154\t  }\n   155\t\n   156\t  /**\n   157\t   * `text` as the repo's formatter leaves it for `path` — `mise x -- dprint\n   158\t   * fmt --stdin` under the repo's own config — or null when it cannot say.\n   159\t   */\n   160\t  format(path, text, config) {\n   161\t    const res = spawnSync(\n   162\t      \"mise\",\n   163\t      [\"x\", \"--\", \"dprint\", \"fmt\", \"--config\", config, \"--stdin\", path],\n   164\t      {\n   165\t        cwd: this.repoRoot,\n   166\t        encoding: \"utf8\",\n   167\t        input: text,\n   168\t        stdio: [\"pipe\", \"pipe\", \"pipe\"],\n   169\t        maxBuffer: 64 * 1024 * 1024,\n   170\t        env: { ...process.env, ...TOOL_ENV },\n   171\t      },\n   172\t    );\n   173\t    return res.status === 0 && !res.error ? res.stdout : null;\n   174\t  }\n   175\t\n   176\t  /** `mise latest <tool>`, once per tool per call; no version refuses, naming the tool. */\n   177\t  latest(tool) {\n   178\t    this.latests ??= new Map();\n   179\t    if (!this.latests.has(tool)) {\n   180\t      const res = this.mise([\"latest\", tool]);\n   181\t      const out = (res.stdout ?? \"\").trim().split(\"\\n\")[0]?.trim() ?? \"\";\n   182\t      if (res.status !== 0 || !out || /\\s/.test(out)) {\n   183\t        const why = (res.stderr ?? \"\").trim().split(\"\\n\")[0]\n   184\t          || `exit ${res.status}`;\n   185\t        throw new RefusalError(\n   186\t          `mise latest ${tool} gave no version (${why}) — a pin CI loads is only ever written exact`,\n   187\t        );\n   188\t      }\n   189\t      this.latests.set(tool, out);\n   190\t    }\n   191\t    return this.latests.get(tool);\n   192\t  }\n   193\t\n   194\t  /** `MISE_ENV=dev mise run setup:all` — installs and sets up everything the repo pins. */\n   195\t  setupAll() {\n   196\t    const res = this.mise([\"run\", \"setup:all\"], TOOL_ENV);\n   197\t    // colour codes stripped: the output lands in a JSON report, warnings included\n   198\t    return {\n   199\t      ok: res.status === 0,\n   200\t      output: tail(res).replace(\n   201\t        new RegExp(`${String.fromCharCode(27)}\\\\[[0-9;]*m`, \"g\"),\n   202\t        \"\",\n   203\t      ),\n   204\t    };\n   205\t  }\n   206\t}","is_error":false}]},"uuid":"1dccb20a-a620-4a54-812d-0ee58fbfecf3","timestamp":"2026-10-05T07:45:00.906Z","sourceToolAssistantUUID":"95b87e84-f447-476d-aed4-275ffcb8e4ac","userType":"external","entrypoint":"cli","cwd":"/Users/virajpatel/Projects/github.com/virajp/claude-plugins/.worktrees/2026-10-05-tool-config-templates","sessionId":"69f6d805-2cf4-410f-bb9a-f18a900e1285","version":"2.1.289","gitBranch":"2026-10-05-tool-config-templates"}
