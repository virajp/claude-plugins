the script refuses to act on. */\n     9\texport class UnsafePathError extends Error {}\n    10\t\n    11\t/** Refuse a path that is absolute, empty, or holds a `..` segment. */\n    12\texport function checkRelPath(path) {\n    13\t  if (\n    14\t    typeof path !== \"string\"\n    15\t    || path === \"\"\n    16\t    || path.startsWith(\"/\")\n    17\t    || /^[A-Za-z]:/.test(path)\n    18\t    || path.includes(\"\\\\\")\n    19\t    || path.split(\"/\").some(seg => seg === \"..\")\n    20\t  ) {\n    21\t    throw new UnsafePathError(\n    22\t      `${JSON.stringify(path)} is not a repo-relative path — refused`,\n    23\t    );\n    24\t  }\n    25\t  return path;\n    26\t}\n    27\t\n    28\texport function splitLines(text) {\n    29\t  const lines = text.split(\"\\n\");\n    30\t  const eol = lines.at(-1) === \"\";\n    31\t  if (eol) {\n    32\t    lines.pop();\n    33\t  }\n    34\t  return { lines, eol };\n    35\t}\n    36\t\n    37\texport function joinLines(lines, eol = true) {\n    38\t  if (lines.length === 0) {\n    39\t    return \"\";\n    40\t  }\n    41\t  return lines.join(\"\\n\") + (eol ? \"\\n\" : \"\");\n    42\t}\n     1\t// The writer of `.config/stackgen.yaml` — the script is its only writer. A\n     2\t// call's values merge into what the file holds, and the result is written in\n     3\t// one fixed key order, in the grammar lib/yaml.mjs reads and nothing wider.\n     4\t// The text a call would write is also what that call renders from: it is\n     5\t// loaded through lib/values.mjs exactly as a later call would read it.\n     6\t\n     7\timport {\n     8\t  mkdirSync,\n     9\t  mkdtempSync,\n    10\t  rmSync,\n    11\t  writeFileSync,\n    12\t} from \"node:fs\";\n    13\timport { tmpdir } from \"node:os\";\n    14\timport { join } from \"node:path\";\n    15\timport {\n    16\t  deriveOrigin,\n    17\t  loadValues,\n    18\t  STACKGEN_PATH,\n    19\t} from \"./values.mjs\";\n    20\t\n    21\texport { STACKGEN_PATH };\n    22\t\n    23\tconst HEADER = [\n    24\t  \"# stackgen's values for this repo, read by every tool-config render.\",\n    25\t  \"# Written by the tool-config script alone — change a value through it, never by hand.\",\n    26\t];\n    27\t\n    28\tconst ORDER = [\n    29\t  \"format\",\n    30\t  \"repo_name\",\n    31\t  \"merge_model\",\n    32\t  \"members\",\n    33\t  \"scopes\",\n    34\t  \"node\",\n    35\t  \"external\",\n    36\t  \"forge\",\n    37\t  \"secrets\",\n    38\t  \"packs\",\n    39\t];\n    40\t\n    41\tconst quote = s => `\"${s.replace(/\\\\/g, \"\\\\\\\\\").replace(/\"/g, \"\\\\\\\"\")}\"`;\n    42\t\n    43\tfunction scalar(value) {\n    44\t  if (typeof value === \"string\") {\n    45\t    return quote(value);\n    46\t  }\n    47\t  return String(value);\n    48\t}\n    49\t\n    50\tfunction valueText(value) {\n    51\t  return Array.isArray(value)\n    52\t    ? `[${value.map(scalar).join(\", \")}]`\n    53\t    : scalar(value);\n    54\t}\n    55\t\n    56\t/** The file's text for a parsed document. */\n    57\texport function stackgenText(doc) {\n    58\t  const lines = [...HEADER, \"\"];\n    59\t  for (const key of ORDER) {\n    60\t    if (doc[key] === undefined) {\n    61\t      continue;\n    62\t    }\n    63\t    if (key === \"merge_model\") {\n    64\t      lines.push(\"merge_model:\");\n    65\t      for (const branch of [\"develop\", \"main\"]) {\n    66\t        if (doc.merge_model[branch] !== undefined) {\n    67\t          lines.push(`  ${branch}: ${scalar(doc.merge_model[branch])}`);\n    68\t        }\n    69\t      }\n    70\t      continue;\n    71\t    }\n    72\t    if (key === \"packs\") {\n    73\t      const slugs = Object.keys(doc.packs).sort();\n    74\t      if (!slugs.length) {\n    75\t        continue;\n    76\t      }\n    77\t      lines.push(\"packs:\");\n    78\t      for (const slug of slugs) {\n    79\t        const entries = Object.entries(doc.packs[slug]).sort(([a], [b]) =>\n    80\t          a < b ? -1 : a > b ? 1 : 0\n    81\t        );\n    82\t        if (!entries.length) {\n    83\t          continue;\n    84\t        }\n    85\t        lines.push(`  ${slug}:`);\n    86\t        for (const [k, v] of entries) {\n    87\t          lines.push(`    ${k}: ${valueText(v)}`);\n    88\t        }\n    89\t      }\n    90\t      if (lines.at(-1) === \"packs:\") {\n    91\t        lines.pop();\n    92\t      }\n    93\t      continue;\n    94\t    }\n    95\t    lines.push(`${key}: ${valueText(doc[key])}`);\n    96\t  }\n    97\t  return lines.join(\"\\n\") + \"\\n\";\n    98\t}\n    99\t\n   100\t/** `doc` with `all`'s values set — `merge_model.develop` and `.main` nested. */\n   101\texport function withValues(doc, values) {\n   102\t  const out = structuredClone(doc ?? {});\n   103\t  out.format = 1;\n   104\t  for (const [key, value] of Object.entries(values)) {\n   105\t    if (key.startsWith(\"merge_model.\")) {\n   106\t      out.merge_model = {\n   107\t        ...out.merge_model,\n   108\t        [key.slice(\"merge_model.\".length)]: value,\n   109\t      };\n   110\t    }\n   111\t    else {\n   112\t      out[key] = value;\n   113\t    }\n   114\t  }\n   115\t  return out;\n   116\t}\n   117\t\n   118\t/** `doc` with a pack's values merged in (`sets`), or its entry dropped (`sets` null). */\n   119\texport function withPack(doc, slug, sets) {\n   120\t  const out = structuredClone(doc ?? {});\n   121\t  out.format = 1;\n   122\t  const packs = { ...out.packs };\n   123\t  if (sets === null) {\n   124\t    delete packs[slug];\n   125\t  }\n   126\t  else if (Object.keys(sets).length) {\n   127\t    packs[slug] = { ...packs[slug], ...sets };\n   128\t  }\n   129\t  if (Object.keys(packs).length) {\n   130\t    out.packs = packs;\n   131\t  }\n   132\t  else {\n   133\t    delete out.packs;\n   134\t  }\n   135\t  return out;\n   136\t}\n   137\t\n   138\t/**\n   139\t * The values a template reads, loaded from `text` as the file would hold it\n   140\t * — validated by lib/values.mjs in a scratch directory, then given the repo's\n   141\t * own `origin` names. `pack` adds that pack's own keys.\n   142\t */\n   143\texport function valuesFrom(text, repoRoot, pack) {\n   144\t  const dir = mkdtempSync(join(tmpdir(), \"stackgen-values-\"));\n   145\t  try {\n   146\t    mkdirSync(join(dir, \".config\"));\n   147\t    writeFileSync(join(dir, STACKGEN_PATH), text);\n   148\t    return { ...loadValues(dir, { pack }), ...deriveOrigin(repoRoot) };\n   149\t  }\n   150\t  finally {\n   151\t    rmSync(dir, { recursive: true, force: true });\n   152\t  }\n   153\t}","is_error":false}]},"uuid":"398e660b-33a8-490c-be82-55a96d6c7cf2","timestamp":"2026-10-05T07:44:43.729Z","sourceToolAssistantUUID":"51183d68-8b1e-484d-aee7-27434c7a7012","userType":"external","entrypoint":"cli","cwd":"/Users/virajpatel/Projects/github.com/virajp/claude-plugins/.worktrees/2026-10-05-tool-config-templates","sessionId":"69f6d805-2cf4-410f-bb9a-f18a900e1285","version":"2.1.289","gitBranch":"2026-10-05-tool-config-templates"}
