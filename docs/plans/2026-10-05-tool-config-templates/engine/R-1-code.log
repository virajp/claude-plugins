{"parentUuid":"c33ddf6e-de02-46c2-88a9-6e9699617435","isSidechain":true,"promptId":"f3add2f7-ffac-43ca-818b-a54ab113212d","agentId":"a7b9a102584489b88","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01M2zvtc3EgTEe6cmekfbXPz","type":"tool_result","content":"     1\t// The values a template reads: `.config/stackgen.yaml`, validated, each key\n     2\t// named by upper-casing it and joining nested keys with `_`, plus REPO_URL and\n     3\t// PROJECT_NAME derived from the repo's `origin` at load time — never stored,\n     4\t// so they cannot go stale when the remote moves. A pack's template also sees\n     5\t// its own `packs.<slug>.*` unprefixed; a clash with a global name is refused.\n     6\t\n     7\timport { execFileSync } from \"node:child_process\";\n     8\timport {\n     9\t  existsSync,\n    10\t  readFileSync,\n    11\t  realpathSync,\n    12\t} from \"node:fs\";\n    13\timport { join } from \"node:path\";\n    14\timport { parseYaml } from \"./yaml.mjs\";\n    15\t\n    16\texport const STACKGEN_PATH = \".config/stackgen.yaml\";\n    17\t\n    18\t/** A `.config/stackgen.yaml` that parses but breaks the file's shape. */\n    19\texport class ValuesError extends Error {}\n    20\t\n    21\tconst MERGE_MODELS = [\"direct\", \"pr\"];\n    22\tconst NAME = /^[A-Z][A-Z0-9_]*$/;\n    23\t\n    24\tconst isMap = v => v !== null && typeof v === \"object\" && !Array.isArray(v);\n    25\tconst isStringList = v =>\n    26\t  Array.isArray(v) && v.every(x => typeof x === \"string\");\n    27\tconst isScalar = v => [\"string\", \"number\", \"boolean\"].includes(typeof v);\n    28\t\n    29\tconst kind = {\n    30\t  string: [v => typeof v === \"string\", \"a string\"],\n    31\t  bool: [v => typeof v === \"boolean\", \"true or false\"],\n    32\t  list: [isStringList, \"a list of strings\"],\n    33\t};\n    34\t\n    35\tconst TOP = {\n    36\t  format: null,\n    37\t  repo_name: kind.string,\n    38\t  merge_model: null,\n    39\t  members: kind.list,\n    40\t  scopes: kind.list,\n    41\t  node: kind.bool,\n    42\t  external: kind.bool,\n    43\t  forge: kind.string,\n    44\t  secrets: kind.string,\n    45\t  packs: null,\n    46\t};\n    47\t\n    48\tfunction refuse(key, message) {\n    49\t  throw new ValuesError(`${STACKGEN_PATH}: ${key} ${message}`);\n    50\t}\n    51\t\n    52\tfunction validate(doc) {\n    53\t  if (!isMap(doc)) {\n    54\t    throw new ValuesError(`${STACKGEN_PATH}: the file must be a mapping`);\n    55\t  }\n    56\t  for (const key of Object.keys(doc)) {\n    57\t    if (!Object.hasOwn(TOP, key)) {\n    58\t      refuse(key, \"is not a known key\");\n    59\t    }\n    60\t    const check = TOP[key];\n    61\t    if (check && !check[0](doc[key])) {\n    62\t      refuse(key, `must be ${check[1]}`);\n    63\t    }\n    64\t  }\n    65\t  if (doc.format !== 1) {\n    66\t    refuse(\"format\", `must be 1, got ${JSON.stringify(doc.format ?? null)}`);\n    67\t  }\n    68\t  if (doc.merge_model !== undefined) {\n    69\t    if (!isMap(doc.merge_model)) {\n    70\t      refuse(\"merge_model\", \"must be a mapping of develop and main\");\n    71\t    }\n    72\t    for (const [branch, model] of Object.entries(doc.merge_model)) {\n    73\t      if (branch !== \"develop\" && branch !== \"main\") {\n    74\t        refuse(`merge_model.${branch}`, \"is not a known key\");\n    75\t      }\n    76\t      if (!MERGE_MODELS.includes(model)) {\n    77\t        refuse(\n    78\t          `merge_model.${branch}`,\n    79\t          `must be \"direct\" or \"pr\", got ${JSON.stringify(model)}`,\n    80\t        );\n    81\t      }\n    82\t    }\n    83\t  }\n    84\t  if (doc.packs !== undefined) {\n    85\t    if (!isMap(doc.packs)) {\n    86\t      refuse(\"packs\", \"must be a mapping of pack slugs\");\n    87\t    }\n    88\t    for (const [slug, entries] of Object.entries(doc.packs)) {\n    89\t      if (!isMap(entries)) {\n    90\t        refuse(`packs.${slug}`, \"must be a mapping\");\n    91\t      }\n    92\t      for (const [key, value] of Object.entries(entries)) {\n    93\t        if (!NAME.test(key.toUpperCase())) {\n    94\t          refuse(\n    95\t            `packs.${slug}.${key}`,\n    96\t            \"does not name a value — letters, digits and _ only\",\n    97\t          );\n    98\t        }\n    99\t        if (!isScalar(value) && !isStringList(value)) {\n   100\t          refuse(\n   101\t            `packs.${slug}.${key}`,\n   102\t            \"must be a scalar or a list of strings\",\n   103\t          );\n   104\t        }\n   105\t      }\n   106\t    }\n   107\t  }\n   108\t  return doc;\n   109\t}\n   110\t\n   111\t/** The parsed, validated `.config/stackgen.yaml` under `repoRoot`, or null when absent. */\n   112\texport function readStackgen(repoRoot) {\n   113\t  const path = join(repoRoot, STACKGEN_PATH);\n   114\t  if (!existsSync(path)) {\n   115\t    return null;\n   116\t  }\n   117\t  return validate(\n   118\t    parseYaml(readFileSync(path, \"utf8\"), { source: STACKGEN_PATH }),\n   119\t  );\n   120\t}\n   121\t\n   122\t/** Key → name: upper-cased, nested keys joined with `_`; lists stay values. */\n   123\texport function toNames(obj, prefix = \"\") {\n   124\t  const out = {};\n   125\t  for (const [key, value] of Object.entries(obj)) {\n   126\t    const name = `${prefix}${key.toUpperCase()}`;\n   127\t    if (isMap(value)) {\n   128\t      Object.assign(out, toNames(value, `${name}_`));\n   129\t    }\n   130\t    else {\n   131\t      out[name] = value;\n   132\t    }\n   133\t  }\n   134\t  return out;\n   135\t}\n   136\t\n   137\t/** `{ host, path }` from an scp, ssh:// or https:// remote URL, or null. */\n   138\tfunction parseRemote(url) {\n   139\t  let m = /^(ssh|https):\\/\\/(?:[^@/]*@)?([^/:]+)(?::(\\d+))?\\/(.+)$/i.exec(url);\n   140\t  if (!m && !/^[a-z][a-z0-9+.-]*:\\/\\//i.test(url)) {\n   141\t    m = /^()[^@/\\s]+@([^:/\\s]+):()(.+)$/.exec(url);\n   142\t  }\n   143\t  if (!m) {\n   144\t    return null;\n   145\t  }\n   146\t  const [, scheme, host, port, rest] = m;\n   147\t  const path = rest.replace(/\\/+$/, \"\").replace(/\\.git$/, \"\");\n   148\t  // Both land inside quoted shell and TOML: a host or a segment holding\n   149\t  // anything but these characters is not a forge URL.\n   150\t  if (\n   151\t    !/^[A-Za-z0-9.-]+$/.test(host)\n   152\t    || !/^[A-Za-z0-9._-]+(\\/[A-Za-z0-9._-]+)+$/.test(path)\n   153\t  ) {\n   154\t    return null;\n   155\t  }\n   156\t  if (path.split(\"/\").some(seg => seg === \".\" || seg === \"..\")) {\n   157\t    return null;\n   158\t  }\n   159\t  // An https port is part of the web URL; an ssh port is not.\n   160\t  const web = scheme.toLowerCase() === \"https\" && port ? `:${port}` : \"\";\n   161\t  return { host: `${host.toLowerCase()}${web}`, path };\n   162\t}\n   163\t\n   164\t/** REPO_URL and PROJECT_NAME from `origin`, or `{}` when there is none or it is not a forge URL. */\n   165\texport function deriveOrigin(repoRoot) {\n   166\t  const git = (...args) =>\n   167\t    execFileSync(\"git\", [\"-C\", repoRoot, ...args], {\n   168\t      encoding: \"utf8\",\n   169\t      stdio: [\"ignore\", \"pipe\", \"ignore\"],\n   170\t    })\n   171\t      .trim();\n   172\t  let url;\n   173\t  try {\n   174\t    // git walks up into an enclosing checkout: a directory that is not its own\n   175\t    // repo's top level has no origin of its own.\n   176\t    if (\n   177\t      realpathSync(git(\"rev-parse\", \"--show-toplevel\"))\n   178\t        !== realpathSync(repoRoot)\n   179\t    ) {\n   180\t      return {};\n   181\t    }\n   182\t    url = git(\"remote\", \"get-url\", \"origin\");\n   183\t  }\n   184\t  catch {\n   185\t    return {};\n   186\t  }\n   187\t  const remote = parseRemote(url);\n   188\t  if (!remote) {\n   189\t    return {};\n   190\t  }\n   191\t  return {\n   192\t    REPO_URL: `https://${remote.host}/${remote.path}`,\n   193\t    PROJECT_NAME: remote.path,\n   194\t  };\n   195\t}\n   196\t\n   197\t/** A line break, a C0/C1 control character, or U+2028/U+2029. */\n   198\tconst unsafe = c =>\n   199\t  c <= 0x1f || (c >= 0x7f && c <= 0x9f) || c === 0x2028 || c === 0x2029;\n   200\t\n   201\tfunction checkScalar(name, value) {\n   202\t  if (\n   203\t    typeof value === \"string\"\n   204\t    && [...value].some(ch => unsafe(ch.codePointAt(0)))\n   205\t  ) {\n   206\t    throw new ValuesError(\n   207\t      `${STACKGEN_PATH}: ${name} holds a line break, a control character or a line/paragraph separator — refused`,\n   208\t    );\n   209\t  }\n   210\t}\n   211\t\n   212\t/** Every name D6 and D7 can produce, present in this repo or not. */\n   213\tconst GLOBAL_NAMES = new Set([\n   214\t  ...Object.keys(TOP).filter(k => k !== \"packs\" && k !== \"merge_model\").map(k =>\n   215\t    k.toUpperCase()\n   216\t  ),\n   217\t  \"MERGE_MODEL_DEVELOP\",\n   218\t  \"MERGE_MODEL_MAIN\",\n   219\t  \"REPO_URL\",\n   220\t  \"PROJECT_NAME\",\n   221\t]);\n   222\t\n   223\t/**\n   224\t * The flat name → value map a template reads: every stored key but `packs`,\n   225\t * the names derived from `origin`, and — when `pack` names a slug — that\n   226\t * pack's own keys unprefixed.\n   227\t */\n   228\texport function loadValues(repoRoot, { pack } = {}) {\n   229\t  const { packs = {}, ...stored } = readStackgen(repoRoot) ?? {};\n   230\t  const values = { ...toNames(stored), ...deriveOrigin(repoRoot) };\n   231\t  if (pack !== undefined) {\n   232\t    const own = Object.hasOwn(packs, pack) ? packs[pack] : {};\n   233\t    const seen = new Map();\n   234\t    for (const [key, value] of Object.entries(own)) {\n   235\t      const name = key.toUpperCase();\n   236\t      if (seen.has(name)) {\n   237\t        throw new ValuesError(\n   238\t          `${STACKGEN_PATH}: packs.${pack}.${\n   239\t            seen.get(name)\n   240\t          } and packs.${pack}.${key} both name ${name} — refused`,\n   241\t        );\n   242\t      }